{
  "name": "aetheria-abyss-reshaping",
  "version": "0.2.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build.mjs && node scripts/build-standalone.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/browser.mjs",
    "check": "npm run typecheck && npm test && npm run build && node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "playwright": "1.62.1"
  }
}
