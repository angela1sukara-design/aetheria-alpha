{
  "name": "aetheria-abyss-reshaping",
  "version": "0.2.0-alpha",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "lexicon": "node scripts/lexicon/cli.mjs",
    "lexicon:prepare": "node scripts/lexicon/prepare.mjs",
    "test:lexicon": "node --test tests/lexicon.test.ts tests/lexicon-whole.test.ts",
    "dev": "node scripts/serve.mjs",
    "build": "node scripts/build-adventure-content.mjs && node scripts/build-quest-content.mjs && node scripts/build-lexicon-adapter.mjs && node scripts/build-b-observations.mjs && node scripts/build-b-five-themes.mjs && node scripts/build-a-templates.mjs && node scripts/build-personal-content.mjs && node scripts/build.mjs && node scripts/build-standalone.mjs && node scripts/build-world-samples.mjs",
    "quests:build": "node scripts/build-quest-content.mjs",
    "test:quests": "node --test tests/cyber-apex.test.ts tests/neighborhood-quests.test.ts tests/world-profiles.test.ts tests/main-relationships.test.ts",
    "test:quests:browser": "node tests/world-profiles-browser.mjs",
    "lexicon:build": "node scripts/build-lexicon-adapter.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "node --test tests/*.test.ts",
    "test:browser": "node tests/folio-browser.mjs && node tests/adventure-browser.mjs",
    "test:b-content": "node --test tests/b-observations.test.ts tests/b-five-themes.test.ts tests/b-five-themes-previews.test.mjs",
    "test:b-content:browser": "node tests/b-five-themes-browser.mjs && node tests/b-observations-browser.mjs",
    "test:a-content": "node --test tests/a-templates.test.ts tests/prose-assembly.test.mjs",
    "test:a-content:browser": "node tests/a-templates-browser.mjs",
    "examples:a-content": "node scripts/build-a-template-example.mjs",
    "examples:b-content": "node scripts/build-b-five-theme-examples.mjs && node scripts/build-b-observation-example.mjs",
    "test:worldgen": "node --test tests/worldgen.test.ts tests/worldgen-v02.test.ts",
    "test:worldgen:browser": "node tests/worldgen-browser.mjs",
    "check": "npm run typecheck && npm run typecheck:tests && npm test && npm run build && node scripts/check-dist.mjs && npm run check:foundation",
    "check:foundation": "node scripts/check-foundation.mjs",
    "test:foundation:browser": "node tests/foundation-browser.mjs",
    "test:ui": "node tests/folio-browser.mjs",
    "test:ux": "node tests/adventure-browser.mjs",
    "test:folio": "node tests/folio-browser.mjs && node tests/adventure-browser.mjs",
    "test:adventure:browser": "node tests/adventure-browser.mjs",
    "tag-matrices:build": "node scripts/build-tag-matrices.mjs",
    "tag-matrices:check": "node scripts/check-tag-matrices.mjs",
    "test:tag-matrices": "node scripts/build-tag-matrices.mjs && node --test tests/tag-matrices.test.mjs tests/prose-assembly.test.mjs",
    "test:names": "node --test tests/names.test.ts",
    "test:prose-assembly": "node --test tests/prose-assembly.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "playwright": "1.62.1",
    "typescript": "5.9.3"
  }
}
