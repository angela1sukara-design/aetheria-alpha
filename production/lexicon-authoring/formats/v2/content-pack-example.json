{
  "manifest": {
    "id": "authoring/foundation-example",
    "namespace": "authoring",
    "version": "1.0.0",
    "schemaVersion": 2,
    "engineApiVersion": "0.1",
    "author": "Reviewed neutral format example",
    "status": "reviewed",
    "dependencies": [
      {
        "id": "engine/core",
        "version": "0.1.0",
        "optional": false
      },
      {
        "id": "aetheria/world",
        "version": "0.1.0",
        "optional": false
      },
      {
        "id": "aetheria/reshaping",
        "version": "0.1.0",
        "optional": false
      },
      {
        "id": "aetheria/social",
        "version": "0.1.0",
        "optional": false
      },
      {
        "id": "aetheria/recovery",
        "version": "0.1.0",
        "optional": false
      },
      {
        "id": "aetheria/district",
        "version": "0.2.0",
        "optional": false
      },
      {
        "id": "aetheria/foundation",
        "version": "1.0.0",
        "optional": false
      }
    ],
    "requiresCapabilities": [
      "foundation.v2",
      "body.graph.v1",
      "tf.pipeline.v1",
      "condition.v1",
      "effect.v1",
      "hook.action.v1"
    ],
    "migrations": []
  },
  "variables": [],
  "flags": [],
  "hooks": [],
  "locations": [],
  "routes": [],
  "events": [],
  "texts": {
    "authoring:text.done": "尾部参数已经通过身体补丁更新。"
  },
  "actions": [
    {
      "id": "authoring:action.tail-tone",
      "label": "示例尾部涂层",
      "hint": "仅供内容作者校验示例",
      "group": "daily",
      "surface": "body",
      "conditions": [
        {
          "op": "body.matches",
          "target": {
            "kind": "player"
          },
          "part": {
            "kind": "tail",
            "instanceId": "tail"
          }
        }
      ],
      "effects": [
        {
          "op": "tf.apply",
          "id": "authoring:tf.tail-tone",
          "target": {
            "kind": "player"
          }
        }
      ],
      "resultText": "authoring:text.done"
    }
  ],
  "contributions": [
    {
      "hookId": "aetheria-tf:hook.body",
      "actionIds": [
        "authoring:action.tail-tone"
      ]
    }
  ],
  "bodyPatches": [
    {
      "id": "authoring:patch.tail-tone",
      "label": "尾部参数示例",
      "summary": "明确材料、形态和长度",
      "operations": [
        {
          "type": "attributes",
          "partId": "tail",
          "set": {
            "materialId": "foundation:material.alloy",
            "morphologyId": "foundation:morphology.tail",
            "color": "silver",
            "lengthMm": 650
          },
          "unset": []
        }
      ]
    }
  ],
  "transformations": [
    {
      "id": "authoring:tf.tail-tone",
      "label": "尾部参数示例",
      "source": "free",
      "stages": [
        {
          "id": "apply",
          "atMinutes": 0,
          "label": "完成",
          "patchId": "authoring:patch.tail-tone"
        }
      ]
    }
  ],
  "proseMaterials": [
    {
      "id": "authoring:prose.tail",
      "text": "尾部表面泛着银色光泽，转身时需要留出空间。",
      "tags": [
        "foundation:body.mechanical-tail"
      ],
      "source": "neutral-authoring-example",
      "review": "approved",
      "tier": "general"
    }
  ],
  "proseSelections": [
    {
      "id": "authoring:selection.tail",
      "entryId": "authoring:prose.tail",
      "channel": "body",
      "when": [
        {
          "op": "body.matches",
          "target": {
            "kind": "player"
          },
          "part": {
            "kind": "tail",
            "materialFamily": "mechanical",
            "minLengthMm": 600
          }
        }
      ]
    }
  ]
}
