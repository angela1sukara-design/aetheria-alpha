{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:aetheria:lexicon-delivery:1",
  "title": "词条整包交付（完整性、范围和批次身份另由本地校验器检查）",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schemaVersion",
    "scope",
    "batches"
  ],
  "properties": {
    "format": {
      "const": "aetheria-lexicon-delivery"
    },
    "schemaVersion": {
      "const": 1
    },
    "scope": {
      "enum": [
        "all",
        "npc",
        "body",
        "world",
        "daily",
        "text"
      ]
    },
    "batches": {
      "type": "array",
      "minItems": 1,
      "maxItems": 214,
      "items": {
        "$ref": "batch.schema.json"
      }
    }
  }
}
