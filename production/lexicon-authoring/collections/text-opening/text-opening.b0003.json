{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-opening",
  "batchId": "text-opening.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-opening.b0003.0001",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "雨棚支架松了两颗钉，想请你帮我扶一下木杆。",
      "description": "雨棚维修协作开场。"
    },
    {
      "id": "lx.text-opening.b0003.0002",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "水渠闸板今早卡住了，我去拨一下，你若路过可帮看着水位。",
      "description": "水渠事务请托。"
    },
    {
      "id": "lx.text-opening.b0003.0003",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "苔藓培植箱要换一次滤网，材料我带了，缺一双手。",
      "description": "植物养护事务。"
    },
    {
      "id": "lx.text-opening.b0003.0004",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "码头寄存的斗笠还在，晴天前最好取走晒一晒。",
      "description": "提醒取物事务。"
    },
    {
      "id": "lx.text-opening.b0003.0005",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "公共洗衣台的排水慢，我报过一次，想确认有没有人跟进。",
      "description": "核实报修进度。"
    },
    {
      "id": "lx.text-opening.b0003.0006",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "蕨类苗要今晚浇透，轮值表上写的是我，先跟你说一声。",
      "description": "轮值事务告知。"
    },
    {
      "id": "lx.text-opening.b0003.0007",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "浮桥木板有一块翘起，我画了记号，想约人一起钉牢。",
      "description": "安全修补事务。"
    },
    {
      "id": "lx.text-opening.b0003.0008",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "雨衣借贷柜钥匙换班了，新钥匙在第二层抽屉。",
      "description": "交接钥匙事务。"
    },
    {
      "id": "lx.text-opening.b0003.0009",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "水岸步道今晚有人清淤，绕路牌子我刚立好。",
      "description": "公共施工通知。"
    },
    {
      "id": "lx.text-opening.b0003.0010",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "集市湿货摊位费改了算法，说明贴在棚柱上，你可以看一眼。",
      "description": "费用变更告知。"
    },
    {
      "id": "lx.text-opening.b0003.0011",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "雨停之后叶子上的水珠特别圆，我看了好一会儿。",
      "description": "雨后闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0012",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "渠边的青蛙叫得断断续续，像在对口令。",
      "description": "水岸声响闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0013",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我把湿鞋子倒扣在栏杆上，半晌还在滴水。",
      "description": "潮湿生活琐事。"
    },
    {
      "id": "lx.text-opening.b0003.0014",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "苔墙上冒出一朵小白菇，不知道能不能碰。",
      "description": "植物共居闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0015",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "雨棚下打牌的人走了，只剩一地湿脚印。",
      "description": "雨棚场景闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0016",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "今天风从水面吹过来，衣服一会儿就潮了。",
      "description": "湿度感受闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0017",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "有人在浮萍里放了盏小灯，夜里会亮一点。",
      "description": "水岸装饰见闻。"
    },
    {
      "id": "lx.text-opening.b0003.0018",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我刚摘了几片可食用的嫩蕨，洗得挺干净。",
      "description": "植物食用闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0019",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "码头木桩上的绳子结泡胀了，解起来费劲。",
      "description": "潮湿物件闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0020",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "听着水渠流水声，心情莫名地慢了下来。",
      "description": "安静面闲聊。"
    },
    {
      "id": "lx.text-opening.b0003.0021",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "雨棚布面被风鼓成弧形，绳结绷得紧紧的。",
      "description": "共观雨棚形态。"
    },
    {
      "id": "lx.text-opening.b0003.0022",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "水渠里漂着一片卷边的叶子，慢慢往下游去。",
      "description": "共看水流细节。"
    },
    {
      "id": "lx.text-opening.b0003.0023",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "步道两侧的苔藓颜色深浅不一，潮湿处更绿。",
      "description": "共观苔藓分布。"
    },
    {
      "id": "lx.text-opening.b0003.0024",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "码头栏杆摸上去凉而涩，盐分大概留下了。",
      "description": "共感栏杆触感。"
    },
    {
      "id": "lx.text-opening.b0003.0025",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "远处有人在撑伞过跳板，伞沿滴下一串水。",
      "description": "共看雨中行人。"
    },
    {
      "id": "lx.text-opening.b0003.0026",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "棚顶积水忽然泻下一大股，砸在桶里很响。",
      "description": "共处积水泻落。"
    },
    {
      "id": "lx.text-opening.b0003.0027",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "石缝里钻出一丛小蕨，叶子还带着水珠。",
      "description": "共观石缝植物。"
    },
    {
      "id": "lx.text-opening.b0003.0028",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "空气里有一股淡淡的青草和湿木味。",
      "description": "共感水岸气味。"
    },
    {
      "id": "lx.text-opening.b0003.0029",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "跳板中央有一处磨得发白，走的人多。",
      "description": "共察通行痕迹。"
    },
    {
      "id": "lx.text-opening.b0003.0030",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "灯笼在雨棚下晃，光斑在水面上碎开。",
      "description": "共观光影水面。"
    },
    {
      "id": "lx.text-opening.b0003.0031",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "日安。雨棚这边干一点，你可以先站过来。",
      "description": "让出干处的问候。"
    },
    {
      "id": "lx.text-opening.b0003.0032",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。伞我多带了一把，若你需要可以先用。",
      "description": "提供雨具的问候。"
    },
    {
      "id": "lx.text-opening.b0003.0033",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "早。水位比昨天低了些，过桥应该稳一些。",
      "description": "晨间路况问候。"
    },
    {
      "id": "lx.text-opening.b0003.0034",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "晚上好。步道灯亮了，我先跟你问声好。",
      "description": "夜路问候。"
    },
    {
      "id": "lx.text-opening.b0003.0035",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "打扰了。我是来取晾在棚下的竹篮的。",
      "description": "取物式问候。"
    },
    {
      "id": "lx.text-opening.b0003.0036",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "见过。鞋底泥多，我在门口蹭一下再进。",
      "description": "进门前礼貌说明。"
    },
    {
      "id": "lx.text-opening.b0003.0037",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "您好。湿货刚到，气味有点重，先跟你说一声。",
      "description": "提醒气味的问候。"
    },
    {
      "id": "lx.text-opening.b0003.0038",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "嗨。坐栏杆上可以吗？我保证不挡路。",
      "description": "问座问候。"
    },
    {
      "id": "lx.text-opening.b0003.0039",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。手里这束蕨是送邻居的，顺路问个好。",
      "description": "托物顺路问候。"
    },
    {
      "id": "lx.text-opening.b0003.0040",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "下午好。雨大的时候我就躲这边，今天又遇见你。",
      "description": "雨棚偶遇问候。"
    },
    {
      "id": "lx.text-opening.b0003.0041",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "雨天你更喜欢待在棚下，还是撑伞快走？随便问问。",
      "description": "试探雨天习惯。"
    },
    {
      "id": "lx.text-opening.b0003.0042",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有人把苔藓养在屋里当装饰，你觉得闷不闷？",
      "description": "试探植物共居态度。"
    },
    {
      "id": "lx.text-opening.b0003.0043",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "水渠清淤要不要喊更多人，你怎么看？",
      "description": "试探公共劳动意见。"
    },
    {
      "id": "lx.text-opening.b0003.0044",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "潮湿天衣服总干不了，你有没有土办法？",
      "description": "试探生活经验。"
    },
    {
      "id": "lx.text-opening.b0003.0045",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "若聊浮桥维修太无聊，我们也可以说说夜里的蛙声。",
      "description": "提供话题分支。"
    },
    {
      "id": "lx.text-opening.b0003.0046",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "我不太确定该不该采路边的菇，你懂行的话想请教一句。",
      "description": "谨慎试探知识。"
    },
    {
      "id": "lx.text-opening.b0003.0047",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "码头要不要加一块防滑垫，你会支持吗？",
      "description": "试探设施意见。"
    },
    {
      "id": "lx.text-opening.b0003.0048",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有时候听水声会发呆，你也这样吗？没有也没关系。",
      "description": "试探安静共鸣。"
    },
    {
      "id": "lx.text-opening.b0003.0049",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "雨棚漏的那角，你觉得补布还是换整幅更好？",
      "description": "试探修补方案。"
    },
    {
      "id": "lx.text-opening.b0003.0050",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "如果愿意，我可以讲讲上次涨水时的小事；不愿意就当没提。",
      "description": "可退的话题邀请。"
    }
  ]
}
