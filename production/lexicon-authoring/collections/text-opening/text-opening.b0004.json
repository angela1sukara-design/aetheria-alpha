{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-opening",
  "batchId": "text-opening.b0004",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.text-opening.b0004.0001",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "石阶第三级松了，我做了临时垫木，想请你帮忙试踩一下。",
      "description": "石阶安全事务。"
    },
    {
      "id": "lx.text-opening.b0004.0002",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "遮阳布的挂钩掉了一只，备用钩在布袋里，你闲时可帮挂上。",
      "description": "遮阳维护请托。"
    },
    {
      "id": "lx.text-opening.b0004.0003",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "迁居行李清单我抄了一份，想跟你核对有没有漏项。",
      "description": "迁居事务核对。"
    },
    {
      "id": "lx.text-opening.b0004.0004",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "高地驿站的饮水要预约，名额还剩几个，你若需要我帮问。",
      "description": "饮水预约事务。"
    },
    {
      "id": "lx.text-opening.b0004.0005",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "布帘洗涤点今天下午收件，脏帘可以先送过去。",
      "description": "洗涤事务提醒。"
    },
    {
      "id": "lx.text-opening.b0004.0006",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "石阶两侧的扶手要重新缠麻绳，材料到了，缺人手。",
      "description": "扶手维修协作。"
    },
    {
      "id": "lx.text-opening.b0004.0007",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "远行登记表要填目的地和预计归日，我把笔放桌上了。",
      "description": "远行登记事务。"
    },
    {
      "id": "lx.text-opening.b0004.0008",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "遮阳棚支架螺丝松动，我画了红点，方便你找。",
      "description": "标记维修点。"
    },
    {
      "id": "lx.text-opening.b0004.0009",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "高处储物间钥匙轮值换人了，新负责人住东侧第二户。",
      "description": "钥匙轮值告知。"
    },
    {
      "id": "lx.text-opening.b0004.0010",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "迁居车队明早出发，空位还剩一个，先问你要不要占。",
      "description": "询问意向，不强迫。"
    },
    {
      "id": "lx.text-opening.b0004.0011",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "石阶晒了一上午，坐上去还是烫的。",
      "description": "晴燥体感闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0012",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "遮阳布被风掀起一角，光一下子刺进来。",
      "description": "光影变化闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0013",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "有人把布帘染成浅沙色，远看像连着山壁。",
      "description": "布帘审美闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0014",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "迁居的人把旧壶挂在车边，一路叮当作响。",
      "description": "迁居见闻闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0015",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我鞋底粘了细沙，怎么跺都跺不干净。",
      "description": "干燥琐事闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0016",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "高处风大，帽子要按着才不会飞。",
      "description": "风力闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0017",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "远处有人在石阶上休息，水壶放在膝盖上。",
      "description": "远景观察闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0018",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "布帘缝里透出的光一条一条的，像被切开。",
      "description": "布帘光影闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0019",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "听说下一站的井水更甜，不知道是不是真的。",
      "description": "远行传闻闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0020",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我把水壶灌满了，走长路心里踏实一点。",
      "description": "远行准备闲聊。"
    },
    {
      "id": "lx.text-opening.b0004.0021",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "石阶被踩得发亮的地方集中在中间偏右。",
      "description": "共察石阶磨损。"
    },
    {
      "id": "lx.text-opening.b0004.0022",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "遮阳棚下的影子边缘很硬，阳光也硬。",
      "description": "共处强烈光影。"
    },
    {
      "id": "lx.text-opening.b0004.0023",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "布帘被风贴到墙上又弹开，发出啪的一声。",
      "description": "共听布帘声。"
    },
    {
      "id": "lx.text-opening.b0004.0024",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "高处平台的沙被扫成一堆，角落里还积着。",
      "description": "共看清扫痕迹。"
    },
    {
      "id": "lx.text-opening.b0004.0025",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "栏杆扶手上的麻绳起了毛边，握久了扎手。",
      "description": "共感扶手触感。"
    },
    {
      "id": "lx.text-opening.b0004.0026",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "远处山脊线条清晰，几乎没有雾。",
      "description": "共观晴燥远景。"
    },
    {
      "id": "lx.text-opening.b0004.0027",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "驿站门口的水缸盖着木板，边上搁着瓢。",
      "description": "共看饮水设施。"
    },
    {
      "id": "lx.text-opening.b0004.0028",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "石缝里几乎长不出草，只有一点干黄的茎。",
      "description": "共观干燥植被。"
    },
    {
      "id": "lx.text-opening.b0004.0029",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "遮阳布的接缝用粗线加固过，针脚很密。",
      "description": "共察布面工艺。"
    },
    {
      "id": "lx.text-opening.b0004.0030",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "台阶转角堆着几块备用石，编号还在。",
      "description": "共看维修备料。"
    },
    {
      "id": "lx.text-opening.b0004.0031",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "日安。石阶晒得很热，你慢一点下比较稳。",
      "description": "关照式问候。"
    },
    {
      "id": "lx.text-opening.b0004.0032",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。遮阳棚这边凉快，可以先站一会儿。",
      "description": "让阴凉问候。"
    },
    {
      "id": "lx.text-opening.b0004.0033",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "早。水壶我灌了两壶，你若口渴可以先喝。",
      "description": "分享饮水问候。"
    },
    {
      "id": "lx.text-opening.b0004.0034",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "晚上好。布帘放下后光就柔了，我先问声好。",
      "description": "夜色问候。"
    },
    {
      "id": "lx.text-opening.b0004.0035",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "打扰了。我是迁居路过的，想问一下饮水点方向。",
      "description": "问路式问候。"
    },
    {
      "id": "lx.text-opening.b0004.0036",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "见过。帽子被风吹歪了，我整理一下再说话。",
      "description": "整理后问候。"
    },
    {
      "id": "lx.text-opening.b0004.0037",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "您好。远行登记处还开着，不着急的话可以慢慢填。",
      "description": "指引式问候。"
    },
    {
      "id": "lx.text-opening.b0004.0038",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "嗨。坐石阶上可以吗？我不挡你下楼。",
      "description": "保持礼貌距离的问候，呼应「嗨坐石阶上可以吗？我不」情境。"
    },
    {
      "id": "lx.text-opening.b0004.0039",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。手里这卷布帘是送驿站的，顺路打个招呼。",
      "description": "托物问候。"
    },
    {
      "id": "lx.text-opening.b0004.0040",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "下午好。风干得嘴唇起皮，我带了点油膏，需要就说。",
      "description": "关照干燥的问候。"
    },
    {
      "id": "lx.text-opening.b0004.0041",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "走长石阶时你更喜欢一口气上，还是中途多歇？",
      "description": "试探行走习惯。"
    },
    {
      "id": "lx.text-opening.b0004.0042",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "遮阳布颜色深浅，你有没有偏好？随便聊聊。",
      "description": "试探审美。"
    },
    {
      "id": "lx.text-opening.b0004.0043",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "迁居时最舍不得扔的是什么？不愿意说也没关系。",
      "description": "试探情感话题。"
    },
    {
      "id": "lx.text-opening.b0004.0044",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "高处夜里很凉，你一般加一件还是加两件？",
      "description": "试探御寒经验。"
    },
    {
      "id": "lx.text-opening.b0004.0045",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "若聊路线太枯燥，我们也可以说说沿途看见的布帘花色。",
      "description": "试探兴趣且可退，呼应「若聊路线太枯燥我们也可」情境。"
    },
    {
      "id": "lx.text-opening.b0004.0046",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有人说干燥天气适合晒药草，你信吗？",
      "description": "试探经验判断。"
    },
    {
      "id": "lx.text-opening.b0004.0047",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "石阶要不要加防滑槽，你会投赞成吗？",
      "description": "试探公共设施意见。"
    },
    {
      "id": "lx.text-opening.b0004.0048",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "远行时你更怕没水，还是怕没阴凉？我只是好奇。",
      "description": "试探顾虑优先级。"
    },
    {
      "id": "lx.text-opening.b0004.0049",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "布帘洗太勤会不会褪色，你怎么看？",
      "description": "试探养护观念。"
    },
    {
      "id": "lx.text-opening.b0004.0050",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "如果愿意听，我可以讲讲上次迁居的一件小事；不愿意就算。",
      "description": "可退话题邀请。"
    }
  ]
}
