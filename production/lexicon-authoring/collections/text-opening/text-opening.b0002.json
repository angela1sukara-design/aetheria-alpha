{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-opening",
  "batchId": "text-opening.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-opening.b0002.0001",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "这把旧剪子刃口钝了，想请你看一眼能不能磨回来。",
      "description": "以修补事务开场。"
    },
    {
      "id": "lx.text-opening.b0002.0002",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "店里订的布线到了半卷，你若还缺，我可以按原价分一点。",
      "description": "手艺材料共享事务。"
    },
    {
      "id": "lx.text-opening.b0002.0003",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "学徒今天请假，柜台这边人手紧，想先跟你说一声。",
      "description": "告知店务变动。"
    },
    {
      "id": "lx.text-opening.b0002.0004",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "那张凳子的腿裂了一道细缝，我量好尺寸了，你方便时过来对一下。",
      "description": "协作测量事务。"
    },
    {
      "id": "lx.text-opening.b0002.0005",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "工具箱钥匙我放在抽屉第二格，取的时候记得锁回。",
      "description": "交接工具事务。"
    },
    {
      "id": "lx.text-opening.b0002.0006",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "这批旧锅把要重新铆钉，你擅长的话，我想请你先试一只。",
      "description": "请托手艺协作。"
    },
    {
      "id": "lx.text-opening.b0002.0007",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "招牌油漆快干了，想问你还要不要补第二层颜色。",
      "description": "确认修补进度事务。"
    },
    {
      "id": "lx.text-opening.b0002.0008",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "废料箱满了，我准备清一次，有想留的零件先挑走。",
      "description": "清理前的事务通知。"
    },
    {
      "id": "lx.text-opening.b0002.0009",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "顾客托修的灯罩要周五前好，我们时间还够，对吧？",
      "description": "核对交期，征求确认。"
    },
    {
      "id": "lx.text-opening.b0002.0010",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "胶水剩最后一小瓶，我去进货前先问你有没有别的牌子偏好。",
      "description": "进货前征求意见。"
    },
    {
      "id": "lx.text-opening.b0002.0011",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "刚才磨刀时飞起一点铁屑，我还以为是灰尘。",
      "description": "手艺现场闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0012",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "这张旧桌面被擦得发亮了，看得出用了很多年。",
      "description": "欣赏旧物闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0013",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "学徒把线轴绕得整整齐齐，比我当年强。",
      "description": "称赞协作闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0014",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "小店午后总是安静，只听得到针线穿过布的声音。",
      "description": "店内氛围闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0015",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "有人把破损的陶壶送来，说舍不得扔，我懂这种心情。",
      "description": "旧物情感闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0016",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我袖口沾了点松脂，怎么搓都还有气味。",
      "description": "手艺后的琐碎闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0017",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "修椅子时发现座面下刻着一行小字，年代挺久了。",
      "description": "发现旧痕的闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0018",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "今天进的麻绳手感偏粗，打结倒是很结实。",
      "description": "材料手感闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0019",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "隔壁补鞋的把锤子敲得有节奏，听着不烦。",
      "description": "邻店劳作声闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0020",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我把废布头拼成一小块垫子，样子丑，坐着倒舒服。",
      "description": "废物利用闲聊。"
    },
    {
      "id": "lx.text-opening.b0002.0021",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "工作台边上的木屑堆成一小丘，脚一碰就散开。",
      "description": "共处手艺工位环境。"
    },
    {
      "id": "lx.text-opening.b0002.0022",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "店门口那盏油灯芯剪过了，火苗稳了一些。",
      "description": "共观店内灯火。"
    },
    {
      "id": "lx.text-opening.b0002.0023",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "墙上挂着一排修好的把手，影子长短不一。",
      "description": "共看陈列旧件。"
    },
    {
      "id": "lx.text-opening.b0002.0024",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "砂纸摩擦的声音从里屋传出来，并不急促。",
      "description": "共听修补声。"
    },
    {
      "id": "lx.text-opening.b0002.0025",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "窗台上晾着刚洗的抹布，水还在往下滴。",
      "description": "共处晾晒细节。"
    },
    {
      "id": "lx.text-opening.b0002.0026",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "货架第三层缺了一格挡板，空位很显眼。",
      "description": "共看店内缺件。"
    },
    {
      "id": "lx.text-opening.b0002.0027",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "地板上有一道被拖过的浅痕，像是重物挪过。",
      "description": "共察使用痕迹。"
    },
    {
      "id": "lx.text-opening.b0002.0028",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "通风口吹进来的风带着一点木香和胶味。",
      "description": "共感手艺气味。"
    },
    {
      "id": "lx.text-opening.b0002.0029",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "工具墙上空了两个挂钩，扳手大概还在用。",
      "description": "共观工具状态。"
    },
    {
      "id": "lx.text-opening.b0002.0030",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "门槛磨损得发圆了，进出的人一定很多。",
      "description": "共看门槛使用痕。"
    },
    {
      "id": "lx.text-opening.b0002.0031",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。我是来取上周送修的木勺的，不着急。",
      "description": "取件式礼貌问候。"
    },
    {
      "id": "lx.text-opening.b0002.0032",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "日安。店里若忙，我可以先在门口等。",
      "description": "尊重店务的问候。"
    },
    {
      "id": "lx.text-opening.b0002.0033",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "见过。手里这卷线是给学徒的，请帮我转交。",
      "description": "托带物品的问候。"
    },
    {
      "id": "lx.text-opening.b0002.0034",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "下午好。我想看看能不能加塞修一把旧锁。",
      "description": "询价式礼貌开场。"
    },
    {
      "id": "lx.text-opening.b0002.0035",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "打扰了。路过看见灯还亮着，进来问一声好。",
      "description": "路过问候。"
    },
    {
      "id": "lx.text-opening.b0002.0036",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "早。工作台擦得很干净，一看就开张了。",
      "description": "称赞式晨间问候。"
    },
    {
      "id": "lx.text-opening.b0002.0037",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "您好。我带了点粗茶，不算谢礼，只是顺手。",
      "description": "轻度礼节问候。"
    },
    {
      "id": "lx.text-opening.b0002.0038",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "嗨。剪刀借我用一下可以吗？用完马上还。",
      "description": "借物前的礼貌问候。"
    },
    {
      "id": "lx.text-opening.b0002.0039",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。上次教我的打结法，我练得还算像。",
      "description": "回访式问候。"
    },
    {
      "id": "lx.text-opening.b0002.0040",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "晚上好。收工前我来确认明天的材料单。",
      "description": "收工前事务问候。"
    },
    {
      "id": "lx.text-opening.b0002.0041",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "关于旧物该不该修到原样，你有没有自己的看法？",
      "description": "试探修补观念。"
    },
    {
      "id": "lx.text-opening.b0002.0042",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有人喜欢把裂痕留着当痕迹，你觉得可以吗？",
      "description": "试探审美偏好。"
    },
    {
      "id": "lx.text-opening.b0002.0043",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "如果学徒问‘为什么不换新的’，你会怎么答？我只是好奇。",
      "description": "试探教学态度。"
    },
    {
      "id": "lx.text-opening.b0002.0044",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "这把锤子握感偏沉，你用惯了吗，还是我手生？",
      "description": "试探工具习惯。"
    },
    {
      "id": "lx.text-opening.b0002.0045",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "小店要不要挂一块‘可预约’的牌子，你怎么想？",
      "description": "试探经营细节。"
    },
    {
      "id": "lx.text-opening.b0002.0046",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有时候修到一半会想放弃，你也有过吗？",
      "description": "试探情绪共鸣。"
    },
    {
      "id": "lx.text-opening.b0002.0047",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "若把废料做成装饰，会不会显得浪费工夫？随便聊聊。",
      "description": "试探再利用态度。"
    },
    {
      "id": "lx.text-opening.b0002.0048",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "协作时你更喜欢先说步骤，还是边做边说？",
      "description": "试探协作偏好。"
    },
    {
      "id": "lx.text-opening.b0002.0049",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "那件旧衣的补丁颜色有点跳，要不要换成素色？你定。",
      "description": "试探审美决定权。"
    },
    {
      "id": "lx.text-opening.b0002.0050",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "我不太确定该不该收加急费，你若有经验，想听一句。",
      "description": "谨慎试探收费话题。"
    }
  ]
}
