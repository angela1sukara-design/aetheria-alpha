{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-opening",
  "batchId": "text-opening.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-opening.b0001.0001",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "驿站那边托我把这包药草送到巷口，你认得收件的人吗？",
      "description": "以日常托送事务开场，不预设双方熟识。"
    },
    {
      "id": "lx.text-opening.b0001.0002",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "公共告示栏的纸要换了，我先问一句：你这边有空帮贴一角吗？",
      "description": "征求事务协助，留有拒绝空间。"
    },
    {
      "id": "lx.text-opening.b0001.0003",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "水费单我刚填完，想确认一下你那户的门牌是不是三号。",
      "description": "核对住址类事务，语气克制。"
    },
    {
      "id": "lx.text-opening.b0001.0004",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "集市收摊前还剩两袋粗盐，若你要用，我按平时价留着。",
      "description": "以余货交易开场，不强迫购买。"
    },
    {
      "id": "lx.text-opening.b0001.0005",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "路灯检修通知写着今晚熄两盏，你路过西巷时注意脚下。",
      "description": "传达公共事务提醒。"
    },
    {
      "id": "lx.text-opening.b0001.0006",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "邻里轮值的清扫名单该轮到我了，想先跟你对一下时间。",
      "description": "协调轮值事务。"
    },
    {
      "id": "lx.text-opening.b0001.0007",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "寄存柜钥匙我带回来了，你方便的时候来取就行。",
      "description": "归还物品的事务开场。"
    },
    {
      "id": "lx.text-opening.b0001.0008",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "公共厨房的炉子有人报修，我来问是不是你提的那次。",
      "description": "核实报修事务。"
    },
    {
      "id": "lx.text-opening.b0001.0009",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "粮站说面粉要改领票方式，你如果也去领，我们可以一起听说明。",
      "description": "邀请同行办事，不代替对方决定。"
    },
    {
      "id": "lx.text-opening.b0001.0010",
      "category": "text-opening",
      "subcategory": "事务开场",
      "text": "这封便条是给东侧住户的，门上没人，你见着人能帮忙转一句吗？",
      "description": "请托转达，允许婉拒。"
    },
    {
      "id": "lx.text-opening.b0001.0011",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "今天巷口的粥摊开得早，路过闻到香味就停了半步。",
      "description": "以日常见闻开启闲聊。"
    },
    {
      "id": "lx.text-opening.b0001.0012",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "昨晚隔壁练琴练到很晚，我倒睡得意外踏实。",
      "description": "分享琐事，不抱怨指责。"
    },
    {
      "id": "lx.text-opening.b0001.0013",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "你那件褂子领口的线脚很整齐，是自己缝的吗？",
      "description": "从衣物细节切入闲聊。"
    },
    {
      "id": "lx.text-opening.b0001.0014",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "刚在井边遇见一只不认生的猫，它跟了我半条街。",
      "description": "轻松日常见闻。"
    },
    {
      "id": "lx.text-opening.b0001.0015",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "这几天早饭老吃同一口锅的糊味，我也懒得换锅了。",
      "description": "自嘲式生活闲聊。"
    },
    {
      "id": "lx.text-opening.b0001.0016",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "广场上有人在晒席子，风一吹，席边还翻了个角。",
      "description": "观察公共场景开场。"
    },
    {
      "id": "lx.text-opening.b0001.0017",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我刚把窗台上的陶罐挪了位置，总算不挡光了。",
      "description": "分享小调整。"
    },
    {
      "id": "lx.text-opening.b0001.0018",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "听说南市的布匹到了一批素色的，你要不要哪天去看看？",
      "description": "分享市集信息，不替对方决定。"
    },
    {
      "id": "lx.text-opening.b0001.0019",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "有一阵子没在长椅上坐过了，今天特地多坐了一会儿。",
      "description": "平静的闲聊入口。"
    },
    {
      "id": "lx.text-opening.b0001.0020",
      "category": "text-opening",
      "subcategory": "闲聊开场",
      "text": "我口袋里还剩半块麦饼，味道一般，你要是饿可以分一半。",
      "description": "随手分享，语气随意。"
    },
    {
      "id": "lx.text-opening.b0001.0021",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "这排屋檐滴水的节奏还挺齐，像有人在轻轻敲。",
      "description": "共听屋檐滴水。"
    },
    {
      "id": "lx.text-opening.b0001.0022",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "石板路上的青苔被踩亮了一小截，走起来要小心些。",
      "description": "提醒共同路面状况。"
    },
    {
      "id": "lx.text-opening.b0001.0023",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "那边晾衣绳晃得很厉害，大概是风从巷口拐进来了。",
      "description": "共看风吹晾衣。"
    },
    {
      "id": "lx.text-opening.b0001.0024",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "公共井盖今天开着半扇，取水的人排得不长。",
      "description": "共处取水场景。"
    },
    {
      "id": "lx.text-opening.b0001.0025",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "墙根那盆不知谁放的草长得很快，叶子快碰到门槛了。",
      "description": "共观路边植物。"
    },
    {
      "id": "lx.text-opening.b0001.0026",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "这盏廊灯今天亮得偏黄，比往常柔和一点。",
      "description": "共处灯光变化。"
    },
    {
      "id": "lx.text-opening.b0001.0027",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "巷尾那扇木门又吱呀响了两声，像是有人刚进出。",
      "description": "共享环境声响。"
    },
    {
      "id": "lx.text-opening.b0001.0028",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "地面还留着清晨洒水的痕迹，鞋底会黏一点土。",
      "description": "共感地面湿度。"
    },
    {
      "id": "lx.text-opening.b0001.0029",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "远处有人在敲木箱，一声一声，并不急。",
      "description": "共听远处劳作声。"
    },
    {
      "id": "lx.text-opening.b0001.0030",
      "category": "text-opening",
      "subcategory": "共同环境",
      "text": "这条过道的影子被遮阳布切成两截，站这边凉快些。",
      "description": "共处阴凉过道。"
    },
    {
      "id": "lx.text-opening.b0001.0031",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "日安。我路过这边，看见门开着，就先问一声好。",
      "description": "保持距离的礼貌问候。"
    },
    {
      "id": "lx.text-opening.b0001.0032",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "下午好。若你正忙，我站外面等一会儿也行。",
      "description": "问候并尊重对方时间。"
    },
    {
      "id": "lx.text-opening.b0001.0033",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。我们好像在粮站见过一面，不一定记得准。",
      "description": "轻度熟识的礼貌问候。"
    },
    {
      "id": "lx.text-opening.b0001.0034",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "早。井边的人不多，你可以先打水。",
      "description": "晨间问候兼让路。"
    },
    {
      "id": "lx.text-opening.b0001.0035",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "晚上好。灯火刚亮，我先跟你打个招呼再走。",
      "description": "短暂礼貌致意。"
    },
    {
      "id": "lx.text-opening.b0001.0036",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "打扰了。我是西巷新搬来的，今天来认一下门。",
      "description": "自我介绍式问候。"
    },
    {
      "id": "lx.text-opening.b0001.0037",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "你好。手里东西重的话，我可以把门撑一下。",
      "description": "问候并提供即时小助。"
    },
    {
      "id": "lx.text-opening.b0001.0038",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "见过。天气还算温和，适合出门办点小事。",
      "description": "中性礼貌寒暄。"
    },
    {
      "id": "lx.text-opening.b0001.0039",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "您好。我不耽误太久，只想确认一件小事。",
      "description": "正式略敬的问候。"
    },
    {
      "id": "lx.text-opening.b0001.0040",
      "category": "text-opening",
      "subcategory": "礼貌问候",
      "text": "嗨。坐这边可以吗？旁边这张凳子空着。",
      "description": "轻松礼貌问座。"
    },
    {
      "id": "lx.text-opening.b0001.0041",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "不知道你对旧地图上的记号感不感兴趣，我偶尔会描一描。",
      "description": "试探兴趣，不强求回应。"
    },
    {
      "id": "lx.text-opening.b0001.0042",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有人说南口的茶摊换了配方，你喝过新的吗？",
      "description": "以传闻试探共同话题。"
    },
    {
      "id": "lx.text-opening.b0001.0043",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "如果聊天气太没意思，我们也可以说说最近修好的桥。",
      "description": "主动提供话题分支。"
    },
    {
      "id": "lx.text-opening.b0001.0044",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "你平时更喜欢清早出门，还是傍晚散步？我只是随便问问。",
      "description": "轻度偏好试探。"
    },
    {
      "id": "lx.text-opening.b0001.0045",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "听说有人在收集旧纽扣，这件事你觉得稀奇吗？",
      "description": "试探对琐事的态度。"
    },
    {
      "id": "lx.text-opening.b0001.0046",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "我不太确定该不该提修屋顶的事，你如果忙就当我没问。",
      "description": "谨慎试探事务边界。"
    },
    {
      "id": "lx.text-opening.b0001.0047",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "关于轮值名单，你有没有什么想改的地方？没有也没关系。",
      "description": "试探意见，允许沉默。"
    },
    {
      "id": "lx.text-opening.b0001.0048",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "有时候会想，住得近的人是不是更容易互相照应，你怎么看？",
      "description": "开放式邻里话题试探。"
    },
    {
      "id": "lx.text-opening.b0001.0049",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "我带了点粗糖，不知道你会不会嫌甜。",
      "description": "以实物试探接受度。"
    },
    {
      "id": "lx.text-opening.b0001.0050",
      "category": "text-opening",
      "subcategory": "试探话题",
      "text": "若你愿意听，我可以说说上周集市上的一件小事；不愿意就算了。",
      "description": "明确可退的话题邀请。"
    }
  ]
}
