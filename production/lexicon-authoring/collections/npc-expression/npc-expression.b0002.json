{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "npc-expression",
  "batchId": "npc-expression.b0002",
  "source": {
    "producer": "ai-npc",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.npc-expression.b0002.0001",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方借放大镜抬眼，镜片后的目光短暂放大又恢复。",
      "description": "经放大镜的目光变化；有眼者可适配。"
    },
    {
      "id": "lx.npc-expression.b0002.0002",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方盯着胶痕边缘的气泡，直到气泡不再鼓起。",
      "description": "专注观察胶痕气泡的时长。"
    },
    {
      "id": "lx.npc-expression.b0002.0003",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方对色时把布样举到窗边，目光在两色间来回跳。",
      "description": "对色时目光在样本间跳跃。"
    },
    {
      "id": "lx.npc-expression.b0002.0004",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方听估价争议时目光钉在账本装订线上。",
      "description": "争议中盯住账本装订线。"
    },
    {
      "id": "lx.npc-expression.b0002.0005",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方检查榫卯时侧头，目光贴着缝隙扫过。",
      "description": "侧头沿缝隙扫视的检查目光。"
    },
    {
      "id": "lx.npc-expression.b0002.0006",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方被砂轮火星吸引一瞬，随即戴上护目动作。",
      "description": "瞥见火星后补做防护。"
    },
    {
      "id": "lx.npc-expression.b0002.0007",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方教人时看的是你的手，不是你的脸。",
      "description": "教学注视手部动作。"
    },
    {
      "id": "lx.npc-expression.b0002.0008",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方发现尺寸不对，目光从尺面跳到你脸上。",
      "description": "从工具跳到对话者面部的目光切换。"
    },
    {
      "id": "lx.npc-expression.b0002.0009",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方夜工时把目光凑近灯罩缝，辨认线号。",
      "description": "凑近灯缝辨认细小标记。"
    },
    {
      "id": "lx.npc-expression.b0002.0010",
      "category": "npc-expression",
      "subcategory": "目光表现",
      "text": "对方送客到门口，目光仍停在未收尾的工件上。",
      "description": "送客时目光仍挂在工件。"
    },
    {
      "id": "lx.npc-expression.b0002.0011",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方吹去木屑时鼓起双颊，随即恢复平静。",
      "description": "鼓颊吹屑的面部动作。"
    },
    {
      "id": "lx.npc-expression.b0002.0012",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方闻到溶剂味时皱鼻，随手推开窗缝。",
      "description": "皱鼻与推窗连锁。"
    },
    {
      "id": "lx.npc-expression.b0002.0013",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方咬断线头时齿关轻响，唇边多了一根短线。",
      "description": "咬线后面部与唇边残留。"
    },
    {
      "id": "lx.npc-expression.b0002.0014",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方被蒸汽扑面，闭眼侧过脸，睫毛挂上细珠。",
      "description": "蒸汽扑面时闭眼侧脸。"
    },
    {
      "id": "lx.npc-expression.b0002.0015",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方专注时舌尖抵着一侧齿列，神情发僵。",
      "description": "舌抵齿的专注面容；有口舌者可适配。"
    },
    {
      "id": "lx.npc-expression.b0002.0016",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方听完客诉先抿紧嘴，再松开慢慢回。",
      "description": "抿嘴再松开的回应前奏。"
    },
    {
      "id": "lx.npc-expression.b0002.0017",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方砂纸打磨起劲时，颊侧被粉尘染上一道灰。",
      "description": "颊侧沾灰的劳作痕迹。"
    },
    {
      "id": "lx.npc-expression.b0002.0018",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方被烫到指尖，吸气嘶了一声，眉心一拧。",
      "description": "轻烫时的吸气与拧眉。"
    },
    {
      "id": "lx.npc-expression.b0002.0019",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方戴上口罩前对你笑了一下，随即只露出眼。",
      "description": "戴罩前的短笑与遮挡。"
    },
    {
      "id": "lx.npc-expression.b0002.0020",
      "category": "npc-expression",
      "subcategory": "面部表现",
      "text": "对方数针脚时嘴唇微动，像在无声计数。",
      "description": "无声计数的唇动。"
    },
    {
      "id": "lx.npc-expression.b0002.0021",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方用膝顶住木板，腾出手来拧紧夹具。",
      "description": "膝顶木板腾手的作坊姿态。"
    },
    {
      "id": "lx.npc-expression.b0002.0022",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方把工具叼在肩窝，腾出双手比划尺寸。",
      "description": "肩窝夹物腾手比划。"
    },
    {
      "id": "lx.npc-expression.b0002.0023",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方蹲在低柜前找钉，脚跟离地保持平衡。",
      "description": "蹲找时的脚跟离地。"
    },
    {
      "id": "lx.npc-expression.b0002.0024",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方侧坐在工作凳边缘，随时能站起来让路。",
      "description": "凳缘侧坐的随时起身姿态。"
    },
    {
      "id": "lx.npc-expression.b0002.0025",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方用肘推开半掩的门，双手占满工件。",
      "description": "肘推门因双手占满。"
    },
    {
      "id": "lx.npc-expression.b0002.0026",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方把尺子别在后领，弯腰时尺尾轻轻翘起。",
      "description": "后领别尺弯腰的细节。"
    },
    {
      "id": "lx.npc-expression.b0002.0027",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方单膝跪地钉底层，另一腿撑成三角。",
      "description": "单膝跪钉的支撑姿态。"
    },
    {
      "id": "lx.npc-expression.b0002.0028",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方把听筒夹在耳与肩之间，双手继续缠线。",
      "description": "肩耳夹听筒继续手工。"
    },
    {
      "id": "lx.npc-expression.b0002.0029",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方后退一步打量整体，脚后跟踩到扫把柄。",
      "description": "后退打量误踩扫把。"
    },
    {
      "id": "lx.npc-expression.b0002.0030",
      "category": "npc-expression",
      "subcategory": "姿态细节",
      "text": "对方用髋关上抽屉，因为手上沾着未干的漆。",
      "description": "髋关抽屉因手沾漆。"
    },
    {
      "id": "lx.npc-expression.b0002.0031",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方把报价单递到一半，又收回来改了一个数字。",
      "description": "递单又收回改数。"
    },
    {
      "id": "lx.npc-expression.b0002.0032",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方砂轮已转，手却悬在上方，最终先关闸。",
      "description": "悬手后改关闸的安全犹豫。"
    },
    {
      "id": "lx.npc-expression.b0002.0033",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方拆线拆到关键结，停住去翻旧笔记。",
      "description": "拆到关键停手翻笔记。"
    },
    {
      "id": "lx.npc-expression.b0002.0034",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方已写上完工，又在旁边加了一行保养叮嘱。",
      "description": "写完工又补叮嘱。"
    },
    {
      "id": "lx.npc-expression.b0002.0035",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方想把废料丢掉，掂了掂又放回“可再存”筐。",
      "description": "掂废料后改投放。"
    },
    {
      "id": "lx.npc-expression.b0002.0036",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方抬锤对准，又放下改垫一块软布。",
      "description": "抬锤又改垫布。"
    },
    {
      "id": "lx.npc-expression.b0002.0037",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方把学徒叫来，话到嘴边改成自己重做示范。",
      "description": "叫人又改自做示范。"
    },
    {
      "id": "lx.npc-expression.b0002.0038",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方签字前把工单翻到背面看了看空白处。",
      "description": "签字前翻看背面。"
    },
    {
      "id": "lx.npc-expression.b0002.0039",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方伸手去拿客人的旧件，先问了一句能否动。",
      "description": "触物前先口头确认。"
    },
    {
      "id": "lx.npc-expression.b0002.0040",
      "category": "npc-expression",
      "subcategory": "犹豫动作",
      "text": "对方关灯出门又折返，确认炭火已用沙盖死。",
      "description": "出门折返查火。"
    },
    {
      "id": "lx.npc-expression.b0002.0041",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方交件后靠在门框上，把围裙擦手的一角垂下。",
      "description": "交件后靠门框垂围裙角。"
    },
    {
      "id": "lx.npc-expression.b0002.0042",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方把酸胀的手指一根根扳响，再甩了甩腕。",
      "description": "扳指甩腕的收工放松。"
    },
    {
      "id": "lx.npc-expression.b0002.0043",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方坐到废料箱上，用脚尖钩过地上的扫帚。",
      "description": "坐废料箱钩扫帚。"
    },
    {
      "id": "lx.npc-expression.b0002.0044",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方喝净杯底冷茶，把杯倒扣在吸水布上。",
      "description": "饮尽倒扣杯的收尾。"
    },
    {
      "id": "lx.npc-expression.b0002.0045",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方听收音机小节拍，用指尖在台面轻轻跟。",
      "description": "指尖跟节拍的放松。"
    },
    {
      "id": "lx.npc-expression.b0002.0046",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方把护目镜顶到额上，露出压出的红痕。",
      "description": "推镜露压痕。"
    },
    {
      "id": "lx.npc-expression.b0002.0047",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方在窗边伸个懒腰，脊椎一节节拉开。",
      "description": "窗边伸懒腰。"
    },
    {
      "id": "lx.npc-expression.b0002.0048",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方把沾灰的脸对着镜子拍了两下，笑出声。",
      "description": "拍灰笑出的短放松。"
    },
    {
      "id": "lx.npc-expression.b0002.0049",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方躺在长凳上闭目一刻，手臂垂过凳边。",
      "description": "长凳闭目垂臂。"
    },
    {
      "id": "lx.npc-expression.b0002.0050",
      "category": "npc-expression",
      "subcategory": "放松动作",
      "text": "对方用湿毛巾捂脸再揭开，呼出一声热气。",
      "description": "热毛巾捂脸揭开。"
    }
  ]
}
