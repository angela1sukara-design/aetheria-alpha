{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-sense",
  "batchId": "text-tf-sense.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-tf-sense.b0002.0001",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你握锉时，虎口的弧度与旧锉柄不再贴合，柄在掌心微微打转。",
      "description": "虎口弧与锉柄失贴。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0002",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "俯身看台面裂纹时，视线高度变了，裂纹走向要重新辨认。",
      "description": "俯身视线高度变化。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0003",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你把针凑近眼前，发现手指挡住的视野比以前大，要侧开一点才看清针眼。",
      "description": "手指挡视野变大。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0004",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "戴上护目镜后，镜框卡在新的眉骨弧上，位置总要往上推。",
      "description": "眉骨弧改变镜框位。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0005",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "跪姿修合叶时，膝与小腿的折叠角度生疏，你垫了块布才稳住。",
      "description": "跪姿折叠角生疏。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0006",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你侧身进窄缝取工具，肩宽把缝口填得更满，肘部擦到木架。",
      "description": "肩宽填满窄缝。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0007",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "量尺贴在小臂上比对时，臂长的刻度印象错了半寸，你又量一次。",
      "description": "小臂刻度印象偏移。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0008",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你看见自己投在台面蜡光里的手影，指节更突，影也更长。",
      "description": "蜡光手影指节更突。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0009",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "系围裙时，腰线的位置感觉上移，带子要重新打结才服帖。",
      "description": "腰线上移系围裙。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0010",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "推拉锯时，前臂外缘碰到自己的侧肋，这条新轮廓还没编进动作习惯。",
      "description": "前臂触侧肋新轮廓。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0011",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "锯末的气味一下子变冲，你把脸偏开，仍能辨出新旧木头的差别。",
      "description": "锯末气味变冲仍可辨。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0012",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "砂纸摩擦声在耳边放大，你下意识减轻了按压力度。",
      "description": "砂声放大减轻按压。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0013",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "指尖辨出木纹逆顺比目测更快，你闭着眼也能顺着纹走锉。",
      "description": "指尖辨纹快于目测。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0014",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "烙铁的温度隔着手套也能清晰感到，你提前把烙铁移开半寸。",
      "description": "隔套感温提前移开。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0015",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "胶水的气味变得层次分明，你能闻出哪一瓶已开始发稠。",
      "description": "胶气味层次可辨稠。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0016",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "台面细微的震动传到肘部，你察觉到邻座在敲钉，比听觉更早。",
      "description": "肘感邻座敲钉。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0017",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "灯光下线的颜色分得更细，你盯着两卷近似的线，一时拿不准该用哪卷。",
      "description": "辨色变细反而犹豫。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0018",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "金属碰撞的尖响让你一颤，平时同样的声音从未如此扎耳。",
      "description": "金属尖响更扎耳。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0019",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "松香的甜苦味在嘴里留下余韵，你咽了口口水想冲淡它。",
      "description": "松香味口腔余韵。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0020",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "夜店收工后，黑暗里工具轮廓仍依稀可辨，你眨眨眼适应。",
      "description": "暗中工具轮廓可辨。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0021",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "新生的茧皮擦过布料，触感发涩，你停针辨认茧与布的摩擦。",
      "description": "茧皮擦布发涩。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0022",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "掌心按木时，木的凉意传来得更快，像掌纹更深地贴进木纹。",
      "description": "掌木凉意传导加快。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0023",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "指腹摸到自己虎口的硬茧旁，多了一小片光滑的新皮，触感分裂。",
      "description": "茧旁新皮触感分裂。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0024",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你捏线，线在指间的滑动阻力变大，像指面多了细小的倒刺感。",
      "description": "捏线阻力与倒刺感。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0025",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "护目镜鼻托压处发麻，皮肤下像有一层薄壳在抵着托垫。",
      "description": "鼻托处薄壳抵感。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0026",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "膝垫布贴着膝骨，骨突处的触感更尖，你挪了挪跪姿。",
      "description": "膝骨突触感更尖。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0027",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你摸后颈，发际有一小片细密的硬缘，像微型锯齿贴着皮肤。",
      "description": "发际硬缘如微锯。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0028",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "手套内壁蹭过手背，手背皮肤比记忆中更干，蹭出细响。",
      "description": "手套蹭干手背细响。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0029",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你用指节敲台面，敲击的反馈更脆，指节表面像多了一层薄壳。",
      "description": "指节敲台反馈更脆。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0030",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "蜡液溅到腕侧，那一小片皮肤的触感变得光滑发紧。",
      "description": "蜡溅腕侧光滑发紧。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0031",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你提起工具箱，重心比预想的靠后，第一步下意识后仰半寸。",
      "description": "提箱重心靠后。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0032",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "踩凳够高架时，支撑脚的抖感更明显，你双手扶着架沿。",
      "description": "踩凳支撑脚抖。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0033",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "推锯前倾时，髋部承重轴感觉下移，锯程因此缩短一截。",
      "description": "推锯髋轴下移。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0034",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "从跪姿起身，身体重量跟得慢，你手先撑地再移交重心。",
      "description": "跪起重量滞后撑地。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0035",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "侧搬零件箱时，髋先转的习惯被新的侧肋轮廓打断，你顿了一顿。",
      "description": "侧搬被侧肋轮廓打断。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0036",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "打磨加压时，体重压向前臂，脚掌踮起的幅度比记忆中大。",
      "description": "打磨踮脚幅度变大。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0037",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "接过重锤，手腕一沉，肩背接住的位置比以前靠外。",
      "description": "接锤肩背受力靠外。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0038",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "退开工作台时，后脚撤的节奏与新的腿长感错拍，你补了半步。",
      "description": "退台腿长感错拍。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0039",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "蹲开箱底钉，脚跟承重时膝外撑的角度需要重新找。",
      "description": "蹲姿膝外撑重找。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0040",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你坐回学徒凳，坐骨着力点偏移，要挪一下才坐稳。",
      "description": "坐骨着力点偏移。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0041",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "手活不顺带来的烦躁，和身体新触感的好奇搅在一起，你叹了口气继续。",
      "description": "烦躁与好奇搅合。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0042",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你想跟师傅说一声异样，又怕耽误活计，话在嘴里转成请教尺寸。",
      "description": "异样改口请教尺寸。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0043",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "轻微的慌里夹着认真，你把每个动作放慢，像重新做学徒。",
      "description": "慌中认真放慢动作。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0044",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "被自己的手影逗笑，笑完又有点空，你把灯芯拨亮一点。",
      "description": "笑后空拨灯芯。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0045",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "羞耻与专注交替：做错一针时羞，盯着改正时又忘掉羞。",
      "description": "羞耻与专注交替。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0046",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你既想快点回到旧手感，又忍不住用新触感去辨木纹。",
      "description": "求旧感与恋新触。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0047",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "邻座投来一瞥，你心里一紧，随即用整理工具掩饰。",
      "description": "被瞥一紧后掩饰。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0048",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "完成一件小修后的释然，和身体陌生感叠在一起，心情复杂。",
      "description": "完工释然叠陌生。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0049",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "温柔的自我鼓励升起：慢慢来。随即被工期的焦虑压回去一点。",
      "description": "自励与工期焦虑。"
    },
    {
      "id": "lx.text-tf-sense.b0002.0050",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你感到被改变的无奈，又在无奈里找到一点可以观察的趣味。",
      "description": "无奈中的观察趣味。"
    }
  ]
}
