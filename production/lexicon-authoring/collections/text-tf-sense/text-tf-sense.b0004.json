{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-sense",
  "batchId": "text-tf-sense.b0004",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.text-tf-sense.b0004.0001",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你摘下遮阳帽，额上多出的弧度让帽圈印痕变了形，你用指描了一下。",
      "description": "帽印随额弧变形。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0002",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "沿陡阶上行时，肩背擦崖壁的位置上移，衣肩很快沾了干尘。",
      "description": "陡阶擦壁位置上移。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0003",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你举手遮阳，小臂外缘更圆，袖管余量消失，布面绷紧。",
      "description": "遮阳小臂圆绷袖。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0004",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "坐石阶歇脚，腿侧碰到阶沿的位置变了，要挪才能悬稳。",
      "description": "坐阶腿侧触点变。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0005",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "门帘拨开时，手背的轮廓先露出，你自己看了一眼又缩回帘后整理。",
      "description": "拨帘手背轮廓自顾。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0006",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "镜一样的亮石映出侧影，耳尖更尖，你偏头确认不是热浪变形。",
      "description": "亮石映耳尖确认。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0007",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "系腰带时腰线感觉上移，行囊重量的分配点要重找。",
      "description": "腰线上移重找负重。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0008",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "跨干渠时，脚掌触地面积感变大，沙面陷得更深一点。",
      "description": "跨渠脚掌面积感大。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0009",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你看见墙上自己的影肩更宽，风过影晃，宽仍在。",
      "description": "墙影肩宽确认。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0010",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "面巾绕颈，颈围触感变了，巾要多绕半圈才贴实。",
      "description": "颈围变面巾多绕。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0011",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "干热空气刮过鼻腔，气味被抽干又放大，你能闻出远处灶烟。",
      "description": "干热中远嗅灶烟。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0012",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "风声在耳边变得很满，你要把别人的话听两遍才抓得住。",
      "description": "风声满要听两遍。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0013",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "脚心感知到碎石下的空鼓，比眼睛看见松动更早，你换了落点。",
      "description": "脚心先感碎石空鼓。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0014",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "水袋里的水味道发淡，你又喝一口，确认是自己的味觉变了。",
      "description": "水味淡确认味觉。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0015",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "正午石面反光刺得你持续眯眼，帽檐压到不能再低。",
      "description": "石反光持续眯眼。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0016",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "驼铃隔着两个弯还能听见，你数着铃声估距离，又觉得不可靠。",
      "description": "远听驼铃估距犹豫。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0017",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "沙尘贴肤的细涩被放大，你不停眨眼睛想把涩感眨掉。",
      "description": "沙涩放大不停眨。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0018",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "夜阶靠脚底触感比靠眼，纹路深浅传到脚心异常清楚。",
      "description": "夜阶脚心底感清楚。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0019",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "汗味自己的都变得鲜明，你把面巾提上鼻下挡了一挡。",
      "description": "自汗味鲜明提巾。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0020",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "远处热浪里的人影边缘发毛，你用力看仍看不清面目。",
      "description": "热浪人影发毛难辨。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0021",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "干裂的指腹擦过水罐耳，涩得发响，你换了握法。",
      "description": "干指腹擦罐耳发响。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0022",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "新生细绒在干风里竖起，衣内衬刮过时又痒又清楚。",
      "description": "干风细绒竖起刮衬。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0023",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你摸后颈，硬缘贴着晒红的皮，热与硬叠成奇怪的触感。",
      "description": "后颈硬缘叠晒热。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0024",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "靴里脚掌中心的软垫感让落沙更闷，你跺了跺脚想抖开。",
      "description": "靴内软垫落沙闷。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0025",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "唇边干皮触到面巾，布面相对显得粗，你润了润唇再贴巾。",
      "description": "干唇触巾显粗。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0026",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "耳廓薄壳感在干风里更明显，风声像贴着壳外刮过。",
      "description": "耳壳干风刮声。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0027",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "膝骨突隔着裤布顶石阶，触感更尖，你垫了只手再坐。",
      "description": "膝突顶阶更尖。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0028",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你用手背贴额，额上细密凹凸刮过手背，两边都发涩。",
      "description": "手背贴额双侧涩。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0029",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "甲缘刮过干裂的裤缝，刮擦声细而硬，你停下来听了一瞬。",
      "description": "甲缘刮裤缝细硬。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0030",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "行囊带勒肩处，肩皮像多了薄壳，带的压力被壳分散又发麻。",
      "description": "肩薄壳分散带压。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0031",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "陡阶上行前压时，重心比记忆中更贴阶，你觉得自己变沉。",
      "description": "陡阶前压重心变沉。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0032",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "下坡后移，脚跟承重更多，踝部的生疏感让步幅缩短。",
      "description": "下坡跟承踝生疏。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0033",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "扛行囊前倾，肩线斜度变了，第一步在沙上打了个滑。",
      "description": "扛囊肩斜沙滑。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0034",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "风口张开双脚，迎风侧腿抖得更明显，重心在两脚间找。",
      "description": "风口迎风腿抖找重心。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0035",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "石凳起身，重量滞后，你手扶石沿才把重心送前脚。",
      "description": "石凳起身扶沿。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0036",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "让驮队内侧承重，膝角生疏，你点在阶缘的外侧脚多停一瞬。",
      "description": "让队膝角生疏。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0037",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "跨干渠蹲跳，落地膝吸震时软垫脚心让你多颠了一下。",
      "description": "跨渠落地多颠。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0038",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "顶门帘前送，肩先入时新肩宽卡住帘缝，你侧了一下才进。",
      "description": "顶帘肩宽卡缝。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0039",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "碎石路低重心试踏，脚心空鼓感让你连换两个落点。",
      "description": "碎石空鼓连换落点。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0040",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "水罐换肩，侧倾找平时，新的侧肋轮廓让动作顿了一顿。",
      "description": "换肩侧肋轮廓顿。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0041",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "干渴的烦与新身体的好奇搅在一起，你灌水时洒了几滴。",
      "description": "干渴烦搅好奇洒水。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0042",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你想跟同路人说异样，话到嘴边变成问前方还有没有遮阳处。",
      "description": "异样改口问遮阳。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0043",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "风里的不安被远处驼铃稍稍安抚，你跟着铃声调整步频。",
      "description": "风不安被驼铃安抚。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0044",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "好笑与羞叠合：帽总滑，你当众按了三次，脸有点热。",
      "description": "帽滑当众按三次羞。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0045",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "迁居的疲与身体新奇叠着，你坐行囊上发了一会儿呆。",
      "description": "迁疲叠新奇发呆。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0046",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你既想快点习惯坡道，又舍不得高处这份放大的风声。",
      "description": "求习惯与恋风声。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0047",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "被门帘内人看了一眼的紧，随后用整理面巾掩饰。",
      "description": "被看紧后整面巾。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0048",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "平静下有一丝倔，像坡还没走完，身体却已换了地图。",
      "description": "平静下的细倔。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0049",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "自我怜悯闪过——晒与变同时来——随即被你自己笑开。",
      "description": "晒与变自怜笑开。"
    },
    {
      "id": "lx.text-tf-sense.b0004.0050",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "释然与陌生并存：歇下了，身体却仍在报告每一个新触点。",
      "description": "歇下释然仍感新触。"
    }
  ]
}
