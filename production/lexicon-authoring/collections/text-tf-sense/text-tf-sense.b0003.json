{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-sense",
  "batchId": "text-tf-sense.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-tf-sense.b0003.0001",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你低头看自己浸在浅水里的小腿，轮廓比记忆中更圆，水线也因此更高。",
      "description": "浸水小腿轮廓变圆。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0002",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "侧身过雨棚窄道时，肩背擦湿木的位置靠后，衣立刻沾了一片潮。",
      "description": "窄道擦湿位置偏移。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0003",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你举手够棚钩，指尖多出的弧度先碰到钩，手掌后到。",
      "description": "够钩指尖弧先触。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0004",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "蹲在渠沿时，膝外缘的线条顶到裤管，布料绷出浅痕。",
      "description": "蹲姿膝外缘绷裤。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0005",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "水面倒影里，自己的耳廓多了一点尖，涟漪散开后尖仍在。",
      "description": "倒影耳尖确认。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0006",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你把湿发拢到一侧，侧颈的弧度摸起来更生疏，指停了一停。",
      "description": "拢发侧颈弧生疏。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0007",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "跨渠木板时，脚掌触板的面积感觉更大，板因此更稳也更陌生。",
      "description": "脚掌触板面积变大。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0008",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "伞柄靠肩的位置滑了一下，肩线斜度变了，伞要重新架稳。",
      "description": "肩线斜变伞架不稳。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0009",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你看见自己投在湿石上的影子腰更窄，晃了晃，影子跟着扭。",
      "description": "湿石影腰窄。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0010",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "戴回湿帽时，帽圈卡在新的额弧上，要前后挪才服帖。",
      "description": "额弧变帽圈失贴。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0011",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "潮气的味道变得层次分明，你能闻出苔、泥与远处炊烟的差别。",
      "description": "潮气味层次可辨。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0012",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "雨点打棚布的声音在耳边放大，你下意识把说话声压低。",
      "description": "雨棚声放大压低话。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0013",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "脚心感知到木板下的水流震颤，比眼睛看见涟漪更早。",
      "description": "脚心先感水流震。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0014",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "溅到唇边的水带一点藻味，味觉把那一点放大成清晰的苦绿。",
      "description": "藻味被味觉放大。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0015",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "阴天的光线仍刺得你眯眼，湿石反光尤其难忍。",
      "description": "阴天湿石反光刺眼。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0016",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "邻人身上的皂角味隔着雨丝也能闻到，你微微侧开脸。",
      "description": "雨中远嗅皂角。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0017",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "指尖碰到湿栏杆，凉意传来极快，你几乎要缩手又按住。",
      "description": "湿栏凉意极快。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0018",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "水车吱呀在夜里格外清楚，你侧耳时连齿轮间歇都能数。",
      "description": "夜听水车间歇可数。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0019",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "雾气贴面时，鼻腔里的湿冷感被放大，你深吸又轻轻呼出。",
      "description": "雾贴面湿冷放大。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0020",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "裤脚拖过苔面的细响被听得很清，你抬高了裤脚再走。",
      "description": "苔面拖响听清后抬裤。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0021",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "新生的细鳞缘擦过湿衣内衬，密而凉，你停步辨认界线。",
      "description": "细鳞缘擦湿衣。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0022",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "掌心贴苔石，苔的绒感与掌上新皮的涩感叠在一起。",
      "description": "苔绒与新皮涩叠合。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0023",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "脚掌踩浮板，板面防滑纹嵌进变软的脚心，触感发闷。",
      "description": "脚心变软嵌防滑纹。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0024",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "雨丝打在手背，手背皮肤像多了一层薄壳，雨点声更脆。",
      "description": "手背薄壳雨点脆。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0025",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你摸颈侧，触到一片光滑贴肤的凉，随吞咽轻移。",
      "description": "颈侧光滑凉贴。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0026",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "膝弯相贴时发粘，潮气把那层湿膜感变得更明显。",
      "description": "潮中膝弯湿膜。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0027",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "指缝夹湿绳，绳纤维刮过变糙的指腹，阻力明显。",
      "description": "湿绳刮糙指腹。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0028",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "耳廓内侧进了小水珠，薄壳似的耳缘把水珠声放大成细响。",
      "description": "耳缘放大水珠声。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0029",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你用袖口擦脸，颊边细密凹凸刮过布面，布面起了细毛。",
      "description": "颊凹凸刮布起毛。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0030",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "发丝贴着后颈新的硬缘，又痒又清楚，你拨开又贴回。",
      "description": "发贴后颈硬缘痒。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0031",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "踏上湿阶，重心本能压低，你觉得自己比记忆中更贴地。",
      "description": "湿阶重心压低贴地。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0032",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "提桶过木板，对侧倾的幅度要重新找，水差点荡出。",
      "description": "提桶对侧倾重找。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0033",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "从蹲姿捞叶起身，重量滞后，手先撑苔石才站稳。",
      "description": "捞叶起身撑石。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0034",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "浮板上张开双脚，均分重量时脚心的软感让你微晃。",
      "description": "浮板脚心软感微晃。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0035",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "被溅水后撤，重心拉回前掌的过程比预想多了一拍。",
      "description": "惊撤重心回掌慢拍。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0036",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "侧身让推车，内侧腿承重时膝的角度生疏，你顿了一顿。",
      "description": "让车内侧膝角生疏。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0037",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "扛湿网上肩，前倾承接时肩线斜度变了，网滑了一下。",
      "description": "扛网肩斜变网滑。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0038",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "下渠岸脚尖先落，全身重量跟过来时踝部有点发飘。",
      "description": "下岸重量跟踝飘。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0039",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "泥滩拔脚换腿，重心交接比旧习惯慢，泥差点再吸住。",
      "description": "泥滩换腿重心慢。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0040",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你在棚下站久，左右摆动变小，像重心被潮气粘在中线。",
      "description": "棚下重心粘中线。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0041",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "潮气里的烦闷和对新触感的好奇搅在一起，你甩了甩袖继续走。",
      "description": "潮烦闷搅好奇。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0042",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你想跟渠边洗衣的人闲聊一句异样，话出口却成了问水冷不冷。",
      "description": "异样改口问水冷。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0043",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "雨声放大后的不安，被棚下共躲的安静人影稍稍安抚。",
      "description": "雨不安被共躲安抚。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0044",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "好笑与湿冷叠合：你踩到自己多出的步幅，差点滑，又站稳了。",
      "description": "步幅失准好笑湿冷。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0045",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "温柔的自我观察升起，随即被赶路的现实感压回口袋。",
      "description": "自观被赶路压回。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0046",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你既想快点干透，又舍不得雨中这份放大的感官，心情摆动。",
      "description": "求干与恋雨感摆动。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0047",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "被旁人看了一眼的紧，和自己对倒影的沉迷交替出现。",
      "description": "被看紧与恋倒影。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0048",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "疲惫里夹着清亮，像雨后空气，腿沉眼睛却睁着。",
      "description": "疲惫夹清亮。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0049",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "羞耻闪过——衣湿贴出新轮廓——随即被你用披肩盖住。",
      "description": "湿衣轮廓羞后遮。"
    },
    {
      "id": "lx.text-tf-sense.b0003.0050",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "平静之下有一丝兴奋，像发现一条新渠，水流还未知。",
      "description": "平静下的细兴奋。"
    }
  ]
}
