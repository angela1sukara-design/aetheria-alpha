{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-sense",
  "batchId": "text-tf-sense.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-tf-sense.b0001.0001",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你低头时看见自己肩线比记忆中宽了一点，衣缝因此绷得更紧。你没有立刻伸手去量。",
      "description": "肩宽轮廓的陌生感，非能力描述。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0002",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "镜中的侧影多出一小截耳后弧度，你侧过脸又侧回来，确认那不是光影。",
      "description": "耳后弧度的轮廓确认。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0003",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你举手遮阳，发现小臂的外缘线条更圆。袖管空出的余量也少了。",
      "description": "小臂外缘变圆的陌生。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0004",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "坐下时腿侧碰到椅沿的位置变了，你挪了挪才找到旧习惯的坐姿。",
      "description": "腿侧轮廓改变坐感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0005",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你摸到后颈多了一道浅浅的脊感，指腹沿它上下走，心里有些发空。",
      "description": "后颈脊感的陌生触认。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0006",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "鞋里脚趾的排布感觉不同，你活动了一下，像在重新认识这双脚的边界。",
      "description": "脚趾排布轮廓陌生。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0007",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你侧身过门时，肩背擦到门框的位置比以前靠后。你停半步才继续走。",
      "description": "侧身擦门框位置偏移。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0008",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "领口贴着喉结的高度变了，吞咽时布料摩擦点上移。你下意识松了松领。",
      "description": "领口相对喉位变化。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0009",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "你看见自己投在墙上的影子耳尖更尖，晃了晃头，影子跟着尖了一下。",
      "description": "影子耳尖的轮廓陌生。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0010",
      "category": "text-tf-sense",
      "subcategory": "轮廓陌生感",
      "text": "握拳时指节的排列看起来更密，指缝变窄。你松开又握紧，确认不是错觉。",
      "description": "指节排列变密的陌生。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0011",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "街对面的说话声比往常清楚，你下意识把注意力收回近处的脚步。",
      "description": "听觉变敏后的注意回收。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0012",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "灶边的油烟味一下子变重，你退后半步，鼻翼轻轻翕动。",
      "description": "嗅觉加重后的退后。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0013",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "指尖碰到杯壁时，温度传来得更快，你差点松手，又稳住了。",
      "description": "触觉温度传导变快。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0014",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "光线从窗缝进来时刺得你眯眼，平时同样的亮度从未如此。",
      "description": "对寻常光线更敏感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0015",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "地面细微的震动传到脚心，你察觉到远处有车经过，比耳朵更早。",
      "description": "脚心感知远震。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0016",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "嘴里的水味道变淡，你又喝了一口，确认不是水本身的问题。",
      "description": "味觉变淡的确认。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0017",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "衣料摩擦声在耳边放大，你走路时下意识放轻了步子。",
      "description": "摩擦声放大后放轻步。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0018",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "夜色里轮廓反而更清晰，你眨了眨眼，适应这种不习惯的夜视感。",
      "description": "夜视感的短暂适应眨眼。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0019",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "邻人身上的皂角味隔着一段距离就能闻到，你把脸微微偏向另一侧。",
      "description": "远距嗅到皂角后侧脸。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0020",
      "category": "text-tf-sense",
      "subcategory": "感官变化",
      "text": "指腹辨出桌面木纹的深浅，比目测还细。你顺着纹路慢慢滑过。",
      "description": "指腹分辨木纹深浅。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0021",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "新生的细绒擦过袖口内侧，那种柔痒让你停下来辨认皮肤与布的界线。",
      "description": "细绒触袖的材质感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0022",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "掌心摸到自己小臂，触感比记忆中更干、更涩。你又摸了一次确认。",
      "description": "小臂干燥涩感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0023",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "耳廓边缘触到发丝时有细密的凉意，像薄壳贴着温热的皮肤。",
      "description": "耳廓薄壳凉意。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0024",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你把手指贴上颈侧，触到一片光滑的硬感，随吞咽轻微起伏。",
      "description": "颈侧光滑硬感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0025",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "脚底踩地时，脚掌中心多了一层软垫似的触感，落地更闷。",
      "description": "脚掌软垫触感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0026",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "指甲边缘刮过布面，发出细微的刮擦声，触感比以前硬。",
      "description": "甲缘变硬刮布。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0027",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你用手背贴脸，颊边有一小片细鳞似的凹凸，凉而密。",
      "description": "颊边细鳞凹凸。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0028",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "膝弯内侧皮肤相贴时发粘，像多了一层薄薄的湿膜。",
      "description": "膝弯湿膜触感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0029",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "指缝夹住一缕线，线在指间滑动的阻力变大，像指腹变糙了。",
      "description": "指腹变糙夹线。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0030",
      "category": "text-tf-sense",
      "subcategory": "材质触感",
      "text": "你摸后脑，发根处触感更粗，指尖能清楚数出一缕一缕。",
      "description": "发根变粗可辨。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0031",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你站直时，重心像往前挪了半寸，脚尖因此承受更多。",
      "description": "重心前移脚尖承重。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0032",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "坐下起身的瞬间，身体比预想的沉，你手扶了一下椅沿。",
      "description": "起身沉感扶椅。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0033",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "侧身让路时，髋部的转动轴感觉更低，动作因此慢了半拍。",
      "description": "髋转轴变低的感觉。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0034",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你提轻物时，肩背的受力点上移，像多背了一点看不见的重量。",
      "description": "肩背受力点上移感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0035",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "走路时左右摆动变小，重心更贴着中线，你觉得步伐变稳也变笨。",
      "description": "重心贴中线的稳笨感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0036",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "弯腰拾物时，后背像多了一截杠杆，起身需要更明确的发力。",
      "description": "弯腰杠杆感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0037",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你靠墙时，肩胛贴墙的位置变了，要挪一步才找到旧的舒服点。",
      "description": "靠墙肩胛位置偏移。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0038",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "单脚站立试鞋时，支撑腿抖得更明显，重心在脚心来回找。",
      "description": "单脚试鞋重心抖寻。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0039",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "上楼时前脚落阶，身体重量跟得比记忆中晚一瞬，你放慢了节奏。",
      "description": "上楼重量滞后感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0040",
      "category": "text-tf-sense",
      "subcategory": "重心感觉",
      "text": "你转身时，尾椎一带像多了一点拖拽感，旋转因此更圆。",
      "description": "转身尾椎拖拽感。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0041",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "陌生感里夹着一点好奇，你既想多摸两下，又怕被旁人注意。",
      "description": "好奇与怕注意并存。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0042",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你觉得好笑，又觉得不安，嘴角抬起又压下去。",
      "description": "好笑与不安交替。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0043",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "平静之下有一丝烦躁，像衣服标签磨着皮肤，不大却挥之不去。",
      "description": "平静下的细烦躁。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0044",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你想告诉身边人，话到嘴边又改成一句无关的闲聊。",
      "description": "欲言又止改闲聊。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0045",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "轻微的得意混着羞耻，你低头整理袖口，掩饰脸上的热。",
      "description": "得意与羞耻掩饰。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0046",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "好奇压过了起初的慌，你开始认真观察自己的手背纹理。",
      "description": "慌转好奇观手背。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0047",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你感到被看见的不安，同时又有点想确认别人有没有发现。",
      "description": "怕被看见又想确认。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0048",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "疲惫与新鲜叠在一起，像走远路后看见新街景，腿酸却睁着眼。",
      "description": "疲惫与新鲜叠合。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0049",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "温柔的自我怜悯升起，随即被你自己轻轻笑开。",
      "description": "自怜被轻笑化解。"
    },
    {
      "id": "lx.text-tf-sense.b0001.0050",
      "category": "text-tf-sense",
      "subcategory": "情绪混合",
      "text": "你既想快点习惯，又舍不得这份短暂的新奇，心情来回摆。",
      "description": "求习惯与恋新奇摆动。"
    }
  ]
}
