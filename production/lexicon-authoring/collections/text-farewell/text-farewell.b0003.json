{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-farewell",
  "batchId": "text-farewell.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-farewell.b0003.0001",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "我去把雨棚绳收紧一扣，马上回来。",
      "description": "维护短离。"
    },
    {
      "id": "lx.text-farewell.b0003.0002",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "水位刻度我看一眼，你先避雨。",
      "description": "观测短离。"
    },
    {
      "id": "lx.text-farewell.b0003.0003",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "斗笠在柜里，我取来晒，片刻回棚下。",
      "description": "短时离开并交代去向，呼应「斗笠在柜里我取来晒片」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0004",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "鞋太湿，我到栏杆倒水，你继续说。",
      "description": "短时离开并交代去向，呼应「鞋太湿我到栏杆倒水你」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0005",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "蕨苗叶卷了，我去浇半勺，很快。",
      "description": "养护短离。"
    },
    {
      "id": "lx.text-farewell.b0003.0006",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "浮板钉盒空了，我去工具棚拿，等我。",
      "description": "短时离开并交代去向，呼应「浮板钉盒空了我去工具棚」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0007",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "伞借给那边的人，我送过去就回。",
      "description": "借出短离。"
    },
    {
      "id": "lx.text-farewell.b0003.0008",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "积水桶满了，我倒掉再聊，防溢。",
      "description": "处理积水。"
    },
    {
      "id": "lx.text-farewell.b0003.0009",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "告示绳湿了，我把字条夹高一点，即回。",
      "description": "调整短离。"
    },
    {
      "id": "lx.text-farewell.b0003.0010",
      "category": "text-farewell",
      "subcategory": "短暂离开",
      "text": "蛙声太近，我关半扇窗，噪音小点再谈。",
      "description": "降噪短离。"
    },
    {
      "id": "lx.text-farewell.b0003.0011",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "雨棚巡检走完，记录放下，我收工。",
      "description": "巡检收工。"
    },
    {
      "id": "lx.text-farewell.b0003.0012",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "闸板拨通了，今日水务到此，先走。",
      "description": "水务结束。"
    },
    {
      "id": "lx.text-farewell.b0003.0013",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "滤网换好，培植班次结束。",
      "description": "养护班结束。"
    },
    {
      "id": "lx.text-farewell.b0003.0014",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "清淤段收工哨响了，工具清点完我撤。",
      "description": "清淤收工。"
    },
    {
      "id": "lx.text-farewell.b0003.0015",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "浮板钉牢验收过，外勤销单，回驿。",
      "description": "验收后告别。"
    },
    {
      "id": "lx.text-farewell.b0003.0016",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "洗衣台疏通交接给专人，我的职责清了。",
      "description": "交接告别。"
    },
    {
      "id": "lx.text-farewell.b0003.0017",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "绕路牌加固完毕，路政班次结束。",
      "description": "路政结束。"
    },
    {
      "id": "lx.text-farewell.b0003.0018",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "湿货摊位费核对完，账班下班。",
      "description": "账务下班。"
    },
    {
      "id": "lx.text-farewell.b0003.0019",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "雨衣柜盘点结束，钥匙交班。",
      "description": "盘点交班。"
    },
    {
      "id": "lx.text-farewell.b0003.0020",
      "category": "text-farewell",
      "subcategory": "工作告别",
      "text": "步道灯巡完一圈，夜班到点，我回。",
      "description": "夜班到点。"
    },
    {
      "id": "lx.text-farewell.b0003.0021",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "雨小了，我先走，你伞还够用吗——自己看着办。",
      "description": "关照但不替决定。"
    },
    {
      "id": "lx.text-farewell.b0003.0022",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "棚下见，地滑，步子放慢。",
      "description": "提醒道别。"
    },
    {
      "id": "lx.text-farewell.b0003.0023",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "听够水声了，我回家换鞋，你慢走。",
      "description": "日常道别。"
    },
    {
      "id": "lx.text-farewell.b0003.0024",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "告辞。苔墙上别靠太紧，湿。",
      "description": "日常道别含轻度关照，呼应「告辞苔墙上别靠太紧湿」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0025",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "先别。斗笠晒干我会放回柜，你来取即可。",
      "description": "事务相关道别。"
    },
    {
      "id": "lx.text-farewell.b0003.0026",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "走了。渠边风凉，领子竖起来。",
      "description": "体感关照。"
    },
    {
      "id": "lx.text-farewell.b0003.0027",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "日安收尾，跳板中段那块白痕留神。",
      "description": "路况道别。"
    },
    {
      "id": "lx.text-farewell.b0003.0028",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "聊完了，我回东岸，你留西岸也行。",
      "description": "分岸道别。"
    },
    {
      "id": "lx.text-farewell.b0003.0029",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "再见。叶子上的水珠很好看，我记下了。",
      "description": "意象收束。"
    },
    {
      "id": "lx.text-farewell.b0003.0030",
      "category": "text-farewell",
      "subcategory": "普通道别",
      "text": "散了。湿脚印会干的。",
      "description": "轻巧道别。"
    },
    {
      "id": "lx.text-farewell.b0003.0031",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "雨棚常在，谁躲雨谁遇见，不约。",
      "description": "不约定下次会面，呼应「雨棚常在谁躲雨谁遇见」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0032",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "清淤若再招人，名单会贴；我不私约。",
      "description": "告示替代。"
    },
    {
      "id": "lx.text-farewell.b0003.0033",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "水位正常时未必常见，涨水时总会碰面。",
      "description": "条件偶遇。"
    },
    {
      "id": "lx.text-farewell.b0003.0034",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "采蕨各走各的路，撞见了点头。",
      "description": "户外偶遇。"
    },
    {
      "id": "lx.text-farewell.b0003.0035",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "茶会我不邀，想喝自己来码头。",
      "description": "不约定下次会面，呼应「茶会我不邀想喝自己来码」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0036",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "养护班次轮到会再见，轮不到也正常。",
      "description": "轮值驱动。"
    },
    {
      "id": "lx.text-farewell.b0003.0037",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "字条在告示绳上就够，不必当面再约。",
      "description": "书面替代。"
    },
    {
      "id": "lx.text-farewell.b0003.0038",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "也许灯笼夜再遇，也许只在白天擦肩。",
      "description": "时间不定。"
    },
    {
      "id": "lx.text-farewell.b0003.0039",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "各回各的干处，潮气散了再算。",
      "description": "状态驱动。"
    },
    {
      "id": "lx.text-farewell.b0003.0040",
      "category": "text-farewell",
      "subcategory": "未约定再见",
      "text": "不说下次。水岸路长，总会再湿一次鞋。",
      "description": "意象未约定。"
    },
    {
      "id": "lx.text-farewell.b0003.0041",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "先走；雨若再大，棚下位置我可以给你留半边。",
      "description": "空间余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0042",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "清淤我请假；下次名单你若缺人，勾我一下。",
      "description": "再邀余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0043",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "话题停；排水坡度你若画草图，我愿意看。",
      "description": "书面延续。"
    },
    {
      "id": "lx.text-farewell.b0003.0044",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "取斗笠改日；柜号我记住，你忙时再来。",
      "description": "取物余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0045",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "浇水今日我值；你若想学手法，旁观随时。",
      "description": "学习余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0046",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "走了；浮板若还响，回头告诉我何处。",
      "description": "离开同时保留后续可能，呼应「走了；浮板若还响回头告」情境。"
    },
    {
      "id": "lx.text-farewell.b0003.0047",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "伞你先用；还的时候挂回棚柱钩即可。",
      "description": "归还方式余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0048",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "先回换鞋；若你找到更好的防滑垫样品，给我看。",
      "description": "样品余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0049",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "夜听蛙你去；录音若愿意分享片段，我可听。",
      "description": "分享余地。"
    },
    {
      "id": "lx.text-farewell.b0003.0050",
      "category": "text-farewell",
      "subcategory": "留有余地",
      "text": "散了；涨水通知一出，我们自会在板前相遇。",
      "description": "公共信息驱动余地。"
    }
  ]
}
