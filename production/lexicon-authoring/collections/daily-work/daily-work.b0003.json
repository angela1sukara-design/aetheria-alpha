{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-work",
  "batchId": "daily-work.b0003",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "subcategory": "准备",
      "text": "对方把雨棚下的水桶挪到滴水线外，再铺上一块干草垫。",
      "description": "挪桶铺垫避开滴水。",
      "id": "lx.daily-work.b0003.0001",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把苔藓从石缝轻轻揭起，放入湿布裹好待移栽。",
      "description": "揭苔备移的准备。",
      "id": "lx.daily-work.b0003.0002",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把水渠闸板提起一寸，让水流变缓便于清淤。",
      "description": "提闸缓流备清淤。",
      "id": "lx.daily-work.b0003.0003",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把橡胶靴在门槛磕净泥，再换上干袜进棚。",
      "description": "磕泥换袜的进棚准备。",
      "id": "lx.daily-work.b0003.0004",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把蕨叶上的露珠抖落，理顺叶柄再扎成束。",
      "description": "抖露理叶扎束准备。",
      "id": "lx.daily-work.b0003.0005",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把竹竿架到雨棚下，晾开湿透的麻袋通风。",
      "description": "架竿晾袋的准备。",
      "id": "lx.daily-work.b0003.0006",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把水渠边的石阶扫净青苔碎屑，免得打滑。",
      "description": "扫苔防滑的准备。",
      "id": "lx.daily-work.b0003.0007",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把水壶灌满渠水，静置沉淀后再倒入浇花壶。",
      "description": "沉淀渠水备浇。",
      "id": "lx.daily-work.b0003.0008",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把雨布展开检查破洞，用粉笔圈出待补处。",
      "description": "检雨布圈破洞准备。",
      "id": "lx.daily-work.b0003.0009",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把草鞋浸湿再拧半干，以便在湿石上抓地。",
      "description": "浸鞋半干备行水岸。",
      "id": "lx.daily-work.b0003.0010",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把漂来的芦苇杆削尖，编成简易的拦网架。",
      "description": "削苇编拦网的制作。",
      "id": "lx.daily-work.b0003.0011",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把泥巴和碎草拌匀，糊到雨棚漏处的缝隙。",
      "description": "泥草糊漏的制作。",
      "id": "lx.daily-work.b0003.0012",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把水生植物根部裹泥球，放入沉底的陶盆。",
      "description": "裹泥栽水生的制作。",
      "id": "lx.daily-work.b0003.0013",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把竹片对弯成弧，绑成拱架撑起低垂的藤蔓。",
      "description": "弯竹成拱撑藤制作。",
      "id": "lx.daily-work.b0003.0014",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把湿木板用火烤去潮气，再刨平表面。",
      "description": "烘潮刨平木板制作。",
      "id": "lx.daily-work.b0003.0015",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把苔藓铺成毯状，压入石阶缝作防滑垫。",
      "description": "铺苔作垫的制作。",
      "id": "lx.daily-work.b0003.0016",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把破渔网补上新线，网眼大小与旧处对齐。",
      "description": "补网对齐网眼制作。",
      "id": "lx.daily-work.b0003.0017",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把荷叶叠成碗形，装入洗净的野菜待送。",
      "description": "荷叶叠碗装菜制作。",
      "id": "lx.daily-work.b0003.0018",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把渠边淤泥挖出，捏成土砖晾在棚下。",
      "description": "淤泥捏砖晾干制作。",
      "id": "lx.daily-work.b0003.0019",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把蕨根捣碎拌灰，涂在木柱根部防潮。",
      "description": "蕨根灰涂柱防潮制作。",
      "id": "lx.daily-work.b0003.0020",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方蹲下看水渠流速，用浮叶计时估量是否过急。",
      "description": "浮叶估流的检查。",
      "id": "lx.daily-work.b0003.0021",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方摸雨棚支柱根部，感觉是否仍有渗水。",
      "description": "触检支柱渗水。",
      "id": "lx.daily-work.b0003.0022",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方掀开苔毯一角，看石阶是否还在返潮。",
      "description": "掀苔检石返潮。",
      "id": "lx.daily-work.b0003.0023",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把刚糊的泥缝按一下，确认已经半干结壳。",
      "description": "按泥检壳的检查。",
      "id": "lx.daily-work.b0003.0024",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方闻渠水气味，判断是否需要再换一轮清水。",
      "description": "闻水判断是否换水。",
      "id": "lx.daily-work.b0003.0025",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把拦网提起，看网眼有没有被水草堵住。",
      "description": "提网检堵的检查。",
      "id": "lx.daily-work.b0003.0026",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方轻摇藤架，听绑绳有没有松脱的声响。",
      "description": "摇架听绳松脱。",
      "id": "lx.daily-work.b0003.0027",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方看陶盆是否沉稳，盆缘有没有被水流冲偏。",
      "description": "看盆位是否被冲偏。",
      "id": "lx.daily-work.b0003.0028",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方用木尺量雨棚下净高，确认人走过不会碰头。",
      "description": "量棚高防碰头检查。",
      "id": "lx.daily-work.b0003.0029",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方掐断一片蕨叶，看断面是否仍有充足汁液。",
      "description": "掐叶看汁检活力。",
      "id": "lx.daily-work.b0003.0030",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把捞起的水草拧干，摊在竹帘上晒。",
      "description": "拧草摊晒的整理。",
      "id": "lx.daily-work.b0003.0031",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把湿透的工具擦干，涂薄油防锈后挂起。",
      "description": "擦干涂油挂具整理。",
      "id": "lx.daily-work.b0003.0032",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把淤泥铲进筐，整齐码到岸边指定处。",
      "description": "淤泥入筐码岸整理。",
      "id": "lx.daily-work.b0003.0033",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把雨衣抖干水珠，挂到通风的竹竿上。",
      "description": "抖水挂雨衣整理。",
      "id": "lx.daily-work.b0003.0034",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把漂浮的落叶捞净，倒进堆肥角。",
      "description": "捞叶入堆肥整理。",
      "id": "lx.daily-work.b0003.0035",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把闸板擦净青苔，靠墙立好并系绳固定。",
      "description": "擦闸板立靠整理。",
      "id": "lx.daily-work.b0003.0036",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把空陶盆叠放，盆底朝上沥水。",
      "description": "叠盆沥水的整理。",
      "id": "lx.daily-work.b0003.0037",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把湿麻绳松开晾干，重新绕成圈再挂。",
      "description": "晾绳重绕挂放整理。",
      "id": "lx.daily-work.b0003.0038",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把棚下杂物按干湿分区，湿的靠外干的靠里。",
      "description": "干湿分区摆物整理。",
      "id": "lx.daily-work.b0003.0039",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把用过的草垫抖泥，叠好压在石板下定型。",
      "description": "抖泥叠垫定型整理。",
      "id": "lx.daily-work.b0003.0040",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把清好的渠段指给下一班，说明闸板当前高度。",
      "description": "交代渠段与闸高。",
      "id": "lx.daily-work.b0003.0041",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把移栽好的苔盆放在交接台上，附一张养护短笺。",
      "description": "交苔盆附养护笺。",
      "id": "lx.daily-work.b0003.0042",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把雨棚钥匙递给替班者，提醒东角仍在滴水。",
      "description": "交钥匙并提醒滴水点。",
      "id": "lx.daily-work.b0003.0043",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把装好的野菜荷叶碗递给来取的人。",
      "description": "递交荷叶碗装菜。",
      "id": "lx.daily-work.b0003.0044",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把拦网卷好，交给下水的人并指明投放点。",
      "description": "交卷网并指投放点。",
      "id": "lx.daily-work.b0003.0045",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把土砖半成品标明晾晒天数，交给看守棚的人。",
      "description": "交土砖并标晾晒天数。",
      "id": "lx.daily-work.b0003.0046",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把水样瓶递给检验的人，瓶口塞紧并贴取样时辰。",
      "description": "交水样贴时辰。",
      "id": "lx.daily-work.b0003.0047",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把湿靴放在门口木架，口头告知内里已垫干草。",
      "description": "交靴位并告知垫草。",
      "id": "lx.daily-work.b0003.0048",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把今日清淤量记在木牌上，挂到交接墙钉。",
      "description": "挂牌记录清淤量交接。",
      "id": "lx.daily-work.b0003.0049",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把备用雨布叠好压石，留给夜班随时取用。",
      "description": "留备用雨布给夜班。",
      "id": "lx.daily-work.b0003.0050",
      "category": "daily-work"
    }
  ]
}
