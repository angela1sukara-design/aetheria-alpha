{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-work",
  "batchId": "daily-work.b0002",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "subcategory": "准备",
      "text": "对方把旧木椅翻过来，用粉笔在松动的榫眼旁画了小圈。",
      "description": "标出待修榫眼的准备。",
      "id": "lx.daily-work.b0002.0001",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把砂纸按粗细分好，粗的放左手边，细的靠窗。",
      "description": "砂纸按粒度摆位准备。",
      "id": "lx.daily-work.b0002.0002",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把骨胶放入温水盆中，用木棒轻轻搅散结块。",
      "description": "化胶待用的准备动作。",
      "id": "lx.daily-work.b0002.0003",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把学徒递来的工具一一检视，缺锉的那格空着。",
      "description": "检视工具齐全与否。",
      "id": "lx.daily-work.b0002.0004",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把破布袋摊开，把能用的布片挑到一边成堆。",
      "description": "挑拣可用布片的准备。",
      "id": "lx.daily-work.b0002.0005",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把蜡块削成薄片，放入小铁盅里慢慢融化。",
      "description": "融蜡备涂的准备。",
      "id": "lx.daily-work.b0002.0006",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把量尺拉直，在工作台边缘钉了两个参照钉。",
      "description": "钉参照钉便于量裁。",
      "id": "lx.daily-work.b0002.0007",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把旧门锁拆下的零件铺在白布上，按位置排开。",
      "description": "零件按位铺排的准备。",
      "id": "lx.daily-work.b0002.0008",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把磨刀石浸湿，在石面洒上细砂，摆好角度架。",
      "description": "浸石备磨的准备动作。",
      "id": "lx.daily-work.b0002.0009",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把灯挪近台面，又用反光板把光聚到接缝处。",
      "description": "调光照缝的准备。",
      "id": "lx.daily-work.b0002.0010",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把松动的椅腿重新楔紧，再抹上一层薄胶。",
      "description": "楔紧椅腿并涂胶修补。",
      "id": "lx.daily-work.b0002.0011",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方用细针把裂开的鞋帮缝回，针脚密而均匀。",
      "description": "细密缝合鞋帮裂口。",
      "id": "lx.daily-work.b0002.0012",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把缺角的瓷碗用金属箍卡住，轻轻收紧螺丝。",
      "description": "箍补破瓷的制作动作。",
      "id": "lx.daily-work.b0002.0013",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把旧伞骨理直，换上一根新撑条并绑牢。",
      "description": "换伞骨撑条的修补。",
      "id": "lx.daily-work.b0002.0014",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把皮革边沿削薄，涂上黏合剂后压合在一起。",
      "description": "削边黏合皮革的制作。",
      "id": "lx.daily-work.b0002.0015",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把断了的扫帚柄对接，用铁丝缠紧再刷漆封口。",
      "description": "对接扫帚柄的修补。",
      "id": "lx.daily-work.b0002.0016",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把布补丁背面抹浆，熨贴到破洞上，边沿压平。",
      "description": "熨贴补丁的制作动作。",
      "id": "lx.daily-work.b0002.0017",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把木匣缺盖按原样锯出新盖，合页钉在旧孔位。",
      "description": "配盖钉合页的制作。",
      "id": "lx.daily-work.b0002.0018",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把铜壶底的凹痕从内侧顶出，再用布抛光。",
      "description": "顶凹抛光铜壶的修补。",
      "id": "lx.daily-work.b0002.0019",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把藤编破口处抽出断藤，穿入新藤并编回纹理。",
      "description": "换藤复编的制作过程。",
      "id": "lx.daily-work.b0002.0020",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方晃了晃修好的抽屉，听滑轨有没有涩声。",
      "description": "听声检查抽屉滑动。",
      "id": "lx.daily-work.b0002.0021",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把补好的布袋装上沙袋试提，观察缝线是否扯动。",
      "description": "负重试缝的检查。",
      "id": "lx.daily-work.b0002.0022",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方用指甲抠胶缝，确认胶已干透不会再黏手。",
      "description": "抠试胶干的检查动作。",
      "id": "lx.daily-work.b0002.0023",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把伞撑开收起数次，看伞骨是否同步开合。",
      "description": "反复开合检查伞骨。",
      "id": "lx.daily-work.b0002.0024",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把椅子四脚着地，从侧面看椅面是否水平。",
      "description": "目测椅面水平的检查。",
      "id": "lx.daily-work.b0002.0025",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把皮革对折又展开，看黏合处有没有起翘。",
      "description": "对折检查皮革黏合。",
      "id": "lx.daily-work.b0002.0026",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方用放大镜看瓷裂缝走向，确认箍是否压住裂端。",
      "description": "放大镜检瓷裂与箍位。",
      "id": "lx.daily-work.b0002.0027",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把门锁装回试转，钥匙进退是否顺畅。",
      "description": "装回试转锁的检查。",
      "id": "lx.daily-work.b0002.0028",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把扫帚倒立，看柄与头接合处有没有松晃。",
      "description": "倒立检查扫帚接合。",
      "id": "lx.daily-work.b0002.0029",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把藤篮装满湿布，提起来看底部会不会鼓出。",
      "description": "负重检藤篮底部。",
      "id": "lx.daily-work.b0002.0030",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把拆下的旧钉子按长短分罐，罐口贴纸条注明。",
      "description": "旧钉分罐贴签整理。",
      "id": "lx.daily-work.b0002.0031",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把用过的砂纸叠齐，写上已用次数再放回匣。",
      "description": "砂纸记次归匣整理。",
      "id": "lx.daily-work.b0002.0032",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把胶刷用热水洗净，刷毛朝上晾在杯口。",
      "description": "洗刷晾干的整理。",
      "id": "lx.daily-work.b0002.0033",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把剩余的皮边角料按大小塞进不同抽屉。",
      "description": "皮料边角分屉整理。",
      "id": "lx.daily-work.b0002.0034",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把工作台边的木屑扫入布袋，系口挂到门外。",
      "description": "扫屑入袋挂外的整理。",
      "id": "lx.daily-work.b0002.0035",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把量具擦净油污，挂回墙上对应的剪影位。",
      "description": "量具擦净归影位。",
      "id": "lx.daily-work.b0002.0036",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把半成品贴上“待干”纸条，摆到通风架层。",
      "description": "半成品标态上架。",
      "id": "lx.daily-work.b0002.0037",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把学徒散落的钉子收回盒中，盒盖扣严。",
      "description": "收回散钉扣盖整理。",
      "id": "lx.daily-work.b0002.0038",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把磨钝的锉刀单放一格，旁边写“待磨”。",
      "description": "钝锉分格待磨标记。",
      "id": "lx.daily-work.b0002.0039",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把空胶瓶冲洗后倒置，瓶身画圈表示可回收。",
      "description": "空胶瓶冲洗标回收。",
      "id": "lx.daily-work.b0002.0040",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把修好的椅子推向店门口，把账单夹在椅背上。",
      "description": "交椅并夹账单。",
      "id": "lx.daily-work.b0002.0041",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把补好的伞递给来人，同时演示一次开合。",
      "description": "交伞并演示开合。",
      "id": "lx.daily-work.b0002.0042",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把零件清单递给学徒，让其对照装箱。",
      "description": "交清单供对照装箱。",
      "id": "lx.daily-work.b0002.0043",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把修好的锁连同两把备用钥匙放进纸袋。",
      "description": "交锁及备用钥匙入袋。",
      "id": "lx.daily-work.b0002.0044",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把尚未干透的木匣标“明日取”，交给店员保管。",
      "description": "交代未干物件改日取。",
      "id": "lx.daily-work.b0002.0045",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把用剩的蜡块包好，退还给委托人。",
      "description": "退还剩余材料的交接。",
      "id": "lx.daily-work.b0002.0046",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把工具箱推到学徒面前，口头点名今日要用的三件。",
      "description": "交箱并点名所需工具。",
      "id": "lx.daily-work.b0002.0047",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把样品修补前后对照照放到柜台上供看。",
      "description": "摆对照照供人查看。",
      "id": "lx.daily-work.b0002.0048",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把缮补完成的账本合上，在封面贴好完成日。",
      "description": "合账本贴完成日交接。",
      "id": "lx.daily-work.b0002.0049",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把空板条捆成一束，交给邻店作薪柴备用。",
      "description": "移交废板条作备用。",
      "id": "lx.daily-work.b0002.0050",
      "category": "daily-work"
    }
  ]
}
