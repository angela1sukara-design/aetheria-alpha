{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-work",
  "batchId": "daily-work.b0004",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "subcategory": "准备",
      "text": "对方把遮阳布拉开，用石块压住四角防风掀。",
      "description": "拉遮阳布压角准备。",
      "id": "lx.daily-work.b0004.0001",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把石阶上的沙土扫进畚箕，清出落脚的宽面。",
      "description": "扫石阶沙土准备。",
      "id": "lx.daily-work.b0004.0002",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把水囊灌满，挂到鞍旁并检查塞子是否严实。",
      "description": "灌水囊检塞准备。",
      "id": "lx.daily-work.b0004.0003",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把布帘卷起一半，让凉风进棚又挡直晒。",
      "description": "半卷布帘调光准备。",
      "id": "lx.daily-work.b0004.0004",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把远行包打开，按重量把重物垫到底层。",
      "description": "重物垫底装包准备。",
      "id": "lx.daily-work.b0004.0005",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把石臼擦净，准备捣香料给过路人换用。",
      "description": "擦石臼备捣香料。",
      "id": "lx.daily-work.b0004.0006",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把草帽边沿缝紧，再在帽带上打活结防脱。",
      "description": "缝帽沿打活结准备。",
      "id": "lx.daily-work.b0004.0007",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把迁居清单抄到硬纸板，夹在行李最外层。",
      "description": "抄清单夹外层准备。",
      "id": "lx.daily-work.b0004.0008",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把干粮按日分包，每包塞一张标记日期的纸条。",
      "description": "干粮按日分包准备。",
      "id": "lx.daily-work.b0004.0009",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把遮阳棚立杆插牢，用绳与石桩拉成三角。",
      "description": "立杆拉三角固定棚。",
      "id": "lx.daily-work.b0004.0010",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把干草拧成绳，编成临时的遮阳檐边。",
      "description": "拧草编檐的制作。",
      "id": "lx.daily-work.b0004.0011",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把破布帘拼接加长，缝上新的穿杆套。",
      "description": "拼接布帘加穿杆套。",
      "id": "lx.daily-work.b0004.0012",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把石阶缺口用碎石楔紧，再抹上湿黏土填平。",
      "description": "楔石抹土修阶制作。",
      "id": "lx.daily-work.b0004.0013",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把竹筒掏空作水筒，两端塞上软木。",
      "description": "掏竹制水筒的制作。",
      "id": "lx.daily-work.b0004.0014",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把旧鞍垫重新填絮，外罩换上一层耐磨布。",
      "description": "填絮换罩修鞍垫。",
      "id": "lx.daily-work.b0004.0015",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把晒干的果片串成环，挂到棚梁上风干再收。",
      "description": "串果片风干制作。",
      "id": "lx.daily-work.b0004.0016",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把布条染成土黄，晾干后裁成行李标签。",
      "description": "染布裁签的制作。",
      "id": "lx.daily-work.b0004.0017",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把石板凿出浅槽，用作洗手台排水。",
      "description": "凿石槽作排水制作。",
      "id": "lx.daily-work.b0004.0018",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把断了的登山杖接口金属箍箍紧，缠麻加固。",
      "description": "箍杖缠麻的修补制作。",
      "id": "lx.daily-work.b0004.0019",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把羊皮缝成简易风挡，立在灶口迎风侧。",
      "description": "缝风挡立灶侧制作。",
      "id": "lx.daily-work.b0004.0020",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方踩了踩新修的石阶，感觉有没有翘动。",
      "description": "踩检石阶稳否。",
      "id": "lx.daily-work.b0004.0021",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方拉扯遮阳布边，看压石是否仍够重。",
      "description": "拉布检压石重量。",
      "id": "lx.daily-work.b0004.0022",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方拧开水囊塞闻了闻，确认没有馊味。",
      "description": "闻水检是否变质。",
      "id": "lx.daily-work.b0004.0023",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把布帘放下一半又拉起，看轨道是否顺滑。",
      "description": "拉帘检轨道顺滑。",
      "id": "lx.daily-work.b0004.0024",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方掂远行包两侧，调整到两肩受力相近。",
      "description": "掂包调肩力平衡。",
      "id": "lx.daily-work.b0004.0025",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把草帽在头上试戴，确认帽带长度合适。",
      "description": "试戴检帽带长度。",
      "id": "lx.daily-work.b0004.0026",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方摇登山杖听接口，确认金属箍没有松响。",
      "description": "摇杖听箍松响。",
      "id": "lx.daily-work.b0004.0027",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方看果串有没有回潮发黏，发黏的单独摘下。",
      "description": "检果串回潮情况。",
      "id": "lx.daily-work.b0004.0028",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方用手掌贴石槽，感觉排水是否通畅不积。",
      "description": "贴槽感排水通畅。",
      "id": "lx.daily-work.b0004.0029",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把风挡立稳后扇风试，看会不会倒向灶口。",
      "description": "扇风试风挡稳否。",
      "id": "lx.daily-work.b0004.0030",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把石阶扫下的沙倒回坡下，不堆在通行处。",
      "description": "沙土倒坡下整理。",
      "id": "lx.daily-work.b0004.0031",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把遮阳布收起叠方，塞进防尘的布套。",
      "description": "收叠遮阳布入套。",
      "id": "lx.daily-work.b0004.0032",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把空水囊吹干内壁，倒置晾在绳上。",
      "description": "吹干倒置晾水囊。",
      "id": "lx.daily-work.b0004.0033",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把布帘卷紧，用布带束好挂到梁上。",
      "description": "卷帘束带挂梁整理。",
      "id": "lx.daily-work.b0004.0034",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把远行包内物品按取用频率重排。",
      "description": "按取用频率重排包内。",
      "id": "lx.daily-work.b0004.0035",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把碎石边角扫进缝隙，用扫帚压实。",
      "description": "碎石压缝整理。",
      "id": "lx.daily-work.b0004.0036",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把染布晾干后收起，按色分捆。",
      "description": "染布分色捆收。",
      "id": "lx.daily-work.b0004.0037",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把灶灰铲入陶罐，盖上盖免得被风扬起。",
      "description": "铲灰入罐盖严整理。",
      "id": "lx.daily-work.b0004.0038",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把迁居装箱清单勾销已装项，未装项留红圈。",
      "description": "勾清单标未装项。",
      "id": "lx.daily-work.b0004.0039",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把草帽擦去沙尘，挂到阴凉通风处。",
      "description": "擦尘挂帽整理。",
      "id": "lx.daily-work.b0004.0040",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把水囊递给下一段路的旅伴，说明剩余水量。",
      "description": "交水囊并告余量。",
      "id": "lx.daily-work.b0004.0041",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把遮阳棚钥匙交给留守者，指明拉绳位置。",
      "description": "交棚钥指拉绳位。",
      "id": "lx.daily-work.b0004.0042",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把迁居箱推到车旁，把标签朝外方便核验。",
      "description": "推箱标签朝外交接。",
      "id": "lx.daily-work.b0004.0043",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把修好的登山杖交还，并演示箍的收紧方向。",
      "description": "交杖演示收紧方向。",
      "id": "lx.daily-work.b0004.0044",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把果串取下一环递给来换水的人。",
      "description": "交果串换水的交接。",
      "id": "lx.daily-work.b0004.0045",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把石阶修缮记录交给下一班，标出未稳的两级。",
      "description": "交修阶记录标未稳级。",
      "id": "lx.daily-work.b0004.0046",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把干粮分包放进对方空袋，按日序排好。",
      "description": "交干粮按日序入袋。",
      "id": "lx.daily-work.b0004.0047",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把布帘收卷说明交给店员，注明织物怕潮。",
      "description": "交收卷说明注怕潮。",
      "id": "lx.daily-work.b0004.0048",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把空水筒还给补给点，塞子单独用线系在筒侧。",
      "description": "还水筒塞子系侧。",
      "id": "lx.daily-work.b0004.0049",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把今日见闻短笔记夹进驿站留言板。",
      "description": "夹见闻笔记到留言板。",
      "id": "lx.daily-work.b0004.0050",
      "category": "daily-work"
    }
  ]
}
