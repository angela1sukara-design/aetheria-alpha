{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-work",
  "batchId": "daily-work.b0001",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "subcategory": "准备",
      "text": "对方把抹布拧干，叠成小方块，依次摆在柜角，方便随时取用。",
      "description": "开工前整理擦拭布的准备动作。",
      "id": "lx.daily-work.b0001.0001",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方检查水桶水位，又添了半瓢清澈的井水，才提起桶走向门口。",
      "description": "装水备工的微小准备。",
      "id": "lx.daily-work.b0001.0002",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把袖口挽到肘上，用皮筋固定，免得布料蹭到湿台面。",
      "description": "挽袖防污的开工准备。",
      "id": "lx.daily-work.b0001.0003",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把钥匙串按用途分挂在墙上的木钉，指尖点过每一枚确认。",
      "description": "钥匙归位与核对的准备动作。",
      "id": "lx.daily-work.b0001.0004",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方在工作台旁铺开旧报纸，边缘对齐桌沿，再压上两块小石。",
      "description": "铺垫防污纸的准备工作。",
      "id": "lx.daily-work.b0001.0005",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把竹筛敲了敲，抖掉昨夜残留的灰屑，再搁到通风处。",
      "description": "清筛备料的日常准备。",
      "id": "lx.daily-work.b0001.0006",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方拧开油壶盖闻了闻，确认没有酸味，才倒出薄薄一层到碗底。",
      "description": "检查油品气味后取用的准备。",
      "id": "lx.daily-work.b0001.0007",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把量杯、木勺和记号笔并列排好，空出右手活动的空间。",
      "description": "工具就位的桌面准备。",
      "id": "lx.daily-work.b0001.0008",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方点燃小炭炉，等火苗稳住才把水壶挪到架上。",
      "description": "生火待水的开工准备。",
      "id": "lx.daily-work.b0001.0009",
      "category": "daily-work"
    },
    {
      "subcategory": "准备",
      "text": "对方把记事板擦净，用炭笔写下今日要处理的几项名称。",
      "description": "开列当日事项的准备动作。",
      "id": "lx.daily-work.b0001.0010",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方用木勺缓缓搅粥，偶尔刮一下锅底，免得糊住。",
      "description": "熬粥时的单纯制作动作。",
      "id": "lx.daily-work.b0001.0011",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把面团对折再揉开，掌心用力均匀，直到表面光滑。",
      "description": "揉面工序的可观察制作。",
      "id": "lx.daily-work.b0001.0012",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把洗净的菜叶铺平，用刀横切成细条，动作不急不缓。",
      "description": "切丝备菜的制作片段。",
      "id": "lx.daily-work.b0001.0013",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把线头穿过针眼，打了个小结，开始缝合布袋破口。",
      "description": "缝补布袋的制作动作。",
      "id": "lx.daily-work.b0001.0014",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把木条两端锯齐，再用砂布轻轻打磨毛边。",
      "description": "截木打磨的基础制作。",
      "id": "lx.daily-work.b0001.0015",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把纱布叠成三层，中间夹入药草碎末，缝成小包。",
      "description": "缝制草药包的制作过程。",
      "id": "lx.daily-work.b0001.0016",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把陶坯转到转盘中央，双手扶稳，慢慢抬起壁沿。",
      "description": "拉坯塑形的制作动作。",
      "id": "lx.daily-work.b0001.0017",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把蜜糖倒进温水，用竹筷搅到完全化开，再倒入瓶中。",
      "description": "冲蜜调液的制作片段。",
      "id": "lx.daily-work.b0001.0018",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把纸裁成同样大小的长条，沿边折出细细的折痕。",
      "description": "折纸备料的制作动作。",
      "id": "lx.daily-work.b0001.0019",
      "category": "daily-work"
    },
    {
      "subcategory": "制作",
      "text": "对方把蜡烛芯固定在模具中央，缓缓倒入融化的蜂蜡。",
      "description": "灌蜡制烛的制作过程。",
      "id": "lx.daily-work.b0001.0020",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方提起桶底，对着光看有没有渗水的细线。",
      "description": "检漏的日常检查动作。",
      "id": "lx.daily-work.b0001.0021",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方用指腹按压面包表面，感受回弹是否均匀。",
      "description": "触感检查烘焙成品。",
      "id": "lx.daily-work.b0001.0022",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把木勺浸入汤中再取出，看挂勺的稠度是否合适。",
      "description": "观察挂勺稠度的检查。",
      "id": "lx.daily-work.b0001.0023",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方拧紧瓶盖后又松一点，确认螺纹没有卡死。",
      "description": "瓶盖松紧的检查动作。",
      "id": "lx.daily-work.b0001.0024",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把布料对着窗光展开，寻找破洞和薄处。",
      "description": "透光检布的检查片段。",
      "id": "lx.daily-work.b0001.0025",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方用指甲轻刮木板接缝，听有没有空响。",
      "description": "听声检查木接缝。",
      "id": "lx.daily-work.b0001.0026",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把灯芯剪短一点，点燃试看火焰是否稳定。",
      "description": "试燃检查灯芯长度。",
      "id": "lx.daily-work.b0001.0027",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方掂了掂口袋重量，又数一遍里面的铜币。",
      "description": "核对零钱数量的检查。",
      "id": "lx.daily-work.b0001.0028",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方把锁孔对准钥匙，轻轻试转半圈，确认没有锈住。",
      "description": "试锁的检查动作。",
      "id": "lx.daily-work.b0001.0029",
      "category": "daily-work"
    },
    {
      "subcategory": "检查",
      "text": "对方弯腰看鞋底磨损，用手摸摸鞋跟是否松动。",
      "description": "检查鞋底磨损情况。",
      "id": "lx.daily-work.b0001.0030",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把用过的碗摞齐，按大小分开放进竹筐。",
      "description": "碗具按尺寸归拢。",
      "id": "lx.daily-work.b0001.0031",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把掉落的菜叶扫进畚箕，倒进门外的堆肥桶。",
      "description": "清扫厨余的整理动作。",
      "id": "lx.daily-work.b0001.0032",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把绳子绕成圈，挂到门后的钉子上。",
      "description": "绕绳挂放的整理。",
      "id": "lx.daily-work.b0001.0033",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把空瓶冲洗干净，倒置在沥水架上风干。",
      "description": "空瓶冲洗沥干的整理。",
      "id": "lx.daily-work.b0001.0034",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把散落的纽扣按颜色分进小纸盒，盖上盖子。",
      "description": "纽扣分色收纳的整理。",
      "id": "lx.daily-work.b0001.0035",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把桌面的木屑吹开，再用湿布擦去残留的胶痕。",
      "description": "清桌去屑的整理动作。",
      "id": "lx.daily-work.b0001.0036",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把折叠好的布巾按用途贴上标签，塞进抽屉。",
      "description": "布巾分类贴签整理。",
      "id": "lx.daily-work.b0001.0037",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把扫帚靠墙放正，畚箕倒扣在旁，免得积水。",
      "description": "清扫工具归位的整理。",
      "id": "lx.daily-work.b0001.0038",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把写完的纸条按日期夹进夹子，挂在钩上。",
      "description": "纸条按日归档整理。",
      "id": "lx.daily-work.b0001.0039",
      "category": "daily-work"
    },
    {
      "subcategory": "整理",
      "text": "对方把多余的包装纸压平，叠好收进柜底备用。",
      "description": "包装纸压平收纳。",
      "id": "lx.daily-work.b0001.0040",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把装满的水瓶递给前来的人，同时指了指瓶肩的刻度。",
      "description": "递水并示意容量的交接。",
      "id": "lx.daily-work.b0001.0041",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把钥匙放在柜台上，口头说明哪一把开后门。",
      "description": "交钥匙并口头说明用途。",
      "id": "lx.daily-work.b0001.0042",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把记事板转向对方，用指尖点出未完成的两项。",
      "description": "移交记事并标出待办。",
      "id": "lx.daily-work.b0001.0043",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把温好的汤罐放在门槛边，轻敲罐盖示意可取。",
      "description": "放置汤罐并示意可取。",
      "id": "lx.daily-work.b0001.0044",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把修好的凳子推到门口，在扶手上系了一条短布条。",
      "description": "交还修好物件并做标记。",
      "id": "lx.daily-work.b0001.0045",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把装好的布袋递给学徒，嘱咐先放阴凉处再打开。",
      "description": "递袋并交代存放注意。",
      "id": "lx.daily-work.b0001.0046",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把收据撕下一联，夹进对方带来的信封里。",
      "description": "交收据入信封的交接。",
      "id": "lx.daily-work.b0001.0047",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把空箱叠好，推到巷口留给下一位来收的人。",
      "description": "空箱移交到约定位置。",
      "id": "lx.daily-work.b0001.0048",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把样品摆在浅盘里，推到桌中央供人查看。",
      "description": "摆样供看的交接动作。",
      "id": "lx.daily-work.b0001.0049",
      "category": "daily-work"
    },
    {
      "subcategory": "交接",
      "text": "对方把工具箱合上，把提手朝向接手的人，退后半步。",
      "description": "合箱递交并让出空间。",
      "id": "lx.daily-work.b0001.0050",
      "category": "daily-work"
    }
  ]
}
