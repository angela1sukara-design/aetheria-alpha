{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-move",
  "batchId": "daily-move.b0001",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "subcategory": "步行细节",
      "text": "对方放慢脚步，鞋底在石板缝间找平稳的落点。",
      "description": "石板缝找落点的步行。",
      "id": "lx.daily-move.b0001.0001",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方把重心移到前脚掌，悄无声息地走过午睡的巷。",
      "description": "前掌轻走过午睡巷。",
      "id": "lx.daily-move.b0001.0002",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方踩到水洼边缘绕开，裤脚因此始终干着。",
      "description": "绕水洼保裤脚干。",
      "id": "lx.daily-move.b0001.0003",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方一步一顿数着地砖，走到第七块拐进侧门。",
      "description": "数砖拐门的步行。",
      "id": "lx.daily-move.b0001.0004",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方脚跟先着地再过渡到全掌，走长路省力。",
      "description": "脚跟过渡全掌省力走。",
      "id": "lx.daily-move.b0001.0005",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方把步幅收短，跟上前面推车的人却不催。",
      "description": "收步幅跟车不催。",
      "id": "lx.daily-move.b0001.0006",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方脚尖略外八，方便随时侧身让路。",
      "description": "外八便于侧身让路。",
      "id": "lx.daily-move.b0001.0007",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方走过菜市场时抬高膝盖，免得绊到低筐。",
      "description": "抬膝避低筐步行。",
      "id": "lx.daily-move.b0001.0008",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方鞋带松了也不停，用脚侧把带压进鞋里继续走。",
      "description": "脚侧压带继续走。",
      "id": "lx.daily-move.b0001.0009",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在人群里斜向迈步，像穿缝一样挪到空处。",
      "description": "斜向穿缝挪到空处。",
      "id": "lx.daily-move.b0001.0010",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方抓住墙砖凸起，身体贴墙侧向上挪了两级。",
      "description": "抓砖凸贴墙上挪。",
      "id": "lx.daily-move.b0001.0011",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方手脚并用爬上低墙，坐在墙头再荡腿落地。",
      "description": "爬低墙坐头荡落。",
      "id": "lx.daily-move.b0001.0012",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方沿脚手架斜杆攀到二层平台，不看脚下。",
      "description": "沿斜杆攀二层平台。",
      "id": "lx.daily-move.b0001.0013",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方把脚趾扣进石缝，手指扣着藤蔓向上挪。",
      "description": "趾扣石缝攀藤上。",
      "id": "lx.daily-move.b0001.0014",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方用膝顶住树干，双手抱树一点点上升。",
      "description": "膝顶树干抱攀上升。",
      "id": "lx.daily-move.b0001.0015",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方倒挂在横梁上，双手交替前移到另一端。",
      "description": "倒挂横梁交替前移。",
      "id": "lx.daily-move.b0001.0016",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方踩着堆叠的木箱攀到窗台，再翻身进屋。",
      "description": "踩箱攀窗翻身进屋。",
      "id": "lx.daily-move.b0001.0017",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方抓住绳结一节节上爬，小腿夹绳稳住。",
      "description": "抓绳结夹腿上爬。",
      "id": "lx.daily-move.b0001.0018",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方手脚张开贴岩壁，横向挪到平台缺口。",
      "description": "贴岩壁横向挪平台。",
      "id": "lx.daily-move.b0001.0019",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方踩着铁梯每格停半秒，确认踏实再上。",
      "description": "铁梯每格确认再上。",
      "id": "lx.daily-move.b0001.0020",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "鳞侧贴着缓流，身体轻轻侧倾，尾鳍画出一道细弧。",
      "description": "缓流中侧倾游动的质感描写。",
      "id": "lx.daily-move.b0001.0021",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方侧身漂在水面，双臂缓慢划出八字。",
      "description": "侧漂双臂划八字。",
      "id": "lx.daily-move.b0001.0022",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方脚蹼轮流下压，身体保持水平向前滑。",
      "description": "脚蹼轮压水平前滑。",
      "id": "lx.daily-move.b0001.0023",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜入桥洞阴影，只露出鼻尖换气。",
      "description": "潜入桥影鼻尖换气。",
      "id": "lx.daily-move.b0001.0024",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方仰面漂浮，脚尖偶尔点一下保持方向。",
      "description": "仰漂脚尖点向。",
      "id": "lx.daily-move.b0001.0025",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方在浅滩手脚并用，像走又像游地挪向深水。",
      "description": "浅滩手脚并用挪深。",
      "id": "lx.daily-move.b0001.0026",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方蜷身再弹开，借助弹力穿过狭窄水道。",
      "description": "蜷弹穿过窄水道。",
      "id": "lx.daily-move.b0001.0027",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方贴池底潜行，手掌轻推泥沙前进。",
      "description": "贴底推沙潜行。",
      "id": "lx.daily-move.b0001.0028",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方转身时带动一圈水涡，尾巴轻轻一甩稳住。",
      "description": "转身带涡尾甩稳住。",
      "id": "lx.daily-move.b0001.0029",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方浮出水面吐气泡，又缓缓沉回半透明的绿水。",
      "description": "吐泡再沉回绿水。",
      "id": "lx.daily-move.b0001.0030",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着湿苔石面滑出半步，手臂张开平衡。",
      "description": "湿苔滑步张臂平衡。",
      "id": "lx.daily-move.b0001.0031",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方坐上冰溜的木板，双手撑地加速滑下坡。",
      "description": "坐板撑地滑下坡。",
      "id": "lx.daily-move.b0001.0032",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方鞋底打蜡后，在抛光石廊上轻轻滑行。",
      "description": "打蜡鞋底石廊滑。",
      "id": "lx.daily-move.b0001.0033",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方抓住吊环荡出，落地时脚掌贴地滑停。",
      "description": "荡环落地贴地滑停。",
      "id": "lx.daily-move.b0001.0034",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方顺着雨后屋檐下的积水沟，鞋尖推水滑行。",
      "description": "积水沟鞋尖推水滑。",
      "id": "lx.daily-move.b0001.0035",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方趴在滑梯上腹贴面，慢速下滑控制方向。",
      "description": "腹贴滑梯慢控向。",
      "id": "lx.daily-move.b0001.0036",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方用一块破布垫脚，在刚打过蜡的地板上滑过。",
      "description": "布垫脚蜡地滑过。",
      "id": "lx.daily-move.b0001.0037",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方侧身贴墙，肩背借墙面滑动绕过狭窄处。",
      "description": "侧贴墙滑过狭窄。",
      "id": "lx.daily-move.b0001.0038",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着落叶堆惯性滑出一小段，嘎吱作响。",
      "description": "踩叶堆惯性滑响。",
      "id": "lx.daily-move.b0001.0039",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方坐在麻袋上被人轻推，沿斜坡滑到仓门。",
      "description": "坐麻袋沿坡滑仓门。",
      "id": "lx.daily-move.b0001.0040",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把水桶换到另一侧肩膀，步幅随之调整。",
      "description": "换肩担水调步幅。",
      "id": "lx.daily-move.b0001.0041",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方背着柴捆侧身进窄门，柴梢小心不刮墙。",
      "description": "侧身进门柴不刮墙。",
      "id": "lx.daily-move.b0001.0042",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方抬着木箱与人对面错步，口里喊着左或右。",
      "description": "抬箱错步喊左右。",
      "id": "lx.daily-move.b0001.0043",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方用推车过坎时先翘前轮，再压后轮跟上。",
      "description": "推车翘前压后过坎。",
      "id": "lx.daily-move.b0001.0044",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把米袋抱在胸前，用下巴压住袋口防漏。",
      "description": "抱米袋下巴压口。",
      "id": "lx.daily-move.b0001.0045",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方挑担过桥时放慢，扁担微颤却不洒。",
      "description": "过桥慢挑扁担不洒。",
      "id": "lx.daily-move.b0001.0046",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把花盆托在掌心，肘贴腰侧防晃。",
      "description": "托盆肘贴腰防晃。",
      "id": "lx.daily-move.b0001.0047",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方拖着沉箱，一步一顿在地面留下浅痕。",
      "description": "拖沉箱留浅痕。",
      "id": "lx.daily-move.b0001.0048",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把长竿竖扛，转弯时先抬头看电线。",
      "description": "竖扛长竿转弯看线。",
      "id": "lx.daily-move.b0001.0049",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方用布带斜挎陶罐，手始终护在罐腹。",
      "description": "斜挎陶罐手护腹。",
      "id": "lx.daily-move.b0001.0050",
      "category": "daily-move"
    }
  ]
}
