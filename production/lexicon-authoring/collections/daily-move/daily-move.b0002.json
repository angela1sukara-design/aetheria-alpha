{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-move",
  "batchId": "daily-move.b0002",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "subcategory": "步行细节",
      "text": "对方绕开地上的刨花堆，鞋底不粘木屑进店。",
      "description": "绕刨花免粘屑进店。",
      "id": "lx.daily-move.b0002.0001",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在狭长的工具架间侧身走，肩不碰挂锉。",
      "description": "侧身架间肩不碰锉。",
      "id": "lx.daily-move.b0002.0002",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方踩着店内磨出的凹痕走路，步点几乎固定。",
      "description": "踩凹痕固定步点。",
      "id": "lx.daily-move.b0002.0003",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方把沾胶的鞋在门口垫上蹭净，才进洁净区。",
      "description": "蹭胶鞋进洁净区。",
      "id": "lx.daily-move.b0002.0004",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方搬着半成品小步挪，目光一直盯着未干漆面。",
      "description": "小步挪盯未干漆。",
      "id": "lx.daily-move.b0002.0005",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方跟在师傅身后学步距，师傅停他也停。",
      "description": "跟师傅学步距同停。",
      "id": "lx.daily-move.b0002.0006",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在昏灯下放慢脚，用脚尖探有没有散钉。",
      "description": "脚尖探散钉慢行。",
      "id": "lx.daily-move.b0002.0007",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方走过晾漆区时屏息，步子又轻又直。",
      "description": "晾漆区屏息轻直走。",
      "id": "lx.daily-move.b0002.0008",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方把围裙角掖好再走，免得扫到地上零件。",
      "description": "掖围裙角免扫零件。",
      "id": "lx.daily-move.b0002.0009",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在后巷运料时贴墙走，给对面推车留宽。",
      "description": "贴墙走让推车宽。",
      "id": "lx.daily-move.b0002.0010",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方踩梯取上层木料，一手扶梁一手递货。",
      "description": "踩梯取料扶梁递。",
      "id": "lx.daily-move.b0002.0011",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方攀上货架最高格，用膝卡住横档稳住。",
      "description": "攀货架膝卡横档。",
      "id": "lx.daily-move.b0002.0012",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方顺着屋梁爬到漏雨点，背上绑着油毡卷。",
      "description": "爬梁背油毡查漏。",
      "id": "lx.daily-move.b0002.0013",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方抓住吊钩攀到半空，检查悬挂的半成品。",
      "description": "抓吊钩攀检半成品。",
      "id": "lx.daily-move.b0002.0014",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方踩着叠起的废箱够到高处工具钩。",
      "description": "踩废箱够高钩。",
      "id": "lx.daily-move.b0002.0015",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方沿墙钉的踏脚石上到阁楼材料间。",
      "description": "踏脚石上阁楼材料间。",
      "id": "lx.daily-move.b0002.0016",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方倒挂查看桌底粘接，双手交替支撑。",
      "description": "倒挂查桌底粘接。",
      "id": "lx.daily-move.b0002.0017",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方攀住窗框探身到外墙，刮掉鼓起的腻子。",
      "description": "攀窗框刮外墙腻子。",
      "id": "lx.daily-move.b0002.0018",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方踩着锯木架攀到屋顶补瓦，绳系腰间。",
      "description": "踩锯架攀顶补瓦。",
      "id": "lx.daily-move.b0002.0019",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方双手抓梁、脚蹬柱，像猴子一样挪到对侧。",
      "description": "抓梁蹬柱挪对侧。",
      "id": "lx.daily-move.b0002.0020",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方在染缸旁的清水池里漂洗布，身体半浸。",
      "description": "清水池半浸漂布。",
      "id": "lx.daily-move.b0002.0021",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜到水槽底部捞落螺丝，手在浑水里摸索。",
      "description": "潜水槽摸捞螺丝。",
      "id": "lx.daily-move.b0002.0022",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方在泡木料的大池里趟行，水没到腰。",
      "description": "泡木池趟行水没腰。",
      "id": "lx.daily-move.b0002.0023",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方浮在冷却池表面，用脚搅散过热的水层。",
      "description": "浮冷却池搅散热层。",
      "id": "lx.daily-move.b0002.0024",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方侧游到池角，把沉底的刷子捞起来。",
      "description": "侧游捞沉底刷。",
      "id": "lx.daily-move.b0002.0025",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方在雨后积成的后院水潭里，试新做的木浮标。",
      "description": "水潭试木浮标游。",
      "id": "lx.daily-move.b0002.0026",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜泳穿过桥下暗渠，去取被冲走的木板。",
      "description": "潜泳暗渠取冲走板。",
      "id": "lx.daily-move.b0002.0027",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方仰漂在宽木盆里，检查盆缝是否渗水。",
      "description": "仰漂木盆检渗缝。",
      "id": "lx.daily-move.b0002.0028",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方手脚轻划靠近浮台，把工具递上岸。",
      "description": "轻划近浮台递工具。",
      "id": "lx.daily-move.b0002.0029",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜入染料沉淀池取样，瓶口始终朝上。",
      "description": "潜沉淀池取样瓶朝上。",
      "id": "lx.daily-move.b0002.0030",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着洒了锯末的地面，推着箱子滑行省力。",
      "description": "锯末地推箱滑行。",
      "id": "lx.daily-move.b0002.0031",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方坐在滑轮板上，在货架走廊滑到尽头取物。",
      "description": "坐滑轮板取物滑行。",
      "id": "lx.daily-move.b0002.0032",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方把打蜡地板当短滑道，脚下一溜到门口。",
      "description": "蜡地短溜到门口。",
      "id": "lx.daily-move.b0002.0033",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方用撬杠翘箱，箱底垫管滚动滑移。",
      "description": "撬箱垫管滚动滑移。",
      "id": "lx.daily-move.b0002.0034",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着倾斜的木料滑道，控制下料速度。",
      "description": "踏滑道控下料速。",
      "id": "lx.daily-move.b0002.0035",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方跪在抹布上，借惯性滑过刚拖完的长廊。",
      "description": "跪抹布滑长廊。",
      "id": "lx.daily-move.b0002.0036",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方把油布铺在坡道，让沉重的石臼缓慢下滑。",
      "description": "油布坡道滑石臼。",
      "id": "lx.daily-move.b0002.0037",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方侧身贴着光滑的金属柜门滑过狭窄缝。",
      "description": "贴柜门滑过窄缝。",
      "id": "lx.daily-move.b0002.0038",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩冰过的铁皮屋顶，小心滑向烟囱座。",
      "description": "冰铁皮顶滑向烟囱。",
      "id": "lx.daily-move.b0002.0039",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方坐麻袋从物料坡滑下，双脚先落地刹住。",
      "description": "坐袋滑坡脚刹。",
      "id": "lx.daily-move.b0002.0040",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方与学徒抬长木，步伐喊号一致过门槛。",
      "description": "抬长木喊号过门槛。",
      "id": "lx.daily-move.b0002.0041",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方背着工具卷，侧身挤过堆满零件的过道。",
      "description": "背工具卷挤零件道。",
      "id": "lx.daily-move.b0002.0042",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方抱着未干的漆柜，走极慢以免手印。",
      "description": "抱未干漆柜极慢走。",
      "id": "lx.daily-move.b0002.0043",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方用肩扛铁砧，另一手扶墙保持平衡。",
      "description": "肩扛铁砧扶墙平衡。",
      "id": "lx.daily-move.b0002.0044",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方推着装满砂纸的小车，过沟时两人抬轮。",
      "description": "推砂纸车过沟抬轮。",
      "id": "lx.daily-move.b0002.0045",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把玻璃夹在软垫间竖运，不让其弯曲。",
      "description": "软垫夹玻璃竖运。",
      "id": "lx.daily-move.b0002.0046",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方拖着沉木箱，在拐角垫圆木滚一下方向。",
      "description": "拖箱拐角垫木转向。",
      "id": "lx.daily-move.b0002.0047",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方头顶一摞竹匾，一手稳匾一手开门。",
      "description": "头顶竹匾一手开门。",
      "id": "lx.daily-move.b0002.0048",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把胶水桶提离身侧，防溅到衣与路过者。",
      "description": "提胶桶离身防溅。",
      "id": "lx.daily-move.b0002.0049",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方与人交接半成品时停步，等对方握稳再松手。",
      "description": "交半成品等握稳松。",
      "id": "lx.daily-move.b0002.0050",
      "category": "daily-move"
    }
  ]
}
