{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-move",
  "batchId": "daily-move.b0003",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "subcategory": "步行细节",
      "text": "对方踩着露出的石墩过浅渠，鞋底不沾渠泥。",
      "description": "踩石墩过渠鞋不沾泥。",
      "id": "lx.daily-move.b0003.0001",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在湿苔石阶上放慢，每一步都先试滑。",
      "description": "湿苔阶试滑慢行。",
      "id": "lx.daily-move.b0003.0002",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方挽起裤脚赤足走沙滩，趾缝挤出细沙。",
      "description": "赤足沙滩趾挤沙。",
      "id": "lx.daily-move.b0003.0003",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方沿着雨棚滴水线外侧走，肩头始终干着。",
      "description": "滴水线外走肩干。",
      "id": "lx.daily-move.b0003.0004",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在蕨丛窄径侧身行，手护着脸旁叶尖。",
      "description": "蕨径侧身手护叶尖。",
      "id": "lx.daily-move.b0003.0005",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方踩着浮在淤泥上的木板桥，一步一颤。",
      "description": "踩浮板桥一步一颤。",
      "id": "lx.daily-move.b0003.0006",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方逆着浅水流走，脚感水流方向校正路线。",
      "description": "逆浅流脚感校向。",
      "id": "lx.daily-move.b0003.0007",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方在雾气棚下小步走，伸手探前面的人影。",
      "description": "雾棚小步伸手探影。",
      "id": "lx.daily-move.b0003.0008",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方绕开刚铺的苔毯，走旁边未铺的石面。",
      "description": "绕苔毯走未铺石。",
      "id": "lx.daily-move.b0003.0009",
      "category": "daily-move"
    },
    {
      "subcategory": "步行细节",
      "text": "对方把重心放低走过晃动的跳板，上船不颠。",
      "description": "低重心过跳板上船。",
      "id": "lx.daily-move.b0003.0010",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方攀着湿藤上到岸壁平台，藤叶擦过脸颊。",
      "description": "攀湿藤上岸壁平台。",
      "id": "lx.daily-move.b0003.0011",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方手脚并用爬上倾斜的闸门架，去松卡住的绳。",
      "description": "爬闸门架松卡绳。",
      "id": "lx.daily-move.b0003.0012",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方抓住芦苇丛深处的撑杆，拔身出没顶的草。",
      "description": "抓撑杆拔身出芦苇。",
      "id": "lx.daily-move.b0003.0013",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方沿水磨石壁的凹坑上攀，避开滑苔最厚处。",
      "description": "凹坑攀壁避厚苔。",
      "id": "lx.daily-move.b0003.0014",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方攀上搁浅船的桅杆座，远眺水位线。",
      "description": "攀桅杆座远眺水位。",
      "id": "lx.daily-move.b0003.0015",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方踩着沉木桩露出的头，跃向更高的堤面。",
      "description": "踩沉桩头跃上堤。",
      "id": "lx.daily-move.b0003.0016",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方抓住雨棚骨架攀到檐口，理顺被风掀的布。",
      "description": "攀棚架理掀布。",
      "id": "lx.daily-move.b0003.0017",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方贴着湿岩横向挪，手指抠进水蚀的小洞。",
      "description": "贴湿岩抠水蚀洞横挪。",
      "id": "lx.daily-move.b0003.0018",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方爬上蕨坡，用膝和肘交替前进不伤嫩叶。",
      "description": "膝肘爬蕨坡护嫩叶。",
      "id": "lx.daily-move.b0003.0019",
      "category": "daily-move"
    },
    {
      "subcategory": "攀行意象",
      "text": "对方攀住系船桩翻上码头，水从衣角滴落。",
      "description": "攀系船桩翻上码头。",
      "id": "lx.daily-move.b0003.0020",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜入清澈渠段，睁眼辨认沉底的落叶图案。",
      "description": "潜清渠辨沉叶图案。",
      "id": "lx.daily-move.b0003.0021",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方侧泳穿过荷田空隙，荷叶擦过肩背。",
      "description": "侧泳穿荷田叶擦肩。",
      "id": "lx.daily-move.b0003.0022",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方浮在暖浅滩，脚尖点沙慢慢后退。",
      "description": "浮暖滩脚尖点沙退。",
      "id": "lx.daily-move.b0003.0023",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜到闸底查看淤堵，手电光在浑水里晃。",
      "description": "潜闸底手电查淤。",
      "id": "lx.daily-move.b0003.0024",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方仰泳顺着缓流漂，看头顶雨棚的轮廓移动。",
      "description": "仰泳顺漂看棚影移。",
      "id": "lx.daily-move.b0003.0025",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方用蛙泳贴近岸边，把漂走的草帽捞回。",
      "description": "蛙泳贴岸捞草帽。",
      "id": "lx.daily-move.b0003.0026",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方潜入温泉与冷渠交汇处，身体感受温差层。",
      "description": "潜温差层感冷暖。",
      "id": "lx.daily-move.b0003.0027",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方蜷身从半淹的圆管涵洞游过，到另一侧亮处。",
      "description": "蜷身游过半淹涵洞。",
      "id": "lx.daily-move.b0003.0028",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方脚蹼轻蹬跟随鱼群一段，再浮上换气。",
      "description": "脚蹼随鱼群再换气。",
      "id": "lx.daily-move.b0003.0029",
      "category": "daily-move"
    },
    {
      "subcategory": "游动",
      "text": "对方漂在夜色水面，只靠岸灯辨方向缓游回。",
      "description": "夜漂靠岸灯缓游回。",
      "id": "lx.daily-move.b0003.0030",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着长满青苔的石槽，滑雪似的滑到下水口。",
      "description": "苔石槽滑到下水口。",
      "id": "lx.daily-move.b0003.0031",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方坐在湿芭蕉叶上，从缓坡滑进浅水溅起浪。",
      "description": "坐蕉叶滑坡进浅水。",
      "id": "lx.daily-move.b0003.0032",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方赤脚在平滑的淤泥滩上滑行，留下长痕。",
      "description": "赤脚淤泥滩滑留痕。",
      "id": "lx.daily-move.b0003.0033",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方抓住藤条荡向对岸，落地时脚掌贴泥滑停。",
      "description": "荡藤落地贴泥滑停。",
      "id": "lx.daily-move.b0003.0034",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着倾斜的拦水板，侧滑到维修口。",
      "description": "踩拦水板侧滑维修口。",
      "id": "lx.daily-move.b0003.0035",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方趴在光滑的巨石上腹滑，滑入潭中一声轻响。",
      "description": "腹滑巨石入潭轻响。",
      "id": "lx.daily-move.b0003.0036",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方用竹筏借水流滑行，竹篙点岸微调方向。",
      "description": "竹筏借流篙点微调。",
      "id": "lx.daily-move.b0003.0037",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方踩着结冰薄壳的浅洼，小心滑向对岸干地。",
      "description": "薄冰洼小心滑向干地。",
      "id": "lx.daily-move.b0003.0038",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方坐木盆从引水槽滑下，双手抓沿控制。",
      "description": "坐盆滑引水槽抓沿。",
      "id": "lx.daily-move.b0003.0039",
      "category": "daily-move"
    },
    {
      "subcategory": "滑行",
      "text": "对方肩背贴湿岩壁下滑，脚先探到稳石才松手。",
      "description": "贴湿岩下滑脚探稳。",
      "id": "lx.daily-move.b0003.0040",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方挑着水桶过跳板，扁担随跳板颤而颤。",
      "description": "挑水过跳板随颤。",
      "id": "lx.daily-move.b0003.0041",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方抱着苔盆贴身走，肘护盆沿防叶折。",
      "description": "抱苔盆肘护防叶折。",
      "id": "lx.daily-move.b0003.0042",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方与人抬湿网，步伐踩在同一块浮板上。",
      "description": "抬湿网同踩浮板。",
      "id": "lx.daily-move.b0003.0043",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方背着芦苇捆侧身过窄堤，捆梢垂向水面。",
      "description": "背芦捆侧身过窄堤。",
      "id": "lx.daily-move.b0003.0044",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方推独轮车过泥路，车辙里积水溅起。",
      "description": "推独轮过泥溅积水。",
      "id": "lx.daily-move.b0003.0045",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方头顶鱼篓过桥，一手扶篓一手抓栏。",
      "description": "顶鱼篓过桥扶栏。",
      "id": "lx.daily-move.b0003.0046",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方拖着湿缆绳上岸，一步一顿把绳盘好。",
      "description": "拖湿缆上岸盘绳。",
      "id": "lx.daily-move.b0003.0047",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方抬土砖走雨棚下，砖上盖叶防滴湿。",
      "description": "抬土砖盖叶防滴湿。",
      "id": "lx.daily-move.b0003.0048",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方用肩扛船桨，桨叶朝后免得刮到人前。",
      "description": "扛桨叶朝后免刮人。",
      "id": "lx.daily-move.b0003.0049",
      "category": "daily-move"
    },
    {
      "subcategory": "搬运途中",
      "text": "对方把水样箱抱在胸前，过晃板时蹲低重心。",
      "description": "抱水样箱晃板蹲低。",
      "id": "lx.daily-move.b0003.0050",
      "category": "daily-move"
    }
  ]
}
