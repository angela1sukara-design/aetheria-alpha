{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-talk",
  "batchId": "daily-talk.b0003",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "subcategory": "倾听",
      "text": "对方在雨声里把耳朵凑近，才听清棚下的低语。",
      "description": "雨中凑近听棚下低语。",
      "id": "lx.daily-talk.b0003.0001",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方停下撑篙，侧耳听对岸喊的水位变化。",
      "description": "停篙听对岸喊水位。",
      "id": "lx.daily-talk.b0003.0002",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方蹲在苔石旁，听同伴讲哪一段渠该清。",
      "description": "蹲苔石听哪段该清。",
      "id": "lx.daily-talk.b0003.0003",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方把蓑衣帽檐抬起，露出眼睛认真听完。",
      "description": "抬蓑檐露眼听完。",
      "id": "lx.daily-talk.b0003.0004",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方在滴水节奏里点头，表示听懂了换班要点。",
      "description": "滴水中点头示听懂。",
      "id": "lx.daily-talk.b0003.0005",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方关掉柴油机，专听远处关于闸门的呼叫。",
      "description": "关柴油机听闸门呼叫。",
      "id": "lx.daily-talk.b0003.0006",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方把湿发拨开耳际，方便听清细小的叮嘱。",
      "description": "拨湿发听清叮嘱。",
      "id": "lx.daily-talk.b0003.0007",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方坐在船舷听老人讲旧航道，不插一句。",
      "description": "坐船舷听旧航道不插。",
      "id": "lx.daily-talk.b0003.0008",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方把竹筒茶放下，双手接过对方递来的水样说明。",
      "description": "放茶接听水样说明。",
      "id": "lx.daily-talk.b0003.0009",
      "category": "daily-talk"
    },
    {
      "subcategory": "倾听",
      "text": "对方在风里侧过身，用身体挡风听完短报。",
      "description": "侧身挡风听短报。",
      "id": "lx.daily-talk.b0003.0010",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方把水位争执岔到“今晚雨大不大”。",
      "description": "水位争执岔到雨势。",
      "id": "lx.daily-talk.b0003.0011",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方举起一把新采的蕨，把抱怨引到野菜做法。",
      "description": "举蕨引到野菜做法。",
      "id": "lx.daily-talk.b0003.0012",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方问对岸灯为何亮着，把沉默的船舱聊开。",
      "description": "问对岸灯聊开船舱。",
      "id": "lx.daily-talk.b0003.0013",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方把清淤进度搁下，转聊谁家棚漏该补。",
      "description": "搁清淤转聊棚漏。",
      "id": "lx.daily-talk.b0003.0014",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方把湿地图折起，提议先喝一口再谈路线。",
      "description": "折图提议喝一口再谈。",
      "id": "lx.daily-talk.b0003.0015",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方提起昨夜蛙鸣，把紧张巡查聊松一点。",
      "description": "提蛙鸣松紧张巡查。",
      "id": "lx.daily-talk.b0003.0016",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方把责任推诿截住，改问工具够不够用。",
      "description": "截推诿改问工具够否。",
      "id": "lx.daily-talk.b0003.0017",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方指着漂来的荷叶，把话题拐到今天的菜。",
      "description": "指荷叶拐到今日菜。",
      "id": "lx.daily-talk.b0003.0018",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方说“水的事回头说”，先问大家饿不饿。",
      "description": "水事回头先问饿否。",
      "id": "lx.daily-talk.b0003.0019",
      "category": "daily-talk"
    },
    {
      "subcategory": "轮换话题",
      "text": "对方把值班表翻到明日，把今夜争执留到天亮。",
      "description": "翻明日表留争到天亮。",
      "id": "lx.daily-talk.b0003.0020",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方复述：“闸降两格，不是升？”等对方点头。",
      "description": "复述闸降两格确认。",
      "id": "lx.daily-talk.b0003.0021",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方用手比水深到膝，问是不是这个深度。",
      "description": "比膝深确认水深。",
      "id": "lx.daily-talk.b0003.0022",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方把集合点画在湿沙上，问大家认不认这一笔。",
      "description": "湿沙画集合点确认。",
      "id": "lx.daily-talk.b0003.0023",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方慢念船号，等对岸用同样节奏回答。",
      "description": "慢念船号等对岸答。",
      "id": "lx.daily-talk.b0003.0024",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方把“午后移苔”写在木牌，举起来给棚内看。",
      "description": "木牌写移苔举看。",
      "id": "lx.daily-talk.b0003.0025",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方指着漏点问：“是东角还是西角在滴？”",
      "description": "指漏点确认东西角。",
      "id": "lx.daily-talk.b0003.0026",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方把人数再数一遍报出，请领队核对。",
      "description": "数人数报出请核对。",
      "id": "lx.daily-talk.b0003.0027",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方用绳结表示“危险勿近”，问大家是否明白。",
      "description": "绳结示危险确认明白。",
      "id": "lx.daily-talk.b0003.0028",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方把取水时段再说一遍，写在公共板上。",
      "description": "取水时段写板确认。",
      "id": "lx.daily-talk.b0003.0029",
      "category": "daily-talk"
    },
    {
      "subcategory": "确认意思",
      "text": "对方把“左岸先行”用手势比出，等回应再动。",
      "description": "手势左岸先行等回应。",
      "id": "lx.daily-talk.b0003.0030",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方比划水流打旋的样子，找词说“有回灌”。",
      "description": "比打旋找词回灌。",
      "id": "lx.daily-talk.b0003.0031",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方说“那种……滑得站不住的苔”，努力形容。",
      "description": "滑得站不住形容苔。",
      "id": "lx.daily-talk.b0003.0032",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方用“像煮粥起泡”描述闸下翻涌，自己也笑。",
      "description": "煮粥起泡喻闸下翻涌。",
      "id": "lx.daily-talk.b0003.0033",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方把方言里的渠名说出口，再补通用称呼。",
      "description": "方言渠名补通用称。",
      "id": "lx.daily-talk.b0003.0034",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方停顿时拧着蓑衣角，终于说出“需要增援”。",
      "description": "拧蓑角说出需增援。",
      "id": "lx.daily-talk.b0003.0035",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方用手量空气湿度，嘴里找“闷”还是“潮”。",
      "description": "量湿度寻闷或潮。",
      "id": "lx.daily-talk.b0003.0036",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方把“船要沉”改口成“吃水有点深了”。",
      "description": "船要沉改口吃水深。",
      "id": "lx.daily-talk.b0003.0037",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方借荷叶的弧度比喻想修的棚顶弧。",
      "description": "借荷叶弧喻棚顶弧。",
      "id": "lx.daily-talk.b0003.0038",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方先说“那边”，又补方位词把地点说清。",
      "description": "那边再补方位说清。",
      "id": "lx.daily-talk.b0003.0039",
      "category": "daily-talk"
    },
    {
      "subcategory": "寻找措辞",
      "text": "对方用脚趾在泥里画箭头，替说不清的方向。",
      "description": "泥里画箭头替方向。",
      "id": "lx.daily-talk.b0003.0040",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方把蓑衣披上：“我去下一段。”转身收话。",
      "description": "披蓑去下段收话。",
      "id": "lx.daily-talk.b0003.0041",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方敲了敲空桶，示意水分完了，闲聊可止。",
      "description": "敲空桶示水分完止聊。",
      "id": "lx.daily-talk.b0003.0042",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方说“潮要涨了”，解开缆绳准备离岸。",
      "description": "潮涨解缆准备离岸。",
      "id": "lx.daily-talk.b0003.0043",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方把灯笼递给下一班，口头交接随灯交走。",
      "description": "递灯笼交接随灯走。",
      "id": "lx.daily-talk.b0003.0044",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方点头收伞进棚，雨声替他结束了门外谈。",
      "description": "收伞进棚雨声收谈。",
      "id": "lx.daily-talk.b0003.0045",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方把巡查牌翻面挂上，表示本轮对话结束。",
      "description": "翻巡查牌结束对话。",
      "id": "lx.daily-talk.b0003.0046",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方挥手让船先走，岸上的叮嘱不再加长。",
      "description": "挥手让船走叮嘱止。",
      "id": "lx.daily-talk.b0003.0047",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方说“明早渠边见”，把夜话干净收住。",
      "description": "明早渠边见收夜话。",
      "id": "lx.daily-talk.b0003.0048",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方把湿地图卷起塞进怀里，路线谈完收场。",
      "description": "卷湿地图路线谈完。",
      "id": "lx.daily-talk.b0003.0049",
      "category": "daily-talk"
    },
    {
      "subcategory": "结束话题",
      "text": "对方吹灭身边小灯，黑暗里只余水声，话止。",
      "description": "吹灯余水声话止。",
      "id": "lx.daily-talk.b0003.0050",
      "category": "daily-talk"
    }
  ]
}
