  "batchId": "daily-life.b0001",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.daily-life.b0001.0001",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用湿布绕着门把手转圈擦，再换成干布抿干水迹。",
      "description": "擦拭门把手的干湿两步。"
    },
    {
      "id": "lx.daily-life.b0001.0002",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把灶台缝里的渣用竹签挑出，拢进一撮纸里。",
      "description": "挑灶缝渣并收纸。"
    },
    {
      "id": "lx.daily-life.b0001.0003",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方涮拖把时换了两桶水，第二桶清许多才上地。",
      "description": "换水涮拖把。"
    },
    {
      "id": "lx.daily-life.b0001.0004",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把窗框凹槽里的灰用旧牙刷刷出，弹进簸箕。",
      "description": "刷窗框凹槽灰。"
    },
    {
      "id": "lx.daily-life.b0001.0005",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方拧干抹布后对折，专擦桌沿一圈油膜。",
      "description": "对折抹布专擦桌沿。"
    },
    {
      "id": "lx.daily-life.b0001.0006",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把鞋垫抽出晾在通风处，鞋壳另用布擦内壁。",
      "description": "抽垫晾晒并擦鞋壳。"
    },
    {
      "id": "lx.daily-life.b0001.0007",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方扫完地先用脚把扫帚刮净，再挂回钉上。",
      "description": "刮净扫帚后挂起。"
    },
    {
      "id": "lx.daily-life.b0001.0008",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把水槽滤网抠出，冲掉菜叶再卡回原位。",
      "description": "清滤网菜叶。"
    },
    {
      "id": "lx.daily-life.b0001.0009",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用旧报纸揉成团，擦玻璃至不留绒毛。",
      "description": "报纸团擦玻璃。"
    },
    {
      "id": "lx.daily-life.b0001.0010",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把垃圾桶内袋提起时用手捂口，防溅到沿。",
      "description": "提垃圾袋捂口防溅。"
    },
    {
      "id": "lx.daily-life.b0001.0011",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把松动的椅脚楔进薄木片，轻敲到位。",
      "description": "楔木片修松椅脚。"
    },
    {
      "id": "lx.daily-life.b0001.0012",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方用针线把围裙带重新缝牢，打结藏在内侧。",
      "description": "缝围裙带藏结。"
    },
    {
      "id": "lx.daily-life.b0001.0013",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方给漏水的壶嘴缠上止水胶带，再试倒半杯。",
      "description": "缠胶带试倒检漏。"
    },
    {
      "id": "lx.daily-life.b0001.0014",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把断了的扫把柄接上套管，钉两枚小钉固定。",
      "description": "套管钉接扫把柄。"
    },
    {
      "id": "lx.daily-life.b0001.0015",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方用胶水粘回纽扣，压住等干才松手。",
      "description": "粘纽扣按压待干。"
    },
    {
      "id": "lx.daily-life.b0001.0016",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把窗纱破洞用同色线织补，边缘修剪齐。",
      "description": "织补窗纱破洞。"
    },
    {
      "id": "lx.daily-life.b0001.0017",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方给抽屉滑轨点一滴油，来回推几次听声。",
      "description": "滑轨点油试推。"
    },
    {
      "id": "lx.daily-life.b0001.0018",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把鞋底开胶处擦净，涂胶夹住过夜。",
      "description": "鞋底开胶涂夹。"
    },
    {
      "id": "lx.daily-life.b0001.0019",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方用砂纸轻磨木勺毛刺，再抹一层薄油。",
      "description": "磨勺刺并抹油。"
    },
    {
      "id": "lx.daily-life.b0001.0020",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把松了的锅盖钮旋紧，垫片换了新的。",
      "description": "旋紧锅盖钮换垫。"
    },
    {
      "id": "lx.daily-life.b0001.0021",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把季节衣物卷成筒，竖放入箱节省空隙。",
      "description": "卷筒竖放衣物。"
    },
    {
      "id": "lx.daily-life.b0001.0022",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方用旧罐分装螺丝，盖上写清长短。",
      "description": "分罐螺丝并标长短。"
    },
    {
      "id": "lx.daily-life.b0001.0023",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把电线绕成圈用布条系住，挂在门后钩。",
      "description": "绕线系布挂钩。"
    },
    {
      "id": "lx.daily-life.b0001.0024",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把药按早中晚分三格，格盖透明可瞥见。",
      "description": "分格收纳药品。"
    },
    {
      "id": "lx.daily-life.b0001.0025",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把围巾按颜色叠好，深色在下浅色在上。",
      "description": "按色深浅叠围巾。"
    },
    {
      "id": "lx.daily-life.b0001.0026",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把垃圾袋套两层，外层写投放日方便记。",
      "description": "双层袋并标投放日。"
    },
    {
      "id": "lx.daily-life.b0001.0027",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把常用勺筷放在最外格，客用的收进里格。",
      "description": "常用餐具外格收纳。"
    },
    {
      "id": "lx.daily-life.b0001.0028",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把说明书折成原样，塞回电器原盒夹层。",
      "description": "说明书折回原盒。"
    },
    {
      "id": "lx.daily-life.b0001.0029",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把鞋盒盖侧开小窗，取出时不必整摞搬。",
      "description": "鞋盒侧窗取物。"
    },
    {
      "id": "lx.daily-life.b0001.0030",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把钥匙按用途分两环，出门环与备用环分开。",
      "description": "钥匙分环收纳。"
    },
    {
      "id": "lx.daily-life.b0001.0031",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把缺货写在门背小黑板，出门前再看一眼。",
      "description": "门背黑板列缺货。"
    },
    {
      "id": "lx.daily-life.b0001.0032",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方掂了掂菜篮，确认还能加两捆青菜的空位。",
      "description": "掂篮估剩余空位。"
    },
    {
      "id": "lx.daily-life.b0001.0033",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把旧瓶洗净带回，准备装散装酱料。",
      "description": "洗净旧瓶备散装。"
    },
    {
      "id": "lx.daily-life.b0001.0034",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把布袋叠进外衣袋，省得店里再要纸袋。",
      "description": "布袋叠进衣袋。"
    },
    {
      "id": "lx.daily-life.b0001.0035",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方核对库存盐罐，剩两指高就列入清单。",
      "description": "看盐罐决定是否购。"
    },
    {
      "id": "lx.daily-life.b0001.0036",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把找零小盒清空，硬币按面值分格。",
      "description": "清找零盒分面值。"
    },
    {
      "id": "lx.daily-life.b0001.0037",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方看了看天色，雨伞与清单一起搁在门口。",
      "description": "伞与清单同置门口。"
    },
    {
      "id": "lx.daily-life.b0001.0038",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把保温壶灌半满热水，路上喝也能暖手。",
      "description": "灌半壶备路上暖。"
    },
    {
      "id": "lx.daily-life.b0001.0039",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把市场开放时段抄到纸条，夹在钱夹里。",
      "description": "抄时段夹钱夹。"
    },
    {
      "id": "lx.daily-life.b0001.0040",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方试了试推车轮，卡住的一只先上油。",
      "description": "试推车轮并上油。"
    },
    {
      "id": "lx.daily-life.b0001.0041",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用温水浸湿毛巾，按在颈后揉了几圈。",
      "description": "温毛巾揉颈后。"
    },
    {
      "id": "lx.daily-life.b0001.0042",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方把指甲剪到与指腹齐，锉掉锐利边角。",
      "description": "剪指甲并锉边。"
    },
    {
      "id": "lx.daily-life.b0001.0043",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方梳开打结的发丝，断发拢进纸再丢。",
      "description": "梳结发并收断发。"
    },
    {
      "id": "lx.daily-life.b0001.0044",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方换上干净袜，旧袜翻面晾在通风钩。",
      "description": "换袜并翻面晾旧。"
    },
    {
      "id": "lx.daily-life.b0001.0045",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方滴眼药水前洗手，仰头后闭目片刻。",
      "description": "滴眼前洗手闭目。"
    },
    {
      "id": "lx.daily-life.b0001.0046",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用软刷清牙缝，再漱口至水色变清。",
      "description": "清牙缝并漱清。"
    },
    {
      "id": "lx.daily-life.b0001.0047",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方把护手霜揉开再涂，指缝也抹到。",
      "description": "护手霜揉开涂指缝。"
    },
    {
      "id": "lx.daily-life.b0001.0048",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方检查脚底是否起茧，用浮石轻磨一处。",
      "description": "浮石轻磨脚茧。"
    },
    {
      "id": "lx.daily-life.b0001.0049",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方把口罩绳调到不勒耳的位置再戴上。",
      "description": "调口罩绳松紧。"
    },
    {
      "id": "lx.daily-life.b0001.0050",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方睡前把发绳松开，发丝散开枕上。",
      "description": "睡前松发绳。"
    }
  ]
}
