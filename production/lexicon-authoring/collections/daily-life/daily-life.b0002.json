  "library": "daily-life",
  "batchId": "daily-life.b0002",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.daily-life.b0002.0001",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用毛刷清扫工作台缝，把木屑扫进铁簸箕。",
      "description": "刷台缝收木屑。"
    },
    {
      "id": "lx.daily-life.b0002.0002",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把沾胶的抹布单独泡溶剂盆，不混入洗衣。",
      "description": "沾胶布单泡溶剂。"
    },
    {
      "id": "lx.daily-life.b0002.0003",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方擦拭量爪后涂薄油，以防过夜生锈。",
      "description": "擦量爪并涂防锈油。"
    },
    {
      "id": "lx.daily-life.b0002.0004",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把砂轮罩内积粉掏出，倒进可燃废桶。",
      "description": "掏砂轮罩积粉。"
    },
    {
      "id": "lx.daily-life.b0002.0005",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用湿海绵压吸油漆滴，再干布抿边。",
      "description": "海绵吸漆滴干抿。"
    },
    {
      "id": "lx.daily-life.b0002.0006",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方刷净锉齿槽，用铁丝通开堵塞的齿谷。",
      "description": "通锉齿堵塞。"
    },
    {
      "id": "lx.daily-life.b0002.0007",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把地板上的铁屑用磁吸棒吸起再弹入盒。",
      "description": "磁吸铁屑入盒。"
    },
    {
      "id": "lx.daily-life.b0002.0008",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方清洗胶水嘴，用细针挑开凝固孔。",
      "description": "清胶嘴挑凝固孔。"
    },
    {
      "id": "lx.daily-life.b0002.0009",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把护目镜两面哈气擦净，挂回干净钩。",
      "description": "擦护目镜挂回。"
    },
    {
      "id": "lx.daily-life.b0002.0010",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方收工扫一圈，把掉落的螺丝按尺寸归格。",
      "description": "扫落螺丝归格。"
    },
    {
      "id": "lx.daily-life.b0002.0011",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把椅背松榫重新涂胶，用带捆紧候干。",
      "description": "松榫涂胶捆候。"
    },
    {
      "id": "lx.daily-life.b0002.0012",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方用同色线补围裙破洞，针脚尽量藏进折边。",
      "description": "补洞藏针脚折边。"
    },
    {
      "id": "lx.daily-life.b0002.0013",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方给锤柄裂口灌入木胶，楔子钉紧。",
      "description": "锤柄裂口灌胶楔紧。"
    },
    {
      "id": "lx.daily-life.b0002.0014",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方更换台钳磨损垫片，试夹软木不留印。",
      "description": "换钳垫试夹软木。"
    },
    {
      "id": "lx.daily-life.b0002.0015",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把灯罩卡扣掰回原位，听咔哒一声到位。",
      "description": "掰回灯罩卡扣。"
    },
    {
      "id": "lx.daily-life.b0002.0016",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方用铜丝绑牢松脱的刷毛，再修齐锋口。",
      "description": "铜丝绑刷毛修锋。"
    },
    {
      "id": "lx.daily-life.b0002.0017",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把抽屉底板钉回，角落加小角铁加固。",
      "description": "钉底板加角铁。"
    },
    {
      "id": "lx.daily-life.b0002.0018",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方磨平凿刃崩口，油石上走八字。",
      "description": "油石磨凿刃崩口。"
    },
    {
      "id": "lx.daily-life.b0002.0019",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方给砂纸托板换新夹，旧砂纸边还能用。",
      "description": "换托板夹续用砂纸。"
    },
    {
      "id": "lx.daily-life.b0002.0020",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方重绕松了的卷尺弹簧，试拉回弹是否有力。",
      "description": "重绕卷尺弹簧试弹。"
    },
    {
      "id": "lx.daily-life.b0002.0021",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把钻头按直径插入泡沫板，孔径写号。",
      "description": "泡沫板收纳钻头。"
    },
    {
      "id": "lx.daily-life.b0002.0022",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把色线绕在纸板上，板端写色名。",
      "description": "纸板绕线标色名。"
    },
    {
      "id": "lx.daily-life.b0002.0023",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把半用油漆罐盖严，外沿擦净写开封日。",
      "description": "封漆罐标开封日。"
    },
    {
      "id": "lx.daily-life.b0002.0024",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把废钉与好钉分两罐，废罐标红叉。",
      "description": "好坏钉分罐标示。"
    },
    {
      "id": "lx.daily-life.b0002.0025",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把图纸卷筒立放，筒口塞防尘布。",
      "description": "立放图纸筒塞布。"
    },
    {
      "id": "lx.daily-life.b0002.0026",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把常用扳手挂磁条，少用的进抽屉。",
      "description": "磁条挂常用扳手。"
    },
    {
      "id": "lx.daily-life.b0002.0027",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把砂纸按目数分袋，袋外用大字标记。",
      "description": "分袋砂纸标目数。"
    },
    {
      "id": "lx.daily-life.b0002.0028",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把客户联单按月夹，夹脊写年月。",
      "description": "联单按月夹收纳。"
    },
    {
      "id": "lx.daily-life.b0002.0029",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把小弹簧装透明格，格盖可贴尺寸条。",
      "description": "透明格收纳弹簧。"
    },
    {
      "id": "lx.daily-life.b0002.0030",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把防护手套按干湿分开晾，干的叠进盒。",
      "description": "干湿手套分晾收。"
    },
    {
      "id": "lx.daily-life.b0002.0031",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把缺的砂纸目数写进工单备注栏。",
      "description": "工单备注缺砂纸。"
    },
    {
      "id": "lx.daily-life.b0002.0032",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方掂空漆罐，确认该补哪几个色号。",
      "description": "掂罐确认补色号。"
    },
    {
      "id": "lx.daily-life.b0002.0033",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把旧钻头磨损严重的挑出，列替换清单。",
      "description": "挑旧钻头列替换。"
    },
    {
      "id": "lx.daily-life.b0002.0034",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把布袋装好空瓶，准备去店里换散装溶剂。",
      "description": "空瓶入袋备换溶剂。"
    },
    {
      "id": "lx.daily-life.b0002.0035",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方核对卡尺电池仓，电量低则列入采购。",
      "description": "查卡尺电列入购。"
    },
    {
      "id": "lx.daily-life.b0002.0036",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把找给客户的零钱盒补足小数额。",
      "description": "补足找零小数额。"
    },
    {
      "id": "lx.daily-life.b0002.0037",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方看交货日，提前一天列包装纸与绳需求。",
      "description": "按交货日列包材。"
    },
    {
      "id": "lx.daily-life.b0002.0038",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把样品袋编号，准备带到材料市场对色。",
      "description": "编号样品袋备对色。"
    },
    {
      "id": "lx.daily-life.b0002.0039",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方抄下五金店歇业日，避免空跑。",
      "description": "抄歇业日防空跑。"
    },
    {
      "id": "lx.daily-life.b0002.0040",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方试推载料小车，轴响则先加油再出门。",
      "description": "试车轴并加油。"
    },
    {
      "id": "lx.daily-life.b0002.0041",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方收工先洗掉甲缝漆渍，再涂护手霜。",
      "description": "洗甲缝漆后护手。"
    },
    {
      "id": "lx.daily-life.b0002.0042",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用盐水漱口去掉溶剂余味，再喝水。",
      "description": "盐水漱去溶剂味。"
    },
    {
      "id": "lx.daily-life.b0002.0043",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方把护目勒痕处按摩几下，再摘镜休息。",
      "description": "按摩护目勒痕。"
    },
    {
      "id": "lx.daily-life.b0002.0044",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方换下沾木屑的工袜，脚浸温水片刻。",
      "description": "换工袜浸足温水。"
    },
    {
      "id": "lx.daily-life.b0002.0045",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方清理鼻腔粉尘后，到通风处深呼吸几次。",
      "description": "清鼻后通风呼吸。"
    },
    {
      "id": "lx.daily-life.b0002.0046",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方修剪被木刺扎过的指甲缘，消毒棉轻按。",
      "description": "修甲缘并消毒按。"
    },
    {
      "id": "lx.daily-life.b0002.0047",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方把腰带松一扣，蹲久后站直缓一缓。",
      "description": "松腰带站直缓身。"
    },
    {
      "id": "lx.daily-life.b0002.0048",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用湿巾擦后颈汗盐，再把衣领翻下。",
      "description": "擦后颈汗翻领。"
    },
    {
      "id": "lx.daily-life.b0002.0049",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方检查耳塞是否变形，变形的丢弃换新。",
      "description": "查耳塞形换新。"
    },
    {
      "id": "lx.daily-life.b0002.0050",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方睡前把指关节轻轻活动，不强迫弹响。",
      "description": "睡前轻活指关节。"
    }
  ]
