{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-life",
  "batchId": "daily-life.b0004",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.daily-life.b0004.0001",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用干帚扫石阶沙尘，沙扫到阶侧槽里。",
      "description": "扫阶沙入侧槽。"
    },
    {
      "id": "lx.daily-life.b0004.0002",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把遮阳布抖掉沙，挂高处用棍拍净。",
      "description": "抖拍遮阳布沙。"
    },
    {
      "id": "lx.daily-life.b0004.0003",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方擦拭水囊嘴，再用开水烫一下沥干。",
      "description": "擦烫水囊嘴沥干。"
    },
    {
      "id": "lx.daily-life.b0004.0004",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把帐篷底沙扫出门口，不扫向主路。",
      "description": "扫帐底沙避主路。"
    },
    {
      "id": "lx.daily-life.b0004.0005",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用湿布擦陶罐肩尘，干布随即抿干。",
      "description": "湿干布擦罐肩。"
    },
    {
      "id": "lx.daily-life.b0004.0006",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方清扫布帘褶里的沙，褶逐条抖开。",
      "description": "逐褶抖帘内沙。"
    },
    {
      "id": "lx.daily-life.b0004.0007",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把靴底纹里的碎石抠出，敲靴跟震净。",
      "description": "抠靴纹敲跟净石。"
    },
    {
      "id": "lx.daily-life.b0004.0008",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方冲洗过滤布至水色清，荫处晾不暴晒。",
      "description": "冲过滤布荫晾。"
    },
    {
      "id": "lx.daily-life.b0004.0009",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用软刷清指南针玻璃缝灰，盖回防尘。",
      "description": "刷针镜缝盖防尘。"
    },
    {
      "id": "lx.daily-life.b0004.0010",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把驮架缝隙沙吹出，再用布擦木面。",
      "description": "吹架缝沙擦木面。"
    },
    {
      "id": "lx.daily-life.b0004.0011",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把帐篷漏光缝贴补丁布，针脚密绕破口。",
      "description": "帐缝贴补密绕针。"
    },
    {
      "id": "lx.daily-life.b0004.0012",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方用皮条重勒松脱的驮架结，勒紧打双结。",
      "description": "皮条重勒驮架结。"
    },
    {
      "id": "lx.daily-life.b0004.0013",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方给手杖裂柄缠麻后刷漆，候干试承重。",
      "description": "麻缠杖柄刷漆试。"
    },
    {
      "id": "lx.daily-life.b0004.0014",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方更换磨断的帽绳，新绳浸蜡防磨。",
      "description": "换帽绳浸蜡。"
    },
    {
      "id": "lx.daily-life.b0004.0015",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把水囊微漏处涂止水膏，夹住候干。",
      "description": "水囊漏涂膏夹候。"
    },
    {
      "id": "lx.daily-life.b0004.0016",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方缝睡垫开线，内侧垫布条加固。",
      "description": "缝睡垫垫布加固。"
    },
    {
      "id": "lx.daily-life.b0004.0017",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方钉回松动的石阶踏面，缝填防滑砂。",
      "description": "钉踏面填防滑砂。"
    },
    {
      "id": "lx.daily-life.b0004.0018",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方重编草鞋断耳，草茎浸湿再编。",
      "description": "浸草茎重编鞋耳。"
    },
    {
      "id": "lx.daily-life.b0004.0019",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方给遮阳臂裂口楔薄木，胶干后磨平。",
      "description": "臂裂楔木胶磨平。"
    },
    {
      "id": "lx.daily-life.b0004.0020",
      "category": "daily-life",
      "subcategory": "修补",
      "text": "对方把旗绳断处对接，结移到不受力段。",
      "description": "旗绳对接结移位。"
    },
    {
      "id": "lx.daily-life.b0004.0021",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把地图按区域折好，常用区折在外层。",
      "description": "地图分区折外常用。"
    },
    {
      "id": "lx.daily-life.b0004.0022",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方用布袋分装粗细盐，袋口写用途结。",
      "description": "布袋分盐标用途。"
    },
    {
      "id": "lx.daily-life.b0004.0023",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把绳按长度挂不同钉，长绳挂高钉。",
      "description": "按长分钉挂绳。"
    },
    {
      "id": "lx.daily-life.b0004.0024",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把干粮罐离地架起，罐间留通风缝。",
      "description": "干粮罐架高留缝。"
    },
    {
      "id": "lx.daily-life.b0004.0025",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把手杖靠墙有序，短杖靠门应急。",
      "description": "手杖靠墙短靠门。"
    },
    {
      "id": "lx.daily-life.b0004.0026",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把湿纱巾挂通风篷杆，下垫接沙布。",
      "description": "湿纱挂杆垫接沙。"
    },
    {
      "id": "lx.daily-life.b0004.0027",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把灯油与火柴分匣，匣外标满空与潮。",
      "description": "匣标满空防潮。"
    },
    {
      "id": "lx.daily-life.b0004.0028",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把靴子倒扣架上，筒内塞纸定型。",
      "description": "靴倒扣塞纸定型。"
    },
    {
      "id": "lx.daily-life.b0004.0029",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把滤芯按新旧套叠，旧的标日期。",
      "description": "滤芯套叠标日期。"
    },
    {
      "id": "lx.daily-life.b0004.0030",
      "category": "daily-life",
      "subcategory": "收纳",
      "text": "对方把迁居清单与铅笔同夹板，挂帐门内侧。",
      "description": "清单笔夹挂帐门。"
    },
    {
      "id": "lx.daily-life.b0004.0031",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把缺的蜡绳色写在帽檐内侧条。",
      "description": "帽檐条记蜡绳色。"
    },
    {
      "id": "lx.daily-life.b0004.0032",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方掂盐罐，结块潮解则列入换购。",
      "description": "盐潮解列入换购。"
    },
    {
      "id": "lx.daily-life.b0004.0033",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把空油壶洗净，准备去驿站打灯油。",
      "description": "洗油壶备驿站打油。"
    },
    {
      "id": "lx.daily-life.b0004.0034",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把布袋装好空瓶，散装酱料更轻便。",
      "description": "空瓶入袋备散装。"
    },
    {
      "id": "lx.daily-life.b0004.0035",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方核对水净化片余量，低于三日用量则购。",
      "description": "查净化片三日量。"
    },
    {
      "id": "lx.daily-life.b0004.0036",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把集市开放日抄防水片，夹进钱夹。",
      "description": "抄集市日夹钱夹。"
    },
    {
      "id": "lx.daily-life.b0004.0037",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方看风向，背风日列晾晒与采购同办。",
      "description": "背风日并办晾购。"
    },
    {
      "id": "lx.daily-life.b0004.0038",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方试驮架平衡空载，响处先紧螺栓。",
      "description": "试空载紧响螺栓。"
    },
    {
      "id": "lx.daily-life.b0004.0039",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方把他人托买项另列，旁注交还地点。",
      "description": "托买另列注交还地。"
    },
    {
      "id": "lx.daily-life.b0004.0040",
      "category": "daily-life",
      "subcategory": "购物准备",
      "text": "对方灌半壶水，排队荫下也能润喉。",
      "description": "半壶水备排队润喉。"
    },
    {
      "id": "lx.daily-life.b0004.0041",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用温布敷被日晒发红的颈后，再荫歇。",
      "description": "温布敷晒颈荫歇。"
    },
    {
      "id": "lx.daily-life.b0004.0042",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方梳开被风沙粘的发，清水冲洗再扎。",
      "description": "冲沙发再扎起。"
    },
    {
      "id": "lx.daily-life.b0004.0043",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方把干裂指缘涂油脂，指缝也抹到。",
      "description": "干裂指涂油脂满缝。"
    },
    {
      "id": "lx.daily-life.b0004.0044",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方换下沙粒袜，脚缝用布擦净再穿干袜。",
      "description": "换沙袜擦缝穿干。"
    },
    {
      "id": "lx.daily-life.b0004.0045",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方仰头用清水洗眼，冲掉风沙微粒。",
      "description": "清水洗眼冲风沙。"
    },
    {
      "id": "lx.daily-life.b0004.0046",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方修剪被绳磨起的茧缘，浮石轻磨一处。",
      "description": "修茧缘浮石轻磨。"
    },
    {
      "id": "lx.daily-life.b0004.0047",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用温布敷背带勒痕，再调松一扣。",
      "description": "敷勒痕调松背带。"
    },
    {
      "id": "lx.daily-life.b0004.0048",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方检查唇裂处，涂薄层无香脂。",
      "description": "唇裂涂无香脂。"
    },
    {
      "id": "lx.daily-life.b0004.0049",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方睡前把沙尘外衣挂篷外，不进卧帐。",
      "description": "沙衣挂篷外。"
    },
    {
      "id": "lx.daily-life.b0004.0050",
      "category": "daily-life",
      "subcategory": "个人照料",
      "text": "对方用温水泡被寒浸的踝，再缓缓转踝。",
      "description": "温水泡踝转踝。"
    }
  ]
}
