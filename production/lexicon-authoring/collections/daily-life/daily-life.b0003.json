    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.daily-life.b0003.0001",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用竹片刮去雨棚布上的青苔，再用清水冲。",
      "description": "竹片刮苔并冲水。"
    },
    {
      "id": "lx.daily-life.b0003.0002",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把渠边石阶缝的淤泥掏出，甩进岸上泥堆。",
      "description": "掏阶缝淤泥。"
    },
    {
      "id": "lx.daily-life.b0003.0003",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方涮船舱时换仓外清水，脏水不回渠。",
      "description": "涮舱换清水不回渠。"
    },
    {
      "id": "lx.daily-life.b0003.0004",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把斗笠内圈汗碱用湿布擦，阴干不暴晒。",
      "description": "擦斗笠汗碱阴干。"
    },
    {
      "id": "lx.daily-life.b0003.0005",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用软刷清渔网孔藻，挂高处沥水。",
      "description": "刷网孔藻挂沥。"
    },
    {
      "id": "lx.daily-life.b0003.0006",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把水缸外壁青苔刮薄，留一层防裂不刮光。",
      "description": "刮缸苔留薄层。"
    },
    {
      "id": "lx.daily-life.b0003.0007",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方扫吊脚楼板缝落叶，用钩子勾出卡缝的枝。",
      "description": "扫楼缝勾卡枝。"
    },
    {
      "id": "lx.daily-life.b0003.0008",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方冲滤网至水色清，倒扣在雨棚干处。",
      "description": "冲滤网倒扣干处。"
    },
    {
      "id": "lx.daily-life.b0003.0009",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方用旧布擦栏杆潮痕，布分干湿两块轮换。",
      "description": "干湿布轮擦潮痕。"
    },
    {
      "id": "lx.daily-life.b0003.0010",
      "category": "daily-life",
      "subcategory": "清洁",
      "text": "对方把湿鞋塞报纸吸潮，报纸定时更换。",
      "description": "鞋塞报纸吸潮换纸。"
    },
    {
