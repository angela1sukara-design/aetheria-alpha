  "entries": [
    {
      "id": "lx.daily-social.b0001.0001",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "点头不喊名",
      "description": "路上遇见熟人只点头，不喊出名字以免惊扰旁人。",
      "examples": [
        "巷口对上眼，下巴轻轻一抬。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0002",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "先让路再问好",
      "description": "窄路相遇先侧身让过，过后才补一句短问候。",
      "examples": [
        "您先——早。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0003",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "提手中物致意",
      "description": "双手占满时用抬高物件代替挥手。",
      "examples": [
        "篮子举高一点当招呼。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0004",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "看天气开场",
      "description": "习惯用一句天气作招呼，不深问私事。",
      "examples": [
        "今儿风倒是软。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0005",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "摸帽檐示意",
      "description": "戴帽时习惯轻触帽檐代替鞠躬。",
      "examples": [
        "指尖点一下帽边就过。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0006",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "短停不等答",
      "description": "打招呼后继续走，不强迫对方停下回话。",
      "examples": [
        "嗨——人已经走过去了。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0007",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "对小孩蹲一点",
      "description": "对矮小的孩子打招呼会微微屈膝平视。",
      "examples": [
        "蹲半步，声也放轻。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0008",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "晚归轻声",
      "description": "夜里归来遇邻只低声，怕惊醒窗内。",
      "examples": [
        "夜安，门缝里的气音。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0009",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "雨天缩句",
      "description": "雨天招呼压成两三个字，省得对方撑伞久站。",
      "examples": [
        "快进——伞歪了。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0010",
      "category": "daily-social",
      "subcategory": "打招呼",
      "name": "隔窗手势",
      "description": "隔着玻璃见熟人，抬手画个小圈代替喊。",
      "examples": [
        "窗上哈气前先挥一下。"
      ]
    },
    {
      "id": "lx.daily-social.b0001.0011",
      "category": "daily-social",
      "subcategory": "待客",
      "name": "先递干布",
      "description": "客人进门湿手湿伞，先递干布再让座。",
      "examples": [
