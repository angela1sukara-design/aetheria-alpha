{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-observe",
  "batchId": "daily-observe.b0003",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.daily-observe.b0003.0001",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方蹲在渠边，近看水面漂着的苔丝是否结团。",
      "description": "近看水苔结团。"
    },
    {
      "id": "lx.daily-observe.b0003.0002",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把蕨叶翻到背面，查看孢子囊是否鼓起。",
      "description": "近看蕨叶背面孢子。"
    },
    {
      "id": "lx.daily-observe.b0003.0003",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方凑近雨棚接缝，看滴水是否总从同一处落下。",
      "description": "近看雨棚漏点。"
    },
    {
      "id": "lx.daily-observe.b0003.0004",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方捏起石阶缝里的青苔，观察根须沾着的泥色。",
      "description": "近看苔根泥色。"
    },
    {
      "id": "lx.daily-observe.b0003.0005",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把竹筒滤网举到眼前，看孔眼是否被藻膜堵住。",
      "description": "近看滤网藻膜。"
    },
    {
      "id": "lx.daily-observe.b0003.0006",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方俯身看木桥栏杆，辨认潮痕涨到第几道纹。",
      "description": "近看栏杆潮痕高度。"
    },
    {
      "id": "lx.daily-observe.b0003.0007",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把虾笼口凑近，检查编织结有没有松。",
      "description": "近看虾笼结扣。"
    },
    {
      "id": "lx.daily-observe.b0003.0008",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方近看水桶内壁，刮下一圈淡绿再闻了闻。",
      "description": "近看桶壁淡绿附着。"
    },
    {
      "id": "lx.daily-observe.b0003.0009",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把湿鞋垫翻开，盯着夹层是否发白起霉。",
      "description": "近看鞋垫夹层霉变。"
    },
    {
      "id": "lx.daily-observe.b0003.0010",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方凑近灯笼纸，看雨点晕开的圈是否干透。",
      "description": "近看灯笼纸雨晕。"
    },
    {
      "id": "lx.daily-observe.b0003.0011",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方站在堤上远望下游，看谁家的浣衣点还亮着。",
      "description": "远望下游浣衣灯。"
    },
    {
      "id": "lx.daily-observe.b0003.0012",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方从雨棚下望向对岸芦苇，估摸风是否要转向。",
      "description": "远望芦苇判风。"
    },
    {
      "id": "lx.daily-observe.b0003.0013",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方远望渠闸木柄，确认是否仍被石头压住。",
      "description": "远望渠闸压石。"
    },
    {
      "id": "lx.daily-observe.b0003.0014",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方在桥墩旁远望上游漂来的泡沫带。",
      "description": "远望上游泡沫带。"
    },
    {
      "id": "lx.daily-observe.b0003.0015",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方抬头远望山腰云带，判断午后是否还有阵雨。",
      "description": "远望山腰云带。"
    },
    {
      "id": "lx.daily-observe.b0003.0016",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方从吊脚楼窗口远望渡口，看船是否靠岸。",
      "description": "远望渡口靠船。"
    },
    {
      "id": "lx.daily-observe.b0003.0017",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方远望田埂上的斗笠移动，辨认是谁在巡渠。",
      "description": "远望田埂斗笠辨人。"
    },
    {
      "id": "lx.daily-observe.b0003.0018",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方站在高脚仓梯上，远望自家菜畦的反光膜。",
      "description": "远望菜畦反光膜。"
    },
    {
      "id": "lx.daily-observe.b0003.0019",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方收网间隙远望灯塔闪光间隔是否如常。",
      "description": "远望灯塔闪光间隔。"
    },
    {
      "id": "lx.daily-observe.b0003.0020",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方把目光送到湿地尽头的白鸟群，再收回脚边水洼。",
      "description": "远望白鸟再收回近处。"
    },
    {
      "id": "lx.daily-observe.b0003.0021",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两片苔藓并放掌心，比哪片更润更厚。",
      "description": "比较苔藓润厚。"
    },
    {
      "id": "lx.daily-observe.b0003.0022",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方将新旧雨棚布边并拢，比防水涂层反光。",
      "description": "比较雨棚布涂层。"
    },
    {
      "id": "lx.daily-observe.b0003.0023",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方用两根竹竿插入水中，比较没入深度估淤。",
      "description": "比较竹竿没水深度。"
    },
    {
      "id": "lx.daily-observe.b0003.0024",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两碗井水对光，看浑浊度差多少。",
      "description": "比较井水浑浊。"
    },
    {
      "id": "lx.daily-observe.b0003.0025",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方捏两把河沙，比哪一把更细更适合填缝。",
      "description": "比较河沙粗细。"
    },
    {
      "id": "lx.daily-observe.b0003.0026",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把干湿两双草鞋并排，估摸还能穿几天。",
      "description": "比较干湿草鞋寿命。"
    },
    {
      "id": "lx.daily-observe.b0003.0027",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方将早晨与傍晚的水位刻痕对照粉笔线。",
      "description": "比较早晚水位刻痕。"
    },
    {
      "id": "lx.daily-observe.b0003.0028",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两束晾干的香蒲并提，比哪束更脆易折。",
      "description": "比较香蒲脆度。"
    },
    {
      "id": "lx.daily-observe.b0003.0029",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方听两处滴水，比较哪处节奏更快该先修。",
      "description": "比较两处滴水节奏。"
    },
    {
      "id": "lx.daily-observe.b0003.0030",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把清澈溪水与渠水各盛半杯并排观察。",
      "description": "比较溪水与渠水色。"
    },
    {
      "id": "lx.daily-observe.b0003.0031",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方坐在雨棚下侧听，分辨是雨打布还是打叶。",
      "description": "侧听雨打布与叶。"
    },
    {
      "id": "lx.daily-observe.b0003.0032",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把耳朵靠近渠闸缝，听水挤过的嘶声强弱。",
      "description": "侧听闸缝水声。"
    },
    {
      "id": "lx.daily-observe.b0003.0033",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方夜里侧听蛙鸣疏密，判断水位是否上涨。",
      "description": "侧听蛙鸣疏密。"
    },
    {
      "id": "lx.daily-observe.b0003.0034",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方停桨侧听，辨认远处是渡船还是漂木撞击。",
      "description": "侧听渡船与漂木。"
    },
    {
      "id": "lx.daily-observe.b0003.0035",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方在苔径上侧耳，听身后是否有人踩水跟上。",
      "description": "侧听身后踩水。"
    },
    {
      "id": "lx.daily-observe.b0003.0036",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把竹筒贴近耳，听里面积水晃动的闷响。",
      "description": "侧听竹筒积水晃。"
    },
    {
      "id": "lx.daily-observe.b0003.0037",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方侧听屋檐铁皮，判断雨势是否转密。",
      "description": "侧听铁皮雨势。"
    },
    {
      "id": "lx.daily-observe.b0003.0038",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方在码头侧听缆绳摩擦桩的咯吱。",
      "description": "侧听缆绳磨桩。"
    },
    {
      "id": "lx.daily-observe.b0003.0039",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方清晨侧听水车是否仍在缓慢咬合。",
      "description": "侧听水车咬合。"
    },
    {
      "id": "lx.daily-observe.b0003.0040",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把窗推开一线，侧听夜潮拍岸的远近。",
      "description": "侧听夜潮远近。"
    },
    {
      "id": "lx.daily-observe.b0003.0041",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀开雨棚积水角，翻出堵在排水口的落叶。",
      "description": "翻查雨棚排水落叶。"
    },
    {
      "id": "lx.daily-observe.b0003.0042",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开石缝，寻找昨夜藏进去的小螺壳。",
      "description": "翻查石缝螺壳。"
    },
    {
      "id": "lx.daily-observe.b0003.0043",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把渔网从浮子一端翻起，检查破洞位置。",
      "description": "翻查渔网破洞。"
    },
    {
      "id": "lx.daily-observe.b0003.0044",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀起码头木板一块，查看下面潮虫是否成群。",
      "description": "翻查码头板下潮虫。"
    },
    {
      "id": "lx.daily-observe.b0003.0045",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻晾衣筐底层，找出仍湿的那件贴身衣。",
      "description": "翻查晾筐湿衣。"
    },
    {
      "id": "lx.daily-observe.b0003.0046",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把草药束解开翻拣，挑出发霉的几茎。",
      "description": "翻查草药发霉茎。"
    },
    {
      "id": "lx.daily-observe.b0003.0047",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开船舱隔板，清点备用桨托是否齐全。",
      "description": "翻查船舱桨托。"
    },
    {
      "id": "lx.daily-observe.b0003.0048",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀开水缸盖布，用勺搅底看沉淀厚薄。",
      "description": "翻查水缸底沉淀。"
    },
    {
      "id": "lx.daily-observe.b0003.0049",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把旧雨靴倒扣敲击，翻出里面的小石与泥。",
      "description": "翻查雨靴内异物。"
    },
    {
      "id": "lx.daily-observe.b0003.0050",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开田埂泥袋，确认缺口修补用泥还够。",
      "description": "翻查泥袋余量。"
    }
  ]
}
