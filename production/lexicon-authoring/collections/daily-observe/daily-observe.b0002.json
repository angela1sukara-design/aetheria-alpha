{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-observe",
  "batchId": "daily-observe.b0002",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.daily-observe.b0002.0001",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把裂开的椅腿凑到灯下，看木纹是否还能咬住钉。",
      "description": "近看椅腿裂纹与木纹。"
    },
    {
      "id": "lx.daily-observe.b0002.0002",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方用放大镜贴着补丁边缘，检查针脚是否跳线。",
      "description": "近看补丁针脚。"
    },
    {
      "id": "lx.daily-observe.b0002.0003",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方捏起旧钮扣，对着光线看孔眼是否磨成椭圆。",
      "description": "近看钮扣孔磨损。"
    },
    {
      "id": "lx.daily-observe.b0002.0004",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把砂纸背面翻过来，辨认剩余粗细代号。",
      "description": "近看砂纸目数标记。"
    },
    {
      "id": "lx.daily-observe.b0002.0005",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方凑近胶瓶嘴，看凝固的环是否还能挤开。",
      "description": "近看胶瓶嘴凝固环。"
    },
    {
      "id": "lx.daily-observe.b0002.0006",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把量尺贴在旧抽屉侧板，盯着刻度与磨损对齐。",
      "description": "近看量尺与磨损对齐。"
    },
    {
      "id": "lx.daily-observe.b0002.0007",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方俯看砧板刀痕，辨认哪几道是新切的。",
      "description": "近看砧板新旧刀痕。"
    },
    {
      "id": "lx.daily-observe.b0002.0008",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把线轴举到眼前，数剩余圈数大概还能缝几处。",
      "description": "近看线轴余量。"
    },
    {
      "id": "lx.daily-observe.b0002.0009",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方检查钳口齿纹，用指甲刮过看是否打滑。",
      "description": "近看钳口齿纹磨损。"
    },
    {
      "id": "lx.daily-observe.b0002.0010",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把旧灯罩内壁转到光下，看烟熏斑的厚薄。",
      "description": "近看灯罩内烟熏。"
    },
    {
      "id": "lx.daily-observe.b0002.0011",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方站在店门口远望街角，看学徒是否提着材料回来。",
      "description": "远望等候学徒归来。"
    },
    {
      "id": "lx.daily-observe.b0002.0012",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方从工作台抬头，望向窗外晾着的修好的伞布。",
      "description": "远望窗外晾伞。"
    },
    {
      "id": "lx.daily-observe.b0002.0013",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方送客到阶上，远望巷口是否还有下一位候着。",
      "description": "远望巷口候客。"
    },
    {
      "id": "lx.daily-observe.b0002.0014",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方把目光送到对街铁匠铺烟，估摸对方是否打烊。",
      "description": "远望对街铺烟与营业。"
    },
    {
      "id": "lx.daily-observe.b0002.0015",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方在屋顶补瓦间隙，远望邻屋顶是否也有人影。",
      "description": "远望邻屋顶人影。"
    },
    {
      "id": "lx.daily-observe.b0002.0016",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方靠着门框望向广场，看修鞋摊的伞是否还撑着。",
      "description": "远望修鞋摊伞影。"
    },
    {
      "id": "lx.daily-observe.b0002.0017",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方从二楼窗口远望材料市场旗帜，判断风向是否利于晾胶。",
      "description": "远望旗帜判风。"
    },
    {
      "id": "lx.daily-observe.b0002.0018",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方收工时远望河对岸灯火，心里默数还要走几段路。",
      "description": "远望归途灯火估程。"
    },
    {
      "id": "lx.daily-observe.b0002.0019",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方把半修好的椅子搁下，远望学徒练习台是否仍亮着。",
      "description": "远望练习台灯光。"
    },
    {
      "id": "lx.daily-observe.b0002.0020",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方站在梯子上远望整条街的招牌，核对自家字迹是否显眼。",
      "description": "远望街招对比自家。"
    },
    {
      "id": "lx.daily-observe.b0002.0021",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把新旧两把凿子并排，比较刃口反光宽度。",
      "description": "比较凿刃反光。"
    },
    {
      "id": "lx.daily-observe.b0002.0022",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方将客户带来的残片与库存木样并置对色。",
      "description": "比较残片与库存色。"
    },
    {
      "id": "lx.daily-observe.b0002.0023",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两卷线贴着捻，比哪一卷更酥更易断。",
      "description": "比较线卷酥脆度。"
    },
    {
      "id": "lx.daily-observe.b0002.0024",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方用卡尺先后量旧件与新坯，低声报出差值。",
      "description": "比较旧件新坯尺寸。"
    },
    {
      "id": "lx.daily-observe.b0002.0025",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两块砂纸摩擦声对比，选更细的那张收尾。",
      "description": "比较砂纸摩擦声。"
    },
    {
      "id": "lx.daily-observe.b0002.0026",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方将修补前后的壶嘴并看，检查弧线是否顺。",
      "description": "比较壶嘴弧线前后。"
    },
    {
      "id": "lx.daily-observe.b0002.0027",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两瓶溶剂开盖闻，选气味更淡的那瓶。",
      "description": "比较溶剂气味浓淡。"
    },
    {
      "id": "lx.daily-observe.b0002.0028",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把学徒缝的第一针与示范针并排对照。",
      "description": "比较学徒针与示范针。"
    },
    {
      "id": "lx.daily-observe.b0002.0029",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方掂了掂修好前后的门锁，感觉重量是否回正。",
      "description": "比较门锁修复前后重量。"
    },
    {
      "id": "lx.daily-observe.b0002.0030",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两张碳纸叠着看透光，挑纹路更匀的一张。",
      "description": "比较碳纸纹路匀度。"
    },
    {
      "id": "lx.daily-observe.b0002.0031",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方敲击木板侧听回声，判断内部是否中空开裂。",
      "description": "侧听敲木判空裂。"
    },
    {
      "id": "lx.daily-observe.b0002.0032",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方拧紧螺丝时侧耳，听螺纹是否咬合顺畅。",
      "description": "侧听螺丝咬合声。"
    },
    {
      "id": "lx.daily-observe.b0002.0033",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方让砂轮轻触，侧听啸声高低再调整力度。",
      "description": "侧听砂轮啸声。"
    },
    {
      "id": "lx.daily-observe.b0002.0034",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把耳朵靠近钟壳，听擒纵是否仍均匀。",
      "description": "侧听钟壳内节奏。"
    },
    {
      "id": "lx.daily-observe.b0002.0035",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方在隔壁学徒练习时侧听，偶尔喊一句慢一点。",
      "description": "侧听学徒练习节奏。"
    },
    {
      "id": "lx.daily-observe.b0002.0036",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方关抽屉前侧听滚轮，辨认哪一侧缺了油。",
      "description": "侧听抽屉滚轮异响。"
    },
    {
      "id": "lx.daily-observe.b0002.0037",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方给壶注水侧听水位爬升，估摸何时该停。",
      "description": "侧听注水水位声。"
    },
    {
      "id": "lx.daily-observe.b0002.0038",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方夜里留店，侧听门外是否有人试推门把。",
      "description": "侧听门外试门。"
    },
    {
      "id": "lx.daily-observe.b0002.0039",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方焊接间隙侧听风扇，确认排烟仍在转。",
      "description": "侧听排烟风扇运转。"
    },
    {
      "id": "lx.daily-observe.b0002.0040",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把布蒙在收音机上侧听，找最清晰的公共电台。",
      "description": "侧听蒙布后的电台。"
    },
    {
      "id": "lx.daily-observe.b0002.0041",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开旧工具册，寻找失踪型号的替代页。",
      "description": "翻查工具册替代型号。"
    },
    {
      "id": "lx.daily-observe.b0002.0042",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把废料箱倒出一角，翻找还能用的短钉。",
      "description": "翻查废料箱短钉。"
    },
    {
      "id": "lx.daily-observe.b0002.0043",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀开工作台垫布，清点滚落到缝里的垫片。",
      "description": "翻查台垫下垫片。"
    },
    {
      "id": "lx.daily-observe.b0002.0044",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻顾客寄存袋标签，核对取件日期与编号。",
      "description": "翻查寄存标签日期。"
    },
    {
      "id": "lx.daily-observe.b0002.0045",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把旧配方本从夹层抽出，翻到用铅笔改过的那页。",
      "description": "翻查配方本铅笔改页。"
    },
    {
      "id": "lx.daily-observe.b0002.0046",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻查抽屉深处，摸出一枚备用锁芯弹簧。",
      "description": "翻查抽屉备用弹簧。"
    },
    {
      "id": "lx.daily-observe.b0002.0047",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把学徒练习本翻到最后，看有没有偷偷加页。",
      "description": "翻查学徒本加页。"
    },
    {
      "id": "lx.daily-observe.b0002.0048",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀开货架底层挡板，清点季节性少用的模具。",
      "description": "翻查货架底模具。"
    },
    {
      "id": "lx.daily-observe.b0002.0049",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开保修单夹，找出那张字迹模糊的回执。",
      "description": "翻查保修夹模糊回执。"
    },
    {
      "id": "lx.daily-observe.b0002.0050",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把零线盒按颜色分区翻一遍，确认缺红线。",
      "description": "翻查零线盒缺色。"
    }
  ]
}
