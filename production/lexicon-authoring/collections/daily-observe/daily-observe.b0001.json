{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-observe",
  "batchId": "daily-observe.b0001",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.daily-observe.b0001.0001",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方俯身凑近门把手，用指腹摩过刻痕，像辨认新旧。",
      "description": "近距离触摸式查看门件表面。"
    },
    {
      "id": "lx.daily-observe.b0001.0002",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把灯盏端到耳边般近，盯着灯芯结焦的位置。",
      "description": "贴近查看灯芯结焦。"
    },
    {
      "id": "lx.daily-observe.b0001.0003",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方蹲下看鞋底夹缝，挑出一粒小石，又把它放回掌心端详。",
      "description": "近看鞋底夹缝异物。"
    },
    {
      "id": "lx.daily-observe.b0001.0004",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把碗沿转到光下，顺着一圈细裂痕慢慢挪目光。",
      "description": "近看碗沿裂纹走向。"
    },
    {
      "id": "lx.daily-observe.b0001.0005",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方捏起线头对着窗缝，眯眼辨认股数。",
      "description": "近看线股粗细。"
    },
    {
      "id": "lx.daily-observe.b0001.0006",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把告示下沿掀起一点，查看背面是否还有字迹。",
      "description": "近看告示背面残留。"
    },
    {
      "id": "lx.daily-observe.b0001.0007",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方用指甲轻刮桌面污点，观察刮痕是否变色。",
      "description": "近看污点附着性质。"
    },
    {
      "id": "lx.daily-observe.b0001.0008",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把钥匙齿槽对着光线，一齿一齿数过去。",
      "description": "近看钥匙齿形。"
    },
    {
      "id": "lx.daily-observe.b0001.0009",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方凑近墙角霉点，鼻尖几乎贴上白灰。",
      "description": "贴近查看墙角霉斑。"
    },
    {
      "id": "lx.daily-observe.b0001.0010",
      "category": "daily-observe",
      "subcategory": "近看",
      "text": "对方把布袋翻到内侧，盯着缝线是否起毛。",
      "description": "近看布袋内侧缝线。"
    },
    {
      "id": "lx.daily-observe.b0001.0011",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方站在廊口，目光越过晾衣绳落到街尽头的灰影。",
      "description": "远望街道尽头轮廓。"
    },
    {
      "id": "lx.daily-observe.b0001.0012",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方抬头看屋顶烟囱，确认哪一家还在冒淡烟。",
      "description": "远望屋顶炊烟位置。"
    },
    {
      "id": "lx.daily-observe.b0001.0013",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方倚着栏杆望向对岸，数了数亮着的窗口。",
      "description": "远望对岸亮窗。"
    },
    {
      "id": "lx.daily-observe.b0001.0014",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方走出店门回头，望见自家门牌在雨雾里仍可辨认。",
      "description": "远望归途门牌。"
    },
    {
      "id": "lx.daily-observe.b0001.0015",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方把视线放远到广场旗杆，再慢慢收回近处摊位。",
      "description": "远望再拉回近景的扫视。"
    },
    {
      "id": "lx.daily-observe.b0001.0016",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方在桥上停步，望着河面漂过的泡沫直至拐弯消失。",
      "description": "远望河面漂物远去。"
    },
    {
      "id": "lx.daily-observe.b0001.0017",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方望向山脊一线，判断云是否还压得住。",
      "description": "远望山脊与云层关系。"
    },
    {
      "id": "lx.daily-observe.b0001.0018",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方从窗缝望出去，看巷口是否还有人排队。",
      "description": "远望巷口人流。"
    },
    {
      "id": "lx.daily-observe.b0001.0019",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方把目光送到夜市最远一盏灯，估摸还有多远。",
      "description": "远望夜市灯火距离。"
    },
    {
      "id": "lx.daily-observe.b0001.0020",
      "category": "daily-observe",
      "subcategory": "远望",
      "text": "对方站在高阶上，望着归巢鸟群掠过烟囱。",
      "description": "远望鸟群掠过屋顶。"
    },
    {
      "id": "lx.daily-observe.b0001.0021",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两只杯子并排放好，敲了敲听哪只声更闷。",
      "description": "比较杯壁回声。"
    },
    {
      "id": "lx.daily-observe.b0001.0022",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方左右手各握一块肥皂，掂了掂轻重再放回。",
      "description": "比较皂块重量手感。"
    },
    {
      "id": "lx.daily-observe.b0001.0023",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把新旧两截绳子并拢，比对磨损起毛的位置。",
      "description": "比较绳索磨损段。"
    },
    {
      "id": "lx.daily-observe.b0001.0024",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方将两张收据摊开，指尖在数字栏来回点对。",
      "description": "比较收据数字栏。"
    },
    {
      "id": "lx.daily-observe.b0001.0025",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两双手套叠齐指尖，看哪双缝线更松。",
      "description": "比较手套缝线松紧。"
    },
    {
      "id": "lx.daily-observe.b0001.0026",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两块木板侧面相贴，用手掌感受高低差。",
      "description": "比较木板侧面平整。"
    },
    {
      "id": "lx.daily-observe.b0001.0027",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方端起两碗汤先后闻了闻，再决定先喝哪碗。",
      "description": "比较汤气先后闻辨。"
    },
    {
      "id": "lx.daily-observe.b0001.0028",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两枚纽扣并在掌心，转着看孔距是否一致。",
      "description": "比较纽扣孔距。"
    },
    {
      "id": "lx.daily-observe.b0001.0029",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把今日与昨日的菜价小票叠在一起对照。",
      "description": "比较隔日菜价小票。"
    },
    {
      "id": "lx.daily-observe.b0001.0030",
      "category": "daily-observe",
      "subcategory": "比较",
      "text": "对方把两支笔在纸上各画一道，比墨色深浅。",
      "description": "比较笔墨深浅。"
    },
    {
      "id": "lx.daily-observe.b0001.0031",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方停下手中活，侧耳听楼梯上是否还有脚步。",
      "description": "侧听楼梯脚步。"
    },
    {
      "id": "lx.daily-observe.b0001.0032",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把耳朵靠近水管，辨认里面是流水还是空响。",
      "description": "侧听水管声音性质。"
    },
    {
      "id": "lx.daily-observe.b0001.0033",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方在嘈杂市声里偏过头，捕捉远处叫卖的半句。",
      "description": "侧听市声中的叫卖。"
    },
    {
      "id": "lx.daily-observe.b0001.0034",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方关上门缝后仍站住，听邻屋是否继续争执。",
      "description": "侧听邻屋声响是否延续。"
    },
    {
      "id": "lx.daily-observe.b0001.0035",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把杯沿贴耳，听热水倒入时气泡的细碎声。",
      "description": "侧听注水气泡声。"
    },
    {
      "id": "lx.daily-observe.b0001.0036",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方夜里醒了一下，侧听窗外是否仍在滴檐水。",
      "description": "侧听檐水滴落。"
    },
    {
      "id": "lx.daily-observe.b0001.0037",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方路过工地围挡，侧听里面锤击的节奏是否均匀。",
      "description": "侧听工地锤击节奏。"
    },
    {
      "id": "lx.daily-observe.b0001.0038",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方把收音机音量拧小，侧耳分辨哪一台更清晰。",
      "description": "侧听择台清晰度。"
    },
    {
      "id": "lx.daily-observe.b0001.0039",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方在排队时侧身，听前面的人报了什么份量。",
      "description": "侧听队列前方报量。"
    },
    {
      "id": "lx.daily-observe.b0001.0040",
      "category": "daily-observe",
      "subcategory": "侧听",
      "text": "对方坐在窗边，侧听巷里推车轮毂的吱呀远近。",
      "description": "侧听推车轮声远近。"
    },
    {
      "id": "lx.daily-observe.b0001.0041",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开抽屉最下层，摸到一把被布包着的旧钥匙。",
      "description": "翻查抽屉底层旧物。"
    },
    {
      "id": "lx.daily-observe.b0001.0042",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把账本从后往前翻，寻找某个月的空白页。",
      "description": "翻查账本空白页。"
    },
    {
      "id": "lx.daily-observe.b0001.0043",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀起地垫一角，查看下面是否积了灰土。",
      "description": "翻查地垫下方。"
    },
    {
      "id": "lx.daily-observe.b0001.0044",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把衣袋一个个掏空，把纸屑摊在桌上分类。",
      "description": "翻查衣袋内容分类。"
    },
    {
      "id": "lx.daily-observe.b0001.0045",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻过枕套内侧标签，核对洗涤说明小字。",
      "description": "翻查枕套洗涤标签。"
    },
    {
      "id": "lx.daily-observe.b0001.0046",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把工具箱隔层拉开，清点缺少的那号扳手。",
      "description": "翻查工具箱隔层。"
    },
    {
      "id": "lx.daily-observe.b0001.0047",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方翻开旧日历背面，寻找随手记下的地址。",
      "description": "翻查日历背面字迹。"
    },
    {
      "id": "lx.daily-observe.b0001.0048",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把信匣按年份抽出，抽出中间那叠再合上。",
      "description": "翻查信匣年份分叠。"
    },
    {
      "id": "lx.daily-observe.b0001.0049",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方掀开灶台挡板，用手电扫过管道接头。",
      "description": "翻查灶台挡板后管道。"
    },
    {
      "id": "lx.daily-observe.b0001.0050",
      "category": "daily-observe",
      "subcategory": "翻查",
      "text": "对方把鞋盒堆重新归位前，掀盖确认标签年份。",
      "description": "翻查鞋盒标签年份。"
    }
  ]
}
