{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-refusal",
  "batchId": "text-refusal.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-refusal.b0002.0001",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "钝剪我自己磨，步骤我熟，谢谢关心。",
      "description": "因熟练拒绝代劳。"
    },
    {
      "id": "lx.text-refusal.b0002.0002",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "布线分装我来称，你去忙你的单子。",
      "description": "拒绝打断对方工时。"
    },
    {
      "id": "lx.text-refusal.b0002.0003",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "凳腿裂缝我自己钉，先试再说。",
      "description": "坚持亲自动手。"
    },
    {
      "id": "lx.text-refusal.b0002.0004",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "工具箱我自己锁，流程不能省。",
      "description": "坚持交接流程。"
    },
    {
      "id": "lx.text-refusal.b0002.0005",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "铆钉试做我想独自完成，当练习。",
      "description": "以练习为由拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0006",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "油漆第二层我刷，手法要连贯。",
      "description": "工艺连贯性拒绝插手。"
    },
    {
      "id": "lx.text-refusal.b0002.0007",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "废料清理我按分类倒，不必两人一起。",
      "description": "一人足够的拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0008",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "灯罩赶工我自己排期，不临时加人。",
      "description": "拒绝临时加人。"
    },
    {
      "id": "lx.text-refusal.b0002.0009",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "进胶我自己去选，手感要摸过才敢定。",
      "description": "需亲感而拒绝代购。"
    },
    {
      "id": "lx.text-refusal.b0002.0010",
      "category": "text-refusal",
      "subcategory": "拒绝帮忙",
      "text": "学徒的线轴我自己检查，教学不能代。",
      "description": "教学责任拒绝代劳。"
    },
    {
      "id": "lx.text-refusal.b0002.0011",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "午后茶歇我先不去，刃口还没磨完。",
      "description": "因进度拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0012",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "邻店看锤子我有兴趣，今天走不开柜台。",
      "description": "因值守拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0013",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "拼布垫展示会我缺席，下次带成品去。",
      "description": "单次缺席。"
    },
    {
      "id": "lx.text-refusal.b0002.0014",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "晚上聊旧物故事改期吧，我手还黏着胶。",
      "description": "因状态拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0015",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "废料改造互助局我不参加，在旁看看就好。",
      "description": "旁观替代参与。"
    },
    {
      "id": "lx.text-refusal.b0002.0016",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "学徒聚餐我这次不去，他们自己玩得更松。",
      "description": "给空间的拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0017",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "加急单庆祝我不喝酒，你们喝，我盯火。",
      "description": "角色替代的拒绝。"
    },
    {
      "id": "lx.text-refusal.b0002.0018",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "周末市集摆摊位我不去，店里还有积活。",
      "description": "优先店务。"
    },
    {
      "id": "lx.text-refusal.b0002.0019",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "交换工具日我只旁观，今年不拿自己的出去。",
      "description": "拒绝交换。"
    },
    {
      "id": "lx.text-refusal.b0002.0020",
      "category": "text-refusal",
      "subcategory": "拒绝邀请",
      "text": "收工后散步你先走，我要把台面擦完。",
      "description": "收尾优先。"
    },
    {
      "id": "lx.text-refusal.b0002.0021",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "这把剪子原主是谁，我不方便说。",
      "description": "保留委托者身份。"
    },
    {
      "id": "lx.text-refusal.b0002.0022",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "灯罩顾客要求保密图案，细节到此。",
      "description": "尊重客户保密。"
    },
    {
      "id": "lx.text-refusal.b0002.0023",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "店里账目我不多谈，只说交期。",
      "description": "保留财务。"
    },
    {
      "id": "lx.text-refusal.b0002.0024",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "学徒请假原因属于对方隐私，我只说人手紧。",
      "description": "保护第三人。"
    },
    {
      "id": "lx.text-refusal.b0002.0025",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "旧桌上的刻字内容我想自己看，不朗读。",
      "description": "保留发现细节。"
    },
    {
      "id": "lx.text-refusal.b0002.0026",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "进货渠道我自行联系，名单不公开。",
      "description": "保留供应商。"
    },
    {
      "id": "lx.text-refusal.b0002.0027",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "加急费怎么定，我还在想，暂不讨论。",
      "description": "保留定价过程。"
    },
    {
      "id": "lx.text-refusal.b0002.0028",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "废料里留下的零件用途，我先不解释。",
      "description": "保留意图。"
    },
    {
      "id": "lx.text-refusal.b0002.0029",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "自己袖口的松脂怎么弄上的，小事，不必追问。",
      "description": "拒绝追问琐事。"
    },
    {
      "id": "lx.text-refusal.b0002.0030",
      "category": "text-refusal",
      "subcategory": "保留隐私",
      "text": "协作时我更习惯少说话，不是针对谁。",
      "description": "说明习惯非针对。"
    },
    {
      "id": "lx.text-refusal.b0002.0031",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "裂痕留不留的审美争论，今天到此。",
      "description": "停止审美争执。"
    },
    {
      "id": "lx.text-refusal.b0002.0032",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "为什么不换新的，这个问题我稍后再答学徒。",
      "description": "推迟并停止当下。"
    },
    {
      "id": "lx.text-refusal.b0002.0033",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "锤子沉不沉，因人而异，别再比了。",
      "description": "收束或拒绝继续该题，呼应「锤子沉不沉因人而异别」情境。"
    },
    {
      "id": "lx.text-refusal.b0002.0034",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "加急费话题先搁下，我们把活做完。",
      "description": "事务优先停题。"
    },
    {
      "id": "lx.text-refusal.b0002.0035",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "废料改造吵到这够了，各自保留看法。",
      "description": "允许分歧收束。"
    },
    {
      "id": "lx.text-refusal.b0002.0036",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "店里闲话我不想听，请说手上的单子。",
      "description": "拉回工作。"
    },
    {
      "id": "lx.text-refusal.b0002.0037",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "油漆颜色够不够匀，看到这，别再评了。",
      "description": "停止评价。"
    },
    {
      "id": "lx.text-refusal.b0002.0038",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "关于谁教得更好，这类话请停。",
      "description": "停止比较教学。"
    },
    {
      "id": "lx.text-refusal.b0002.0039",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "旧物该不该修，原则谈完了，动手吧。",
      "description": "从讨论转行动。"
    },
    {
      "id": "lx.text-refusal.b0002.0040",
      "category": "text-refusal",
      "subcategory": "停止话题",
      "text": "我不想继续听对学徒的挑剔。",
      "description": "停止负面议论。"
    },
    {
      "id": "lx.text-refusal.b0002.0041",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "钝剪你不必帮磨；若愿意，帮我递一下油石就好。",
      "description": "缩小帮助。"
    },
    {
      "id": "lx.text-refusal.b0002.0042",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "午后茶歇我不去；你把水壶续满，算帮大忙。",
      "description": "轻量替代。"
    },
    {
      "id": "lx.text-refusal.b0002.0043",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "摆摊我不去；材料清单你若抄一份给我，我远程备货。",
      "description": "远程替代到场。"
    },
    {
      "id": "lx.text-refusal.b0002.0044",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "铆钉我不请人代做；你示范一次，我自己跟。",
      "description": "示范替代代做。"
    },
    {
      "id": "lx.text-refusal.b0002.0045",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "进胶我不托人；你只告诉我哪家气味淡。",
      "description": "信息替代代购。"
    },
    {
      "id": "lx.text-refusal.b0002.0046",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "聚餐我不去；收工后的清场我可以多做一轮。",
      "description": "劳动替代出席。"
    },
    {
      "id": "lx.text-refusal.b0002.0047",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "交换工具日我不拿出去；你可以在店里借用一天。",
      "description": "店内借用替代。"
    },
    {
      "id": "lx.text-refusal.b0002.0048",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "顾客身份我不说；交期和工艺要求可以讲清楚。",
      "description": "信息公开替代身份。"
    },
    {
      "id": "lx.text-refusal.b0002.0049",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "这个话题停；若还想聊，我们说砂纸目数怎么选。",
      "description": "换技术话题。"
    },
    {
      "id": "lx.text-refusal.b0002.0050",
      "category": "text-refusal",
      "subcategory": "提出替代",
      "text": "加急费暂不谈；你先看标准件价目，作参考。",
      "description": "资料替代定价讨论。"
    }
  ]
}
