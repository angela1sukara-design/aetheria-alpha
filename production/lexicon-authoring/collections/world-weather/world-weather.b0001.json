{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-weather",
  "batchId": "world-weather.b0001",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.world-weather.b0001.0001",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "早市收摊时细雨刚起，竹筐上的水珠顺着绳结往下滴。",
      "description": "清晨市集细雨，焦点在日常收摊节奏。"
    },
    {
      "id": "lx.world-weather.b0001.0002",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气贴着巷口矮墙，洗衣绳上的布片轮廓变得柔软。",
      "description": "巷内薄雾与晾晒日常，气氛平静。"
    },
    {
      "id": "lx.world-weather.b0001.0003",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨丝斜过公共水台，石面上的脚印一会儿就被冲浅。",
      "description": "公共水台遇雨，强调可洗净的生活痕迹。"
    },
    {
      "id": "lx.world-weather.b0001.0004",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "薄雾里邻人点头借过，伞骨轻轻碰了一下又各自挪开。",
      "description": "雾中礼貌让路，保持恰当距离。"
    },
    {
      "id": "lx.world-weather.b0001.0005",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨敲着遮雨布，布下有人低头整理刚买的青菜。",
      "description": "遮雨布下的短暂停留，平常而具体。"
    },
    {
      "id": "lx.world-weather.b0001.0006",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾散得慢，街角粥摊的蒸汽先把招牌字露出来。",
      "description": "雾与热食蒸汽交织，偏温热感。"
    },
    {
      "id": "lx.world-weather.b0001.0007",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨点打在空铁桶上，节奏均匀，像有人在轻敲桌面。",
      "description": "雨打器物声，不制造紧张。"
    },
    {
      "id": "lx.world-weather.b0001.0008",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气顺着排水沟低低走，孩子们绕开积水跳过石阶。",
      "description": "低雾与玩闹，轻快生活面。"
    },
    {
      "id": "lx.world-weather.b0001.0009",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨把晒干的台阶洇出深浅两层色。",
      "description": "雨后台阶色差，观察焦点清晰。"
    },
    {
      "id": "lx.world-weather.b0001.0010",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾中远处有人哼着不成调的歌，听不清词，也不急着听清。",
      "description": "雾中远声，保持松弛。"
    },
    {
      "id": "lx.world-weather.b0001.0011",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "午后阳光落在公用长椅上，木纹被照得发暖。",
      "description": "普通公共座椅上的晴光。"
    },
    {
      "id": "lx.world-weather.b0001.0012",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光从屋檐缺口斜进来，正好照到门口的擦鞋垫。",
      "description": "门口小光斑，生活尺度。"
    },
    {
      "id": "lx.world-weather.b0001.0013",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴天里晾衣绳影子在墙上慢慢挪，像一排安静的刻度。",
      "description": "日影移动作时间感，非机制。"
    },
    {
      "id": "lx.world-weather.b0001.0014",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "窗纸透进柔光，桌上的针线盒边缘亮了一圈。",
      "description": "室内柔光与日用物。"
    },
    {
      "id": "lx.world-weather.b0001.0015",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "广场石板反着浅光，路过的人眯眼又很快习惯。",
      "description": "公共广场晴光，平常适应。"
    },
    {
      "id": "lx.world-weather.b0001.0016",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光把水缸边的青苔照得发亮，又并不刺眼。",
      "description": "水缸旁苔藓受光，平和。"
    },
    {
      "id": "lx.world-weather.b0001.0017",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "清晨第一缕光落在门环上，金属凉意还在。",
      "description": "晨光与门环触感。"
    },
    {
      "id": "lx.world-weather.b0001.0018",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴空下布棚一角翻起，露出里面整齐码好的空碗。",
      "description": "布棚晴日，日常备餐痕迹。"
    },
    {
      "id": "lx.world-weather.b0001.0019",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光穿过竹帘格子，在地板上画出细细的条纹。",
      "description": "竹帘光影，居家平静。"
    },
    {
      "id": "lx.world-weather.b0001.0020",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "傍晚余晖贴着矮墙走，墙根坐着闲聊的人也不挪地方。",
      "description": "黄昏闲聊光色，礼貌共处。"
    },
    {
      "id": "lx.world-weather.b0001.0021",
      "category": "world-weather",
      "subcategory": "风",
      "text": "穿堂风从后门进来，把灶台旁的纸签轻轻掀起一角。",
      "description": "室内穿堂风，轻微动静。"
    },
    {
      "id": "lx.world-weather.b0001.0022",
      "category": "world-weather",
      "subcategory": "风",
      "text": "巷风带着邻家蒸笼的热气掠过，很快又散开。",
      "description": "风送食物气味一瞬，不浓烈。"
    },
    {
      "id": "lx.world-weather.b0001.0023",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风把屋檐下的风铃吹得断断续续，像在打招呼。",
      "description": "风铃声，友善日常。"
    },
    {
      "id": "lx.world-weather.b0001.0024",
      "category": "world-weather",
      "subcategory": "风",
      "text": "一阵风掀起门帘，帘后的人抬手按住，笑着让开。",
      "description": "门帘遇风与礼貌互动。"
    },
    {
      "id": "lx.world-weather.b0001.0025",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风顺着街沟走，把落叶推到水沟边的铁箅旁。",
      "description": "街沟风力，清理感而非破坏。"
    },
    {
      "id": "lx.world-weather.b0001.0026",
      "category": "world-weather",
      "subcategory": "风",
      "text": "微风拂过晾晒的粗布，布面鼓起又慢慢落下。",
      "description": "晾布鼓风，节奏舒缓。"
    },
    {
      "id": "lx.world-weather.b0001.0027",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风从市场过道吹来，夹着一点皂角与干草味。",
      "description": "市场风味混合，朴素。"
    },
    {
      "id": "lx.world-weather.b0001.0028",
      "category": "world-weather",
      "subcategory": "风",
      "text": "顶楼平台上风大些，有人用手按住草帽沿继续聊天。",
      "description": "高处风与日常交谈。"
    },
    {
      "id": "lx.world-weather.b0001.0029",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风停的片刻，纸鸢线在手心里忽然变轻。",
      "description": "风停触感变化，轻巧。"
    },
    {
      "id": "lx.world-weather.b0001.0030",
      "category": "world-weather",
      "subcategory": "风",
      "text": "夜风把窗边的薄帘吹向内侧，灯影跟着晃了两下。",
      "description": "夜风与灯影，安静。"
    },
    {
      "id": "lx.world-weather.b0001.0031",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "石阶还存着夜里的凉，赤脚的人会先站一旁试温度。",
      "description": "晨凉石阶，体感焦点。"
    },
    {
      "id": "lx.world-weather.b0001.0032",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "炉边热气扑面，退后半步就能感到巷风的凉。",
      "description": "热炉与巷凉对比。"
    },
    {
      "id": "lx.world-weather.b0001.0033",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "手握刚打来的井水，指节很快泛红又渐渐回温。",
      "description": "井水凉触，日常取水。"
    },
    {
      "id": "lx.world-weather.b0001.0034",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "午后晒过的墙皮温温的，靠一会儿也不觉得烫。",
      "description": "墙体温感，舒适尺度。"
    },
    {
      "id": "lx.world-weather.b0001.0035",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "雨后空气清凉，袖口偶有未干的潮意。",
      "description": "雨后清凉与衣物潮意。"
    },
    {
      "id": "lx.world-weather.b0001.0036",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "厨房里热雾散开，门口反而显得格外凉快。",
      "description": "厨热门凉对照。"
    },
    {
      "id": "lx.world-weather.b0001.0037",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "坐在遮阳布下，额上的汗慢慢干成薄薄一层盐。",
      "description": "遮阳下的热汗，平常。"
    },
    {
      "id": "lx.world-weather.b0001.0038",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "夜里被窝外的空气凉得干净，脚一探就缩回来。",
      "description": "夜凉探脚，生活幽默。"
    },
    {
      "id": "lx.world-weather.b0001.0039",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "铁壶把烫得需要垫布，壶身却只是温热。",
      "description": "器物冷热差异，具体。"
    },
    {
      "id": "lx.world-weather.b0001.0040",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "春末的午后不冷不热，人都愿意在门口多站一会儿。",
      "description": "适宜气温的停留感。"
    },
    {
      "id": "lx.world-weather.b0001.0041",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雾刚散开，招牌上的水珠还没干，阳光已经到了檐角。",
      "description": "雾转晴的交接瞬间。"
    },
    {
      "id": "lx.world-weather.b0001.0042",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雨停后风先到，把积水涟漪吹成细纹。",
      "description": "雨止风起的过渡。"
    },
    {
      "id": "lx.world-weather.b0001.0043",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "云层边缘发亮，街面上的影子一下子变得清楚。",
      "description": "云开影清，光感转换。"
    },
    {
      "id": "lx.world-weather.b0001.0044",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "闷热忽然被一阵凉风打断，有人抬头看天色。",
      "description": "闷热转凉的短暂征兆。"
    },
    {
      "id": "lx.world-weather.b0001.0045",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "黄昏时雨脚变稀，灯笼先被点亮，雨声还在远处。",
      "description": "黄昏雨稀与开灯。"
    },
    {
      "id": "lx.world-weather.b0001.0046",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "晨霜化成水膜，石板开始反光，行人步子慢了半拍。",
      "description": "霜化反光的清晨过渡。"
    },
    {
      "id": "lx.world-weather.b0001.0047",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "风停雨起之间空了一拍，巷里只听见碗筷轻碰。",
      "description": "风雨间隙的安静日常。"
    },
    {
      "id": "lx.world-weather.b0001.0048",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "阴转晴时屋顶上的鸽子先飞起来晒翅膀。",
      "description": "阴晴交替的动物反应。"
    },
    {
      "id": "lx.world-weather.b0001.0049",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "热气散尽，傍晚空气里留下一点点尘土与皂香。",
      "description": "日热退去后的气味层次。"
    },
    {
      "id": "lx.world-weather.b0001.0050",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "夜色压低时最后一缕霞光还停在水缸沿上。",
      "description": "日夜交接的微光残留。"
    }
  ]
}
