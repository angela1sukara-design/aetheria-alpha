{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-weather",
  "batchId": "world-weather.b0004",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.world-weather.b0004.0001",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "高地薄雾贴着石阶低低走，远处布帘轮廓发虚。",
      "description": "高地薄雾与石阶布帘。"
    },
    {
      "id": "lx.world-weather.b0004.0002",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨落在干燥石面上，很快洇开又被风吹干。",
      "description": "干石遇细雨易干。"
    },
    {
      "id": "lx.world-weather.b0004.0003",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气绕过遮阳棚柱，棚下远行者整理肩带也不急。",
      "description": "遮阳棚雾中休整。"
    },
    {
      "id": "lx.world-weather.b0004.0004",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨雾里石阶湿痕只留半级，上面仍是干白。",
      "description": "石阶局部湿痕。"
    },
    {
      "id": "lx.world-weather.b0004.0005",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "薄雾中驿棚灯火偏黄，门口挂着未干的斗笠。",
      "description": "驿棚雾与斗笠。"
    },
    {
      "id": "lx.world-weather.b0004.0006",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨敲着高地铁皮水箱，声音清脆不像低地。",
      "description": "高地雨打水箱声。"
    },
    {
      "id": "lx.world-weather.b0004.0007",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾散得慢，远行者的脚印在粉尘与湿痕间交替。",
      "description": "雾中脚印干湿交替。"
    },
    {
      "id": "lx.world-weather.b0004.0008",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨雾贴着崖边草丛走，草叶发亮却不滴水。",
      "description": "崖边草雾光。"
    },
    {
      "id": "lx.world-weather.b0004.0009",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨过后雾未尽，遮阳布上的尘土被冲出浅纹。",
      "description": "雨冲遮阳布尘纹。"
    },
    {
      "id": "lx.world-weather.b0004.0010",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾里听见远处蹄声，近处只有布帘轻拍棚柱。",
      "description": "远蹄近帘层次。"
    },
    {
      "id": "lx.world-weather.b0004.0011",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴光把石阶晒得发白，边缘投下短而硬的影。",
      "description": "高地石阶硬影。"
    },
    {
      "id": "lx.world-weather.b0004.0012",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光穿透遮阳布的织纹，地面落下一片细点光。",
      "description": "遮阳布透光点。"
    },
    {
      "id": "lx.world-weather.b0004.0013",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "午后晴光下布帘颜色发透，里面人影只剩轮廓。",
      "description": "布帘透光人影。"
    },
    {
      "id": "lx.world-weather.b0004.0014",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴空高远，石台反光刺眼，有人侧身找阴影说话。",
      "description": "晴燥反光与侧身。"
    },
    {
      "id": "lx.world-weather.b0004.0015",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晨光先到崖顶旗杆，随后石阶一级级亮起来。",
      "description": "晨光沿阶铺开。"
    },
    {
      "id": "lx.world-weather.b0004.0016",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光照着晒干的水壶皮套，缝线阴影清晰可见。",
      "description": "水壶皮套受光。"
    },
    {
      "id": "lx.world-weather.b0004.0017",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴光下迁居箱盖微翘，箱面尘土被擦出一道新痕。",
      "description": "迁居箱与晴尘。"
    },
    {
      "id": "lx.world-weather.b0004.0018",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "斜阳贴着高墙走，墙根坐着歇脚的人也不挪地方。",
      "description": "斜阳歇脚。"
    },
    {
      "id": "lx.world-weather.b0004.0019",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴天里遮阳棚布绷得发紧，绳结影子像一排小扣。",
      "description": "绷布绳结影。"
    },
    {
      "id": "lx.world-weather.b0004.0020",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "傍晚余晖停在石阶最高一级，下面已经转凉色。",
      "description": "阶顶余晖阶下凉色。"
    },
    {
      "id": "lx.world-weather.b0004.0021",
      "category": "world-weather",
      "subcategory": "风",
      "text": "干风从山口灌入，掀起遮阳布一角又放下。",
      "description": "山口干风掀布。"
    },
    {
      "id": "lx.world-weather.b0004.0022",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风把石阶上的细沙吹进缝里，脚步声变得更脆。",
      "description": "风沙入缝步声脆。"
    },
    {
      "id": "lx.world-weather.b0004.0023",
      "category": "world-weather",
      "subcategory": "风",
      "text": "高处风大，布帘猎猎响，棚内谈话却压得很低。",
      "description": "风大声低对照。"
    },
    {
      "id": "lx.world-weather.b0004.0024",
      "category": "world-weather",
      "subcategory": "风",
      "text": "微风送来远处炊烟味，很快又被干空气散掉。",
      "description": "风送炊烟一瞬。"
    },
    {
      "id": "lx.world-weather.b0004.0025",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风吹过空水袋，袋口啪地轻响一下。",
      "description": "空水袋风响。"
    },
    {
      "id": "lx.world-weather.b0004.0026",
      "category": "world-weather",
      "subcategory": "风",
      "text": "一阵风掀起远行者斗篷边，露出里面补过的衬布。",
      "description": "斗篷掀边见补丁。"
    },
    {
      "id": "lx.world-weather.b0004.0027",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风停片刻，石阶上的尘土重新落定，脚印边缘变清楚。",
      "description": "风停尘定脚印清。"
    },
    {
      "id": "lx.world-weather.b0004.0028",
      "category": "world-weather",
      "subcategory": "风",
      "text": "夜风干凉，布帘内侧被吹得贴向棚柱。",
      "description": "夜干风贴帘。"
    },
    {
      "id": "lx.world-weather.b0004.0029",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风从峡谷上来，带着一点草香和晒热的石味。",
      "description": "峡谷风味。"
    },
    {
      "id": "lx.world-weather.b0004.0030",
      "category": "world-weather",
      "subcategory": "风",
      "text": "顶棚风口呜呜响，里面有人用手按住地图边角。",
      "description": "风口与按地图。"
    },
    {
      "id": "lx.world-weather.b0004.0031",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "石阶晒透后烫脚，阴影里却一下子凉下来。",
      "description": "晒烫与影凉。"
    },
    {
      "id": "lx.world-weather.b0004.0032",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "干热风扑面，喝一口水壶里的温水反而觉得清。",
      "description": "干热与温水对照。"
    },
    {
      "id": "lx.world-weather.b0004.0033",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "遮阳棚下额汗干得快，留下浅浅盐痕。",
      "description": "棚下汗干成盐。"
    },
    {
      "id": "lx.world-weather.b0004.0034",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "夜里石面回凉，赤脚一触就缩，鞋垫却还留着日温。",
      "description": "夜石凉与鞋垫余温。"
    },
    {
      "id": "lx.world-weather.b0004.0035",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "手握金属扣发烫，布带却只是温热。",
      "description": "金属烫布温带。"
    },
    {
      "id": "lx.world-weather.b0004.0036",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "高处空气干爽，嘴唇容易发紧，有人舔一下继续走。",
      "description": "干空气唇感。"
    },
    {
      "id": "lx.world-weather.b0004.0037",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "午后墙根热浪明显，挪到布帘后立刻好许多。",
      "description": "墙热帘后凉。"
    },
    {
      "id": "lx.world-weather.b0004.0038",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "迁居箱背阴面还凉，向阳面已经温得能烘手。",
      "description": "箱体阴阳温差。"
    },
    {
      "id": "lx.world-weather.b0004.0039",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "晨凉未散，石阶缝里还存着一点夜气。",
      "description": "晨凉石缝。"
    },
    {
      "id": "lx.world-weather.b0004.0040",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "干热午后不闷，人愿意在石台边多站一会儿看远景。",
      "description": "干热适宜停留。"
    },
    {
      "id": "lx.world-weather.b0004.0041",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雾刚散，石阶上的湿痕迅速变白，远影忽然清晰。",
      "description": "雾散湿痕干远影清。"
    },
    {
      "id": "lx.world-weather.b0004.0042",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "云影掠过石台，光暗交替里布帘颜色忽深忽浅。",
      "description": "云影改布色。"
    },
    {
      "id": "lx.world-weather.b0004.0043",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "风转凉时干热退潮，水壶外壁凝出细密水珠。",
      "description": "干热转凉凝露。"
    },
    {
      "id": "lx.world-weather.b0004.0044",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "黄昏尘色变柔，石阶边缘的影子拉得很长。",
      "description": "黄昏影长。"
    },
    {
      "id": "lx.world-weather.b0004.0045",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "晨霜在高地薄薄一层，化开后石面很快恢复干燥。",
      "description": "高地薄霜速干。"
    },
    {
      "id": "lx.world-weather.b0004.0046",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "闷热被干风打断，迁居绳结不再黏手。",
      "description": "闷转干绳结爽手。"
    },
    {
      "id": "lx.world-weather.b0004.0047",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雨脚未到先起风，遮阳布绷紧，有人抬头估量是否收帘。",
      "description": "雨前风紧估量。"
    },
    {
      "id": "lx.world-weather.b0004.0048",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "夜色压低前，最后一缕斜光还停在最高那级石阶。",
      "description": "日尽阶顶余光。"
    },
    {
      "id": "lx.world-weather.b0004.0049",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "热气散尽的傍晚，空气里只剩干草香和一点尘土味。",
      "description": "日热退后干草尘味。"
    },
    {
      "id": "lx.world-weather.b0004.0050",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "阴转晴时山口旗帜先动，随后整条石阶亮起来。",
      "description": "阴晴与旗动阶亮。"
    }
  ]
}
