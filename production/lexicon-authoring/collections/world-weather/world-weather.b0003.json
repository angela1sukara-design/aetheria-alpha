{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-weather",
  "batchId": "world-weather.b0003",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.world-weather.b0003.0001",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨落在水渠面上，涟漪一圈圈推到苔痕边。",
      "description": "水渠细雨与苔边。"
    },
    {
      "id": "lx.world-weather.b0003.0002",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气贴着雨棚下沿漂，棚里坐着剥豆的人说话很轻。",
      "description": "雨棚雾与安静劳作。"
    },
    {
      "id": "lx.world-weather.b0003.0003",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨雾把蕨叶边缘打湿，叶尖一滴一滴落入石缝。",
      "description": "蕨叶滴水的安静节奏。"
    },
    {
      "id": "lx.world-weather.b0003.0004",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "薄雾里渡口木桩发黑，绳结上挂着未干的水珠。",
      "description": "渡口雾中绳结。"
    },
    {
      "id": "lx.world-weather.b0003.0005",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨敲着水生植物的宽叶，声音比打在石板上软。",
      "description": "雨打宽叶的柔声。"
    },
    {
      "id": "lx.world-weather.b0003.0006",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气顺着岸坡往上涨，洗衣石还露着半截。",
      "description": "岸雾与洗衣石。"
    },
    {
      "id": "lx.world-weather.b0003.0007",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨棚外雾浓，棚内灯下青菜叶上的水珠却很清楚。",
      "description": "棚内外雾灯对照。"
    },
    {
      "id": "lx.world-weather.b0003.0008",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨过后雾未散，水渠旁的木桥板还在轻轻反光。",
      "description": "雨后雾中桥板。"
    },
    {
      "id": "lx.world-weather.b0003.0009",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾里听见远处船桨入水，近处只有雨棚布的轻抖。",
      "description": "远桨近棚的层次。"
    },
    {
      "id": "lx.world-weather.b0003.0010",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨雾把岸边晾晒的蓑衣变得更深，气味也更潮。",
      "description": "蓑衣受潮色味变化。"
    },
    {
      "id": "lx.world-weather.b0003.0011",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴光穿透雨棚缝隙，照亮棚柱上新长的薄苔。",
      "description": "雨棚柱苔受光。"
    },
    {
      "id": "lx.world-weather.b0003.0012",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "午后阳光落在水渠清处，能看见浅底的小石子。",
      "description": "晴日水渠清澈。"
    },
    {
      "id": "lx.world-weather.b0003.0013",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光把蕨丛照得半透，叶脉像细细的水路。",
      "description": "蕨叶透光。"
    },
    {
      "id": "lx.world-weather.b0003.0014",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴天里雨棚布被晒干，布纹里的潮痕渐渐退淡。",
      "description": "雨棚晒干过程。"
    },
    {
      "id": "lx.world-weather.b0003.0015",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "斜阳贴着水面走，波光跳到岸边石阶上。",
      "description": "水面反光到石阶。"
    },
    {
      "id": "lx.world-weather.b0003.0016",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晨光先到浮萍缝隙，随后整片水塘慢慢亮起来。",
      "description": "浮萍与晨光铺开。"
    },
    {
      "id": "lx.world-weather.b0003.0017",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴光下苔藓发翠，有人蹲着轻轻拨开看有没有小螺。",
      "description": "苔间寻螺的轻快。"
    },
    {
      "id": "lx.world-weather.b0003.0018",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光照着晒干的莲蓬，壳面裂开细纹也不掉色。",
      "description": "莲蓬晒干受光。"
    },
    {
      "id": "lx.world-weather.b0003.0019",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "雨棚下檐的滴水在晴光里变成细线，很快断掉。",
      "description": "滴水遇晴蒸发。"
    },
    {
      "id": "lx.world-weather.b0003.0020",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "傍晚余晖停在水车轮缘，轮上青苔半干半湿。",
      "description": "水车苔与余晖。"
    },
    {
      "id": "lx.world-weather.b0003.0021",
      "category": "world-weather",
      "subcategory": "风",
      "text": "河风掀起雨棚一角，棚里人抬手按住又继续织网。",
      "description": "河风与雨棚、织网。"
    },
    {
      "id": "lx.world-weather.b0003.0022",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风过蕨丛，叶片互相轻擦，带起一点清苦气味。",
      "description": "风动蕨叶气味。"
    },
    {
      "id": "lx.world-weather.b0003.0023",
      "category": "world-weather",
      "subcategory": "风",
      "text": "岸风把芦絮吹到水渠里，很快又被水流带走。",
      "description": "芦絮随风入水。"
    },
    {
      "id": "lx.world-weather.b0003.0024",
      "category": "world-weather",
      "subcategory": "风",
      "text": "微风推着浮萍慢慢挪位，露出一小块干净水面。",
      "description": "风移浮萍。"
    },
    {
      "id": "lx.world-weather.b0003.0025",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风从湿润的石缝吹来，带着苔藓与清水的凉意。",
      "description": "石缝湿风。"
    },
    {
      "id": "lx.world-weather.b0003.0026",
      "category": "world-weather",
      "subcategory": "风",
      "text": "一阵风把晾在绳上的水草吹得摇晃，水滴甩到地上。",
      "description": "晾水草遇风。"
    },
    {
      "id": "lx.world-weather.b0003.0027",
      "category": "world-weather",
      "subcategory": "风",
      "text": "渡口风大些，船篷布鼓起又瘪下，绳结咯吱轻响。",
      "description": "船篷鼓风。"
    },
    {
      "id": "lx.world-weather.b0003.0028",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风停时水面如镜，雨棚下的谈话声忽然显得清楚。",
      "description": "风停水静声清。"
    },
    {
      "id": "lx.world-weather.b0003.0029",
      "category": "world-weather",
      "subcategory": "风",
      "text": "夜风贴着水岸走，灯影在波纹上碎成细点。",
      "description": "夜岸风与灯影。"
    },
    {
      "id": "lx.world-weather.b0003.0030",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风把雨棚边的铃铛吹响一两下，像提醒有人进出。",
      "description": "雨棚铃与进出。"
    },
    {
      "id": "lx.world-weather.b0003.0031",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "赤脚踩在潮石上，凉意从脚心一直凉到小腿。",
      "description": "潮石凉感。"
    },
    {
      "id": "lx.world-weather.b0003.0032",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "雨棚下空气潮润不闷，额上的汗慢慢干成薄盐。",
      "description": "潮棚体感舒适。"
    },
    {
      "id": "lx.world-weather.b0003.0033",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "手伸进水渠，指尖先凉，腕上却被岸上的暖风拂着。",
      "description": "水凉风暖对照。"
    },
    {
      "id": "lx.world-weather.b0003.0034",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "晒过的石阶温热，旁边阴影里的苔却还凉。",
      "description": "石温苔凉并置。"
    },
    {
      "id": "lx.world-weather.b0003.0035",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "湿蓑衣贴背时凉意明显，脱下后脊背又慢慢回暖。",
      "description": "蓑衣湿凉。"
    },
    {
      "id": "lx.world-weather.b0003.0036",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "午后水面反光发烫，躲进雨棚立刻感到一股清凉。",
      "description": "反光热与棚凉。"
    },
    {
      "id": "lx.world-weather.b0003.0037",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "夜里岸风带湿，袖口吸潮后摸起来发涩。",
      "description": "夜湿袖涩。"
    },
    {
      "id": "lx.world-weather.b0003.0038",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "刚采的水芹握在手里，叶面凉得像刚出井水。",
      "description": "水芹手感凉。"
    },
    {
      "id": "lx.world-weather.b0003.0039",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "炉边烤干的鞋垫还热，门外石板却潮凉。",
      "description": "鞋垫热与门外凉。"
    },
    {
      "id": "lx.world-weather.b0003.0040",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "春末水岸不冷不热，人愿意在雨棚下多坐一会儿。",
      "description": "适宜水岸停留。"
    },
    {
      "id": "lx.world-weather.b0003.0041",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雨停雾留，水渠上先出现一小段清晰倒影。",
      "description": "雨雾交替见倒影。"
    },
    {
      "id": "lx.world-weather.b0003.0042",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "阴转晴时蕨叶上的水珠先亮，随后整片坡岸发绿。",
      "description": "阴晴与蕨亮。"
    },
    {
      "id": "lx.world-weather.b0003.0043",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "风转干，雨棚布不再黏手，晾晒的网绳也变轻。",
      "description": "潮转干的触感。"
    },
    {
      "id": "lx.world-weather.b0003.0044",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "黄昏雨脚变稀，灯先点亮，水面还留着雨点圈。",
      "description": "黄昏雨稀开灯。"
    },
    {
      "id": "lx.world-weather.b0003.0045",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "晨雾散尽，石阶上的蜗牛痕迹才完全露出来。",
      "description": "雾散见蜗牛痕。"
    },
    {
      "id": "lx.world-weather.b0003.0046",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "闷湿被一阵清风打断，浮萍忽然整体偏了一寸。",
      "description": "闷湿转风移萍。"
    },
    {
      "id": "lx.world-weather.b0003.0047",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "云开时水车影子变短，轮上水珠闪了一阵。",
      "description": "云开影短水珠。"
    },
    {
      "id": "lx.world-weather.b0003.0048",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "夜色压低前，最后一缕霞光还停在雨棚檐角。",
      "description": "日夜交接檐光。"
    },
    {
      "id": "lx.world-weather.b0003.0049",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "热气散尽的傍晚，岸边只剩清水味和一点草木香。",
      "description": "日热退后的岸味。"
    },
    {
      "id": "lx.world-weather.b0003.0050",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "霜膜化开，水渠边草叶由白转绿，脚步声也变软。",
      "description": "霜化草转绿。"
    }
  ]
}
