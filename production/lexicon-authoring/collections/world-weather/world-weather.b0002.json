{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-weather",
  "batchId": "world-weather.b0002",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.world-weather.b0002.0001",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨雾贴着作坊窗缝进来，木屑在湿气里沉得更慢。",
      "description": "作坊窗缝雨雾与木屑。"
    },
    {
      "id": "lx.world-weather.b0002.0002",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨打在修补棚的油布上，里面锤子敲得更轻了些。",
      "description": "修补棚雨声与放轻操作。"
    },
    {
      "id": "lx.world-weather.b0002.0003",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气绕过晾漆的木架，学徒用布把架脚的水抹掉。",
      "description": "晾漆遇雾的细心维护。"
    },
    {
      "id": "lx.world-weather.b0002.0004",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨丝顺着工具挂架滴下，地上垫着旧麻袋吸水。",
      "description": "工具架遇雨的防护痕迹。"
    },
    {
      "id": "lx.world-weather.b0002.0005",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾浓时店门口的修伞摊把灯芯拧亮一点。",
      "description": "修伞摊雾中照明调整。"
    },
    {
      "id": "lx.world-weather.b0002.0006",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "细雨把砂纸上的木粉打湿成浅色条纹。",
      "description": "砂纸受雨的视觉细节。"
    },
    {
      "id": "lx.world-weather.b0002.0007",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨雾里胶水味变得柔和，屋里仍有人低头打磨。",
      "description": "雨雾与胶味、打磨并存。"
    },
    {
      "id": "lx.world-weather.b0002.0008",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雾气让鞋匠摊的皮料边缘发暗，他随手盖上一块干布。",
      "description": "皮料防潮的即时动作。"
    },
    {
      "id": "lx.world-weather.b0002.0009",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "雨敲铁皮棚顶，节奏乱时有人停针等它匀一点。",
      "description": "雨声影响缝纫节奏。"
    },
    {
      "id": "lx.world-weather.b0002.0010",
      "category": "world-weather",
      "subcategory": "雨雾",
      "text": "薄雾中旧铜件被擦出一小块亮面，周围仍是雾色。",
      "description": "擦亮旧铜与雾色对比。"
    },
    {
      "id": "lx.world-weather.b0002.0011",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴光落在工作台上，裂缝里的旧漆色一下看得清楚。",
      "description": "晴光助观察修补处。"
    },
    {
      "id": "lx.world-weather.b0002.0012",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光透过布帘格子，照见针线盒里按色排好的线轴。",
      "description": "晴光下的线轴秩序。"
    },
    {
      "id": "lx.world-weather.b0002.0013",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "午后晴光让砂轮边的金属屑闪了一下又暗下去。",
      "description": "金属屑反光一瞬。"
    },
    {
      "id": "lx.world-weather.b0002.0014",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴天把晾干的补丁布晒得发白，方便挑选色差。",
      "description": "晒布选色的实用晴光。"
    },
    {
      "id": "lx.world-weather.b0002.0015",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "窗边晴光正好，学徒把细活挪到光里继续。",
      "description": "借光做细活。"
    },
    {
      "id": "lx.world-weather.b0002.0016",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "阳光照着修好的椅腿，新木与旧木色差并排可见。",
      "description": "新旧木料并置受光。"
    },
    {
      "id": "lx.world-weather.b0002.0017",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴光下油布反光，师傅用手背试了试是否还黏。",
      "description": "油布干燥度触感检查。"
    },
    {
      "id": "lx.world-weather.b0002.0018",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "斜阳把工具柄上的手汗印照得浅浅发亮。",
      "description": "工具使用痕迹受光。"
    },
    {
      "id": "lx.world-weather.b0002.0019",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晴空下小店门口晒着刚漆过的盒盖，旁边立着警示绳。",
      "description": "晒漆与简单警示。"
    },
    {
      "id": "lx.world-weather.b0002.0020",
      "category": "world-weather",
      "subcategory": "晴光",
      "text": "晨光先到磨刀石，水槽里昨夜的铁屑沉淀清晰。",
      "description": "晨光与磨刀残留。"
    },
    {
      "id": "lx.world-weather.b0002.0021",
      "category": "world-weather",
      "subcategory": "风",
      "text": "穿堂风把刨花吹向墙角的收集筐，筐口压着石块。",
      "description": "风与刨花收集。"
    },
    {
      "id": "lx.world-weather.b0002.0022",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风掀起图纸一角，学徒用浆糊罐压住再继续量尺寸。",
      "description": "风扰图纸的应对。"
    },
    {
      "id": "lx.world-weather.b0002.0023",
      "category": "world-weather",
      "subcategory": "风",
      "text": "微风把染料布条吹得轻轻摆，颜色按深浅排成一列。",
      "description": "风中色样布条。"
    },
    {
      "id": "lx.world-weather.b0002.0024",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风从后门进来，带着邻店锯末味掠过修补台。",
      "description": "协作街区的风味。"
    },
    {
      "id": "lx.world-weather.b0002.0025",
      "category": "world-weather",
      "subcategory": "风",
      "text": "一阵风吹灭灯芯，屋里有人笑着重新点燃继续钉。",
      "description": "风灭灯与从容续作。"
    },
    {
      "id": "lx.world-weather.b0002.0026",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风吹过晾线绳，线头互相轻碰，像在低声商量。",
      "description": "晾线遇风的轻响。"
    },
    {
      "id": "lx.world-weather.b0002.0027",
      "category": "world-weather",
      "subcategory": "风",
      "text": "顶棚风口呜呜响，师傅抬头看了眼又低头对线。",
      "description": "风口声不打断细致活。"
    },
    {
      "id": "lx.world-weather.b0002.0028",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风把旧报纸吹散，学徒一张张捡回压在木板下。",
      "description": "风散保护纸与收拾。"
    },
    {
      "id": "lx.world-weather.b0002.0029",
      "category": "world-weather",
      "subcategory": "风",
      "text": "晚风送来隔壁锤声，两边节奏偶尔碰上又错开。",
      "description": "邻坊锤声经风传来。"
    },
    {
      "id": "lx.world-weather.b0002.0030",
      "category": "world-weather",
      "subcategory": "风",
      "text": "风停时木屑落定，工作台面忽然干净了一寸。",
      "description": "风停落屑的安静瞬间。"
    },
    {
      "id": "lx.world-weather.b0002.0031",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "烙铁烫手，柄上缠的旧布条被捏得发亮。",
      "description": "烙铁热感与防烫布。"
    },
    {
      "id": "lx.world-weather.b0002.0032",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "清晨木料凉得发硬，刨刃过处才渐渐温润。",
      "description": "凉木与刨削升温。"
    },
    {
      "id": "lx.world-weather.b0002.0033",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "胶锅边热气扑面，退后一步能感到棚外的凉风。",
      "description": "胶锅热与棚外凉。"
    },
    {
      "id": "lx.world-weather.b0002.0034",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "手指被砂纸磨热，停下来对着风口吹了吹。",
      "description": "打磨热手的小停顿。"
    },
    {
      "id": "lx.world-weather.b0002.0035",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "夜里作坊熄火后台面很快回凉，工具柄也变得涩。",
      "description": "熄火回凉触感。"
    },
    {
      "id": "lx.world-weather.b0002.0036",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "晒过的补丁布温温的，贴到膝上也不觉得刺。",
      "description": "晒布余温。"
    },
    {
      "id": "lx.world-weather.b0002.0037",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "铁砧边热，旁边水桶却凉，淬火时蒸汽短促升起。",
      "description": "热铁与凉水对照。"
    },
    {
      "id": "lx.world-weather.b0002.0038",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "雨后棚里潮凉，师傅把火盆挪近半步再继续缝。",
      "description": "潮凉棚内的取暖微调。"
    },
    {
      "id": "lx.world-weather.b0002.0039",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "握久了的凿子柄发热，换手时掌心留下浅印。",
      "description": "工具握持热感。"
    },
    {
      "id": "lx.world-weather.b0002.0040",
      "category": "world-weather",
      "subcategory": "冷热感",
      "text": "午后棚顶晒透，站久了脖子后也发热。",
      "description": "棚顶传热的身体感。"
    },
    {
      "id": "lx.world-weather.b0002.0041",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雨刚停，棚外地上还湿，棚内已开始试干布抛光。",
      "description": "雨停后立刻续作。"
    },
    {
      "id": "lx.world-weather.b0002.0042",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雾散晴出，色差立刻变得分明，染色师傅重新校对。",
      "description": "雾转晴利于对色。"
    },
    {
      "id": "lx.world-weather.b0002.0043",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "风转凉时胶变稠，有人把锅移近一点火。",
      "description": "天气转凉影响胶性。"
    },
    {
      "id": "lx.world-weather.b0002.0044",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "阴转晴，晾架上的伞骨水珠闪一下又蒸发。",
      "description": "伞骨干燥过程。"
    },
    {
      "id": "lx.world-weather.b0002.0045",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "热气散尽的黄昏，工作台边只剩木香和一点油味。",
      "description": "收工时气味过渡。"
    },
    {
      "id": "lx.world-weather.b0002.0046",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "晨霜化开，门槛石由白转灰，学徒抬脚进门更小心。",
      "description": "霜化门槛与小心入门。"
    },
    {
      "id": "lx.world-weather.b0002.0047",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "雨脚变稀，锤声从闷变清，像工具自己松了口气。",
      "description": "雨稀后声感变化。"
    },
    {
      "id": "lx.world-weather.b0002.0048",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "云影掠过窗台，光暗交替里针脚仍保持均匀。",
      "description": "光暗交替中的细活。"
    },
    {
      "id": "lx.world-weather.b0002.0049",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "夜色压来前最后一缕斜光，刚好够检查最后一道缝。",
      "description": "日尽前的收尾检查。"
    },
    {
      "id": "lx.world-weather.b0002.0050",
      "category": "world-weather",
      "subcategory": "天气过渡",
      "text": "闷热被一阵干风打断，布料不再黏手，缝纫顺了许多。",
      "description": "闷转干利于缝纫。"
    }
  ]
}
