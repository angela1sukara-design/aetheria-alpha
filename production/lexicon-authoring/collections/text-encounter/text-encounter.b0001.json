{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-encounter",
  "batchId": "text-encounter.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-encounter.b0001.0001",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "两位路人在巷口侧肩错开，衣角轻轻一碰。两人都低声道了歉，继续各自的方向。",
      "description": "巷口侧肩错开致歉。"
    },
    {
      "id": "lx.text-encounter.b0001.0002",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "提篮的人与推车的人在桥面相遇，推车的人停半息让提篮先过。提篮点头，车轮随即吱呀前行。",
      "description": "桥面让路提篮先过。"
    },
    {
      "id": "lx.text-encounter.b0001.0003",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "少年追着纸片跑过，差点撞上站着看告示的人。纸片被按住，少年喘着道谢离开。",
      "description": "追纸片险撞看告示者。"
    },
    {
      "id": "lx.text-encounter.b0001.0004",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "雨刚停，两人撑伞在窄道对遇，伞骨轻碰又分开。谁也没有停下闲聊。",
      "description": "窄道伞骨轻碰分开。"
    },
    {
      "id": "lx.text-encounter.b0001.0005",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "背篓擦过墙角，干草屑落了一小撮。路过的人抬脚避开，没有抱怨。",
      "description": "背篓落草屑路人避。"
    },
    {
      "id": "lx.text-encounter.b0001.0006",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "晨光里两人同时伸手扶同一扇半开的院门，对视一瞬，一人缩手让另一人先推。",
      "description": "同扶院门一人让。"
    },
    {
      "id": "lx.text-encounter.b0001.0007",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "抱着布卷的人侧身过长廊，布卷轻蹭廊柱。对面来人侧肩，两人无言错开。",
      "description": "长廊抱布侧肩错开。"
    },
    {
      "id": "lx.text-encounter.b0001.0008",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "孩子们绕石柱跑，大人侧步让开，手护着自己的篮。笑声过去后，街面恢复平常步速。",
      "description": "孩童绕柱大人侧让。"
    },
    {
      "id": "lx.text-encounter.b0001.0009",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "夜归者提灯与迎面的人交会，灯火晃了一下彼此的脸。点头后灯火各自远去。",
      "description": "夜提灯交会点头。"
    },
    {
      "id": "lx.text-encounter.b0001.0010",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "卖菜人歇肩时扁担尾扫过路人衣摆，连声道歉。路人摆手，拍了拍衣摆继续走。",
      "description": "扁担扫衣道歉摆手。"
    },
    {
      "id": "lx.text-encounter.b0001.0011",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "取水队列里，有人踮脚看前面还剩几只桶。后面的人保持一臂距离，偶尔换脚。",
      "description": "取水队踮脚换脚。"
    },
    {
      "id": "lx.text-encounter.b0001.0012",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "告示墙前站着两三个人，互不交谈，各自把内容看完才让出空位。",
      "description": "告示前轮看不交谈。"
    },
    {
      "id": "lx.text-encounter.b0001.0013",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "长椅上已坐两人，第三人站着等，直到有人起身才坐下，先道了谢。",
      "description": "长椅第三人等座道谢。"
    },
    {
      "id": "lx.text-encounter.b0001.0014",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "诊室门外的人把号码布条捏皱又展平。门开时大家同时抬头，又同时低头。",
      "description": "门外捏号条同抬头。"
    },
    {
      "id": "lx.text-encounter.b0001.0015",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "渡口边几人坐在石阶上，看对岸船影。有人问开船时刻，得到的回答是：再等等。",
      "description": "渡口问时得再等等。"
    },
    {
      "id": "lx.text-encounter.b0001.0016",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "粮铺开门前，人影在门廊下疏疏站着。开门铃响，队伍自然收成一线。",
      "description": "粮铺开门前疏站。"
    },
    {
      "id": "lx.text-encounter.b0001.0017",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "雨棚下躲雨的人肩挨肩，却很少说话。雨势一缓，有人先探头看天。",
      "description": "躲雨少言有人探天。"
    },
    {
      "id": "lx.text-encounter.b0001.0018",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "公共炉边等开水的人把壶摆成一排。壶嘴朝向不一，主人用脚尖轻轻扳正。",
      "description": "等开水扳正壶嘴。"
    },
    {
      "id": "lx.text-encounter.b0001.0019",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "夜班交接前，早到的人靠墙站成短列。有人打哈欠，有人闭目，无人插队。",
      "description": "夜班交接靠墙短列。"
    },
    {
      "id": "lx.text-encounter.b0001.0020",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "井台边有人等前面的人打完，空桶放在脚边防倒。风过时桶轻响，主人按住。",
      "description": "井台等打水按空桶。"
    },
    {
      "id": "lx.text-encounter.b0001.0021",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "两位陌生人在水台边同洗菜，聊了两句水温，随即各自低头继续。",
      "description": "水台同洗聊水温。"
    },
    {
      "id": "lx.text-encounter.b0001.0022",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "等船时有人问对方从哪边来，得到简短地名后，话题停在天气上。",
      "description": "等船问来处停天气。"
    },
    {
      "id": "lx.text-encounter.b0001.0023",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "廊下歇脚的人互让半个座位，闲聊屋檐漏不漏。结论是：小漏，垫盆就行。",
      "description": "廊下聊屋檐小漏。"
    },
    {
      "id": "lx.text-encounter.b0001.0024",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "买菜时摊主与熟客寒暄收成，旁听的人只笑不插话，付完钱就走。",
      "description": "买菜旁听寒暄不插。"
    },
    {
      "id": "lx.text-encounter.b0001.0025",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "桥上相遇的旧识停了三句：近来可好、还行、改日再聊。错身继续走。",
      "description": "桥上旧识三句错身。"
    },
    {
      "id": "lx.text-encounter.b0001.0026",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "夜市收摊时邻摊互问剩货，有人用剩菜换了半袋米，双方都说公道。",
      "description": "收摊剩货互换公道。"
    },
    {
      "id": "lx.text-encounter.b0001.0027",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "排队取水时前后两人聊井绳该不该换，未达成一致，打完水各自离开。",
      "description": "排队聊井绳未一致。"
    },
    {
      "id": "lx.text-encounter.b0001.0028",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "窗边探头的两家隔街闲聊孩子上学路远不远，街上的人抬眼就低头。",
      "description": "窗边聊上学路。"
    },
    {
      "id": "lx.text-encounter.b0001.0029",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "工歇靠墙的人闲聊工具好不好使，有人递过自己的锉让对方试试手感。",
      "description": "工歇互试锉手感。"
    },
    {
      "id": "lx.text-encounter.b0001.0030",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "雨停后有人互道一路小心，伞尖点地，像给这句话打了个轻句号。",
      "description": "雨停互道小心。"
    },
    {
      "id": "lx.text-encounter.b0001.0031",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "有人停在铁匠铺外看打铁，火花溅起时后退半步。匠人没有抬头。",
      "description": "铁匠铺外看火花退。"
    },
    {
      "id": "lx.text-encounter.b0001.0032",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "孩子们趴窗台看锯末飞，被大人轻声唤走。窗台上留下几个小手印。",
      "description": "孩童观锯末留手印。"
    },
    {
      "id": "lx.text-encounter.b0001.0033",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "路人看石匠凿阶，节奏整齐。石匠歇手喝水时，路人才走近问一句工钱大概。",
      "description": "观凿阶歇手才问价。"
    },
    {
      "id": "lx.text-encounter.b0001.0034",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "织布机声里，门外有人站了一会儿，听完一段循环才离开，没有进门。",
      "description": "门外听织机一循环。"
    },
    {
      "id": "lx.text-encounter.b0001.0035",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "清沟的人把淤泥铲上岸，旁观的人捂鼻却不走开，偶尔指一指哪里还堵。",
      "description": "清沟旁观捂鼻指堵。"
    },
    {
      "id": "lx.text-encounter.b0001.0036",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "修伞摊前围了两个人看换骨，摊主边做边讲步骤，围观者点头但不插手。",
      "description": "修伞看换骨点头。"
    },
    {
      "id": "lx.text-encounter.b0001.0037",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "夜摊切面的人刀起刀落，等候的人目光跟着刀，没有人催。",
      "description": "夜摊看切面不催。"
    },
    {
      "id": "lx.text-encounter.b0001.0038",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "有人搬砖砌矮墙，路过的人估了一下高度，说了句稳，继续赶路。",
      "description": "观砌墙评稳赶路。"
    },
    {
      "id": "lx.text-encounter.b0001.0039",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "染坊晾布，颜色一片片在风里抖。旁观的人站在上风口，怕沾湿色。",
      "description": "染坊上风口旁观。"
    },
    {
      "id": "lx.text-encounter.b0001.0040",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "磨刀人在街角拉磨，火花细小。看客站成半圈，磨完才散，无人讨价。",
      "description": "街角磨刀半圈散。"
    },
    {
      "id": "lx.text-encounter.b0001.0041",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "一只空碗从窗台边沿滑下，被路过的人伸手托住。碗主探头连声道谢，托碗的人把碗举还。",
      "description": "托住滑碗举还道谢。"
    },
    {
      "id": "lx.text-encounter.b0001.0042",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "风掀开未压住的告示一角，有人停下来把石块重新压好，拍净手上的灰。",
      "description": "压回告示角拍灰。"
    },
    {
      "id": "lx.text-encounter.b0001.0043",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "猫从货筐跳进跳出，摊主笑骂一声，邻摊递过一根绳让它玩。猫不玩绳，走了。",
      "description": "猫跳筐邻递绳猫走。"
    },
    {
      "id": "lx.text-encounter.b0001.0044",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "有人鞋带松了，蹲下系时挡住去路。后面的人停步等，没有出声催。",
      "description": "系鞋带挡路后等。"
    },
    {
      "id": "lx.text-encounter.b0001.0045",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "井绳打结卡住，打水的人愣住。旁人递过小刀割断旧结，两人一起重新系。",
      "description": "井绳卡结旁人助系。"
    },
    {
      "id": "lx.text-encounter.b0001.0046",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "夜路灯灭了一盏，有人从窗内递出烛火，让过路的人点着走完这段暗。",
      "description": "窗内递火点夜路。"
    },
    {
      "id": "lx.text-encounter.b0001.0047",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "孩童的纸鸢挂上树，大人拿竹竿挑了两下挑不下。另有人搬来矮凳，才取回纸鸢。",
      "description": "纸鸢挂树凳取回。"
    },
    {
      "id": "lx.text-encounter.b0001.0048",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "雨点突至，摊主与顾客一起收筐，筐叠筐，淋湿了仍互相道谢。",
      "description": "骤雨共收筐互谢。"
    },
    {
      "id": "lx.text-encounter.b0001.0049",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "有人把拾到的扣子放在告示墙凹槽里，用小石压住，旁边用炭写了半个“拾”。",
      "description": "拾扣压凹槽留字。"
    },
    {
      "id": "lx.text-encounter.b0001.0050",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "长椅上的老人打盹，帽被风吹到地上。路过的人捡起轻轻放回椅面，没有叫醒。",
      "description": "捡帽放回不叫醒。"
    }
  ]
}
