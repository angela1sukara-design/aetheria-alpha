{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-encounter",
  "batchId": "text-encounter.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-encounter.b0002.0001",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "学徒抱着木料出门，与进门的顾客侧肩错开。木料角轻蹭门框，学徒回头看了一眼。",
      "description": "学徒抱料与客错肩。"
    },
    {
      "id": "lx.text-encounter.b0002.0002",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "两人合抬柜子出店，路人自动贴墙。柜脚擦地发出短响，抬的人同步换步。",
      "description": "抬柜路人贴墙换步。"
    },
    {
      "id": "lx.text-encounter.b0002.0003",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "送修的人提着旧钟进门，与收工出门的人撞个满怀。旧钟叮当一声，双方道歉。",
      "description": "送钟与收工相撞道歉。"
    },
    {
      "id": "lx.text-encounter.b0002.0004",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "师傅出门倒锯末，锯末扬起，路过的人捂鼻侧开。师傅扬手致歉，继续倒。",
      "description": "倒锯末路人捂鼻。"
    },
    {
      "id": "lx.text-encounter.b0002.0005",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "线轴从架上滚落，被进店的脚尖挡住。进店的人捡起递还，店内人点头致谢。",
      "description": "线轴滚落脚挡递还。"
    },
    {
      "id": "lx.text-encounter.b0002.0006",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "窄过道里两人侧身交会，工具袋铁扣轻轻一碰。两人都停半息，确认没勾住。",
      "description": "窄道工具袋扣轻碰。"
    },
    {
      "id": "lx.text-encounter.b0002.0007",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "学徒追着被风吹起的图纸跑出店门，差点撞上问价的人。图纸被按住，双方喘气笑。",
      "description": "追图纸险撞问价者。"
    },
    {
      "id": "lx.text-encounter.b0002.0008",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "傍晚关铺，门板抬起时外侧有人正好走过，侧肩让开。门板落槽，一日结束。",
      "description": "关铺抬门板路人让。"
    },
    {
      "id": "lx.text-encounter.b0002.0009",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "邻店借锤的人与还锉的人在巷口相遇，互换手中物，点头各自回店。",
      "description": "巷口借还互换点头。"
    },
    {
      "id": "lx.text-encounter.b0002.0010",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "油漆未干的椅腿抬出晾晒，路人绕远半步。抬椅的人说了声小心，路人应了。",
      "description": "晾椅腿路人绕远。"
    },
    {
      "id": "lx.text-encounter.b0002.0011",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "柜台外有人等估价，手指敲着木沿。店内忙碌的人不主动搭话，估价完才抬头。",
      "description": "等估价敲木沿。"
    },
    {
      "id": "lx.text-encounter.b0002.0012",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "修鞋摊前排着三人，第一人脱了鞋坐等。后面的人看着自己的鞋尖发呆。",
      "description": "修鞋摊三人等。"
    },
    {
      "id": "lx.text-encounter.b0002.0013",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "材料铺开门前，常客靠门框站着。开门后自然让老人先，没有人争。",
      "description": "材料铺开门让老人。"
    },
    {
      "id": "lx.text-encounter.b0002.0014",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "取定做件的人报了名字，店员翻簿。等候的人把编号布条捏了又展。",
      "description": "取定做捏编号条。"
    },
    {
      "id": "lx.text-encounter.b0002.0015",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "磨刀等候处放着一只空凳，有人让来让去，最后谁也没坐，都站着聊磨法。",
      "description": "磨刀等空凳未坐。"
    },
    {
      "id": "lx.text-encounter.b0002.0016",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "学徒考试式的旁观圈外，有人等候师傅空手。圈内人不抬头，圈外人换脚。",
      "description": "旁观圈外等空手。"
    },
    {
      "id": "lx.text-encounter.b0002.0017",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "雨天店门口挤着躲雨兼等活的人，肩挨肩。店内灯火，店外雨声。",
      "description": "雨天店门躲雨等活。"
    },
    {
      "id": "lx.text-encounter.b0002.0018",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "染坊取布的队列短，布票捏在手里防潮。前面的人取完，后面的人上前半步。",
      "description": "染坊取布短列。"
    },
    {
      "id": "lx.text-encounter.b0002.0019",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "夜里加班灯亮着，门外仍有人等急件。门开一条缝，对话压得很低。",
      "description": "夜加班门外等急件。"
    },
    {
      "id": "lx.text-encounter.b0002.0020",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "工具租借处，归还的人与租借的人错开高峰。柜上放着等候用的号码牌。",
      "description": "租借错峰号码牌。"
    },
    {
      "id": "lx.text-encounter.b0002.0021",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "两店主在门口闲聊哪家的胶更稠，未争出结果，各自回去继续干活。",
      "description": "闲聊胶稠未果回店。"
    },
    {
      "id": "lx.text-encounter.b0002.0022",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "等估价时邻客互问修过没有，交换了两三句经验，估价叫号时停下。",
      "description": "等估价互换经验。"
    },
    {
      "id": "lx.text-encounter.b0002.0023",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "学徒休息时蹲台阶闲聊针法，师傅路过哼了一声，两人立刻收声又忍不住笑。",
      "description": "学徒聊针法被哼笑。"
    },
    {
      "id": "lx.text-encounter.b0002.0024",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "送修人与店员寒暄天气，真正的损坏要摊开旧物才说。寒暄只是开场。",
      "description": "送修寒暄天气开场。"
    },
    {
      "id": "lx.text-encounter.b0002.0025",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "邻摊互问今日件数，有人说忙，有人说闲。闲的人过去帮忙半个时辰。",
      "description": "互问件数闲者去帮。"
    },
    {
      "id": "lx.text-encounter.b0002.0026",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "磨刀人与看客闲聊刃口角度，看客似懂非懂，仍点头称是。",
      "description": "磨刀聊刃角点头。"
    },
    {
      "id": "lx.text-encounter.b0002.0027",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "收工路上两人并肩，闲聊明天该不该换锯条，到岔路才分开。",
      "description": "收工路聊换锯条。"
    },
    {
      "id": "lx.text-encounter.b0002.0028",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "借工具时多聊了两句木头干湿，借出的人叮嘱：用完擦净再还。",
      "description": "借工具叮嘱擦净。"
    },
    {
      "id": "lx.text-encounter.b0002.0029",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "午歇喝茶，师傅与熟客闲聊旧铺搬迁，学徒在旁听，不插话。",
      "description": "午歇聊旧铺学徒听。"
    },
    {
      "id": "lx.text-encounter.b0002.0030",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "关铺前邻店互道明日见，有人加了句：胶若到了喊我一声。",
      "description": "关铺约喊胶到。"
    },
    {
      "id": "lx.text-encounter.b0002.0031",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "有人停在店外看师傅走线，针脚细密。师傅没有抬头，看客看完一段离开。",
      "description": "店外看走线一段离。"
    },
    {
      "id": "lx.text-encounter.b0002.0032",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "孩子们围看锯末金粉在斜光里翻，被唤走时一步三回头。",
      "description": "孩童看锯末三回头。"
    },
    {
      "id": "lx.text-encounter.b0002.0033",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "路人看两人合抬柜子出门，估了重量，低声说了句沉，继续走。",
      "description": "观抬柜评沉赶路。"
    },
    {
      "id": "lx.text-encounter.b0002.0034",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "学徒打磨，旁观的熟客指出一处不匀，学徒道谢，重新磨那一角。",
      "description": "旁观指出不匀重磨。"
    },
    {
      "id": "lx.text-encounter.b0002.0035",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "烙烫青烟升起，门外看客捂鼻却站着。烟散，看客才走近问价格。",
      "description": "烙烫烟散才问价。"
    },
    {
      "id": "lx.text-encounter.b0002.0036",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "修钟人耳贴钟壳，店内外一时静。有人想问，被同伴拉袖示意别吵。",
      "description": "听钟静旁人止问。"
    },
    {
      "id": "lx.text-encounter.b0002.0037",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "夜灯下缝补的人影投在窗纸，路过的人停两步，辨不出缝的是什么。",
      "description": "夜窗纸缝影停两步。"
    },
    {
      "id": "lx.text-encounter.b0002.0038",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "配钥匙的人锉齿，金属屑细亮。看客站半圈，配完才散，无人催。",
      "description": "配钥半圈散不催。"
    },
    {
      "id": "lx.text-encounter.b0002.0039",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "有人刷漆，旁观怕沾，站在上风。刷完一道，旁观才评色浅。",
      "description": "上风观刷漆评色。"
    },
    {
      "id": "lx.text-encounter.b0002.0040",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "量布的人展开整匹，旁观帮按住布角。量完，旁观松手，没有讨布头。",
      "description": "旁观按布角不讨头。"
    },
    {
      "id": "lx.text-encounter.b0002.0041",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "胶水瓶盖拧不开，学徒递过布垫手。盖开了，两人都松了口气。",
      "description": "胶盖拧不开递布垫。"
    },
    {
      "id": "lx.text-encounter.b0002.0042",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "猫跳上工作台，踩过未干的墨线。师傅把猫抱下，墨线重画，猫若无其事。",
      "description": "猫踩墨线抱下重画。"
    },
    {
      "id": "lx.text-encounter.b0002.0043",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "突然停电似的——灯芯灭了。有人借邻店火种重新点亮，活计停了半息。",
      "description": "灯灭借火重点。"
    },
    {
      "id": "lx.text-encounter.b0002.0044",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "钉子箱翻倒，钉撒一地。店内几人同时蹲下捡，按长短分回格。",
      "description": "钉翻倒共捡分格。"
    },
    {
      "id": "lx.text-encounter.b0002.0045",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "有人把拾到的顶针放在柜台凹槽，用粉笔写了半个“拾”，压上小木块。",
      "description": "拾顶针留字压木。"
    },
    {
      "id": "lx.text-encounter.b0002.0046",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "学徒打哈欠太狠，针掉进地板缝。全店安静找针，找到时一起笑出声。",
      "description": "针落缝全店找笑。"
    },
    {
      "id": "lx.text-encounter.b0002.0047",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "雨漏正好滴在待修的布上，有人迅速挪布，另有人去搬盆接漏。",
      "description": "雨漏滴布挪布搬盆。"
    },
    {
      "id": "lx.text-encounter.b0002.0048",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "顾客忘拿找回的小票，跑回店时店员已把小票压在门缝。",
      "description": "忘票跑回压门缝。"
    },
    {
      "id": "lx.text-encounter.b0002.0049",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "锯条崩断，大家都停手。师傅换新条，大家才继续，像约好的休息。",
      "description": "锯崩停手换条再续。"
    },
    {
      "id": "lx.text-encounter.b0002.0050",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "关铺时发现一把客留的伞，挂在门外钩上，明日待领。",
      "description": "客伞挂外钩待领。"
    }
  ]
}
