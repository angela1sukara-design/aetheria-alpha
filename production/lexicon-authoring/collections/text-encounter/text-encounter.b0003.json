{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-encounter",
  "batchId": "text-encounter.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-encounter.b0003.0001",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "提桶的人与撑伞的人在渠岸窄道错开，水荡出几点，撑伞的人侧肩未恼。",
      "description": "渠岸提桶撑伞错开。"
    },
    {
      "id": "lx.text-encounter.b0003.0002",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "孩子们追漂叶跑过桥，差点撞上洗衣归家的人。叶漂远了，孩子道歉离开。",
      "description": "追漂叶险撞洗衣人。"
    },
    {
      "id": "lx.text-encounter.b0003.0003",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "雨棚下两人侧肩交会，湿衣相贴一瞬又分开。彼此点头，雨声填满间隙。",
      "description": "棚下湿衣贴分点头。"
    },
    {
      "id": "lx.text-encounter.b0003.0004",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "背网的人与推车的人在船坞木板相遇，背网的人贴桩让车，车轮溅起细水。",
      "description": "船坞背网让推车。"
    },
    {
      "id": "lx.text-encounter.b0003.0005",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "雾中人影先于招呼相遇，两人同时侧肩，伞骨轻碰，雾里笑声短促。",
      "description": "雾中侧肩伞碰短笑。"
    },
    {
      "id": "lx.text-encounter.b0003.0006",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "扛湿菜的人与打伞的人交会，菜叶甩出一滴，打在伞面。双方摆手说没事。",
      "description": "菜叶甩伞面摆手。"
    },
    {
      "id": "lx.text-encounter.b0003.0007",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "夜提灯沿渠走，与对向灯火交会，金线在水面交叉一瞬，人错开后金线分开。",
      "description": "夜灯渠岸金线交叉。"
    },
    {
      "id": "lx.text-encounter.b0003.0008",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "蕨架间侧身交会，肘部收紧，水珠仍被碰落几滴。两人都说了对不起。",
      "description": "蕨架侧身碰落珠。"
    },
    {
      "id": "lx.text-encounter.b0003.0009",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "晒台上躲滴衣的人与下阶的人侧身，滴衣主人在旁不好意思地笑。",
      "description": "晒台躲滴衣侧身笑。"
    },
    {
      "id": "lx.text-encounter.b0003.0010",
      "category": "text-encounter",
      "subcategory": "擦肩场景",
      "text": "解缆的人甩绳，绳尾扫过路过的裤脚。解缆的人喊小心，路过的人抬脚避开。",
      "description": "甩绳扫裤脚避让。"
    },
    {
      "id": "lx.text-encounter.b0003.0011",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "取水短列里，前后保持湿靴不互踩的距离。有人哼不成调的歌，有人闭目。",
      "description": "取水短列湿靴距。"
    },
    {
      "id": "lx.text-encounter.b0003.0012",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "渡口石阶上几人看对岸，问开船，答再等等。雨丝斜过，有人把帽檐压低。",
      "description": "渡口再等等压帽。"
    },
    {
      "id": "lx.text-encounter.b0003.0013",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "雨棚下躲雨的人肩挨肩，雨一缓有人先探头。探头的人说：还可以等。",
      "description": "躲雨探头还可等。"
    },
    {
      "id": "lx.text-encounter.b0003.0014",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "闸旁等放水的人把空桶排好。闸声一响，队列微微前倾，又自觉站直。",
      "description": "等放水闸响前倾。"
    },
    {
      "id": "lx.text-encounter.b0003.0015",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "补网摊前有人等候交网，网堆在脚边防潮布上。补网的人抬头叫号才上前。",
      "description": "补网等叫号上前。"
    },
    {
      "id": "lx.text-encounter.b0003.0016",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "船坞边等潮的人坐着织绳，偶尔抬眼算水位。水位未到，绳继续织。",
      "description": "等潮织绳抬眼算。"
    },
    {
      "id": "lx.text-encounter.b0003.0017",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "公共炉边等开水，壶嘴扳正朝同一方向。蒸汽里有人搓手，有人拍湿帽。",
      "description": "等开水扳壶嘴。"
    },
    {
      "id": "lx.text-encounter.b0003.0018",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "诊棚外湿地上垫着石块当座，等候的人轮流坐，坐的人起身时拍净石面。",
      "description": "诊棚湿地石座轮坐。"
    },
    {
      "id": "lx.text-encounter.b0003.0019",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "夜班交接靠棚柱站成短列，灯火映着湿靴。无人插队，哈欠此起彼落。",
      "description": "夜班棚柱湿靴列。"
    },
    {
      "id": "lx.text-encounter.b0003.0020",
      "category": "text-encounter",
      "subcategory": "公共等候",
      "text": "井台边等打水，空桶垫鞋边。前面的人绳卡结，后面的人上前帮忙，队列未乱。",
      "description": "井台卡结帮忙队列稳。"
    },
    {
      "id": "lx.text-encounter.b0003.0021",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "渠边同洗衣的人聊了两句水温与皂，随即各自低头搓。",
      "description": "同洗聊水温与皂。"
    },
    {
      "id": "lx.text-encounter.b0003.0022",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "躲雨时邻人互问家远不远，话题停在雨会不会整晚。结论：大概不会。",
      "description": "躲雨聊雨会否整夜。"
    },
    {
      "id": "lx.text-encounter.b0003.0023",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "等船时闲聊对岸新棚，有人说好看，有人说挡风。船到，话题中断。",
      "description": "等船聊对岸棚中断。"
    },
    {
      "id": "lx.text-encounter.b0003.0024",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "补网旁观者与补网人闲聊网眼大小，旁观者似懂非懂，仍递线头。",
      "description": "聊网眼递线头。"
    },
    {
      "id": "lx.text-encounter.b0003.0025",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "雾中汇合的熟人先确认是谁，再闲聊能见度，笑声被雾吃掉一半。",
      "description": "雾中确认再聊能见度。"
    },
    {
      "id": "lx.text-encounter.b0003.0026",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "晒台上下的人互道小心滴水，滴衣主人不好意思，听的人说没事。",
      "description": "晒台聊滴水道没事。"
    },
    {
      "id": "lx.text-encounter.b0003.0027",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "工歇靠闸闲聊潮位，有人用小棍在泥上画涨落线，画完被水冲淡。",
      "description": "闲聊潮位泥画线。"
    },
    {
      "id": "lx.text-encounter.b0003.0028",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "夜提灯相遇，闲聊三句：还在走、快到了、灯借我看一眼路。灯还回，人分开。",
      "description": "夜灯闲聊借光看路。"
    },
    {
      "id": "lx.text-encounter.b0003.0029",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "买鱼时摊主与熟客寒暄渔获，旁听的人只笑，付完就走，衣摆带着水腥。",
      "description": "买鱼旁听寒暄即走。"
    },
    {
      "id": "lx.text-encounter.b0003.0030",
      "category": "text-encounter",
      "subcategory": "临时闲聊",
      "text": "雨停互道一路小心，伞尖点湿石，像给这句话按了个水印。",
      "description": "雨停互道小心点石。"
    },
    {
      "id": "lx.text-encounter.b0003.0031",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "有人蹲闸旁看补网，补网人不抬头，偶尔应声。看完一段，看客离开。",
      "description": "闸旁看补网一段离。"
    },
    {
      "id": "lx.text-encounter.b0003.0032",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "清渠的人铲淤，旁观捂鼻指堵点。清渠的人点头，铲向被指处。",
      "description": "清渠旁观指堵点。"
    },
    {
      "id": "lx.text-encounter.b0003.0033",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "织绳的人坐船坞，路过的人停步看手法，看完说了句稳，继续搬货。",
      "description": "观织绳评稳搬货。"
    },
    {
      "id": "lx.text-encounter.b0003.0034",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "孩子们看水车齿轮，被大人唤走。水车仍吱呀，孩子一步三回头。",
      "description": "童观水车三回头。"
    },
    {
      "id": "lx.text-encounter.b0003.0035",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "晾晒渔网的人抖网，水珠成雨。旁观站上风，怕湿，仍站着看完一网。",
      "description": "上风观抖网一网。"
    },
    {
      "id": "lx.text-encounter.b0003.0036",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "修浮板的人钉防滑条，锤声短促。看客站半圈，钉完才散。",
      "description": "修浮板钉条半圈散。"
    },
    {
      "id": "lx.text-encounter.b0003.0037",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "夜灯下补帆的针影投在布面，路过的人停两步，辨不出补的是哪一角。",
      "description": "夜补帆针影停两步。"
    },
    {
      "id": "lx.text-encounter.b0003.0038",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "放闸时有人专门来看水流涌出。闸工不赶人，看客看够了自己走。",
      "description": "放闸观流看够自走。"
    },
    {
      "id": "lx.text-encounter.b0003.0039",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "有人刷防滑漆，旁观怕踩湿，绕道，仍回头看色。",
      "description": "刷防滑漆旁观绕道看。"
    },
    {
      "id": "lx.text-encounter.b0003.0040",
      "category": "text-encounter",
      "subcategory": "工作旁观",
      "text": "量潮尺旁站着记录的人，路过的人问今日水位，得到一个短数字就离开。",
      "description": "量潮旁问水位得数字。"
    },
    {
      "id": "lx.text-encounter.b0003.0041",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "空碗从棚台滑向水渠，被路过的人用竿轻轻一挡，碗转了向，主人追来道谢。",
      "description": "竿挡滑碗主人谢。"
    },
    {
      "id": "lx.text-encounter.b0003.0042",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "猫沿渠边走，踩翻皂角碟。洗衣人笑骂，邻人递过布抹，猫已跳上蕨架。",
      "description": "猫翻皂碟递布抹。"
    },
    {
      "id": "lx.text-encounter.b0003.0043",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "井绳卡结，打水人愣住。旁人递小刀割旧结，两人一起重系，手都沾着湿。",
      "description": "井绳卡结共重系。"
    },
    {
      "id": "lx.text-encounter.b0003.0044",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "骤雨至，摊与客一起收筐，淋湿仍互谢。雨棚下挤进更多人，肩挨肩笑。",
      "description": "骤雨共收筐棚下笑。"
    },
    {
      "id": "lx.text-encounter.b0003.0045",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "孩童纸船卡在闸缝，大人用钩捞出，纸船湿透，孩童仍高兴。",
      "description": "纸船卡闸钩捞湿透。"
    },
    {
      "id": "lx.text-encounter.b0003.0046",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "灯笼被风吹落水面，有人用网捞起，火已灭，灯笼主人道谢抱走。",
      "description": "灯落水网捞火灭。"
    },
    {
      "id": "lx.text-encounter.b0003.0047",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "有人把拾到的发卡压在告示凹槽，炭写半个“拾”，小石压住防风。",
      "description": "拾发卡留字压石。"
    },
    {
      "id": "lx.text-encounter.b0003.0048",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "浮板绳松，站上面的人微晃。岸上人扔绳头，两人一起勒紧桩。",
      "description": "浮板绳松共勒桩。"
    },
    {
      "id": "lx.text-encounter.b0003.0049",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "夜路棚灯灭，窗内递出烛火，过路人点着走完湿暗段，烛还回窗。",
      "description": "棚灯灭窗递火还烛。"
    },
    {
      "id": "lx.text-encounter.b0003.0050",
      "category": "text-encounter",
      "subcategory": "生活小插曲",
      "text": "长椅老人打盹，帽被风吹落近水。路过的人捡起放回椅面，老人未醒。",
      "description": "近水捡帽放回未醒。"
    }
  ]
}
