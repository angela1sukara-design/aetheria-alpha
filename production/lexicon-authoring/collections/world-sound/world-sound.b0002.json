{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-sound",
  "batchId": "world-sound.b0002",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.world-sound.b0002.0001",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "刨刀吃木时嘶声平稳，遇节疤突然发闷一顿。",
      "description": "材料不均造成的声色突变。"
    },
    {
      "id": "lx.world-sound.b0002.0002",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "台钳旋紧末两圈金属嘎吱更尖，到位后静。",
      "description": "夹紧动作的声级爬升。"
    },
    {
      "id": "lx.world-sound.b0002.0003",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "砂轮接触工件嘶出高频，火花声细碎夹在其间。",
      "description": "磨削的高频与颗粒声。"
    },
    {
      "id": "lx.world-sound.b0002.0004",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "缝纫机空踩嗒嗒疏，上布后节奏变密变沉。",
      "description": "负载改变缝纫节奏。"
    },
    {
      "id": "lx.world-sound.b0002.0005",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "锤子敲錾子，金属传声清脆，木柄吸掉一部分。",
      "description": "组合工具的音色分层。"
    },
    {
      "id": "lx.world-sound.b0002.0006",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "砂纸来回沙沙，换细目后声变细而密。",
      "description": "粒度决定的摩擦声谱。"
    },
    {
      "id": "lx.world-sound.b0002.0007",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "胶水瓶盖拧开细响，刷胶时黏滞声贴板面。",
      "description": "涂胶工序的近距小声。"
    },
    {
      "id": "lx.world-sound.b0002.0008",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "直尺弹离木面啪一声，用于检查平面度。",
      "description": "检测动作的短暂声提示。"
    },
    {
      "id": "lx.world-sound.b0002.0009",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "手锯推拉节奏分明，出屑时声略沙。",
      "description": "往复锯切的周期声。"
    },
    {
      "id": "lx.world-sound.b0002.0010",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "钻头刚入木尖啸一瞬，钻深后转为闷转。",
      "description": "钻孔阶段的声色转变。"
    },
    {
      "id": "lx.world-sound.b0002.0011",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "茶炊盖子轻颤，水将开时细密鼓泡声升起。",
      "description": "作坊茶歇的水声预告。"
    },
    {
      "id": "lx.world-sound.b0002.0012",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "学徒压低声音问尺寸，师傅嗯一声确认。",
      "description": "协作中的低声对话。"
    },
    {
      "id": "lx.world-sound.b0002.0013",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "午休有人翻报纸，纸页摩擦声在安静工位放大。",
      "description": "休息时段的生活微声。"
    },
    {
      "id": "lx.world-sound.b0002.0014",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "椅子腿挪开半寸，木地板轻响，随即坐下叹息。",
      "description": "起身落座的声与气。"
    },
    {
      "id": "lx.world-sound.b0002.0015",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "拉链拉上工具包，齿合声短促，包口扣一下。",
      "description": "收纳结束的声标记。"
    },
    {
      "id": "lx.world-sound.b0002.0016",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "擦汗毛巾抖开啪一声，又轻轻搭回肩。",
      "description": "劳作间歇的身体护理声。"
    },
    {
      "id": "lx.world-sound.b0002.0017",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "客户推门铃轻响，屋内锤声自觉停半拍。",
      "description": "礼貌回应访客的声暂停。"
    },
    {
      "id": "lx.world-sound.b0002.0018",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "窗边有人用指甲轻扣玻璃叫同伴看样。",
      "description": "非正式联络的轻叩声。"
    },
    {
      "id": "lx.world-sound.b0002.0019",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "共享杯叠放轻碰，瓷声脆而不响亮。",
      "description": "茶角收纳的克制碰撞。"
    },
    {
      "id": "lx.world-sound.b0002.0020",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "夜修结束拉闸，灯管余辉里脚步放得很轻。",
      "description": "收工时的音量自觉。"
    },
    {
      "id": "lx.world-sound.b0002.0021",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "窗外麻雀踩过刨花堆，细碎踩踏声传进室内。",
      "description": "室外动物与废料的接触声。"
    },
    {
      "id": "lx.world-sound.b0002.0022",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "风掀棚布啪啪两下，又把木屑扬起细沙声。",
      "description": "风对作坊外围的扰动。"
    },
    {
      "id": "lx.world-sound.b0002.0023",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "雨打铁皮棚顶由疏转密，室内说话须略抬声。",
      "description": "降水改变室内所需音量。"
    },
    {
      "id": "lx.world-sound.b0002.0024",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "蜜蜂误入，翅振贴窗嗡嗡，被纸轻轻引导出去。",
      "description": "短暂昆虫闯入的声事件。"
    },
    {
      "id": "lx.world-sound.b0002.0025",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "午后蝉鸣隔着纱窗变闷，像隔了一层布。",
      "description": "纱窗滤波后的自然声。"
    },
    {
      "id": "lx.world-sound.b0002.0026",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "夜深只剩树叶摩擦，偶有一滴冷凝水砸盆。",
      "description": "低活动时的自然底噪。"
    },
    {
      "id": "lx.world-sound.b0002.0027",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "猫从窗台跳进，落地声软，随即蹭工具架轻响。",
      "description": "熟悉动物进出的声迹。"
    },
    {
      "id": "lx.world-sound.b0002.0028",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "雷远滚一圈，砂轮声显得更近更尖。",
      "description": "远雷衬托近机械的对比。"
    },
    {
      "id": "lx.world-sound.b0002.0029",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "晒场布单被风鼓起，啪地回落又鼓。",
      "description": "织物在风中的拍击周期。"
    },
    {
      "id": "lx.world-sound.b0002.0030",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "屋檐融雪滴成串，滴速随日照强弱变。",
      "description": "温度驱动的滴水节奏。"
    },
    {
      "id": "lx.world-sound.b0002.0031",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "砂轮机空转嗡鸣平稳，上工件后音调微降。",
      "description": "负载改变电机基频。"
    },
    {
      "id": "lx.world-sound.b0002.0032",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "台钻皮带偶尔打滑尖啸一瞬，张紧后恢复。",
      "description": "传动异常的短时声。"
    },
    {
      "id": "lx.world-sound.b0002.0033",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "排风扇百叶颤振，风速档一换颤音跟着变。",
      "description": "通风设备的可辨档位声。"
    },
    {
      "id": "lx.world-sound.b0002.0034",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "蒸汽熨斗放气嘶一声，压力回升后静哼。",
      "description": "间歇泄压的蒸汽机构。"
    },
    {
      "id": "lx.world-sound.b0002.0035",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "电动螺丝刀到位离合器咔嗒，螺钉停转。",
      "description": "扭矩限制的到位声。"
    },
    {
      "id": "lx.world-sound.b0002.0036",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "空压机储气罐泄压短促，管道随之轻震。",
      "description": "气源系统的脉冲声。"
    },
    {
      "id": "lx.world-sound.b0002.0037",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "旧缝纫机电机炭刷轻微嘶嘶，转速不稳时更显。",
      "description": "老化电机的特征噪声。"
    },
    {
      "id": "lx.world-sound.b0002.0038",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "砂带机跑偏报警蜂鸣短促，调正后停。",
      "description": "安全提示的非连续声。"
    },
    {
      "id": "lx.world-sound.b0002.0039",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "砂光吸尘管吸着木屑，管壁细沙声连续。",
      "description": "气力输送的材料摩擦声。"
    },
    {
      "id": "lx.world-sound.b0002.0040",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "计时器扭簧上紧咔咔，倒数末段滴答加快。",
      "description": "机械计时的节奏变化。"
    },
    {
      "id": "lx.world-sound.b0002.0041",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "近处锉刀细嘶，隔间锤击闷响，门外车声薄。",
      "description": "工位、邻间、街道三层。"
    },
    {
      "id": "lx.world-sound.b0002.0042",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "师傅在身后低声指导，前方砂轮声像一道墙。",
      "description": "人声与强噪声的前后关系。"
    },
    {
      "id": "lx.world-sound.b0002.0043",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "先听见远处砂轮停转，片刻后自己工位也静。",
      "description": "连锁停工的时间差声景。"
    },
    {
      "id": "lx.world-sound.b0002.0044",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "窗外叫卖远而尖，窗内线轴落地近而闷。",
      "description": "室内外音色与距离对照。"
    },
    {
      "id": "lx.world-sound.b0002.0045",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "楼上脚步轻移，楼下胶味区排风扇低吼更清楚。",
      "description": "垂直空间不同声源的凸显。"
    },
    {
      "id": "lx.world-sound.b0002.0046",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "近处圆规划线几乎无声，远处电钻却像贴耳。",
      "description": "响度错觉与实际距离。"
    },
    {
      "id": "lx.world-sound.b0002.0047",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "收工铃近处清脆，巷尾回声软成一声嗡。",
      "description": "同一铃声的近远变形。"
    },
    {
      "id": "lx.world-sound.b0002.0048",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "学徒耳语在侧，材料仓库门在深处哐当合上。",
      "description": "极近人声与深远物声。"
    },
    {
      "id": "lx.world-sound.b0002.0049",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "雨声在棚顶密，传到里间只剩均匀沙底。",
      "description": "棚结构衰减后的远雨。"
    },
    {
      "id": "lx.world-sound.b0002.0050",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "夜班只留一台机，远处犬吠反而显得很近。",
      "description": "背景变静后的距离错觉。"
    }
  ]
}
