{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-sound",
  "batchId": "world-sound.b0003",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.world-sound.b0003.0001",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "收网绞盘咔咔间歇，绳湿时声更闷。",
      "description": "渔作机械遇湿的声色。"
    },
    {
      "id": "lx.world-sound.b0003.0002",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "竹篙点石轻叩，船身随之轻轻一顿。",
      "description": "撑船接触点的声与动。"
    },
    {
      "id": "lx.world-sound.b0003.0003",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "闸门齿条咬合嘎嘎上升，水声同时变调。",
      "description": "启闭与水流声的耦合。"
    },
    {
      "id": "lx.world-sound.b0003.0004",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "清淤钩刮渠底，泥浆吸吮声黏而短。",
      "description": "维护作业的泥水声。"
    },
    {
      "id": "lx.world-sound.b0003.0005",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "晒网绷绳绷紧时弦声细响，到位后静。",
      "description": "张网工序的张力声。"
    },
    {
      "id": "lx.world-sound.b0003.0006",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "洗菜砧在水边剁，水花声与砧板声叠拍。",
      "description": "临水食品处理的复合声。"
    },
    {
      "id": "lx.world-sound.b0003.0007",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "船底刮铲节奏稳定，偶遇硬壳喀一声。",
      "description": "维护船体的接触变化。"
    },
    {
      "id": "lx.world-sound.b0003.0008",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "水位尺旁粉笔划写沙沙，短促几下停。",
      "description": "观测记录的书写微声。"
    },
    {
      "id": "lx.world-sound.b0003.0009",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "缆绳抛上岸砸木板闷响，随即摩擦收紧。",
      "description": "系泊动作的声序列。"
    },
    {
      "id": "lx.world-sound.b0003.0010",
      "category": "world-sound",
      "subcategory": "工作声",
      "text": "雨棚积叶疏通，杆捅落叶簌簌坠入槽。",
      "description": "维护落叶的坠落声。"
    },
    {
      "id": "lx.world-sound.b0003.0011",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "渡口有人轻咳一声，廊内回音拉长半拍。",
      "description": "半封闭廊的人声回响。"
    },
    {
      "id": "lx.world-sound.b0003.0012",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "茶摊瓷杯放下轻磕，谈话声随即盖过。",
      "description": "社交场合的器物点缀声。"
    },
    {
      "id": "lx.world-sound.b0003.0013",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "换干靴时鞋底拍石台两下，泥点细碎落下。",
      "description": "登岸换装的习惯声。"
    },
    {
      "id": "lx.world-sound.b0003.0014",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "孩童用卵石打漂，点水声一串渐远。",
      "description": "游戏声沿水面的距离衰减。"
    },
    {
      "id": "lx.world-sound.b0003.0015",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "船屋窗内收音机播天气，音量压过轻浪。",
      "description": "居住声源与自然声的竞争。"
    },
    {
      "id": "lx.world-sound.b0003.0016",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "雨披拉链拉上，齿声被雨声切成断续。",
      "description": "动作声被环境雨声掩蔽。"
    },
    {
      "id": "lx.world-sound.b0003.0017",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "邻船有人洗碗，水泼声贴舷传来又弱。",
      "description": "近距水居生活声的贴传。"
    },
    {
      "id": "lx.world-sound.b0003.0018",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "夜渔灯下低声说话，笑声偶尔亮一下。",
      "description": "克制交谈中的突发亮声。"
    },
    {
      "id": "lx.world-sound.b0003.0019",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "晾衣绳滑轮轻响，湿衣滴水打在桶沿。",
      "description": "晾晒相关的双声源。"
    },
    {
      "id": "lx.world-sound.b0003.0020",
      "category": "world-sound",
      "subcategory": "生活声",
      "text": "门帘被风掀起又落下，布打门框啪一声。",
      "description": "风驱动的生活构件声。"
    },
    {
      "id": "lx.world-sound.b0003.0021",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "浪拍栈桩有节奏，涨潮时间隔缩短。",
      "description": "水位改变拍击周期。"
    },
    {
      "id": "lx.world-sound.b0003.0022",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "芦苇丛风声沙沙，深处偶有鸟扑棱。",
      "description": "植被风噪中的突发鸟声。"
    },
    {
      "id": "lx.world-sound.b0003.0023",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "蛙鸣从渠边此起彼伏，靠近能分出远近两团。",
      "description": "群鸣的空间可分性。"
    },
    {
      "id": "lx.world-sound.b0003.0024",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "雨打荷叶密而脆，打水面则闷而连。",
      "description": "不同落点的雨音色。"
    },
    {
      "id": "lx.world-sound.b0003.0025",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "鱼跃出水啪一声，涟漪摩擦声细不可闻。",
      "description": "瞬时水面扰动声。"
    },
    {
      "id": "lx.world-sound.b0003.0026",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "晨雾中鸟鸣发闷，雾散后同一声变亮。",
      "description": "大气条件改变的音色。"
    },
    {
      "id": "lx.world-sound.b0003.0027",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "蟹在石缝爬行细碎刮擦，静止时只剩水声。",
      "description": "底栖动物的近距微声。"
    },
    {
      "id": "lx.world-sound.b0003.0028",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "潮退时泥面吸气般嘶嘶，气泡破裂细密。",
      "description": "滩涂排气的自然声。"
    },
    {
      "id": "lx.world-sound.b0003.0029",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "蜻蜓翅振贴耳一瞬，飞远即融进风噪。",
      "description": "近距昆虫声的快速消失。"
    },
    {
      "id": "lx.world-sound.b0003.0030",
      "category": "world-sound",
      "subcategory": "自然声",
      "text": "夜岸虫声与远浪低鸣叠成两层底噪。",
      "description": "近虫远浪的稳定分层。"
    },
    {
      "id": "lx.world-sound.b0003.0031",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "趸船发电机匀速低吼，振动经甲板传到脚。",
      "description": "船用动力的声振耦合。"
    },
    {
      "id": "lx.world-sound.b0003.0032",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "水泵抽潮灌渠，管口出水声随阀门开度变。",
      "description": "可控流量的水机声。"
    },
    {
      "id": "lx.world-sound.b0003.0033",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "浮桥铰链缺油时尖啸，补油后变闷摩擦。",
      "description": "维护状态改变的机械声。"
    },
    {
      "id": "lx.world-sound.b0003.0034",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "航标灯继电器夜半轻嗒，间隔固定。",
      "description": "助航设备的周期微声。"
    },
    {
      "id": "lx.world-sound.b0003.0035",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "机动舢板怠速突突，离岸后被浪声盖住。",
      "description": "移动声源的远距掩蔽。"
    },
    {
      "id": "lx.world-sound.b0003.0036",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "闸房启闭电机蜂鸣爬升，到位电磁制动咔。",
      "description": "启停完整的电机声程。"
    },
    {
      "id": "lx.world-sound.b0003.0037",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "冷藏船压缩机间歇启动，岸上听来一阵一阵。",
      "description": "远距间歇工业声。"
    },
    {
      "id": "lx.world-sound.b0003.0038",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "缆车式过河器滑轮嘶嘶，到站缓冲弹簧闷响。",
      "description": "摆渡机械的运行与到位。"
    },
    {
      "id": "lx.world-sound.b0003.0039",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "雨刮改装在瞭望窗，刮片节奏盖过轻雨。",
      "description": "人工机械对自然雨声的覆盖。"
    },
    {
      "id": "lx.world-sound.b0003.0040",
      "category": "world-sound",
      "subcategory": "机械声",
      "text": "充电箱风扇低鸣，箱门一关声被闷住一半。",
      "description": "开闭改变的设备声泄漏。"
    },
    {
      "id": "lx.world-sound.b0003.0041",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "近处滴檐清晰，河心浪声成片，对岸锤钉薄而尖。",
      "description": "岸、河、对岸三层声景。"
    },
    {
      "id": "lx.world-sound.b0003.0042",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "船上传话先于船体靠岸声到达。",
      "description": "声音快于可见接触的远近。"
    },
    {
      "id": "lx.world-sound.b0003.0043",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "闸门近处金属嘎嘎，下游水声要数秒后变响。",
      "description": "操作与后果声的时间差。"
    },
    {
      "id": "lx.world-sound.b0003.0044",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "廊内脚步清楚，廊外雨被柱列切成一段段。",
      "description": "建筑分隔的雨声离散化。"
    },
    {
      "id": "lx.world-sound.b0003.0045",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "近处缆绳摩擦，远处渡轮汽笛被雾滤成圆润低音。",
      "description": "雾天远距声的频谱变钝。"
    },
    {
      "id": "lx.world-sound.b0003.0046",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "孩童笑在滩涂近处跳，渔号子在上游线状传来。",
      "description": "点状近声与线状远声。"
    },
    {
      "id": "lx.world-sound.b0003.0047",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "雨停后近处只剩水落管，远处雷仍在山后滚。",
      "description": "局部停雨与远雷的并存。"
    },
    {
      "id": "lx.world-sound.b0003.0048",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "耳边是自己靴子吸泥声，远处是连片蛙鸣墙。",
      "description": "自我噪声与远距声墙。"
    },
    {
      "id": "lx.world-sound.b0003.0049",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "茶摊谈话贴耳，河风偶把对岸锯木声送过来。",
      "description": "风向改变的远距可听性。"
    },
    {
      "id": "lx.world-sound.b0003.0050",
      "category": "world-sound",
      "subcategory": "远近层次",
      "text": "夜静时能听见上游水闸泄流的匀速沙沙。",
      "description": "背景降低后的远距水工声。"
    }
  ]
}
