{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-emotion",
  "batchId": "text-emotion.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-emotion.b0001.0001",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "门牌被风吹响时有人循声找来，我竟觉得有点开心。",
      "description": "因偶遇产生的轻快高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0002",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "粥摊第一碗还冒着热气，捧在手里就踏实了。",
      "description": "对热食的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0003",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "长椅腿修好了，坐下去不晃，心里轻快一截。",
      "description": "因修复完成高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0004",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "告示贴正了，路过的人看得清，我松了口气也笑了。",
      "description": "事务顺利的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0005",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "猫在井边蹭了我小腿一下，一整天都带着笑意。",
      "description": "小动物带来的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0006",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "余盐按公平价成交，买卖双方都点头，痛快。",
      "description": "公平交易的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0007",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "窗台陶罐挪开后光线进来，房间亮得让人想哼歌。",
      "description": "环境改善的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0008",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "轮值对调谈妥，双方都不勉强，难得舒畅。",
      "description": "协商顺利的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0009",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "公共板收到一句谢谢，字丑，但我高兴。",
      "description": "被感谢的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0010",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "地砖干了，走路不再黏鞋，小确幸。",
      "description": "琐事顺遂的高兴。"
    },
    {
      "id": "lx.text-emotion.b0001.0011",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "水费单填了两遍还是格对不齐，越填越烦。",
      "description": "表格带来的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0012",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "路灯通知写得含糊，心里堵得慌。",
      "description": "信息不清的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0013",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "巷口传闻来回传三遍，听得我耳朵生茧。",
      "description": "传闻导致的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0014",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "清扫工具又被乱放，找了半天才见，窝火。",
      "description": "秩序被破坏的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0015",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "炉子报修催了两次还没回音，耐心磨薄了。",
      "description": "等待中的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0016",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "粥一个味吃了五天，不是讨厌，是腻。",
      "description": "重复的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0017",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "门牌擦完又被泥点溅到，功亏一篑的烦。",
      "description": "返工烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0018",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "有人把长椅独占到黄昏，想坐都不能，闷。",
      "description": "公共空间被占的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0019",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "粮站队伍挪得像没挪，腿酸心也酸。",
      "description": "排队烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0020",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "窗关不严，夜里呜呜响，睡意全被搅散。",
      "description": "噪声烦闷。"
    },
    {
      "id": "lx.text-emotion.b0001.0021",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "旧招牌字迹淡了，我还记得它新的时候。",
      "description": "对旧物褪色的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0022",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "那只不认生的猫后来再没跟来，有点可惜。",
      "description": "对中断偶遇的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0023",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "南市那批素色布卖完了，我去晚了一步。",
      "description": "错过好物的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0024",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "井台边的草被踩秃了一圈，夏天会更晒。",
      "description": "对环境损耗的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0025",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "轮值名单上有个名字被划掉，不知搬去哪儿了。",
      "description": "对邻里变迁的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0026",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "陶罐裂了一道细纹，还能用，却再也端不正。",
      "description": "对器物损伤的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0027",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "廊灯今天偏黄，像在提醒灯芯也老了。",
      "description": "对老化的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0028",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "有人把公共板的谢谢纸条揭走了，空得慌。",
      "description": "对善意痕迹消失的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0029",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "地砖湿滑时有人摔倒，自己爬起来走了，我没来得及扶。",
      "description": "对未能及时帮助的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0030",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "练琴的声音停了好几晚，巷子突然安静得过分。",
      "description": "对熟悉声响消失的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0001.0031",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "门牌对上了，心里那根弦松下来。",
      "description": "核实完成后的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0032",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "报修终于有人接单，悬着的事落地了。",
      "description": "事务推进的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0033",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "轮值对调谈开，谁也不欠谁，轻松。",
      "description": "关系理顺的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0034",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "余盐不买也行，家里还够，逼自己的劲消了。",
      "description": "放下执念的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0035",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "传闻查无实据，我选择不再传，心静了。",
      "description": "停止传播后的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0036",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "窗缝塞好，夜风不再灌，终于能睡。",
      "description": "环境问题解决的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0037",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "钥匙找到了，就在第二格，虚惊一场。",
      "description": "失而复得的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0038",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "清扫做完，工具归位，心里也归位。",
      "description": "收束后的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0039",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "说清‘我自己处理’之后，对方点头离开，我松口气。",
      "description": "边界被尊重的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0040",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "地砖干透，那点黏腻感没了，步子也轻。",
      "description": "体感恢复的释然。"
    },
    {
      "id": "lx.text-emotion.b0001.0041",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "旧布告栏被人重新钉正了。我又想笑，又想先把灰掸干净。",
      "description": "惊喜与珍惜交叠的自述，不替听者规定情绪。"
    },
    {
      "id": "lx.text-emotion.b0001.0042",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "猫跟了我半街又忽然跑开，亲近和落空叠在一起。",
      "description": "亲近与失落并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0043",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "公平价成交是高兴的，可称盐时手有点抖，怕秤不准。",
      "description": "高兴与紧张并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0044",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "轮值结束该轻松，可看着下一名单，又有点空。",
      "description": "放松与空虚并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0045",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "谢谢纸条让我暖，又怕自己配不上那两个字。",
      "description": "受宠与不安并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0046",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "炉子修好该庆，想起催单时的口气，又有点歉。",
      "description": "释然与愧疚并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0047",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "南市布没买到是可惜，可省下的钱又能买盐，心里打结。",
      "description": "惋惜与务实拉扯。"
    },
    {
      "id": "lx.text-emotion.b0001.0048",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "巷子安静下来本该睡好，却开始惦记琴声。",
      "description": "安静与思念并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0049",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "拒绝帮忙说出口很必要，说完仍怕对方误会冷淡。",
      "description": "坚定与担心并存。"
    },
    {
      "id": "lx.text-emotion.b0001.0050",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "长椅空了可以坐，却忽然不想坐，只想站着看风。",
      "description": "可得与无欲并存。"
    }
  ]
}
