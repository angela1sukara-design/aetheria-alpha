{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-emotion",
  "batchId": "text-emotion.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-emotion.b0003.0001",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "雨停后水珠圆得过分，我看得开心。",
      "description": "雨后观察的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0002",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "闸板拨通，水流重新有了声音，畅快。",
      "description": "疏通成功的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0003",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "蕨苗新叶展开，嫩得能捏出水，喜欢。",
      "description": "植物生长的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0004",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "雨棚绳收紧后不再啪啪响，耳根清静也高兴。",
      "description": "噪声消除的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0005",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "有人把浮萍灯点亮，水面碎光跳舞，好看。",
      "description": "夜景带来的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0006",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "斗笠晒干，戴上去轻，心情也轻。",
      "description": "器物归位的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0007",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "清淤收工哨响，泥还在，人却笑了。",
      "description": "劳动结束的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0008",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "可食用嫩蕨洗得干净，锅里一香就开心。",
      "description": "食物相关高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0009",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "跳板钉牢，走上去不晃，踏实。",
      "description": "安全恢复的高兴。"
    },
    {
      "id": "lx.text-emotion.b0003.0010",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "棚下忽然有人分享笑话，雨声都成了伴奏。",
      "description": "社交明快面。"
    },
    {
      "id": "lx.text-emotion.b0003.0011",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "鞋倒扣半晌还在滴，湿意赶不走，烦。",
      "description": "持续潮湿的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0012",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "滤网刚换又堵，像跟淤泥较劲。",
      "description": "反复堵塞烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0013",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "雨棚漏角滴到后颈，冰一下，火一下。",
      "description": "身体被滴的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0014",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "告示字被雨晕开，读不清，白跑一趟。",
      "description": "信息损毁烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0015",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "渠边泥咬住鞋底，拔脚费劲，越拔越躁。",
      "description": "行动受阻烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0016",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "蛙声本来好听，连叫三个时辰就变噪。",
      "description": "过量刺激烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0017",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "洗衣台排水慢，衣服泡久发酸味，烦透。",
      "description": "设施故障烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0018",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "伞骨又松一节，撑开像要散，窝囊。",
      "description": "器物失修烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0019",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "绕路多走的那段全是滑泥，鞋报废预警。",
      "description": "绕路代价烦闷。"
    },
    {
      "id": "lx.text-emotion.b0003.0020",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "湿货气味重，躲雨也躲不开，闷。",
      "description": "表达日常烦躁或腻烦，呼应「湿货气味重躲雨也躲不开」情境。"
    },
    {
      "id": "lx.text-emotion.b0003.0021",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "石缝小蕨被人拔走一丛，空了一块绿。",
      "description": "对植被被取的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0022",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "浮萍灯有一盏漂远了，光点少了一颗。",
      "description": "对失落物件的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0023",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "旧雨棚布补了又补，终于要换整幅，有点舍。",
      "description": "对旧布告别的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0024",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "涨水淹过的记号被新漆盖住，记忆少了一层。",
      "description": "对痕迹被抹的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0025",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "码头木桩绳结泡胀解开后，再也收不回那种紧。",
      "description": "对状态不可逆的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0026",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "有人在棚下打牌笑过，走后只剩湿脚印，空。",
      "description": "对热闹消散的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0027",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "认错菇差点入口，吓出一身汗，也惋惜自己粗心。",
      "description": "对疏忽的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0028",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "步道磨白的地方加了防滑，实用，却盖住了故事感。",
      "description": "实用与记忆的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0029",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "夜灯倒影碎开时，有片叶子挡住，构图破了。",
      "description": "对瞬间被扰的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0030",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "清淤捞出的旧陶片太碎，拼不回壶形。",
      "description": "对残片的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0003.0031",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "水位回落到刻度内，警报在心里解除。",
      "description": "安全恢复的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0032",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "斗笠取回完好，寄存柜信誉还在，安心。",
      "description": "取物顺利的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0033",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "说清‘我自己钉’后，没人硬伸手，省心。",
      "description": "表达放下后的轻松，呼应「说清‘我自己钉’后没人」情境。"
    },
    {
      "id": "lx.text-emotion.b0003.0034",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "滤网洗干净还能用，不必次次换新，踏实。",
      "description": "节约方案成立的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0035",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "雨势收了，绕路牌可以收，脚步回原路。",
      "description": "恢复常态的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0036",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "蕨苗浇水量查清，烂根担忧退了。",
      "description": "知识到位的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0037",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "伞还回棚柱钩，债务清零，轻松。",
      "description": "归还完成的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0038",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "湿衣服终于阴干，霉味没出现，谢天谢地。",
      "description": "养护成功的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0039",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "清淤段验收过，泥还臭，责任却卸了。",
      "description": "职责结束的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0040",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "听水声发呆被允许，不必解释发呆，松。",
      "description": "被理解的释然。"
    },
    {
      "id": "lx.text-emotion.b0003.0041",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "雨声让人安静，也让人惦记有没有漏屋。",
      "description": "平静与担忧并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0042",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "浮萍灯好看，油耗却让我算账，美与俭拉扯。",
      "description": "审美与节约并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0043",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "清淤累，收工笑，泥点子溅到脸上也不擦。",
      "description": "疲惫与痛快并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0044",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "拒绝同行撑伞是自主，看对方独走又有点空。",
      "description": "自主与牵挂并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0045",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "新蕨叶可爱，拔走别人那丛的人让我生气又无奈。",
      "description": "喜爱与愤懑并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0046",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "棚下笑话让我笑出声，笑完发现鞋更湿了。",
      "description": "欢快与狼狈并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0047",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "水位安全该放心，刻度线却像提醒下一次涨。",
      "description": "释然与警惕并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0048",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "换整幅雨棚布是进步，旧补丁的针脚我会记得。",
      "description": "前进与纪念并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0049",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "可食用蕨好吃，采时仍怕认错，筷子都谨慎。",
      "description": "享用与谨慎并存。"
    },
    {
      "id": "lx.text-emotion.b0003.0050",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "夜岸安静得珍贵，太静又会想起白天的吵。",
      "description": "珍惜与对比并存。"
    }
  ]
}
