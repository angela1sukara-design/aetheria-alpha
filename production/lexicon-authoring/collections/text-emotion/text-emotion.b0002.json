{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-emotion",
  "batchId": "text-emotion.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-emotion.b0002.0001",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "刃口重新咬布的声音清脆，我听着就高兴。",
      "description": "手艺成效的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0002",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "学徒把线轴绕齐，我夸了一句，双方都笑了。",
      "description": "教学互悦。"
    },
    {
      "id": "lx.text-emotion.b0002.0003",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "旧桌面擦亮后能照见窗影，意外的好看。",
      "description": "发现美的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0004",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "铆钉一次到位，锤声干脆，痛快。",
      "description": "工序顺畅的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0005",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "顾客取件时多看了两眼补丁，像在欣赏。",
      "description": "被认可的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0006",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "废布拼垫坐上去刚好，丑得诚实，我喜欢。",
      "description": "自造物的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0007",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "邻店锤声成了节奏，干活不觉得孤。",
      "description": "共在劳作的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0008",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "进的麻绳打结不松，手感对了，痛快。",
      "description": "材料合手的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0009",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "招牌第二层漆干透均匀，站远看很稳。",
      "description": "完成外观的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0010",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "工具墙上空挂钩重新挂满，秩序回来了。",
      "description": "归位的高兴。"
    },
    {
      "id": "lx.text-emotion.b0002.0011",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "铁屑飞进袖口，怎么抖都有，烦。",
      "description": "细屑纠缠的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0012",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "胶水气味散不掉，窗开了还在，闷得慌。",
      "description": "气味烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0013",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "交期星期五，钉子却断了两根，心口发紧又烦。",
      "description": "资源短缺的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0014",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "砂纸目数拿错，返工一截，火气上来。",
      "description": "失误返工烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0015",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "学徒连问三遍同一句，我答得不耐烦，事后又悔。",
      "description": "耐心耗尽的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0016",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "柜台铃一响一响，手里的活断了又接，碎。",
      "description": "打断导致的烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0017",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "油漆色干后偏深，和样板对不上，堵。",
      "description": "效果偏差烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0018",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "废料箱刚清又满，像永远倒不完。",
      "description": "循环劳动烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0019",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "锁芯卡死，钥匙转不动，越急越拧紧。",
      "description": "机械卡滞烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0020",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "松脂粘在剪刀上，开合都滞涩，一整天不顺。",
      "description": "工具状态烦闷。"
    },
    {
      "id": "lx.text-emotion.b0002.0021",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "旧壶送来时裂得更大了，再修也回不到原样。",
      "description": "对不可逆损伤的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0022",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "桌下刻字被漆盖住一层，想读清楚已难。",
      "description": "对信息被遮的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0023",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "学徒请假，今日少了那双利落的手，空一截。",
      "description": "对缺席协作的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0024",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "那枚想留的垫片最后还是进了废料车，后悔。",
      "description": "对错过保留的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0025",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "锤柄磨出的手窝换了新木，旧触感没了。",
      "description": "对熟悉触感消失的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0026",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "顾客说‘下次再来’，后来真的没有再来。",
      "description": "对中断往来的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0027",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "拼布垫针脚有一处跳线，只有我知道，仍可惜。",
      "description": "对微小瑕疵的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0028",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "店门口油灯芯剪短后，光少了一圈记忆中的暖。",
      "description": "对光感变化的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0029",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "门槛磨圆本是痕迹，被换成新木，反而不熟。",
      "description": "对过度翻新的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0030",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "加急单赶完，细活的从容被挤掉了，有点丢。",
      "description": "对节奏被夺的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0002.0031",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "缺口深度量清，能修，悬着的心落地。",
      "description": "判断明确后的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0032",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "交期跟顾客说实话后，对方点头，我轻松了。",
      "description": "坦诚后的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0033",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "胶水盖拧紧，气味终于开始退，能深呼吸。",
      "description": "问题解决的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0034",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "学徒听懂了‘留痕也无妨’，我不必再争。",
      "description": "观念被理解的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0035",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "废料单过目完毕，该留的留下，该清的清，利落。",
      "description": "决策完成的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0036",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "样板干透颜色对上了，油漆可以继续。",
      "description": "验证通过的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0037",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "工具挂回原位，明天开门不会手忙脚乱。",
      "description": "预备完成的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0038",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "说清‘我想独自试做’后，没人硬帮，松快。",
      "description": "边界清晰的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0039",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "钉盒补满，星期五不再缺钉，安心。",
      "description": "资源到位的释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0040",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "台面擦净，今日收束，烦恼也暂时擦掉一层。",
      "description": "收工释然。"
    },
    {
      "id": "lx.text-emotion.b0002.0041",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "旧物修好是高兴的，可裂痕被填平，又像少了故事。",
      "description": "完成与失落并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0042",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "夸学徒时真心，又怕夸多了对方压力大。",
      "description": "鼓励与顾虑并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0043",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "加急费该收，开口时却觉得自己刻薄。",
      "description": "原则与自我评价拉扯。"
    },
    {
      "id": "lx.text-emotion.b0002.0044",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "废料清掉空间清爽，扔的时候仍一寸寸犹豫。",
      "description": "清爽与不舍并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0045",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "顾客欣赏补丁，我高兴，又想起当时手抖的狼狈。",
      "description": "荣耀与窘迫并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0046",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "邻店锤声作伴是好的，偶也烦它压过自己的节奏。",
      "description": "陪伴与干扰并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0047",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "换新锤柄更稳，旧手窝却像被告别。",
      "description": "进步与告别并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0048",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "教学答不上‘为何不换新’，诚实，也尴尬。",
      "description": "坦诚与尴尬并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0049",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "店安静时能细做，太安静又会抬头找人声。",
      "description": "专注与寂寞并存。"
    },
    {
      "id": "lx.text-emotion.b0002.0050",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "收工该轻松，看见未完成的灯罩，轻松又收回一半。",
      "description": "结束与未完并存。"
    }
  ]
}
