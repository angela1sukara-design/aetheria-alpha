{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-emotion",
  "batchId": "text-emotion.b0004",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.text-emotion.b0004.0001",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "石阶中段阴凉处歇脚，水入喉，整个人亮了。",
      "description": "解渴后的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0002",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "遮阳布重新挂上，刺光被挡住，眼也舒服。",
      "description": "光环境改善的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0003",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "迁居清单核对无漏，箱子盖上，踏实又高兴。",
      "description": "准备完成的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0004",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "远行登记填完，笔一放，像卸下一小块石。",
      "description": "手续完成的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0005",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "布帘浅沙色随风，远看连着山壁，美得简单。",
      "description": "景色审美的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0006",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "车队空位占到了，行李刚好塞下，运气好。",
      "description": "机缘顺利的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0007",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "扶手麻绳缠完，握上去不打滑，安心变开心。",
      "description": "安全改进的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0008",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "驿站井水比想象甜，灌满两壶，嘴角上扬。",
      "description": "水质惊喜的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0009",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "高处风把汗吹干，衣服轻了，人也轻。",
      "description": "体感清爽的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0010",
      "category": "text-emotion",
      "subcategory": "高兴",
      "text": "有人在石阶上让出水壶，我道谢，心里暖。",
      "description": "被关照的高兴。"
    },
    {
      "id": "lx.text-emotion.b0004.0011",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "石阶晒烫，坐下又站起，皮肤刺刺的，烦。",
      "description": "高温体感烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0012",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "遮阳挂钩反复掉，挂三次掉三次，窝火。",
      "description": "反复故障烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0013",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "细沙进鞋怎么倒都倒不净，一步一磨。",
      "description": "沙粒纠缠烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0014",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "登记表归日一栏逼人说满，填也不是空也不是。",
      "description": "表单压力烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0015",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "风把帽子掀歪第五次，按帽子的手酸了。",
      "description": "风力干扰烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0016",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "饮水预约名额口头一问一个变，信息乱。",
      "description": "信息不稳烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0017",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "布帘洗后缩水，挂回去缝对不齐，堵。",
      "description": "缩水变形烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0018",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "石阶人流对冲，避让到脚软，心也燥。",
      "description": "拥挤烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0019",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "嘴唇起皮裂口，说话都扯痛，烦上加痛。",
      "description": "干燥不适烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0020",
      "category": "text-emotion",
      "subcategory": "烦闷",
      "text": "备用石堆占道，绕行时差点崴脚，火大。",
      "description": "障碍物烦闷。"
    },
    {
      "id": "lx.text-emotion.b0004.0021",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "迁居车上旧壶叮当作响，像在告别旧屋。",
      "description": "对离别的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0022",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "石缝干黄的茎再也绿不回来，夏天太硬。",
      "description": "对干旱植物的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0023",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "下一站井水更甜的传闻落空，水只是普通。",
      "description": "对传闻落空的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0024",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "遮阳布旧接缝被拆掉换新，针脚记忆没了。",
      "description": "对工艺痕迹消失的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0025",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "有人在石阶歇过的水壶印子被沙盖住。",
      "description": "对短暂痕迹的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0026",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "远行同伴中途改道，队伍少了一个笑。",
      "description": "对同伴离开的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0027",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "布帘花色沿途少见，想再买同款已无。",
      "description": "对稀缺花色的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0028",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "扶手旧麻绳起毛被换下，粗粝的熟手感没了。",
      "description": "对触感更替的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0029",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "驿站水缸瓢有缺口，水洒半瓢，可惜。",
      "description": "对器物破损的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0030",
      "category": "text-emotion",
      "subcategory": "惋惜",
      "text": "高处夜凉，少带一件衣，冻醒时只剩后悔。",
      "description": "对准备不足的惋惜。"
    },
    {
      "id": "lx.text-emotion.b0004.0031",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "第三级垫木试踩稳了，心跳从喉咙退回去。",
      "description": "安全确认的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0032",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "清单最后一项对上，漏项恐惧消散。",
      "description": "核对完成的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0033",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "饮水名额问到确切数，不再靠猜。",
      "description": "信息明确的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0034",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "脏帘抖沙后再送洗，加价担忧减轻。",
      "description": "预处理有效的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0035",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "归日改填区间被允许，表单压力卸一半。",
      "description": "规则松动的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0036",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "新负责人门牌认对，钥匙交得明白。",
      "description": "交接清晰的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0037",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "油膏涂过嘴唇，裂口不扯了，能正常说话。",
      "description": "体感缓解的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0038",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "风势缓了再挂挂钩，一次挂牢，省心。",
      "description": "时机选对的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0039",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "行李体积量准，空位不再心虚。",
      "description": "测量后的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0040",
      "category": "text-emotion",
      "subcategory": "释然",
      "text": "说清‘我腿劲一般’后，试踩有人护着，安心。",
      "description": "坦诚被接纳的释然。"
    },
    {
      "id": "lx.text-emotion.b0004.0041",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "占到空位高兴，又怕挤了带孩子的人，喜里掺愧。",
      "description": "幸运与愧疚并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0042",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "石阶风光好看，腿却在抖，美与累叠着。",
      "description": "审美与疲惫并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0043",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "迁居是向前，旧壶声却把人往回拉。",
      "description": "前进与怀旧并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0044",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "遮阳布挡住刺光是福，也挡住了远山一角。",
      "description": "舒适与损失并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0045",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "井水甜得想多灌，桶重了又悔。",
      "description": "贪嘴与务实拉扯。"
    },
    {
      "id": "lx.text-emotion.b0004.0046",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "让出水壶时大方，自己口干时又有点懊恼。",
      "description": "慷慨与后悔并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0047",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "远行登记像出发仪式，笔尖却停在未定的归日。",
      "description": "仪式感与不确定并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0048",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "高处风干爽，夜里冻醒，日夜两种脾气。",
      "description": "日间欢快与夜间狼狈。"
    },
    {
      "id": "lx.text-emotion.b0004.0049",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "换新麻绳更安全，握感陌生得像握别人的手。",
      "description": "安全与陌生并存。"
    },
    {
      "id": "lx.text-emotion.b0004.0050",
      "category": "text-emotion",
      "subcategory": "复杂心情",
      "text": "到站该轻松，打开清单又发现漏了一条绳。",
      "description": "抵达与未完并存。"
    }
  ]
}
