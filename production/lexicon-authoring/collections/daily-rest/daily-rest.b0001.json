{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-rest",
  "batchId": "daily-rest.b0001",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "subcategory": "坐歇",
      "text": "对方在门槛石上坐下，双手搁在膝上，看巷口来往的人影。",
      "description": "坐门槛歇脚的日常片段。",
      "id": "lx.daily-rest.b0001.0001",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把小板凳挪到树荫下，脚尖点地轻轻晃。",
      "description": "荫下坐凳轻晃歇息。",
      "id": "lx.daily-rest.b0001.0002",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方靠着墙根蹲下，袖子垫在肘下，闭目片刻。",
      "description": "蹲墙根闭目短歇。",
      "id": "lx.daily-rest.b0001.0003",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐到井边石沿，把鞋脱了一只揉了揉脚心。",
      "description": "坐井沿揉脚歇息。",
      "id": "lx.daily-rest.b0001.0004",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把背篓放下当靠背，坐在干草堆旁喘气。",
      "description": "以背篓为靠坐歇。",
      "id": "lx.daily-rest.b0001.0005",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方在长椅一头坐下，把另一头空着留给后来者。",
      "description": "坐长椅留空位的歇息。",
      "id": "lx.daily-rest.b0001.0006",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方盘腿坐在凉席上，后背挺直却不紧绷。",
      "description": "盘腿坐席的安静歇息。",
      "id": "lx.daily-rest.b0001.0007",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把窗台擦净一角，半坐半靠看院里的鸡。",
      "description": "半靠窗台观院歇息。",
      "id": "lx.daily-rest.b0001.0008",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐在台阶最下层，把下巴搁在交叠的手上。",
      "description": "坐低阶托颏歇息。",
      "id": "lx.daily-rest.b0001.0009",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把麻袋叠成垫，坐上去拍了拍身上的灰。",
      "description": "叠袋为垫坐歇。",
      "id": "lx.daily-rest.b0001.0010",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把肩膀前后转了几圈，听见关节轻响也不在意。",
      "description": "转肩放松的动作。",
      "id": "lx.daily-rest.b0001.0011",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把手浸进凉水盆，指尖在水面轻轻拨动。",
      "description": "浸手拨水的放松。",
      "id": "lx.daily-rest.b0001.0012",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方解开衣领最上的扣子，让风从领口灌进。",
      "description": "解领扣迎风放松。",
      "id": "lx.daily-rest.b0001.0013",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把额头贴在冰过的陶壶侧面，闭了一会儿眼。",
      "description": "额贴凉壶的放松。",
      "id": "lx.daily-rest.b0001.0014",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方伸了个长长的懒腰，指尖碰到门楣又缩回。",
      "description": "伸懒腰的放松动作。",
      "id": "lx.daily-rest.b0001.0015",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把发带松开又系松一点，让头皮透气。",
      "description": "松发带透气放松。",
      "id": "lx.daily-rest.b0001.0016",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把脚跷到矮凳上，脚踝慢慢画圈。",
      "description": "跷脚画圈放松脚踝。",
      "id": "lx.daily-rest.b0001.0017",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方靠在门框上，哼了一小段不成调的曲子。",
      "description": "靠门框轻哼放松。",
      "id": "lx.daily-rest.b0001.0018",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把掌心搓热，覆在后颈揉了几下。",
      "description": "热掌覆颈揉放松。",
      "id": "lx.daily-rest.b0001.0019",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把眼睛闭上数呼吸，数到十再慢慢睁开。",
      "description": "闭目数息的放松。",
      "id": "lx.daily-rest.b0001.0020",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方绕到屋后空地，背对街口安静站了一会儿。",
      "description": "屋后背街独处。",
      "id": "lx.daily-rest.b0001.0021",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把房门虚掩，独自坐在灯下翻无字的旧纸。",
      "description": "虚掩门独自翻纸。",
      "id": "lx.daily-rest.b0001.0022",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方爬上屋顶平台，只带一杯水，坐到天暗。",
      "description": "屋顶独坐待暗。",
      "id": "lx.daily-rest.b0001.0023",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方走进储物间，关上门在黑暗里站了片刻。",
      "description": "储物间暗处独处。",
      "id": "lx.daily-rest.b0001.0024",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方沿着河堤逆向走，避开人群密集的那一侧。",
      "description": "逆向河堤独处行走。",
      "id": "lx.daily-rest.b0001.0025",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把窗帘拉严，在昏光里慢慢整理袖口。",
      "description": "拉帘昏光中独处整理。",
      "id": "lx.daily-rest.b0001.0026",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方坐在空教室后排，听楼外风声而不开灯。",
      "description": "空室听风的独处。",
      "id": "lx.daily-rest.b0001.0027",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把椅子转向墙角，背对门口发一会儿呆。",
      "description": "面墙发呆的独处。",
      "id": "lx.daily-rest.b0001.0028",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方绕到柴堆后面，蹲下看蚂蚁搬家也不出声。",
      "description": "柴后观蚁的安静独处。",
      "id": "lx.daily-rest.b0001.0029",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把耳机摘下却不说话，只是独自望着天花板。",
      "description": "摘耳机独望天花板。",
      "id": "lx.daily-rest.b0001.0030",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方走到门口又停住，伸手摸了摸门把却没按。",
      "description": "摸门把未按的停顿。",
      "id": "lx.daily-rest.b0001.0031",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方话说到一半，抬眼看窗外飞过的鸟，再继续。",
      "description": "话中看鸟的短暂停顿。",
      "id": "lx.daily-rest.b0001.0032",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方提起壶又放下，等炉火再旺一点。",
      "description": "提壶又放等火的停顿。",
      "id": "lx.daily-rest.b0001.0033",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方迈出一步又收回，给推车的人让出空隙。",
      "description": "迈步收回让路的停顿。",
      "id": "lx.daily-rest.b0001.0034",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方擦桌擦到一半，停下来听邻屋的钟响几下。",
      "description": "擦桌听钟的短暂停顿。",
      "id": "lx.daily-rest.b0001.0035",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方把笔悬在纸上，等想清楚下一个字再落下。",
      "description": "悬笔待字的停顿。",
      "id": "lx.daily-rest.b0001.0036",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方系鞋带系到一半，抬头辨认远处的喊声。",
      "description": "系带辨声的短暂停顿。",
      "id": "lx.daily-rest.b0001.0037",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方搅拌到中途停勺，让泡沫自己散去一点。",
      "description": "停勺待泡散的停顿。",
      "id": "lx.daily-rest.b0001.0038",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方推开窗后愣了一下，闻了闻雨后的泥土味。",
      "description": "开窗闻土的短暂停顿。",
      "id": "lx.daily-rest.b0001.0039",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方把钥匙插进锁孔又抽出，确认拿对了那一把。",
      "description": "插钥又抽确认的停顿。",
      "id": "lx.daily-rest.b0001.0040",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把外衣叠好搭在椅背，口袋里的小物掏到盘里。",
      "description": "叠衣掏物的睡前整理。",
      "id": "lx.daily-rest.b0001.0041",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把水杯续上温水，放在床头伸手可及处。",
      "description": "续水置床头睡前整理。",
      "id": "lx.daily-rest.b0001.0042",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把明日要穿的衣物挂到门后，免得清晨乱翻。",
      "description": "挂明日衣的睡前整理。",
      "id": "lx.daily-rest.b0001.0043",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把窗缝塞上布条，再确认灯已熄灭。",
      "description": "塞窗缝熄灯的睡前整理。",
      "id": "lx.daily-rest.b0001.0044",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把地上的拖鞋摆齐，鞋尖朝外方便起夜。",
      "description": "摆齐拖鞋朝外睡前整理。",
      "id": "lx.daily-rest.b0001.0045",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把记事本合上压好，笔插回本侧的皮套。",
      "description": "合本插笔的睡前整理。",
      "id": "lx.daily-rest.b0001.0046",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把炉火压成余烬，灰上盖一层薄沙。",
      "description": "压炉盖沙的睡前整理。",
      "id": "lx.daily-rest.b0001.0047",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把闹钟拨到习惯时辰，放在枕头对面的柜上。",
      "description": "拨钟置柜的睡前整理。",
      "id": "lx.daily-rest.b0001.0048",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把膝盖上的毯子抖平，折成可随时拉起的条。",
      "description": "抖毯折条的睡前整理。",
      "id": "lx.daily-rest.b0001.0049",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把门闩再推紧一寸，听清落扣声才转身。",
      "description": "推闩听扣的睡前整理。",
      "id": "lx.daily-rest.b0001.0050",
      "category": "daily-rest"
    }
  ]
}
