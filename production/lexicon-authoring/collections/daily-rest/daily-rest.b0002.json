{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-rest",
  "batchId": "daily-rest.b0002",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "subcategory": "坐歇",
      "text": "对方在工作台边的旧椅坐下，膝上仍搭着未缝完的布。",
      "description": "台边坐歇布仍在膝。",
      "id": "lx.daily-rest.b0002.0001",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把砂纸放下，坐到门口石阶上吹凉手指。",
      "description": "放砂纸坐阶吹指歇息。",
      "id": "lx.daily-rest.b0002.0002",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方与学徒对坐小凳，中间隔着半修好的抽屉。",
      "description": "对坐小凳隔抽屉歇息。",
      "id": "lx.daily-rest.b0002.0003",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐在卷起的地毯卷上，背靠货架闭目。",
      "description": "坐毯卷靠货架歇息。",
      "id": "lx.daily-rest.b0002.0004",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把胶水盖拧紧后，坐到窗下等胶味散尽。",
      "description": "坐窗下等胶味散歇。",
      "id": "lx.daily-rest.b0002.0005",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方跨坐在长板凳上，双手撑膝看着未干的漆面。",
      "description": "跨坐看漆干的歇息。",
      "id": "lx.daily-rest.b0002.0006",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把围裙解下垫在身下，坐在刨花堆旁。",
      "description": "围裙垫坐刨花旁歇。",
      "id": "lx.daily-rest.b0002.0007",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐进半人高的空木箱，脚伸出箱沿晃着。",
      "description": "坐空木箱晃脚歇息。",
      "id": "lx.daily-rest.b0002.0008",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把椅背调低一点，半躺着看天花板的裂缝。",
      "description": "调椅半躺看裂缝歇。",
      "id": "lx.daily-rest.b0002.0009",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方与邻店师傅共坐门槛，中间放着共用的茶壶。",
      "description": "共坐门槛伴茶壶歇。",
      "id": "lx.daily-rest.b0002.0010",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把捏了一下午的手指逐根掰开再合拢。",
      "description": "掰指放松的动作。",
      "id": "lx.daily-rest.b0002.0011",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把眼睛从细活上挪开，望向远处模糊的招牌。",
      "description": "挪眼远望招牌放松。",
      "id": "lx.daily-rest.b0002.0012",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把虎口贴在冰凉的铁砧侧面降温。",
      "description": "虎口贴砧降温放松。",
      "id": "lx.daily-rest.b0002.0013",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把肩膀靠在门柱上，让重力替手臂歇一会儿。",
      "description": "靠柱卸臂力放松。",
      "id": "lx.daily-rest.b0002.0014",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把鼻尖凑近松木刨花，深吸一口木香。",
      "description": "闻刨花木香放松。",
      "id": "lx.daily-rest.b0002.0015",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把手腕在空中画大圈，缓解长时间握锉的酸。",
      "description": "腕画圈缓解握锉酸。",
      "id": "lx.daily-rest.b0002.0016",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把围裙带子松开一格，肚子得以松一松。",
      "description": "松围裙带放松腹部。",
      "id": "lx.daily-rest.b0002.0017",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把额头抵在光滑的木柜门上，感受微凉。",
      "description": "额抵木柜感凉放松。",
      "id": "lx.daily-rest.b0002.0018",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把鞋跟踩掉一半，脚后跟蹭地溜达两步。",
      "description": "踩半鞋跟溜达放松。",
      "id": "lx.daily-rest.b0002.0019",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把未完成的活盖上布，刻意走开倒杯水。",
      "description": "盖活走开倒水放松。",
      "id": "lx.daily-rest.b0002.0020",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方留在打烊后的店里，只开一盏台灯继续坐着。",
      "description": "打烊后独坐台灯下。",
      "id": "lx.daily-rest.b0002.0021",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方躲进材料间，靠着布匹卷不理会外面的招呼。",
      "description": "材料间靠布卷独处。",
      "id": "lx.daily-rest.b0002.0022",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方爬上阁楼找旧零件，却在尘土味里坐了很久。",
      "description": "阁楼坐久的独处。",
      "id": "lx.daily-rest.b0002.0023",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把学徒支走买钉子，自己在空店里慢慢踱步。",
      "description": "空店踱步的独处。",
      "id": "lx.daily-rest.b0002.0024",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方关上门磨一把私人的小刀，不让旁人围观。",
      "description": "闭门独磨小刀。",
      "id": "lx.daily-rest.b0002.0025",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方坐在后院柴房门槛，听里面虫鸣而不开灯。",
      "description": "柴房门槛听虫独处。",
      "id": "lx.daily-rest.b0002.0026",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把坏掉的旧钟拆开又装回，全程不说话。",
      "description": "独拆装旧钟的独处。",
      "id": "lx.daily-rest.b0002.0027",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方绕到店后晒场，独自数晾干的木条根数。",
      "description": "晒场独数木条。",
      "id": "lx.daily-rest.b0002.0028",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把账本翻到空白页，独自写了几行又撕掉。",
      "description": "独写又撕的账本独处。",
      "id": "lx.daily-rest.b0002.0029",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方坐在未售出的旧沙发上，试坐也像歇息。",
      "description": "试坐旧沙发的独处。",
      "id": "lx.daily-rest.b0002.0030",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方钉到第三下停住，听木头有没有裂的声响。",
      "description": "钉中停听裂声。",
      "id": "lx.daily-rest.b0002.0031",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方刷漆刷到边角，停笔等上一层略干。",
      "description": "刷漆停等略干。",
      "id": "lx.daily-rest.b0002.0032",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方把锯子提起悬空，等学徒把木料扶稳。",
      "description": "悬锯等扶稳的停顿。",
      "id": "lx.daily-rest.b0002.0033",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方量尺寸量到一半，停下来擦眼镜再量。",
      "description": "量中擦镜再量的停顿。",
      "id": "lx.daily-rest.b0002.0034",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方穿针穿了两次没过，停下来重新咬线头。",
      "description": "穿针停顿重咬线头。",
      "id": "lx.daily-rest.b0002.0035",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方搅拌骨胶时停勺，看气泡是否还在冒。",
      "description": "搅胶停看气泡。",
      "id": "lx.daily-rest.b0002.0036",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方把锤子举到肩高又放下，改选更小的那把。",
      "description": "举锤改选的停顿。",
      "id": "lx.daily-rest.b0002.0037",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方砂磨到光滑处停手，用指腹确认手感。",
      "description": "砂磨停手触检。",
      "id": "lx.daily-rest.b0002.0038",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方对缝对齐后停住，让胶水多浸润一秒。",
      "description": "对缝停待胶浸润。",
      "id": "lx.daily-rest.b0002.0039",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方写价签写到一半，停笔回想进货价。",
      "description": "写签停想进货价。",
      "id": "lx.daily-rest.b0002.0040",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把未干的漆件移到通风架，并贴“勿碰”条。",
      "description": "移漆件贴勿碰睡前整理。",
      "id": "lx.daily-rest.b0002.0041",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把锋利工具刃口朝内收入匣，匣上落锁。",
      "description": "刃具入匣落锁睡前整理。",
      "id": "lx.daily-rest.b0002.0042",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把明日要修的物件摆到台左，台右留空。",
      "description": "摆待修件留空台睡前。",
      "id": "lx.daily-rest.b0002.0043",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把胶瓶立放防漏，瓶下垫旧纸。",
      "description": "胶瓶立垫纸睡前整理。",
      "id": "lx.daily-rest.b0002.0044",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把店门内的地垫抖净，重新铺正。",
      "description": "抖铺地垫睡前整理。",
      "id": "lx.daily-rest.b0002.0045",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把账本夹好今日票据，压在镇纸下。",
      "description": "夹票压镇纸睡前整理。",
      "id": "lx.daily-rest.b0002.0046",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把学徒忘收的钉子扫回盒，盒盖写满。",
      "description": "扫钉回盒睡前整理。",
      "id": "lx.daily-rest.b0002.0047",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把灯油壶盖紧，灯芯剪短备明早用。",
      "description": "盖油壶剪灯芯睡前。",
      "id": "lx.daily-rest.b0002.0048",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把围裙挂到通风钉，口袋里掏出粉笔头。",
      "description": "挂围裙掏粉笔睡前。",
      "id": "lx.daily-rest.b0002.0049",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把后门再顶一根木杠，确认推不开才回屋。",
      "description": "顶杠确认后门睡前。",
      "id": "lx.daily-rest.b0002.0050",
      "category": "daily-rest"
    }
  ]
}
