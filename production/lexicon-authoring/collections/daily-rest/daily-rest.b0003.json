{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "daily-rest",
  "batchId": "daily-rest.b0003",
  "source": {
    "producer": "ai-daily",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "subcategory": "坐歇",
      "text": "对方坐在雨棚下的矮墩，听滴水打在桶沿的节奏。",
      "description": "棚下听滴水坐歇。",
      "id": "lx.daily-rest.b0003.0001",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把裤脚挽高，坐在渠边石上把脚浸进浅水。",
      "description": "坐渠边浸脚歇息。",
      "id": "lx.daily-rest.b0003.0002",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方靠着长满苔的石壁坐下，后背感受一层凉意。",
      "description": "靠苔壁感凉坐歇。",
      "id": "lx.daily-rest.b0003.0003",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐在翻过来的空船壳里，膝上摊开湿地图。",
      "description": "坐船壳摊图歇息。",
      "id": "lx.daily-rest.b0003.0004",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把蓑衣垫在湿草上，盘腿看水面起的小泡。",
      "description": "蓑衣垫坐看水泡。",
      "id": "lx.daily-rest.b0003.0005",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐到蕨丛旁的木桩，伸手碰了碰新叶尖。",
      "description": "坐木桩触蕨叶歇。",
      "id": "lx.daily-rest.b0003.0006",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把竹椅拖到棚檐下，避开正滴水的那一线。",
      "description": "拖椅避滴线坐歇。",
      "id": "lx.daily-rest.b0003.0007",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方坐在闸板旁的台阶，下巴搁在交叠的臂上。",
      "description": "坐闸阶托臂歇息。",
      "id": "lx.daily-rest.b0003.0008",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方把湿靴脱掉，赤脚坐在晒暖的石板上。",
      "description": "赤脚坐暖石歇息。",
      "id": "lx.daily-rest.b0003.0009",
      "category": "daily-rest"
    },
    {
      "subcategory": "坐歇",
      "text": "对方与同伴隔一条窄渠对坐，把话音压得很低。",
      "description": "隔渠对坐低语歇。",
      "id": "lx.daily-rest.b0003.0010",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把掌心贴在湿石上，让潮气带走手心的热。",
      "description": "掌贴湿石散热放松。",
      "id": "lx.daily-rest.b0003.0011",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方仰头看雨棚缝里漏下的光点，眨了几下眼。",
      "description": "仰看漏光眨眼放松。",
      "id": "lx.daily-rest.b0003.0012",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把鼻子凑近捣碎的蕨根，闻那股清苦味。",
      "description": "闻蕨根清苦放松。",
      "id": "lx.daily-rest.b0003.0013",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把脚趾在浅泥里轻轻抠动，感受软滑。",
      "description": "趾抠浅泥感软放松。",
      "id": "lx.daily-rest.b0003.0014",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把湿发拨到耳后，让脖颈吹到穿堂风。",
      "description": "拨湿发吹颈放松。",
      "id": "lx.daily-rest.b0003.0015",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把肩膀上的雨滴甩净，再慢慢转肩。",
      "description": "甩雨滴转肩放松。",
      "id": "lx.daily-rest.b0003.0016",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把额头抵在竹筒凉水外侧，闭目片刻。",
      "description": "额抵凉筒闭目放松。",
      "id": "lx.daily-rest.b0003.0017",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方跟着水渠的缓流哼拍子，节拍随波起伏。",
      "description": "随缓流哼拍放松。",
      "id": "lx.daily-rest.b0003.0018",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方把袖口的湿痕拧干，抖开透气。",
      "description": "拧袖湿痕透气放松。",
      "id": "lx.daily-rest.b0003.0019",
      "category": "daily-rest"
    },
    {
      "subcategory": "放松",
      "text": "对方蹲下看蜻蜓停在草尖，直到它飞走才起身。",
      "description": "蹲看蜻蜓的放松。",
      "id": "lx.daily-rest.b0003.0020",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方撑着油纸伞走进芦苇深处，只留伞顶可见。",
      "description": "芦苇深处撑伞独处。",
      "id": "lx.daily-rest.b0003.0021",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方坐在废弃的闸房里，听雨打铁皮屋顶。",
      "description": "闸房听雨独处。",
      "id": "lx.daily-rest.b0003.0022",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方绕到水棚背面，背对忙碌的码头发呆。",
      "description": "水棚背对码头独处。",
      "id": "lx.daily-rest.b0003.0023",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把小船划到河心，收桨任其漂了一段。",
      "description": "河心收桨漂流独处。",
      "id": "lx.daily-rest.b0003.0024",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方钻进高大的蕨丛，蹲下整理湿透的袖口。",
      "description": "蕨丛中整理袖独处。",
      "id": "lx.daily-rest.b0003.0025",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方在夜色棚下独自煮一壶水，不叫任何人。",
      "description": "夜棚独煮水独处。",
      "id": "lx.daily-rest.b0003.0026",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方沿着无人的渠堤慢慢走，鞋子踩出水声。",
      "description": "无人渠堤独走。",
      "id": "lx.daily-rest.b0003.0027",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把灯笼挂到远处树杈，自己坐在暗处。",
      "description": "挂远灯坐暗处独处。",
      "id": "lx.daily-rest.b0003.0028",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方躲进半塌的雨棚角落，听外面人喊也不应。",
      "description": "棚角不应人喊独处。",
      "id": "lx.daily-rest.b0003.0029",
      "category": "daily-rest"
    },
    {
      "subcategory": "独处",
      "text": "对方把日记夹在油布里，蹲在干石上写两行。",
      "description": "干石上独写日记。",
      "id": "lx.daily-rest.b0003.0030",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方挑担走到泥滑处停住，先探一脚再迈。",
      "description": "泥滑处探脚停顿。",
      "id": "lx.daily-rest.b0003.0031",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方清淤挖到一半停铲，看水浑了就等一等。",
      "description": "清淤停铲等水清。",
      "id": "lx.daily-rest.b0003.0032",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方补网补到关键处停针，换一根更韧的线。",
      "description": "补网停针换韧线。",
      "id": "lx.daily-rest.b0003.0033",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方浇到一半停壶，听远处雷声判断要不要收。",
      "description": "浇水停听雷的停顿。",
      "id": "lx.daily-rest.b0003.0034",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方搬苔盆抬到一半放下，先擦干打滑的手。",
      "description": "搬盆停擦滑手。",
      "id": "lx.daily-rest.b0003.0035",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方迈过渠沟时停步，等对岸有人让出落脚点。",
      "description": "过沟停等落脚点。",
      "id": "lx.daily-rest.b0003.0036",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方糊泥缝糊到一半，停手等上一抹略干。",
      "description": "糊泥停等略干。",
      "id": "lx.daily-rest.b0003.0037",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方摇橹摇到桥洞前停桨，侧身让出船位。",
      "description": "桥洞前停桨让船。",
      "id": "lx.daily-rest.b0003.0038",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方采蕨采到一丛，停手数了数够不够一束。",
      "description": "采蕨停手数束。",
      "id": "lx.daily-rest.b0003.0039",
      "category": "daily-rest"
    },
    {
      "subcategory": "短暂停顿",
      "text": "对方系缆系到半扣，停下来看水位涨了没有。",
      "description": "系缆停看水位。",
      "id": "lx.daily-rest.b0003.0040",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把湿蓑衣挂到棚梁，下垫接水盆。",
      "description": "挂蓑衣垫盆睡前整理。",
      "id": "lx.daily-rest.b0003.0041",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把闸板降到夜泊高度，插上保险销。",
      "description": "降闸插销睡前整理。",
      "id": "lx.daily-rest.b0003.0042",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把船缆再绕两圈，确认不会夜间松脱。",
      "description": "绕缆确认睡前整理。",
      "id": "lx.daily-rest.b0003.0043",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把湿地图夹进油纸袋，压在枕下防潮。",
      "description": "地图入油纸袋睡前。",
      "id": "lx.daily-rest.b0003.0044",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把雨靴倒置沥水，内塞报纸吸潮。",
      "description": "靴倒沥水塞纸睡前。",
      "id": "lx.daily-rest.b0003.0045",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把灯芯剪短，灯罩擦去水雾。",
      "description": "剪芯擦罩睡前整理。",
      "id": "lx.daily-rest.b0003.0046",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把明日要移的苔盆集中到门口干处。",
      "description": "集苔盆到干处睡前。",
      "id": "lx.daily-rest.b0003.0047",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把棚门落栓，外挂一盏低亮度夜灯。",
      "description": "落栓挂夜灯睡前。",
      "id": "lx.daily-rest.b0003.0048",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把湿衣拧到不滴，搭到室内绳的内层。",
      "description": "拧衣搭内层睡前整理。",
      "id": "lx.daily-rest.b0003.0049",
      "category": "daily-rest"
    },
    {
      "subcategory": "睡前整理",
      "text": "对方把水渠巡查牌翻到“已巡夜”，挂回钉上。",
      "description": "翻巡查牌挂回睡前。",
      "id": "lx.daily-rest.b0003.0050",
      "category": "daily-rest"
    }
  ]
}
