{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-reply",
  "batchId": "text-reply.b0006",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "社区记忆与新生活：旧习、新住户、微小愿望与不同代际视角，不借用固定剧情"
  },
  "entries": [
    {
      "id": "lx.text-reply.b0006.0001",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "旧习里‘先问再进门’这条，我赞成新住户也沿用。",
      "description": "认可旧习延续。"
    },
    {
      "id": "lx.text-reply.b0006.0002",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "欢迎会不必隆重，清茶就够，我同意。",
      "description": "认可从简。"
    },
    {
      "id": "lx.text-reply.b0006.0003",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "墙角那块旧砖留着当记号，我没意见。",
      "description": "认可保留记忆物。"
    },
    {
      "id": "lx.text-reply.b0006.0004",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "新住户自我介绍用本名就好，外号以后再说。",
      "description": "认可称呼节奏。"
    },
    {
      "id": "lx.text-reply.b0006.0005",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "代际座谈每月一次，我可以参加。",
      "description": "认可活动频次。"
    },
    {
      "id": "lx.text-reply.b0006.0006",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "微小愿望墙可以设，字数限短一点更好。",
      "description": "认可并补充条件。"
    },
    {
      "id": "lx.text-reply.b0006.0007",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "旧灯留下当路标，新灯补在暗处，这样分工对。",
      "description": "认可新旧并存。"
    },
    {
      "id": "lx.text-reply.b0006.0008",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "口述史录音自愿，我不反对。",
      "description": "认可自愿原则。"
    },
    {
      "id": "lx.text-reply.b0006.0009",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "公共厨房的旧锅继续用，我赞成，好用。",
      "description": "认可延续使用。"
    },
    {
      "id": "lx.text-reply.b0006.0010",
      "category": "text-reply",
      "subcategory": "认可",
      "text": "新住户轮值从轻活开始，这个安排合理。",
      "description": "认可过渡安排。"
    },
    {
      "id": "lx.text-reply.b0006.0011",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "旧习全盘沿用……有几条我还想再听听理由。",
      "description": "部分迟疑。"
    },
    {
      "id": "lx.text-reply.b0006.0012",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "欢迎会清茶可以，人太多会不会反而尴尬。",
      "description": "规模顾虑。"
    },
    {
      "id": "lx.text-reply.b0006.0013",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "旧砖留着好，就怕被当成绊脚的。",
      "description": "表达犹豫与顾虑，呼应「旧砖留着好就怕被当成绊」情境。"
    },
    {
      "id": "lx.text-reply.b0006.0014",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "本名介绍好，可有人更想先用代称。",
      "description": "多元顾虑。"
    },
    {
      "id": "lx.text-reply.b0006.0015",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "每月座谈我能来，就是晚上可能困。",
      "description": "精力迟疑。"
    },
    {
      "id": "lx.text-reply.b0006.0016",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "愿望墙好，匿名还是署名，我还没想清。",
      "description": "形式迟疑。"
    },
    {
      "id": "lx.text-reply.b0006.0017",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "旧灯当路标可以，亮度够不够夜路用，不确定。",
      "description": "功能不确定。"
    },
    {
      "id": "lx.text-reply.b0006.0018",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "口述史我愿意听，自己说不说，还在犹豫。",
      "description": "参与程度迟疑。"
    },
    {
      "id": "lx.text-reply.b0006.0019",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "旧锅好用，卫生死角要不要先查一遍？",
      "description": "卫生顾虑。"
    },
    {
      "id": "lx.text-reply.b0006.0020",
      "category": "text-reply",
      "subcategory": "迟疑",
      "text": "轻活轮值好，多久转正活，想先有个数。",
      "description": "期限不明。"
    },
    {
      "id": "lx.text-reply.b0006.0021",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "你说的旧习，是指进门问询，还是指节日仪式？",
      "description": "追问以对齐信息，呼应「你说的旧习是指进门问询」情境。"
    },
    {
      "id": "lx.text-reply.b0006.0022",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "欢迎会是全社区，还是只请同层邻居？",
      "description": "澄清规模。"
    },
    {
      "id": "lx.text-reply.b0006.0023",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "旧砖记号是指向路，还是纪念某次维修？",
      "description": "澄清含义。"
    },
    {
      "id": "lx.text-reply.b0006.0024",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "自我介绍是口头，还是写在门口小牌？",
      "description": "澄清形式。"
    },
    {
      "id": "lx.text-reply.b0006.0025",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "代际座谈是自由聊，还是有主题提纲？",
      "description": "澄清结构。"
    },
    {
      "id": "lx.text-reply.b0006.0026",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "愿望墙字数限多少，十个字还是一行？",
      "description": "追问以对齐信息，呼应「愿望墙字数限多少十个字」情境。"
    },
    {
      "id": "lx.text-reply.b0006.0027",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "旧灯留下，供电还走旧线路吗？",
      "description": "澄清技术细节。"
    },
    {
      "id": "lx.text-reply.b0006.0028",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "口述史录音存哪儿，谁能调听？",
      "description": "澄清存取。"
    },
    {
      "id": "lx.text-reply.b0006.0029",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "旧锅继续用，是公用，还是可预约专用？",
      "description": "澄清使用制。"
    },
    {
      "id": "lx.text-reply.b0006.0030",
      "category": "text-reply",
      "subcategory": "澄清",
      "text": "轻活具体包括哪些，扫地还是分信？",
      "description": "澄清任务。"
    },
    {
      "id": "lx.text-reply.b0006.0031",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "我不赞成把所有旧习都当规矩，有的只是习惯。",
      "description": "性质区分意见。"
    },
    {
      "id": "lx.text-reply.b0006.0032",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "欢迎会不如分散拜访，压力更小。",
      "description": "形式不同意见。"
    },
    {
      "id": "lx.text-reply.b0006.0033",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "旧砖该移到墙龛里，留在墙角不安全。",
      "description": "位置不同意见。"
    },
    {
      "id": "lx.text-reply.b0006.0034",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "外号可以一起介绍，不必等以后。",
      "description": "节奏不同意见。"
    },
    {
      "id": "lx.text-reply.b0006.0035",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "座谈季一次就够，每月太密。",
      "description": "频次不同意见。"
    },
    {
      "id": "lx.text-reply.b0006.0036",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "愿望墙不该限字太死，有人需要多写半句。",
      "description": "灵活度意见。"
    },
    {
      "id": "lx.text-reply.b0006.0037",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "旧灯不如做成展示，照明交给新灯。",
      "description": "功能分离意见。"
    },
    {
      "id": "lx.text-reply.b0006.0038",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "口述史不该录音，笔录更让人放松。",
      "description": "媒介不同意见。"
    },
    {
      "id": "lx.text-reply.b0006.0039",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "旧锅该汰换一批，保留一两口作纪念即可。",
      "description": "提出相左看法，呼应「旧锅该汰换一批保留一两」情境。"
    },
    {
      "id": "lx.text-reply.b0006.0040",
      "category": "text-reply",
      "subcategory": "不同意见",
      "text": "新住户轮值不该刻意减轻，同等对待更公平。",
      "description": "公平观不同。"
    },
    {
      "id": "lx.text-reply.b0006.0041",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "旧习哪些保留，我列个单子再跟你对。",
      "description": "清单后再议。"
    },
    {
      "id": "lx.text-reply.b0006.0042",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "欢迎会办不办，我问过几户新邻居再定。",
      "description": "暂不决断并说明原因，呼应「欢迎会办不办我问过几户」情境。"
    },
    {
      "id": "lx.text-reply.b0006.0043",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "旧砖留不留，我看完通行宽度再答。",
      "description": "实地测量暂缓。"
    },
    {
      "id": "lx.text-reply.b0006.0044",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "介绍用本名还是代称，我想一夜。",
      "description": "暂不决断并说明原因，呼应「介绍用本名还是代称我想」情境。"
    },
    {
      "id": "lx.text-reply.b0006.0045",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "座谈我参不参加，看那个月排班。",
      "description": "日程未定。"
    },
    {
      "id": "lx.text-reply.b0006.0046",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "愿望墙规则，我起草一版给你看了再定。",
      "description": "草案后再定。"
    },
    {
      "id": "lx.text-reply.b0006.0047",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "旧灯供电方案，我问过电工再回。",
      "description": "专业意见暂缓。"
    },
    {
      "id": "lx.text-reply.b0006.0048",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "口述史我开不开口，先旁听一次再说。",
      "description": "体验后决定。"
    },
    {
      "id": "lx.text-reply.b0006.0049",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "旧锅去留，我做完一次卫生检查再提意见。",
      "description": "检查后答复。"
    },
    {
      "id": "lx.text-reply.b0006.0050",
      "category": "text-reply",
      "subcategory": "暂缓回答",
      "text": "轻活转正时间，我跟轮值组商量后再公布。",
      "description": "协商后答复。"
    }
  ]
}
