{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-adapt",
  "batchId": "text-tf-adapt.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-tf-adapt.b0002.0001",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你反复练习握锉的虎口位置，柄不再打转才算过关，但仍觉得生。",
      "description": "握锉虎口反复练。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0002",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "推拉锯时你数着呼吸对齐锯程，前倾幅度试了三次才不磕侧肋。",
      "description": "推锯前倾避侧肋。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0003",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你练习跪姿起身：手撑、膝送、站稳。每步都刻意放慢。",
      "description": "跪起三步放慢练。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0004",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "穿针时你把针放远一点，侧开挡视野的手指，试了多回才过线。",
      "description": "穿针侧指反复试。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0005",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你在空地练习侧身进窄缝，肩角度调到擦架而不卡住。",
      "description": "窄缝侧肩角度练。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0006",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "量尺贴臂比对，你重新记住刻度印象，写在台角备忘。",
      "description": "贴臂重记刻度备忘。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0007",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你练习接锤：腕沉、肩接、不晃。空锤练了十几下才敢接真的。",
      "description": "空锤练接真锤。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0008",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "打磨加压时踮脚幅度过大，你把体重分配改成前脚多一点。",
      "description": "打磨体重分配改。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0009",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你反复系解围裙，找新腰线对应的结位，直到走两步不松。",
      "description": "围裙结位适应腰线。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0010",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "退开工作台时你刻意先撤后脚，练到与新腿长感同拍。",
      "description": "退台后脚同拍练。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0011",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "围裙带往上挪，避开新的腰感，前襟补丁位置也跟着变。",
      "description": "围裙带上挪适腰。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0012",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "袖口卷到不再擦台面蜡迹的高度，你用粉笔在袖里画了记号。",
      "description": "袖高记号避蜡。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0013",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "护目镜鼻托垫了薄布，减轻薄壳感处的压麻。",
      "description": "镜托垫布减麻。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0014",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "工作手套换了更贴指缝的一副，指腹触木才重新清楚。",
      "description": "换贴指手套。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0015",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你把膝垫布加厚一折，缓冲膝突顶地的尖感。",
      "description": "膝垫加厚缓冲。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0016",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "领口别针改别低一点，避开吞咽时的摩擦点。",
      "description": "别针改低避吞咽擦。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0017",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "发带后勒更紧，防止俯身时碎发扫过敏的额弧。",
      "description": "发带紧防扫额。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0018",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你在鞋里加了软垫，跪久之后脚背的压迫轻一些。",
      "description": "鞋内软垫减跪压。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0019",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "工具袋从腰侧挪到略前，避免侧肋新轮廓蹭袋。",
      "description": "工具袋前挪避肋。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0020",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你把外衫换成更宽松的旧衫，举手够架时不再绷肩缝。",
      "description": "宽松旧衫适举手。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0021",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "锉柄缠了新麻绳，加粗后虎口才重新咬住，你试锉了两下。",
      "description": "锉柄缠绳适虎口。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0022",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把灯挪近缝活区，辨色变细后的犹豫少了一些。",
      "description": "挪灯减辨色犹豫。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0023",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "针垫挪到惯用手更容易够到的位置，伸手取针时少绕半圈。",
      "description": "挪针垫减绕手。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0024",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "量尺挂低一截，抬手取尺时不再过度后仰。",
      "description": "量尺挂低减后仰。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0025",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你改用短柄刷上胶，肘部不再轻易碰到邻座。",
      "description": "短柄刷避碰邻座。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0026",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "烙铁架垫高，拿放时腕的自然弧才对得上柄。",
      "description": "烙铁架垫高对腕。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0027",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把废料筐踢近半步，弯腰扔屑时杠杆感好受一点。",
      "description": "废料筐近减杠杆感。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0028",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "剪刀换了指孔更大的一把，新指节排列才伸得进。",
      "description": "大指孔剪适指节。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0029",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "砂纸改用夹具夹住，减少糙指腹直接磨砂的刺痛。",
      "description": "夹具持砂减刺痛。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0030",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你在台沿钉了小挡条，杯和瓶不再轻易被新的肘摆碰倒。",
      "description": "台沿挡条防碰倒。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0031",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你借后门玻璃看俯身的背影，肩宽把围裙带勒出新印。",
      "description": "后门玻看俯身肩印。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0032",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "铜盆反光里，自己握锉的手影指节突兀，你对着影练握姿。",
      "description": "铜盆影练握姿。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0033",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你对小镜检查眉骨与护目镜的卡位，画了记号贴在镜框。",
      "description": "小镜查镜卡位记号。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0034",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "蜡光台面映出半张脸，你盯着颊边凹凸，用手确认位置。",
      "description": "蜡光映颊手确认。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0035",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你让学徒帮忙看一眼肩线正不正，对方说：有点宽，但不怪。",
      "description": "请学徒看肩线。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0036",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "夜里窗纸人影缩成一团，你仍辨出自己耳尖的轮廓。",
      "description": "夜窗纸辨耳尖影。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0037",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你用卷尺量小臂外缘一周，数字写在备忘角，不告诉别人。",
      "description": "自量小臂记备忘。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0038",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "侧身镜里看跪姿折叠角，你调整到看起来不那么别扭。",
      "description": "侧镜调跪姿角。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0039",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你对着镜练点头致谢的幅度，避免耳尖先撞想象中的灯罩。",
      "description": "镜练点头避撞灯。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0040",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "完工后你看了眼手背，纹理已熟一点，仍称不上旧识。",
      "description": "完工看手背未全熟。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0041",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你对师傅说：这两天握法有点别扭，可能要慢一点。师傅哼了一声表示知道。",
      "description": "向师傅说明握法慢。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0042",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "请学徒帮忙递高架工具时，你加了句：我够着费劲。",
      "description": "请递高架并说明。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0043",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "顾客催进度，你平静说：质量优先，我手况需要多确认几步。",
      "description": "对催单说明多确认。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0044",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你跟邻店人说肩好像宽了点，对方笑：干活的都这样。你没有纠正。",
      "description": "说肩宽获误解不纠正。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0045",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "协作抬柜前你提醒：我这侧步伐可能不稳，你们看我一眼。",
      "description": "抬柜前提醒步伐。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0046",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你在记事本写给自己：告知轮班的人——今日不适重活。没有展开身体细节。",
      "description": "自写告知不适重活。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0047",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人碰你手臂道歉，你说：没事，最近触感敏，不是你的错。",
      "description": "说明敏触安对方。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0048",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你谢绝今晚加班：我想早点回去适应一下。对方点头。",
      "description": "谢加班言要适应。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0049",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "对来问价的人你只说：今日接件有限。把私人感受留在柜台内。",
      "description": "公开只限接件。"
    },
    {
      "id": "lx.text-tf-adapt.b0002.0050",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你写信给旧识：手活还在，身体有些新课题。语焉不详，却诚实。",
      "description": "信中手活与新课题。"
    }
  ]
}
