{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-adapt",
  "batchId": "text-tf-adapt.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-tf-adapt.b0003.0001",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你反复练习跨渠木板，双臂微张找平衡，掉下水花也不停试。",
      "description": "跨渠木板平衡练。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0002",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "湿阶探步：前脚探实、重心跟、后脚收。你走了三个来回。",
      "description": "湿阶探步三来回。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0003",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你练习提桶过板的对侧倾，水荡出一点，你减半桶再练。",
      "description": "提桶对侧倾减量练。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0004",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "蹲捞漂叶起身，手撑苔石的时机练到不再发飘。",
      "description": "捞叶撑石时机练。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0005",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "浮板双脚均分，你数着晃动次数，直到能站十息不退岸。",
      "description": "浮板站十息练习。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0006",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "侧身过雨棚窄道，肩角调到只擦湿木不沾大片潮。",
      "description": "窄道肩角减沾潮。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0007",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你练习抬高裤脚走苔面，步幅缩短，拖响消失才停。",
      "description": "抬裤走苔减拖响。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0008",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "下渠岸脚尖先落，你练到踝部不再发飘为止，仍不敢跑。",
      "description": "下岸踝稳仍不跑。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0009",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "泥滩换腿拔脚，重心交接放慢，练到泥只咬住靴底。",
      "description": "泥滩换腿慢交接。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0010",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你在棚下练习转身半径，避免衣摆扫到邻人的桶。",
      "description": "棚下转身避扫桶。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0011",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "裤脚用绳系高，避开泥水，系带位置试了两回才不勒踝。",
      "description": "裤脚系高避泥。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0012",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "披肩交叉扣改高一点，减轻湿衣贴出新轮廓的不适。",
      "description": "披肩高扣遮轮廓。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0013",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "帽檐拧干后垫了吸水布，额弧处压感轻一些。",
      "description": "帽垫布减额压。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0014",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你换防滑底旧鞋，湿板落脚稳一点，仍放慢步。",
      "description": "防滑旧鞋放慢步。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0015",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "袖口内衬加薄蜡布，细鳞缘刮衣的感觉减弱。",
      "description": "袖衬蜡布减鳞刮。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0016",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "手套翻晾后你改戴半指，指腹触绳更清楚。",
      "description": "半指手套触绳。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0017",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "腰间布袋挪到背雨滴的一侧，袋口朝下防进水。",
      "description": "布袋背雨滴侧。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0018",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你把面巾当临时颈围，垫开后颈硬缘与湿领的摩擦。",
      "description": "面巾垫后颈硬缘。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0019",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "裙摆别到膝上，跨板时不再拖水，你走起来轻快些。",
      "description": "裙摆别膝跨板。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0020",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "雨披剪短一截前摆，侧身过窄道时少挂住棚柱。",
      "description": "雨披短摆少挂柱。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0021",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "水桶改用双耳提，肘弯托沿，湿板上更稳。",
      "description": "双耳提桶稳湿板。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0022",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把洗衣板角度调低，俯身时新视线高度才对得上搓位。",
      "description": "洗衣板低调俯视。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0023",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "缆绳改短握段，糙指腹少被纤维刮，仍能勒紧。",
      "description": "缆绳短握减刮。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0024",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "伞柄加缠布套，靠肩时少滑，肩斜变也能架住。",
      "description": "伞柄布套减滑。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0025",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你换了更浅的舀水瓢，腕的自然弧刚好送瓢入水。",
      "description": "浅瓢对腕弧。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0026",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "补网梭子缠厚线，指孔变大，新指节才伸得顺。",
      "description": "梭子厚线适指节。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0027",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "灯笼挂低一截，棚下辨路时不用过度仰头。",
      "description": "灯笼挂低减仰头。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0028",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你在浮板边缘钉防滑条，站立练习时少滑半步。",
      "description": "浮板钉条减滑。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0029",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "水闸扳手加长套管，侧身发力时少憋气。",
      "description": "扳手套管减憋气。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0030",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把空碗放近身前，听雨时伸手可及，不必大动作。",
      "description": "空碗近身听雨。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0031",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "水面倒影里你辨认耳尖与肩宽，涟漪散开又聚拢，你等它稳。",
      "description": "水影等稳辨耳肩。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0032",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "湿石反光刺眼，你仍侧脸看了一眼镜中似的自己，随即眯眼走开。",
      "description": "湿石侧脸一瞥走开。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0033",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你用掌心量小腿浸水后的围度，数字记在心里不说。",
      "description": "掌量小腿围默记。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0034",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "船舱小窗映出半张脸，颊边凹凸在窗光里一闪。",
      "description": "船窗映颊凹凸。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0035",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你请渠边熟人看帽正不正，对方说：有点歪，我帮你正一下？你自己正了。",
      "description": "请看帽自己正。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0036",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "雨停后窗玻清晰，你对玻练抬手够钩的轨迹，改了两次肩角。",
      "description": "窗玻练够钩肩角。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0037",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你盯着浮板倒影里的脚掌轮廓，面积感与实触对上了。",
      "description": "浮板影脚掌对实触。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0038",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "夜提灯照水面，金线里晃着自己的肩，你记了一瞬就熄灯。",
      "description": "夜灯水金线记肩。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0039",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "苔墙渗出的水膜勉强映影，你只辨出耳廓尖，其余糊掉。",
      "description": "苔墙水膜辨耳尖。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0040",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你闭眼用手描自己的侧颈弧，睁眼看倒影，两边对得上才罢。",
      "description": "手描侧颈对倒影。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0041",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你对洗衣邻人说：我过木板要慢一点。对方点头让你先。",
      "description": "说明过板慢获让。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0042",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "请人帮忙提桶上岸，你补充：我重心还在找。",
      "description": "请提桶并言找重心。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0043",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人笑你裤脚系得怪，你笑回：防泥，也防自己绊自己。",
      "description": "笑回裤脚防泥绊。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0044",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你跟同行说窄道让我侧先，对方贴棚柱给你空。",
      "description": "请窄道先侧获空。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0045",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "雾中你提高招呼声：是我，步子不稳。对面应了，放慢汇合。",
      "description": "雾中自报步不稳。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0046",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你谢绝下水捞物：今日触水会晃，岸上我能帮忙递绳。",
      "description": "谢下水改递绳。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0047",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "对问你冷不冷的人，你说：有点敏，不是病。把话题停在这。",
      "description": "说明敏非病止题。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0048",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你在公共场合只说：我坐棚下歇会儿。细节留给雨声。",
      "description": "公开只说棚下歇。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0049",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "写信：水岸的日子还在，身体多了些要认的边。未写能力事。",
      "description": "信中水岸与认边。"
    },
    {
      "id": "lx.text-tf-adapt.b0003.0050",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人碰臂道歉，你说：没事，雨里触觉紧，谢谢你轻一点。",
      "description": "说明雨触紧致谢。"
    }
  ]
}
