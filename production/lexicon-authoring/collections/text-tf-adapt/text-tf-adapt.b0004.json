{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-adapt",
  "batchId": "text-tf-adapt.b0004",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.text-tf-adapt.b0004.0001",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你反复练陡阶前压，手扶内侧壁，直到步频与呼吸同拍。",
      "description": "陡阶前压扶壁练。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0002",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "下坡跟承重，你数着步幅缩短的格数，练到踝不发飘。",
      "description": "下坡缩步踝稳练。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0003",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "扛囊前倾迈沙，滑了两次，第三次减负再练。",
      "description": "扛囊迈沙减负练。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0004",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "风口双脚开立，迎风侧承重练到能站一盏茶的时间。",
      "description": "风口站一盏茶时。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0005",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "跨干渠蹲跳落地，你练膝吸震，软脚心仍多颠就加垫。",
      "description": "跨渠落地加垫练。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0006",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "顶门帘侧肩进入，练到新肩宽不再卡缝。",
      "description": "顶帘侧肩避卡。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0007",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "碎石路低重心试踏，你练到空鼓感一来就换脚。",
      "description": "碎石空鼓即换脚。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0008",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "水罐换肩找平，侧肋轮廓让你顿，你空罐练了十来回。",
      "description": "空罐换肩十来回。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0009",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "石凳起身扶沿，练到不扶也能把重心送前脚——仍偶尔扶。",
      "description": "石凳起身偶仍扶。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0010",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你在空地练转身半径，布帘扫腿时收摆，收干净才停。",
      "description": "空地转身收布帘摆。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0011",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "帽檐压到眉，又留出耳尖空隙，你用指量了空隙宽度。",
      "description": "帽檐留耳尖隙。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0012",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "面巾多绕半圈贴颈，干风少灌，硬缘处垫着布层。",
      "description": "面巾多绕垫硬缘。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0013",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "袖口放低遮晒红小臂，举手时再临时推上。",
      "description": "袖低遮晒临时推。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0014",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "腰带上挪对腰线，行囊带交叉点跟着改。",
      "description": "腰带上挪改囊交。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0015",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "靴内加软垫，软脚心落沙闷感轻一点。",
      "description": "靴垫减落沙闷。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0016",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你换更宽檐的旧帽，反光刺眼时少眯一点。",
      "description": "宽檐旧帽减眯。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0017",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "门帘外披风扣紧，风口侧身时衣摆少猎猎绊腿。",
      "description": "披风扣紧减绊。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0018",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "手套换半指，握罐耳时干指腹少打滑。",
      "description": "半指手套握罐。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0019",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "裤缝转到侧，膝突顶布的尖感分散。",
      "description": "裤缝转侧散膝尖。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0020",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你在肩带下垫旧布，薄壳肩的压麻缓一些。",
      "description": "肩带垫布缓麻。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0021",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "水罐耳缠布，干涩指腹握着不响也少滑。",
      "description": "罐耳缠布减滑响。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0022",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "行囊带收短，晃动变小，新肩宽承重更贴。",
      "description": "囊带收短贴肩。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0023",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把遮阳布角加坠，风掀时少要你腾手去压。",
      "description": "遮阳布加坠减掀。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0024",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "灯笼改手提短杆，夜下阶时光斑更跟脚。",
      "description": "短杆灯跟脚下阶。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0025",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把水壶背带改成斜挎，换肩时少侧倾一拍。",
      "description": "壶带斜挎减侧倾。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0026",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "石阶拐杖试用两日，扶壁仍更习惯，杖就插在行囊侧。",
      "description": "拐杖试用仍习扶壁。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0027",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你在干渠边放块踏石，跨沟时落点固定，少试探。",
      "description": "干渠踏石固定落点。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0028",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "门帘拨杆加长，手背新轮廓少先露出帘缝。",
      "description": "拨杆加长少露手背。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0029",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "窄口壶换宽口，倒水时腕角生疏也不易洒。",
      "description": "宽口壶容腕生疏。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0030",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把地图筒改背在另一侧，侧肋轮廓不再蹭筒。",
      "description": "地图筒换侧避肋。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0031",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "亮石映侧影，你辨耳尖与肩宽，热浪揉边时你等它清。",
      "description": "亮石等清辨耳肩。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0032",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你对小镜调帽与耳尖空隙，画记在帽内侧。",
      "description": "小镜调帽记内侧。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0033",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "门帘缝里瞥见自己手背先出，你改用拨杆后缝里只剩杆影。",
      "description": "改拨杆后缝无手背。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0034",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "井水微澜映脸，你盯颊凹凸一眼，打水时故意不看。",
      "description": "井澜一眼后故意不看。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0035",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "请同路人看肩带正不正，对方说：有点勒，垫布吧。你照做。",
      "description": "请看肩带获垫布建议。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0036",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "夜窗虚影里你描外轮廓，像描迁居后的新门牌。",
      "description": "夜窗描轮廓如门牌。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0037",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你用草茎量腕围，断茎为记，藏进面巾折层。",
      "description": "草茎量腕藏记。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0038",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "高台边看自己投在坡上的长影，肩宽被拉得夸张，你晃肩认影。",
      "description": "坡长影晃肩认。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0039",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "铜壶盖当镜，看额弧与帽印是否重合，不重合就重戴。",
      "description": "壶盖镜查帽印。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0040",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "歇下后你闭眼用手认脸：额、颊、颌。睁眼看星，两边都在。",
      "description": "闭眼手认脸睁看星。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0041",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你对同路人说：陡阶我要慢。对方在前留出两级空。",
      "description": "说明陡阶慢获留空。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0042",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "请人帮忙看路：前方碎石多不多？我脚感还在找。",
      "description": "问路兼言脚感找。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0043",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "驿站井边你说：我倒水可能洒，请让我站稳再倒。",
      "description": "井边请让站稳倒。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0044",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人夸你步伐稳，你笑：还在练，稳是假象。把话题拨开。",
      "description": "拨开夸赞言还在练。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0045",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "风口相遇你用手势请对方先过，口型说：我重心不稳。",
      "description": "风口手势请先过。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0046",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你谢绝夜赶路：暗里我靠脚感，今晚想早点歇。",
      "description": "谢夜赶言靠脚感。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0047",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "对问迁居累不累的人，你说：累，身体也在搬家。对方懂了笑。",
      "description": "言身体也在搬家。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0048",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "公开场合只说：我需要遮阳处坐坐。细节留给干风。",
      "description": "公开只求遮阳坐。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0049",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "写信：高地风大，人还在，轮廓有些新。未写效果。",
      "description": "信中高地与新轮廓。"
    },
    {
      "id": "lx.text-tf-adapt.b0004.0050",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人碰臂道歉，你说：没事，干风里触觉紧，谢谢轻一点。",
      "description": "说明干风触紧。"
    }
  ]
}
