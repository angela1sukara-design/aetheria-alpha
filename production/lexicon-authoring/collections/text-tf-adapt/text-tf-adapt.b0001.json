{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-tf-adapt",
  "batchId": "text-tf-adapt.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-tf-adapt.b0001.0001",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你反复练习侧身过门，肩背擦框时调整角度，直到能一次通过。",
      "description": "侧身过门的反复练习，不承诺成功。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0002",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你在空地里慢慢转身，感受新的旋转半径，转完又转一圈。",
      "description": "空地转身半径练习。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0003",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你把杯子从左手换到右手，换了几种握法，寻找不用想的位置。",
      "description": "换手握杯寻找习惯位。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0004",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你练习从蹲到站，中间停顿两次，确认膝盖的发力顺序。",
      "description": "蹲站发力顺序练习。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0005",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你沿墙根走直线，脚尖对齐砖缝，走歪了就退回重来。",
      "description": "沿砖缝直线行走练习。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0006",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你抬手够高处的挂钩，试了两次高度，第三次才碰到钩缘。",
      "description": "够挂钩高度试探。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0007",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你练习坐下时收腿的时机，腿侧不再磕到椅沿才停。",
      "description": "坐下收腿避椅沿。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0008",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你把步伐放慢，数着落脚点，让新的腿长感跟上节奏。",
      "description": "慢步对齐腿长感。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0009",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你对镜练习点头的幅度，避免耳尖先碰到想象中的帽檐。",
      "description": "对镜点头幅度练习。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0010",
      "category": "text-tf-adapt",
      "subcategory": "动作练习",
      "text": "你反复系解鞋带，指节新排列让绳结几次打滑，你继续试。",
      "description": "系鞋带适应指节。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0011",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你把袖口放长一截，遮住小臂新的外缘，又觉得碍事，再卷回。",
      "description": "袖口长短反复试。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0012",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "领口勒得不舒服，你松一扣又觉空，来回调到勉强可接受。",
      "description": "领口松紧来回调。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0013",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "裤管在膝外缘绷紧，你把裤缝转到侧面，试着分散压力。",
      "description": "裤缝转侧分散压。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0014",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你试了旧鞋和新鞋，旧鞋挤，新鞋空，最后选了旧鞋加厚袜。",
      "description": "新旧鞋折中加袜。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0015",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "腰带孔往外挪一格，腹前布料才平，你走两步确认不会滑。",
      "description": "腰带外挪确认不滑。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0016",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "围巾绕法改了两次，第三次才避开后颈那道敏感的脊感。",
      "description": "围巾绕开后颈脊感。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0017",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你把帽檐调低又调高，寻找既不压耳尖又不晃的位置。",
      "description": "帽檐避耳尖找稳。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0018",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "手套指尖余量太多，你换小一号，又觉紧，犹豫着戴回大的。",
      "description": "手套尺码犹豫。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0019",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "裙摆扫到小腿新轮廓，你把摆边别起一截，试着走路。",
      "description": "裙摆别起试走。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0020",
      "category": "text-tf-adapt",
      "subcategory": "衣物适应",
      "text": "你在衣内衬垫了一小块软布，减轻细绒与布料的刮痒。",
      "description": "内衬垫布减刮痒。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0021",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把水杯换了三个位置，腕的自然垂点终于对上杯耳。",
      "description": "水杯位置对腕垂点。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0022",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "勺子入口的角度变了，你歪了歪腕，汤差点洒，又稳住。",
      "description": "勺入口角重找。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0023",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "钥匙插入锁孔时对不准，你闭一眼瞄准，第三次才推进去。",
      "description": "钥匙对孔反复试。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0024",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你提水桶换了提法：先单手，再双手，最后用肘弯托住桶沿。",
      "description": "提桶多种提法试。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0025",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "扫地时帚柄打到侧肋，你把柄握低一截，扫幅随之变短。",
      "description": "帚柄避侧肋握低。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0026",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "写字时笔杆在新指缝里打滑，你换了握位，字迹歪了一行。",
      "description": "笔杆握位重找字歪。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0027",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "开门把手的高度感觉变了，你抬手过高又放下，才握住。",
      "description": "门把高度感重找。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0028",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你用筷子夹菜，指距变了夹不稳，改用勺完成这一餐。",
      "description": "筷不稳改用勺。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0029",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "灯芯拨子捏不稳，你改用指腹推，灯火晃了两下才定。",
      "description": "灯芯拨改指腹推。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0030",
      "category": "text-tf-adapt",
      "subcategory": "日常工具",
      "text": "你把椅距桌边再挪近半寸，肘才够得着碗，不至于前倾过度。",
      "description": "挪椅距够碗。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0031",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你对着窗玻璃侧过脸，辨认耳后那截新弧，指尖悬着没敢碰玻璃。",
      "description": "窗玻侧脸辨耳弧。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0032",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "水面倒影晃得厉害，你仍盯着肩线，想记住此刻的宽度。",
      "description": "水影盯肩线记宽。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0033",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你借店铺铜盆的反光看手背，纹理比记忆密，你张开又握紧。",
      "description": "铜盆反光看手背。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0034",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "对镜点名身体各部：额、颈、腕。每点到一处就停半息。",
      "description": "对镜点名停息。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0035",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你发现镜中自己眨眼的时机与体内感觉差半拍，多眨了几次对齐。",
      "description": "镜中眨眼对齐半拍。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0036",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "侧身镜里，腰到髋的曲线生疏，你用手比了一下长度。",
      "description": "侧身镜比腰髋长。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0037",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你把灯移近镜面，看清颊边细密凹凸，又把灯移远，凹凸隐去。",
      "description": "移灯看颊凹凸。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0038",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "鞋尖在镜中的朝向与实感不一致，你原地转了半圈校正。",
      "description": "镜中鞋尖朝向校正。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0039",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "你对着镜练习微笑，耳尖先动的画面让你停住，改成轻抿唇。",
      "description": "镜中笑改抿唇。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0040",
      "category": "text-tf-adapt",
      "subcategory": "镜像认识",
      "text": "窗夜把人影映得发虚，你仍描了一遍自己的外轮廓，像描一张陌生地图。",
      "description": "夜窗描外轮廓。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0041",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你对邻人说：我最近走路要慢一点。对方点头，没有追问原因。",
      "description": "向邻人说明慢走。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0042",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你请人帮忙递高处的东西，补充一句：我这阵子够着有点别扭。",
      "description": "请递物并说明别扭。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0043",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人夸你气色好，你笑着说：可能是刚适应新的作息。把话题拨开。",
      "description": "拨开夸赞到作息。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0044",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你跟熟人说肩线好像变了，对方看了一眼，回：我没注意，你自己舒服就好。",
      "description": "说肩线变获平静回应。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0045",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "排队时你请后面的人稍等，解释自己系鞋带要多花一点时间。",
      "description": "排队解释系带变慢。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0046",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你写信给远方的人：身体有些新感觉，还在慢慢认。没有展开细节。",
      "description": "信中简述新感觉。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0047",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "店员问要不要试小号衣服，你说：先这样吧，我还在找合适的尺码。",
      "description": "拒试衣说明找尺码。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0048",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你对同行者说：过窄巷让我先侧一下。对方放慢，给你空间。",
      "description": "请同行让窄巷空间。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0049",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "有人碰了你的手臂又道歉，你说：没事，我这阵子触觉有点敏。",
      "description": "说明触觉敏接受道歉。"
    },
    {
      "id": "lx.text-tf-adapt.b0001.0050",
      "category": "text-tf-adapt",
      "subcategory": "向他人表达",
      "text": "你在公共场合只说：我需要坐一会儿。把更私人的感受留给自己。",
      "description": "公开只说需坐。"
    }
  ]
}
