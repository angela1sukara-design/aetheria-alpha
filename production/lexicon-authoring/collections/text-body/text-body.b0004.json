{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-body",
  "batchId": "text-body.b0004",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.text-body.b0004.0001",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在遮阳布下伸直双臂，布影在手臂上晃出细纹。世界没有因此改变。",
      "description": "遮阳布下的手臂舒展。"
    },
    {
      "id": "lx.text-body.b0004.0002",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你登上石阶中段，停住深吸一口干热空气，胸腔展开。改变的只是你的体感。",
      "description": "石阶中段的扩胸呼吸。"
    },
    {
      "id": "lx.text-body.b0004.0003",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把晒得发紧的肩背往后绕，布帘随之轻响。你把袖口拉回原位。",
      "description": "干热中的肩背环绕。"
    },
    {
      "id": "lx.text-body.b0004.0004",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你坐在石阶边缘，双腿悬空晃了两下，又收回。目光重新平视前方。",
      "description": "石阶边悬腿轻晃。"
    },
    {
      "id": "lx.text-body.b0004.0005",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你摘下遮阳帽扇了扇风，手臂画了半圈再戴回。呼吸与步伐重新对齐。",
      "description": "摘帽扇风的手臂弧。"
    },
    {
      "id": "lx.text-body.b0004.0006",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在高台边踮脚远望，脚跟落下时踝部弹了一下。这一点就够了。",
      "description": "远望踮脚的踝弹。"
    },
    {
      "id": "lx.text-body.b0004.0007",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你转身面向来路，颈项慢慢从一侧转到另一侧。不必再多。",
      "description": "转向来路的颈部转动。"
    },
    {
      "id": "lx.text-body.b0004.0008",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把干裂的指节互相挤压，发出细微的咔响。收束得很克制。",
      "description": "干热中的指节活动。"
    },
    {
      "id": "lx.text-body.b0004.0009",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你靠着石柱侧身拉伸，一侧肋骨贴着温热的石面。像翻过一页薄纸。",
      "description": "贴石柱的侧身拉伸。"
    },
    {
      "id": "lx.text-body.b0004.0010",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你放下行囊，双手撑腰后仰，远山在视野里晃了一晃。街面依旧。",
      "description": "放下行囊后的后仰。"
    },
    {
      "id": "lx.text-body.b0004.0011",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把被风掀起的布帘压回腰间，重新系紧结。做完才觉得完整。",
      "description": "压回风掀布帘。"
    },
    {
      "id": "lx.text-body.b0004.0012",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你拍掉靴面的干燥尘土，鞋帮重新贴紧脚踝。余光扫过确认无误。",
      "description": "拍靴尘整理鞋帮。"
    },
    {
      "id": "lx.text-body.b0004.0013",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把遮阳帽檐调低，挡住刺眼的坡顶反光。属于平静的认真。",
      "description": "调低帽檐挡反光。"
    },
    {
      "id": "lx.text-body.b0004.0014",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把背包带收短一扣，肩负更贴背，少晃动。没有戏剧性。",
      "description": "收短背包带。"
    },
    {
      "id": "lx.text-body.b0004.0015",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把被汗贴住的额发拨开，用布条重新束好。继续融入人流。",
      "description": "束好汗湿额发。"
    },
    {
      "id": "lx.text-body.b0004.0016",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把袖口从肘部放下一截，遮住晒红的小臂。恰如其分。",
      "description": "放低袖口遮晒。"
    },
    {
      "id": "lx.text-body.b0004.0017",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你整理领口，把被风灌进的沙粒抖到袖外。停在足够好的程度。",
      "description": "抖出领口沙粒。"
    },
    {
      "id": "lx.text-body.b0004.0018",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把腰带挪到髋骨上方，行囊重量随之重新分配。像给衣物一个交代。",
      "description": "挪腰带重分配负重。"
    },
    {
      "id": "lx.text-body.b0004.0019",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你蹲下把裤脚里的石子倒出，再拍平裤线。自己看着顺眼就行。",
      "description": "倒出裤脚石子。"
    },
    {
      "id": "lx.text-body.b0004.0020",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把面巾从颈后扯到面前，折齐后再绕回。随即恢复步行节奏。",
      "description": "重绕面巾。"
    },
    {
      "id": "lx.text-body.b0004.0021",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你侧身穿过两道垂帘之间的窄缝，布面擦过肩甲。贴边走得稳。",
      "description": "垂帘窄缝侧身。"
    },
    {
      "id": "lx.text-body.b0004.0022",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你拾级而上时把步幅缩短，适应越来越陡的石阶。空隙刚好够用。",
      "description": "陡阶缩短步幅。"
    },
    {
      "id": "lx.text-body.b0004.0023",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在低矮遮阳棚下弯腰前行，手掌轻触棚骨定位。没有擦出声响。",
      "description": "低棚弯腰前行。"
    },
    {
      "id": "lx.text-body.b0004.0024",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你贴着崖壁内侧走，给外侧的下坡留出安全距离。完成一次无声的协商。",
      "description": "贴崖壁内侧行。"
    },
    {
      "id": "lx.text-body.b0004.0025",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在石台转角收肩，让对向行人先过再迈步。空间关系暂时理顺。",
      "description": "石台转角收肩让路。"
    },
    {
      "id": "lx.text-body.b0004.0026",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你蹲下才能钻过横贯路口的晾晒绳，起身拍尘。你成为通道的一部分。",
      "description": "钻过路口晾绳。"
    },
    {
      "id": "lx.text-body.b0004.0027",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你把身体侧进遮阳篷与货架的夹缝，才够到水罐。不堵塞也不拖延。",
      "description": "篷架夹缝取水罐。"
    },
    {
      "id": "lx.text-body.b0004.0028",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在狭窄石廊里侧身换脚，背脊偶尔轻触石壁。像水穿过石缝。",
      "description": "石廊侧身换脚。"
    },
    {
      "id": "lx.text-body.b0004.0029",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你跨过门槛石坎，前脚先探，确认落点再送重心。适应写在步伐里。",
      "description": "跨石坎探落点。"
    },
    {
      "id": "lx.text-body.b0004.0030",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在棚屋连片的过道里低头，避免碰到来往的檐角。继续向前。",
      "description": "连片过道低头避檐。"
    },
    {
      "id": "lx.text-body.b0004.0031",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你停在石阶拐角，看远处热浪把地平线揉得发虚。不解释为何停。",
      "description": "拐角静观热浪。"
    },
    {
      "id": "lx.text-body.b0004.0032",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你靠着遮阳柱，目光停在布帘被风掀起的弧度上。停本身就是内容。",
      "description": "靠柱看布帘弧。"
    },
    {
      "id": "lx.text-body.b0004.0033",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你坐下歇脚，掌心贴着被晒热的石面，一动不动。细小到几乎看不见。",
      "description": "掌贴热石的静止。"
    },
    {
      "id": "lx.text-body.b0004.0034",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你捏着空水袋，袋口的尘线清晰，你没有立刻起身。却被你完整经历。",
      "description": "捏空水袋的停顿。"
    },
    {
      "id": "lx.text-body.b0004.0035",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你立在高台边，衣角猎猎，肩线却保持水平。随后才接上人流。",
      "description": "高台边肩线静止。"
    },
    {
      "id": "lx.text-body.b0004.0036",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你盯着石缝里一株干草，风过时它轻颤，你也不动。像一枚按住的书签。",
      "description": "盯干草的静立。"
    },
    {
      "id": "lx.text-body.b0004.0037",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你把下巴搁在交叠的手臂上，看行人沿阶上下。世界翻页，你按着。",
      "description": "搁下巴观阶上行。"
    },
    {
      "id": "lx.text-body.b0004.0038",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你侧耳听远处驼铃，脚尖抵住石棱，人影不动。静止结束得同样轻。",
      "description": "听驼铃时脚抵石棱。"
    },
    {
      "id": "lx.text-body.b0004.0039",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你握着帽沿停在门帘外，帘缝透出的光在手背跳动。没有人催促。",
      "description": "门帘外握帽停驻。"
    },
    {
      "id": "lx.text-body.b0004.0040",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你坐在行囊上，目光追着一只飞虫消失在亮白天空。你自己决定何时继续。",
      "description": "坐行囊追飞虫。"
    },
    {
      "id": "lx.text-body.b0004.0041",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你沿陡阶上行，重心前压，手偶尔扶一下内侧石壁。交接干净利落。",
      "description": "陡阶上行前压重心。"
    },
    {
      "id": "lx.text-body.b0004.0042",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你下坡时重心后移，脚跟着地更多，步幅缩短。没有多余摇晃。",
      "description": "下坡后移重心。"
    },
    {
      "id": "lx.text-body.b0004.0043",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你扛起行囊，身体微前倾，迈出的第一步压实沙地。像换挡。",
      "description": "扛囊前倾迈步。"
    },
    {
      "id": "lx.text-body.b0004.0044",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在风口处张开双脚，把重量压向迎风的一侧腿。新的支撑点生效。",
      "description": "风口迎风侧承重。"
    },
    {
      "id": "lx.text-body.b0004.0045",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你从石凳起身，先移重心到前脚，再伸直后腿。旧的暂时让位。",
      "description": "石凳起身重心前移。"
    },
    {
      "id": "lx.text-body.b0004.0046",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你侧身让过驮队，内侧腿承重，外侧腿点在阶缘。这一换让你清醒。",
      "description": "让驮队的内侧承重。"
    },
    {
      "id": "lx.text-body.b0004.0047",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你跨过干涸渠沟，起跳前稍蹲，落地时膝微曲吸震。地面仍是地面。",
      "description": "跨渠沟蹲跳吸震。"
    },
    {
      "id": "lx.text-body.b0004.0048",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你推开被风压住的门帘，肩先顶入，重心随之前送。你仍是你。",
      "description": "顶门帘前送重心。"
    },
    {
      "id": "lx.text-body.b0004.0049",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在松动碎石上放慢，重心压低，脚掌试探后再踏实。只是着力点挪了。",
      "description": "碎石路低重心试踏。"
    },
    {
      "id": "lx.text-body.b0004.0050",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你把水罐换到另一肩，身体瞬时侧倾，又迅速找平。继续走。",
      "description": "换肩水罐的侧倾找平。"
    }
  ]
}
