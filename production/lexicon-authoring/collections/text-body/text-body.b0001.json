{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-body",
  "batchId": "text-body.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-body.b0001.0001",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在长椅边慢慢伸直手臂，骨节轻轻响了一下，随即把袖口拉回原位。肩背随之松一点。",
      "description": "公共座椅旁的日常伸展，动作克制。"
    },
    {
      "id": "lx.text-body.b0001.0002",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你转动肩膀，让背囊带从锁骨移开一点，胸口随之松了一口气。衣料轻轻响了一下。",
      "description": "负重后的肩背舒展，不涉及能力。"
    },
    {
      "id": "lx.text-body.b0001.0003",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你踮起脚尖又落下，像在确认脚踝还能自如活动。像把憋着的一口气放掉。",
      "description": "短暂踮脚舒展，焦点在自我确认。"
    },
    {
      "id": "lx.text-body.b0001.0004",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把双手交叠举过头顶，短短停顿后才慢慢放下。指尖也跟着张开。",
      "description": "站立伸展，节奏平常。"
    },
    {
      "id": "lx.text-body.b0001.0005",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你侧身弯腰，指尖碰到鞋面，随即直起身拍了拍裤腿。随即把注意力收回眼前。",
      "description": "弯腰触鞋的舒展，收束于整理衣物。"
    },
    {
      "id": "lx.text-body.b0001.0006",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你轻轻摇晃手腕，让刚提过水桶的酸胀感散开一些。没有夸张到引注目光。",
      "description": "劳作后的手腕舒展。"
    },
    {
      "id": "lx.text-body.b0001.0007",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你仰头望向屋檐片刻，颈椎随之拉长，又很快收回视线。脚掌在地面重新踩实。",
      "description": "仰头带来的颈项舒展。"
    },
    {
      "id": "lx.text-body.b0001.0008",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在门槛内侧张开双臂，像量一下门框宽窄，随即收拢。短得像一次深呼吸。",
      "description": "借量空间完成的手臂舒展。"
    },
    {
      "id": "lx.text-body.b0001.0009",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你坐下后把腿伸直又收回，脚尖在地面轻轻画了半圈。完成后神情仍旧平常。",
      "description": "坐下时的腿部舒展。"
    },
    {
      "id": "lx.text-body.b0001.0010",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你搓了搓发麻的手指，再张开掌心对着空气停了一停。旁人若看见也只会当寻常。",
      "description": "手指发麻后的舒展与静止。"
    },
    {
      "id": "lx.text-body.b0001.0011",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把衣领翻正，拇指顺着领口内侧走了一圈，确认没有折痕。整理完才继续迈步。",
      "description": "整理衣领，礼貌距离下的自我收拾。"
    },
    {
      "id": "lx.text-body.b0001.0012",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你蹲下系好松了的鞋带，站起时顺手拍掉膝上的灰。手指在布面上多停一瞬。",
      "description": "系鞋带与拍灰的姿态整理。"
    },
    {
      "id": "lx.text-body.b0001.0013",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把散开的发辫重新绕到耳后，动作不快也不躲闪。确认平整后放手。",
      "description": "整理发丝，平常心情。"
    },
    {
      "id": "lx.text-body.b0001.0014",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把袖口卷到小臂中段，又觉得太高，退回一指宽的位置。像给自己一个礼貌。",
      "description": "反复调整袖口高度。"
    },
    {
      "id": "lx.text-body.b0001.0015",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把背包带从一边肩挪到另一边，身体跟着微微侧倾。不假他人之手。",
      "description": "换肩负重时的姿态调整。"
    },
    {
      "id": "lx.text-body.b0001.0016",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你低头检查裙摆有没有沾到泥点，确认后才继续迈步。动作熟门熟路。",
      "description": "检查衣摆的短暂停顿。"
    },
    {
      "id": "lx.text-body.b0001.0017",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把围巾重新绕紧一圈，下颌贴着布料停了半息。带着一点洁癖式的认真。",
      "description": "整理围巾，带一点温度感。"
    },
    {
      "id": "lx.text-body.b0001.0018",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把手套指尖逐个按实，再握了握拳试手感。旁人看了会懂。",
      "description": "戴好手套后的确认动作。"
    },
    {
      "id": "lx.text-body.b0001.0019",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你侧身对着玻璃窗整理帽檐，尽量不挡住别人的路。属于出门前的惯性。",
      "description": "借窗整理帽子，兼顾礼貌。"
    },
    {
      "id": "lx.text-body.b0001.0020",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把腰带扣回原孔，腹前布料随之平整下来。做完神情更安稳。",
      "description": "调整腰带松紧。"
    },
    {
      "id": "lx.text-body.b0001.0021",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你侧身穿过窄巷，肩背贴着墙，让对面的人先过。空间因此让出余地。",
      "description": "窄巷让路时的身体适应。"
    },
    {
      "id": "lx.text-body.b0001.0022",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在低梁下微微低头，手扶门框稳住脚步再进。身体学会了让。",
      "description": "低矮入口处的低头适应。"
    },
    {
      "id": "lx.text-body.b0001.0023",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你把椅子往桌边挪近半寸，膝盖才刚好收到桌下。窄处反而更清醒。",
      "description": "坐姿适应桌下空间。"
    },
    {
      "id": "lx.text-body.b0001.0024",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在拥挤的水台前侧过身，肘部收紧，避免碰到邻人的桶。一步一确认。",
      "description": "公共水台旁的拥挤适应。"
    },
    {
      "id": "lx.text-body.b0001.0025",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你踩上略高的石阶，先试了试落脚点，再把重心送过去。落点确认后再送重心。",
      "description": "石阶高度变化时的适应。"
    },
    {
      "id": "lx.text-body.b0001.0026",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在货架夹道里侧身平移，背部偶尔轻触木架。像与建筑商量过。",
      "description": "窄货道中的侧身移动。"
    },
    {
      "id": "lx.text-body.b0001.0027",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你弯腰钻过晾衣绳，起身时用手托住绳，免得它回弹。尺寸感写在肌肉里。",
      "description": "穿过晾晒区的空间适应。"
    },
    {
      "id": "lx.text-body.b0001.0028",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在长桌尽头找到空隙坐下，肩宽刚好卡进两边的空档。不硬闯。",
      "description": "长桌空位的落座适应。"
    },
    {
      "id": "lx.text-body.b0001.0029",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你贴着栏杆内侧缓行，给推车留出更宽的通道。留下的空隙给别人。",
      "description": "栏杆边让推车的空间配合。"
    },
    {
      "id": "lx.text-body.b0001.0030",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在门槛处停半步，抬脚跨过略高的木槛，落地时放轻。自己也更安全。",
      "description": "跨门槛的节奏适应。"
    },
    {
      "id": "lx.text-body.b0001.0031",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你站在窗边，指尖无意识地摩挲窗台边缘的光滑处。时间在这一停里变慢。",
      "description": "窗边静止时的手指细节。"
    },
    {
      "id": "lx.text-body.b0001.0032",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你坐着等候时，目光停在桌面一道浅浅的刀痕上。只有目光还在动。",
      "description": "等候中的静止注视。"
    },
    {
      "id": "lx.text-body.b0001.0033",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你双手交叠搁在膝上，拇指轻轻对顶，不再挪动。静止比动作更清楚。",
      "description": "膝上交叠双手的静止。"
    },
    {
      "id": "lx.text-body.b0001.0034",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你靠着墙，肩胛贴实砖面，呼吸慢慢与砖缝的凉意同步。像把世界按了暂停。",
      "description": "靠墙静止的贴合感。"
    },
    {
      "id": "lx.text-body.b0001.0035",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你低头看着手心里的一小块布屑，久久没有抖落。细节自己浮上来。",
      "description": "掌心琐屑的静止关注。"
    },
    {
      "id": "lx.text-body.b0001.0036",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你立在队伍里，脚尖对齐地砖缝，整个人几乎不动。呼吸是唯一的响动。",
      "description": "排队时的对齐静止。"
    },
    {
      "id": "lx.text-body.b0001.0037",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你把下巴搁在交叠的手背上，目光落在虚空处片刻。旁人走过也不打断。",
      "description": "托腮式的短暂静止。"
    },
    {
      "id": "lx.text-body.b0001.0038",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你停在告示旁，衣角被风掀起又落下，其余部位不动。停得理直气壮。",
      "description": "告示前的风动衣角对比。"
    },
    {
      "id": "lx.text-body.b0001.0039",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你握着空杯，杯底在桌面压出一圈湿印，你没有立刻移开。像倾听自己的脉搏。",
      "description": "杯底湿印旁的静止停顿。"
    },
    {
      "id": "lx.text-body.b0001.0040",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你侧耳听街外脚步远去，肩膀保持同一高度，没有耸动。什么也不急着做。",
      "description": "倾听时的肩部静止。"
    },
    {
      "id": "lx.text-body.b0001.0041",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你从蹲姿站起时先把重心移到前脚，再慢慢伸直后腿。平衡重新找到。",
      "description": "蹲起过程中的重心转移。"
    },
    {
      "id": "lx.text-body.b0001.0042",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你接过稍重的布袋，身体本能后仰半寸，再找回平衡。脚掌报告新的压力。",
      "description": "接重物时的重心调整。"
    },
    {
      "id": "lx.text-body.b0001.0043",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在湿滑石板上放慢步子，重心压低，脚掌贴地推进。身体比意识更早知道。",
      "description": "湿地面的低重心行走。"
    },
    {
      "id": "lx.text-body.b0001.0044",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你侧身让路时，重心先落到内侧腿，外侧腿才轻抬。稳了才迈下一步。",
      "description": "让路时的单侧重心。"
    },
    {
      "id": "lx.text-body.b0001.0045",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你抬身离凳，脚尖先触地，再把全身重量缓缓送下去。重量在肌肉间交接。",
      "description": "离凳落地的重心顺序。"
    },
    {
      "id": "lx.text-body.b0001.0046",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你推开略沉的门，肩先顶住门扇，重心前移才迈步。像重新学习站立。",
      "description": "推门时的前倾重心。"
    },
    {
      "id": "lx.text-body.b0001.0047",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在摇晃的木板上张开双脚，把重心落在两脚之间。短暂停顿保护关节。",
      "description": "不稳地面的双脚分重心。"
    },
    {
      "id": "lx.text-body.b0001.0048",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你弯腰拾起掉落的扣子，起身途中短暂停一下，稳住眩晕。重心走完该走的路径。",
      "description": "弯腰起身后的重心回稳。"
    },
    {
      "id": "lx.text-body.b0001.0049",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你把身体重量从右脚换到左脚，像在试哪边更踏实。没有踉跄。",
      "description": "左右换脚试重心。"
    },
    {
      "id": "lx.text-body.b0001.0050",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你倚着门框时把重心放在一条腿上，另一腿膝部微曲。只有谨慎。",
      "description": "倚门的单腿支撑重心。"
    }
  ]
}
