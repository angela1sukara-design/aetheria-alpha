{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-body",
  "batchId": "text-body.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-body.b0002.0001",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你放下锉刀，把僵硬的手指一根根展开，指腹还留着木屑感。停在刚好舒服的位置。",
      "description": "细作后的手指舒展。"
    },
    {
      "id": "lx.text-body.b0002.0002",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你从工作台前直起腰，双手撑在腰眼，轻轻后仰。再动一下就嫌多余。",
      "description": "伏案修补后的腰背舒展。"
    },
    {
      "id": "lx.text-body.b0002.0003",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你揉了揉长时间捏针的虎口，再张开手掌对着灯火停一下。空气在胸口走得更顺。",
      "description": "缝纫后的手部舒展。"
    },
    {
      "id": "lx.text-body.b0002.0004",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你转了转因拧螺丝而发紧的手腕，袖口擦过台面木纹。动作收得干净利落。",
      "description": "拧紧操作后的手腕活动。"
    },
    {
      "id": "lx.text-body.b0002.0005",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你站起身时把肩膀向后绕两圈，工具带随之轻响。像自我检查后的小结。",
      "description": "站起后的肩部环绕舒展。"
    },
    {
      "id": "lx.text-body.b0002.0006",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把贴在额前的碎发拨开，顺势伸长了脖子。余韵只有自己感觉得到。",
      "description": "拨发兼颈项舒展。"
    },
    {
      "id": "lx.text-body.b0002.0007",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你蹲着调平桌脚太久，起身时先活动脚踝再迈步。街声没有因此停一拍。",
      "description": "蹲姿久后的踝部舒展。"
    },
    {
      "id": "lx.text-body.b0002.0008",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把夹着布料的双臂松开，掌心朝上，指尖微微发颤。你眨眨眼继续刚才的事。",
      "description": "长时间夹持后的手臂放松。"
    },
    {
      "id": "lx.text-body.b0002.0009",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你仰头望向小店梁上的旧吊灯，颈椎随之舒展一瞬。肌肉的紧绷散开些许。",
      "description": "店内仰望带来的伸展。"
    },
    {
      "id": "lx.text-body.b0002.0010",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你完成一针后放下活计，双手交握举过头顶短暂拉伸。连自己都差点忽略。",
      "description": "工序间隙的举手舒展。"
    },
    {
      "id": "lx.text-body.b0002.0011",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把围裙重新系紧，前襟的旧补丁被拉得平整。没有镜子也凭触感。",
      "description": "系紧围裙的姿态整理。"
    },
    {
      "id": "lx.text-body.b0002.0012",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你用袖口擦掉指尖的蜡迹，再把袖口卷回同一高度。扣件发出细微轻响。",
      "description": "擦手兼整理袖口。"
    },
    {
      "id": "lx.text-body.b0002.0013",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把工具袋从腰侧挪到身前，扣环咔哒一声扣好。布料归位，心也定一点。",
      "description": "调整工具袋位置。"
    },
    {
      "id": "lx.text-body.b0002.0014",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你蹲下把散落的线头收入盒中，起身时拍净膝上木屑。像把散开的边角收回。",
      "description": "收拾线头与拍膝。"
    },
    {
      "id": "lx.text-body.b0002.0015",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把护目镜推到额上，又觉得不稳，重新卡回鼻梁。短暂停顿恰到好处。",
      "description": "调整护目镜位置。"
    },
    {
      "id": "lx.text-body.b0002.0016",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把工作手套翻面抖灰，再按指缝逐个套回。不妨碍别人的路。",
      "description": "翻抖手套后重戴。"
    },
    {
      "id": "lx.text-body.b0002.0017",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把衣襟上的粉笔印拍淡，指腹在布面上多停了一下。完成于公共目光之外。",
      "description": "拍掉粉笔印的整理。"
    },
    {
      "id": "lx.text-body.b0002.0018",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把发带往后勒紧，额前碎发不再垂进视野。属于低声的自我收拾。",
      "description": "勒紧发带以免挡眼。"
    },
    {
      "id": "lx.text-body.b0002.0019",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把膝盖垫布展开铺正，再跪回原先的工作位置。结束后肩线更平。",
      "description": "调整跪垫布的姿态。"
    },
    {
      "id": "lx.text-body.b0002.0020",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把领口别针重新别好，别针尾端贴着锁骨内侧。你点了点头给自己。",
      "description": "别好领口别针。"
    },
    {
      "id": "lx.text-body.b0002.0021",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你侧身挤进工作台与墙之间的窄缝，肘部贴着旧木板。通过后才呼气。",
      "description": "窄工作缝中的侧身。"
    },
    {
      "id": "lx.text-body.b0002.0022",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你弯腰钻过挂满线轴的横杆，起身时用手稳住晃动的线。肩背记下这次的宽窄。",
      "description": "穿过线轴区的适应。"
    },
    {
      "id": "lx.text-body.b0002.0023",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在学徒与师傅之间让出半步，肩宽刚好不挡双方视线。像临时的舞蹈。",
      "description": "协作空间中的让位。"
    },
    {
      "id": "lx.text-body.b0002.0024",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你把小板凳挪近修补台，膝盖才够得着要修的桌腿。没有抱怨门槛。",
      "description": "挪凳适应工作高度。"
    },
    {
      "id": "lx.text-body.b0002.0025",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在堆满旧物的过道里踮脚落点，避开翘起的木板。适应比抱怨快。",
      "description": "旧物过道的落脚适应。"
    },
    {
      "id": "lx.text-body.b0002.0026",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你把身侧的工具架往外推寸许，才有空间转身取锉。动作小而准确。",
      "description": "推开工具架腾出转身位。"
    },
    {
      "id": "lx.text-body.b0002.0027",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你跪在柜台内侧修合叶，肩背刚好卡进柜台下的空腔。空间没有改变，你改了。",
      "description": "柜台下跪姿空间适应。"
    },
    {
      "id": "lx.text-body.b0002.0028",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你侧头避开悬垂的量尺，下巴几乎贴着台面推进。挤中仍保持礼貌。",
      "description": "量尺下的低头侧行。"
    },
    {
      "id": "lx.text-body.b0002.0029",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在两人合抬木箱时侧过髋部，给同伴留出转向弧。像量体裁衣反过来。",
      "description": "协作抬物时的髋部让位。"
    },
    {
      "id": "lx.text-body.b0002.0030",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你把椅子背靠墙，双脚才能伸直，不碰到对面的修补架。身体先于意识调整。",
      "description": "靠墙坐姿避开架具。"
    },
    {
      "id": "lx.text-body.b0002.0031",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你盯着裂开的木纹，指尖停在裂缝边缘，久久不落锯。静止里有观察。",
      "description": "观察裂缝时的静止。"
    },
    {
      "id": "lx.text-body.b0002.0032",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你握着半缝完的布边，针停在半空，目光追着线头走向。手指停在刚好的位置。",
      "description": "缝纫中途的静止观察。"
    },
    {
      "id": "lx.text-body.b0002.0033",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你把耳贴近旧钟壳，整个人僵住，只剩呼吸微动。像一幅未完成的画。",
      "description": "听钟时的全身静止。"
    },
    {
      "id": "lx.text-body.b0002.0034",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你左手按住待粘的接口，右手胶水瓶悬停，等待对位。外界声音退远一点。",
      "description": "粘接前的按压静止。"
    },
    {
      "id": "lx.text-body.b0002.0035",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你坐在角落磨刀石旁，砂声停下后，双手仍保持握姿。你允许自己发呆。",
      "description": "磨刀停顿后的握姿残留。"
    },
    {
      "id": "lx.text-body.b0002.0036",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你看着学徒的手势，自己的手指在空中轻轻比了一下就停住。不动也是一种姿态。",
      "description": "示范中断后的手势静止。"
    },
    {
      "id": "lx.text-body.b0002.0037",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你把旧扣子放在掌心，光线照着缺口，你没有立刻说话。细节经得起细看。",
      "description": "端详旧扣的静止片刻。"
    },
    {
      "id": "lx.text-body.b0002.0038",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你倚着门框看店内忙碌，肩线不动，只有眼珠跟随动作。停顿没有尴尬。",
      "description": "旁观店内的肩部静止。"
    },
    {
      "id": "lx.text-body.b0002.0039",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你捏着量好的布条，两端对齐后，整只手悬停确认。像把注意力收束成点。",
      "description": "量布对齐后的悬停。"
    },
    {
      "id": "lx.text-body.b0002.0040",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你把烙铁离开布面，青烟散去前，你保持同一姿势。然后才准备再动。",
      "description": "烙烫后的姿势保持。"
    },
    {
      "id": "lx.text-body.b0002.0041",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你抬起略沉的工具箱，重心后移，迈出的第一步压得很稳。地面给出回应。",
      "description": "提工具箱时的后移重心。"
    },
    {
      "id": "lx.text-body.b0002.0042",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你踩上矮凳够高架，先把一只脚踩实，再送上全身重量。你听懂了那一点阻力。",
      "description": "踩凳够物的重心上送。"
    },
    {
      "id": "lx.text-body.b0002.0043",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在推拉锯时前脚承重，后脚轻点，随锯程前后挪移。发力顺序被改写一寸。",
      "description": "推拉锯中的前后重心。"
    },
    {
      "id": "lx.text-body.b0002.0044",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你帮同伴扶正柜子，两人同时把重心压向柜脚一侧。习惯正在更新。",
      "description": "协作扶柜的共重心。"
    },
    {
      "id": "lx.text-body.b0002.0045",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你从跪姿起身时，手先撑地，再把重心交给膝盖。下一步会更熟。",
      "description": "跪起时的手膝重心交接。"
    },
    {
      "id": "lx.text-body.b0002.0046",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你侧身搬开半满的零件箱，髋部先转，腿才跟上。重量落在该落的地方。",
      "description": "侧搬箱时的髋先转。"
    },
    {
      "id": "lx.text-body.b0002.0047",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在打磨时把体重压在前臂，脚掌随之微微踮起。左右找到新的协议。",
      "description": "打磨加压时的踮脚重心。"
    },
    {
      "id": "lx.text-body.b0002.0048",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你接过师傅递来的重锤，手腕一沉，立刻用肩背接住力。像调整天平。",
      "description": "接锤时肩背承接重心。"
    },
    {
      "id": "lx.text-body.b0002.0049",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你退开工作台时后脚先撤，前脚仍贴地，重心缓缓后移。倾侧被及时收回。",
      "description": "退台时的后撤重心。"
    },
    {
      "id": "lx.text-body.b0002.0050",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你蹲着开箱底钉，重心落在脚跟上，膝外撑以稳住身形。平衡感回升。",
      "description": "蹲姿开箱的脚跟重心。"
    }
  ]
}
