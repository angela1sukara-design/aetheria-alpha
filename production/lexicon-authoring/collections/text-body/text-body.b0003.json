{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-body",
  "batchId": "text-body.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-body.b0003.0001",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在雨棚下甩了甩沾湿的袖口，手臂随之画了个小弧。不求拉得很满。",
      "description": "雨棚下甩袖的舒展。"
    },
    {
      "id": "lx.text-body.b0003.0002",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你沿着水渠边伸直腿，脚尖点着湿苔，又缩回鞋里。刚好够用就停。",
      "description": "水渠边的腿部伸展。"
    },
    {
      "id": "lx.text-body.b0003.0003",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把被潮气黏住的衣背扯开一点，胸口得以深吸一口气。留下一点轻松的空隙。",
      "description": "潮衣贴背时的扯开舒展。"
    },
    {
      "id": "lx.text-body.b0003.0004",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在蕨丛旁转了转僵硬的脖子，叶片擦过耳廓。像给身体签了到。",
      "description": "蕨丛旁的颈部转动。"
    },
    {
      "id": "lx.text-body.b0003.0005",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你踮脚够雨棚挂钩，起落之间脚踝轻快地弹了两下。然后步伐恢复原速。",
      "description": "够挂钩时的踝部轻弹。"
    },
    {
      "id": "lx.text-body.b0003.0006",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你坐在渠岸石上，双臂向后撑，肩胛张开又合拢。没有声音，只有触感。",
      "description": "渠岸撑臂的肩胛舒展。"
    },
    {
      "id": "lx.text-body.b0003.0007",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你搓开被雨水冻得发紧的手指，掌心对掌心摩擦发热。短促而清楚。",
      "description": "雨后搓手的舒展。"
    },
    {
      "id": "lx.text-body.b0003.0008",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你仰头让棚檐滴水落在眉骨外，颈项随之拉长。结束在自然垂落里。",
      "description": "躲滴水时的仰头伸展。"
    },
    {
      "id": "lx.text-body.b0003.0009",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你把湿发拢到一侧，侧颈暴露在潮湿空气里片刻。不需要观众。",
      "description": "拢发露出侧颈的舒展。"
    },
    {
      "id": "lx.text-body.b0003.0010",
      "category": "text-body",
      "subcategory": "舒展",
      "text": "你在苔痕石阶上蹲起几次，膝盖发出细微响声。像私下完成的小仪式。",
      "description": "苔阶上的蹲起活动。"
    },
    {
      "id": "lx.text-body.b0003.0011",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把被雨打湿的帽檐拧干，再端正地戴回头顶。细节决定踏实感。",
      "description": "拧干帽檐后重戴。"
    },
    {
      "id": "lx.text-body.b0003.0012",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把裤脚从泥水里拉高一截，布边贴着小腿系住。不求完美，求妥帖。",
      "description": "拉高裤脚避泥水。"
    },
    {
      "id": "lx.text-body.b0003.0013",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把披肩上的水珠抖落，重新在胸前交叉扣好。像补上遗漏的一笔。",
      "description": "抖干披肩再扣。"
    },
    {
      "id": "lx.text-body.b0003.0014",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你用袖口内侧擦掉颊边水痕，动作很快，不引人注意。街风吹来也不再乱。",
      "description": "擦颊边水痕。"
    },
    {
      "id": "lx.text-body.b0003.0015",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把湿透的鞋带松开再系紧，鞋口溢出一点水。重新觉得可以见人。",
      "description": "重系湿鞋带。"
    },
    {
      "id": "lx.text-body.b0003.0016",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把贴在额上的湿发别到耳后，指尖碰到微凉的皮肤。习惯成自然。",
      "description": "别开湿发。"
    },
    {
      "id": "lx.text-body.b0003.0017",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把伞收起竖靠墙，再整理被伞柄压皱的衣襟。手指离开时布已服帖。",
      "description": "收伞后整理衣襟。"
    },
    {
      "id": "lx.text-body.b0003.0018",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把手套翻出内侧晾着，双手暂时插进干爽的袖筒。这一下让仪态回正。",
      "description": "翻晾湿手套。"
    },
    {
      "id": "lx.text-body.b0003.0019",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你蹲在水渠边洗鞋底泥，起身时把裤线抚直。不需要解说。",
      "description": "洗鞋后抚直裤线。"
    },
    {
      "id": "lx.text-body.b0003.0020",
      "category": "text-body",
      "subcategory": "整理姿态",
      "text": "你把腰间布袋挪到不被滴水打到的一侧。像默契的自我提醒。",
      "description": "挪布袋避滴水。"
    },
    {
      "id": "lx.text-body.b0003.0021",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你侧身穿过雨棚与墙之间的窄道，肩背几乎贴着湿木。过去之后若无其事。",
      "description": "雨棚窄道侧身。"
    },
    {
      "id": "lx.text-body.b0003.0022",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你抬脚跨过渠上的窄木板，双臂微张以保持平衡。留下的只有足迹。",
      "description": "跨渠木板的平衡。"
    },
    {
      "id": "lx.text-body.b0003.0023",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你弯腰钻过低垂的藤蔓，叶片刮过后背又弹回。窄道教会侧身。",
      "description": "钻过藤蔓的弯腰。"
    },
    {
      "id": "lx.text-body.b0003.0024",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在积水浅洼里踮着落点，寻找露出的石块。你记住了这个角度。",
      "description": "积水中选落脚点。"
    },
    {
      "id": "lx.text-body.b0003.0025",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你贴着棚柱让路，给提着水桶的人留出正中通道。下次会更熟。",
      "description": "棚柱旁让水桶路。"
    },
    {
      "id": "lx.text-body.b0003.0026",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你蹲下才能看清苔缝里的标记，膝盖浸入潮湿空气。不与梁柱争执。",
      "description": "蹲看苔缝标记。"
    },
    {
      "id": "lx.text-body.b0003.0027",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你把身子侧进水闸旁的凹角，才不被溅起的水花打湿。低头是一种礼貌。",
      "description": "凹角避溅水。"
    },
    {
      "id": "lx.text-body.b0003.0028",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在两排蕨架之间侧移，肘部收紧以免碰落水珠。让路也是前行。",
      "description": "蕨架间侧移。"
    },
    {
      "id": "lx.text-body.b0003.0029",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你低头穿过晒网下的湿绳区，手掌护着头顶。脚步放得很轻。",
      "description": "湿绳区低头护顶。"
    },
    {
      "id": "lx.text-body.b0003.0030",
      "category": "text-body",
      "subcategory": "适应空间",
      "text": "你在船坞木板上放慢步幅，脚掌贴着防滑纹前进。像借道而非占用。",
      "description": "船坞木板防滑步。"
    },
    {
      "id": "lx.text-body.b0003.0031",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你停在雨幕外，看水线在石阶上画出一条整齐的边。这一刻不需要意义。",
      "description": "雨幕外静观水线。"
    },
    {
      "id": "lx.text-body.b0003.0032",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你坐在棚下，目光跟着一片落叶沿水渠漂远。静着就够。",
      "description": "棚下追踪落叶。"
    },
    {
      "id": "lx.text-body.b0003.0033",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你指尖停在湿栏杆上，水珠从指缝慢慢渗下。衣角的风反衬静止。",
      "description": "湿栏杆上的指尖静止。"
    },
    {
      "id": "lx.text-body.b0003.0034",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你靠着长满苔的墙，后背凉意渗入，却没有挪开。你与环境短暂同频。",
      "description": "苔墙凉意中的倚靠。"
    },
    {
      "id": "lx.text-body.b0003.0035",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你握着空碗，听棚顶雨点由密转疏，整个人不动。没有下一句台词。",
      "description": "听雨疏密的静止。"
    },
    {
      "id": "lx.text-body.b0003.0036",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你盯着水面倒影里晃动的自己，涟漪散开后仍站着。像把思想搁在表面。",
      "description": "水面倒影前的停驻。"
    },
    {
      "id": "lx.text-body.b0003.0037",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你把下巴搁在交叠的手上，看蕨叶一开一合。静止保存了温度。",
      "description": "观蕨叶开合的托腮。"
    },
    {
      "id": "lx.text-body.b0003.0038",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你立在桥洞口，呼吸与洞内回声对齐，肩线不动。目光有落点。",
      "description": "桥洞口呼吸静止。"
    },
    {
      "id": "lx.text-body.b0003.0039",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你捏着一截湿绳端，绳头滴水，你没有立刻扔掉。手也有落点。",
      "description": "捏湿绳端的停顿。"
    },
    {
      "id": "lx.text-body.b0003.0040",
      "category": "text-body",
      "subcategory": "静止细节",
      "text": "你侧耳听远处水车吱呀，脚尖抵着石缝，人不动。整个人暂时完整。",
      "description": "听水车时的脚尖抵缝。"
    },
    {
      "id": "lx.text-body.b0003.0041",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你踏上湿滑石阶，重心压低，前脚探实才跟后脚。脚下更有数。",
      "description": "湿阶低重心探步。"
    },
    {
      "id": "lx.text-body.b0003.0042",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你提着半满水桶过木板，身体微向对侧倾以找平衡。身体记住这次分配。",
      "description": "提桶过板的对侧倾。"
    },
    {
      "id": "lx.text-body.b0003.0043",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你从蹲姿捞起漂叶，起身时手先撑苔石，再移交重心。不靠蛮力。",
      "description": "捞叶起身的手撑重心。"
    },
    {
      "id": "lx.text-body.b0003.0044",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在晃动的浮板上张开双脚，把重量均分到脚心。靠顺序。",
      "description": "浮板双脚均分重心。"
    },
    {
      "id": "lx.text-body.b0003.0045",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你被溅水惊得后撤半步，随即把重心拉回前脚掌。重心故事写完这一句。",
      "description": "惊撤后重心回前掌。"
    },
    {
      "id": "lx.text-body.b0003.0046",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你侧身让过推车，内侧腿承重，外侧腿轻点水面石。你感到踏实回来。",
      "description": "让车时内侧承重。"
    },
    {
      "id": "lx.text-body.b0003.0047",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你弯腰解缆绳，起身途中在湿甲板短暂停稳。虚浮感退散。",
      "description": "解缆起身的停稳。"
    },
    {
      "id": "lx.text-body.b0003.0048",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你把沉甸甸的湿网扛上肩，身体前倾以承接重量。步伐可以加速一点。",
      "description": "扛湿网的前倾重心。"
    },
    {
      "id": "lx.text-body.b0003.0049",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你从高渠岸迈下，先落脚尖，再缓缓送上全身。仍保持警觉。",
      "description": "下渠岸的脚尖先落。"
    },
    {
      "id": "lx.text-body.b0003.0050",
      "category": "text-body",
      "subcategory": "重心变化",
      "text": "你在泥滩里拔脚时，先把重心移到另一腿，再抽泥脚。直到完全习惯。",
      "description": "泥滩拔脚的换腿重心。"
    }
  ]
}
