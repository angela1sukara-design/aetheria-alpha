{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "world-scent",
  "batchId": "world-scent.b0001",
  "source": {
    "producer": "ai-world",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.world-scent.b0001.0001",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "粥锅揭盖的一瞬，米香贴着鼻尖，随即散成淡淡暖气。",
      "description": "日常炊事的近距浓、远距淡。"
    },
    {
      "id": "lx.world-scent.b0001.0002",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "油条摊热气里夹着一点碱香，风一吹只剩芝麻碎的气味。",
      "description": "街边热食随风分层。"
    },
    {
      "id": "lx.world-scent.b0001.0003",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "蒸笼边的湿面粉甜香贴在袖口，走开几步仍能闻见。",
      "description": "附着衣物的短暂残留。"
    },
    {
      "id": "lx.world-scent.b0001.0004",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "酱油焖菜的咸香从楼下窗台升上来，停在二层檐下。",
      "description": "垂直空间的气味爬升。"
    },
    {
      "id": "lx.world-scent.b0001.0005",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "烤红薯炭香先到，糖焦味后至，两者在巷口交汇。",
      "description": "不同挥发层次的先后。"
    },
    {
      "id": "lx.world-scent.b0001.0006",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "泡菜坛启封的酸辣冲一下，很快被凉风冲淡。",
      "description": "瞬时浓烈后的迅速衰减。"
    },
    {
      "id": "lx.world-scent.b0001.0007",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "豆浆桶边豆腥与暖甜并立，越靠近阀门越明显。",
      "description": "容器近端的气味梯度。"
    },
    {
      "id": "lx.world-scent.b0001.0008",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "煎蛋边缘的焦香只在锅上方一掌高，侧身就弱。",
      "description": "高度极窄的气味层。"
    },
    {
      "id": "lx.world-scent.b0001.0009",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "水果摊切开的瓜香甜而短促，果皮堆那侧带青涩。",
      "description": "切开面与皮堆的对比。"
    },
    {
      "id": "lx.world-scent.b0001.0010",
      "category": "world-scent",
      "subcategory": "食物气味",
      "text": "夜市关摊后，残留的油脂气味贴地游走，膝高最浓。",
      "description": "收摊后低层滞留。"
    },
    {
      "id": "lx.world-scent.b0001.0011",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "晒干的艾草捆散出苦清香，整条廊下都能嗅到薄层。",
      "description": "干燥草药的广布薄香。"
    },
    {
      "id": "lx.world-scent.b0001.0012",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "掐断的葱叶辣香只在指间，搓一下才散开。",
      "description": "破损植物的近手气味。"
    },
    {
      "id": "lx.world-scent.b0001.0013",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "雨后泥土里混着青草汁味，鼻腔先凉后润。",
      "description": "湿土与植物汁的混合层次。"
    },
    {
      "id": "lx.world-scent.b0001.0014",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "桂花落了一地，香气却贴着地面薄薄一层。",
      "description": "落花形成的低空香毯。"
    },
    {
      "id": "lx.world-scent.b0001.0015",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "番茄茎叶的青涩味在温室门口最冲，深处反淡。",
      "description": "入口聚集、内部稀释。"
    },
    {
      "id": "lx.world-scent.b0001.0016",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "薄荷盆被碰倒，凉香炸开又很快收回叶间。",
      "description": "扰动后的爆发与回落。"
    },
    {
      "id": "lx.world-scent.b0001.0017",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "晒被子旁的薰衣草包香气稳而浅，不抢鼻。",
      "description": "家居织物附带的定香。"
    },
    {
      "id": "lx.world-scent.b0001.0018",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "砍开的西瓜皮青气混着果肉甜，两种气味分层清楚。",
      "description": "同一果实不同部位的气味。"
    },
    {
      "id": "lx.world-scent.b0001.0019",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "竹叶清香随风一阵一阵，停风时几乎消失。",
      "description": "风送型植物气味的间歇。"
    },
    {
      "id": "lx.world-scent.b0001.0020",
      "category": "world-scent",
      "subcategory": "植物气味",
      "text": "堆肥角落的腐叶气味闷而甜，翻开才变冲。",
      "description": "静置与翻动的浓淡差。"
    },
    {
      "id": "lx.world-scent.b0001.0021",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "新刨的松木脂香贴在刨花堆上，几步外只剩淡木气。",
      "description": "新鲜木材的距离衰减。"
    },
    {
      "id": "lx.world-scent.b0001.0022",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "晒热的沥青味在正午路面升起，傍晚退回地面。",
      "description": "日照驱动的材料挥发。"
    },
    {
      "id": "lx.world-scent.b0001.0023",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "湿抹布拧干后的皂味短促，布本身的棉腥更久。",
      "description": "清洁剂与织物基味的时差。"
    },
    {
      "id": "lx.world-scent.b0001.0024",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "旧书页的微霉纸香在翻动时一缕一缕逸出。",
      "description": "动作触发的材料气味。"
    },
    {
      "id": "lx.world-scent.b0001.0025",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "铁桶生锈处有薄薄的金属腥，靠近才辨认得出。",
      "description": "腐蚀表面的弱气味。"
    },
    {
      "id": "lx.world-scent.b0001.0026",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "蜡烛熄灭后的蜡烟甜而短，随即被室温空气吞掉。",
      "description": "熄火瞬间的材料余味。"
    },
    {
      "id": "lx.world-scent.b0001.0027",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "橡皮筋盒打开，淡胶水味散出半掌宽就淡了。",
      "description": "封闭容器开启的浅层气味。"
    },
    {
      "id": "lx.world-scent.b0001.0028",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "砖窑余温里还留着土坯的焦土香，夜里更清晰。",
      "description": "热滞后释放的材料气味。"
    },
    {
      "id": "lx.world-scent.b0001.0029",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "油漆未干的门散发溶剂尖味，通风后转成淡漆香。",
      "description": "干燥过程中的气味转型。"
    },
    {
      "id": "lx.world-scent.b0001.0030",
      "category": "world-scent",
      "subcategory": "材料气味",
      "text": "麻袋堆的干草与尘土味混在一起，拍打时扬起更浓。",
      "description": "纤维仓储的扰动增浓。"
    },
    {
      "id": "lx.world-scent.b0001.0031",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "地下室台阶越往下，潮气里的土腥越清楚。",
      "description": "纵深增强的潮湿气味。"
    },
    {
      "id": "lx.world-scent.b0001.0032",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "雨衣内衬的闷湿味在脱下时涌出，室外一吹就散。",
      "description": "密闭穿着后的释放。"
    },
    {
      "id": "lx.world-scent.b0001.0033",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "浴缸排水口附近有一圈皂垢的潮腥，擦后变淡。",
      "description": "局部积湿的定点气味。"
    },
    {
      "id": "lx.world-scent.b0001.0034",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "晨雾带着河面的湿冷气，衣领先感受到凉腥。",
      "description": "水面雾气的附着感。"
    },
    {
      "id": "lx.world-scent.b0001.0035",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "未晒干的毛巾酸潮味贴在脸侧，晒后只剩棉香。",
      "description": "含水状态决定的气味翻转。"
    },
    {
      "id": "lx.world-scent.b0001.0036",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "石墙返潮处气味发闷，干砖段则几乎无味。",
      "description": "同一墙面干湿区的对比。"
    },
    {
      "id": "lx.world-scent.b0001.0037",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "井口升起的湿气混着青苔味，夏季更重。",
      "description": "水源开口的季节性浓淡。"
    },
    {
      "id": "lx.world-scent.b0001.0038",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "闭热的鞋柜里潮皮味沉在底层，上层是布鞋干香。",
      "description": "垂直分层的潮干气味。"
    },
    {
      "id": "lx.world-scent.b0001.0039",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "雨停后树皮蒸出的湿木气短暂而清。",
      "description": "降水结束后的植物蒸腾味。"
    },
    {
      "id": "lx.world-scent.b0001.0040",
      "category": "world-scent",
      "subcategory": "潮湿气味",
      "text": "拖把桶澄清后仍留一丝灰水腥，加醋后转淡。",
      "description": "清洁水残留与中和。"
    },
    {
      "id": "lx.world-scent.b0001.0041",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "厨房门一开，油烟、葱香与洗洁精味叠成一团再散开。",
      "description": "多源瞬时叠加后的分离。"
    },
    {
      "id": "lx.world-scent.b0001.0042",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "市场入口先是鱼腥，再是水果甜，最后是干货霉香。",
      "description": "步行路径上的气味序列。"
    },
    {
      "id": "lx.world-scent.b0001.0043",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "洗衣晾晒的皂香混着隔壁炖汤味，楼道里分不清谁家。",
      "description": "邻里气味在公共通道交汇。"
    },
    {
      "id": "lx.world-scent.b0001.0044",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "花店冷柜泄漏的冰气带着花香与纸箱尘味。",
      "description": "冷藏、植物与包装的三层。"
    },
    {
      "id": "lx.world-scent.b0001.0045",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "车站广场柴油味被路边咖啡香短暂盖过又回来。",
      "description": "强弱气味的交替主导。"
    },
    {
      "id": "lx.world-scent.b0001.0046",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "雨后柏油、湿土与炒栗子香在同一个街角相遇。",
      "description": "天气与食摊的偶合。"
    },
    {
      "id": "lx.world-scent.b0001.0047",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "图书馆里纸墨香底下有一层极淡的地板蜡味。",
      "description": "主气味下的基底材料味。"
    },
    {
      "id": "lx.world-scent.b0001.0048",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "诊所走廊消毒水味与窗外桂花香隔窗对峙。",
      "description": "人工清洁与室外自然的分界。"
    },
    {
      "id": "lx.world-scent.b0001.0049",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "夜风把烧烤烟、河腥与桂花残香绞在一起又扯开。",
      "description": "夜间多源的绞缠与稀释。"
    },
    {
      "id": "lx.world-scent.b0001.0050",
      "category": "world-scent",
      "subcategory": "混合气味",
      "text": "新搬空房里油漆未尽、纸箱尘与开窗后的草香并存。",
      "description": "过渡空间的多重来源。"
    }
  ]
}
