{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-environment",
  "batchId": "text-environment.b0003",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "潮湿水岸与植物共居：雨棚、水渠、苔蕨、生活节奏，包含明快和安静面"
  },
  "entries": [
    {
      "id": "lx.text-environment.b0003.0001",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "雨棚一间接一间连成廊，棚下地面比棚外高一寸。雨大时棚外成河，棚下仍可通行。",
      "description": "连廊雨棚高低分水。"
    },
    {
      "id": "lx.text-environment.b0003.0002",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "水渠贴着宅墙走，渠宽只够一人蹲下洗衣。渠沿石被磨得发亮，长着薄苔。",
      "description": "宅墙水渠洗衣宽度。"
    },
    {
      "id": "lx.text-environment.b0003.0003",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "蕨架排成两列，中间过道湿气扑面。架脚踩在砖上，砖缝渗着细水。",
      "description": "蕨架过道湿气。"
    },
    {
      "id": "lx.text-environment.b0003.0004",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "船坞木板伸进水面，板与岸之间用绳索固定。潮涨时板面几乎与水面齐平。",
      "description": "船坞木板潮位关系。"
    },
    {
      "id": "lx.text-environment.b0003.0005",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "桥洞内侧长满深色苔藓，洞外却是浅灰石。明暗交界就在洞口那一道弧。",
      "description": "桥洞内外苔色交界。"
    },
    {
      "id": "lx.text-environment.b0003.0006",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "水闸旁凹进一块干地，刚好能避溅。凹角堆着几卷缆绳和一只空桶。",
      "description": "水闸凹角避溅空间。"
    },
    {
      "id": "lx.text-environment.b0003.0007",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "苔痕石阶通向高一点的晒台，阶侧挂着滴水的衣物。人上下时要侧身躲衣摆。",
      "description": "苔阶晒台与滴衣。"
    },
    {
      "id": "lx.text-environment.b0003.0008",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "浮板用短桩固定在渠边，板面微晃。上岸的人常在板上停半息找平衡。",
      "description": "浮板短桩与停息。"
    },
    {
      "id": "lx.text-environment.b0003.0009",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "雨幕与屋檐之间形成一条整齐的水帘线。线内干燥，线外湿透，界线清晰。",
      "description": "屋檐水帘线分干湿。"
    },
    {
      "id": "lx.text-environment.b0003.0010",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "藤蔓从墙头垂到过道中央，人要通过时必须弯腰。藤叶背面还挂着昨夜的水珠。",
      "description": "垂藤迫使弯腰通过。"
    },
    {
      "id": "lx.text-environment.b0003.0011",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "雨天棚下的光发绿，像隔着一层薄叶。棚外则是灰白，对比强烈。",
      "description": "棚下绿光与棚外灰白。"
    },
    {
      "id": "lx.text-environment.b0003.0012",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "水面把天光折上来，桥底被照得比预期亮。鱼影偶尔从亮带中掠过。",
      "description": "水面折光亮桥底。"
    },
    {
      "id": "lx.text-environment.b0003.0013",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "晨雾未散时，渠岸只剩轮廓。雾破开一处，那处的苔藓突然变得鲜绿。",
      "description": "晨雾破处苔藓鲜绿。"
    },
    {
      "id": "lx.text-environment.b0003.0014",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "夕阳从雨停的云隙落下，湿石反光刺眼。人们走路时下意识眯眼。",
      "description": "雨停夕阳湿石反光。"
    },
    {
      "id": "lx.text-environment.b0003.0015",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "灯笼挂在棚柱上，光被雨丝切成细线。细线落在水洼里又碎成星点。",
      "description": "雨丝切灯笼光。"
    },
    {
      "id": "lx.text-environment.b0003.0016",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "蕨叶遮住半扇窗，室内光斑呈锯齿状。风过时锯齿在墙上爬动。",
      "description": "蕨叶窗光斑锯齿。"
    },
    {
      "id": "lx.text-environment.b0003.0017",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "阴天水渠几乎没有影子，石与水的界线全靠颜色区分。蹲下才看见浅浅的波。",
      "description": "阴天渠岸无影靠色。"
    },
    {
      "id": "lx.text-environment.b0003.0018",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "月光落在浮板上，板缝的水线发银。岸上人影被拉得很长，扫过银线。",
      "description": "月光浮板水线发银。"
    },
    {
      "id": "lx.text-environment.b0003.0019",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "晴天棚影边界清晰，一步之差从凉到晒。人们喜欢贴着影边走。",
      "description": "棚影边界一步凉晒。"
    },
    {
      "id": "lx.text-environment.b0003.0020",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "船舱小窗透进一条亮带，照亮舱底积水。积水里晃着窗框的倒影。",
      "description": "船舱窗光照积水倒影。"
    },
    {
      "id": "lx.text-environment.b0003.0021",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "渠沿洗衣石被磨出浅窝，窝底光滑。旁边皂角泡沫留下的白渍反复出现又被冲走。",
      "description": "洗衣石浅窝与皂渍。"
    },
    {
      "id": "lx.text-environment.b0003.0022",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "缆绳在桩上勒出深槽，槽边木纤维竖起。新旧绳痕叠在一起。",
      "description": "缆绳勒桩深槽。"
    },
    {
      "id": "lx.text-environment.b0003.0023",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "雨棚支柱下部发黑，是长期溅湿的痕迹。上部仍是原来的浅木色。",
      "description": "棚柱下部溅湿发黑。"
    },
    {
      "id": "lx.text-environment.b0003.0024",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "石阶被湿脚踩出深浅不一的脚印印，干后留下淡影。淡影指向岸上房屋。",
      "description": "湿脚印干后淡影。"
    },
    {
      "id": "lx.text-environment.b0003.0025",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "栏杆扶手被摸出一条发亮的带，带下仍是粗糙石面。亮带高度适合多数人肘搁。",
      "description": "栏杆摸亮带。"
    },
    {
      "id": "lx.text-environment.b0003.0026",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "水桶底在石板上磕出圆印，圆印里积着细沙。沙在雨后被冲进渠里。",
      "description": "水桶底圆印积沙。"
    },
    {
      "id": "lx.text-environment.b0003.0027",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "船舷外侧有一道道缆绳摩擦的白痕，白痕随水位高低错落。没有人讲解，身体自己会懂。",
      "description": "船舷缆绳白痕错落。"
    },
    {
      "id": "lx.text-environment.b0003.0028",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "苔缝里的旧标记被水冲淡，只剩半个箭头。箭头旁有人用炭笔重新描过。",
      "description": "苔缝标记冲淡重描。"
    },
    {
      "id": "lx.text-environment.b0003.0029",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "晒网绳在墙钉上磨细，钉头被磨亮。绳下的墙面有一条被水滴出的竖痕。",
      "description": "晒网绳磨钉与滴痕。"
    },
    {
      "id": "lx.text-environment.b0003.0030",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "浮板防滑纹被踩得边缘圆钝，纹槽里嵌着绿藻。藻在干季会褪成灰。",
      "description": "浮板纹槽嵌绿藻。"
    },
    {
      "id": "lx.text-environment.b0003.0031",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "清晨有人沿渠洗衣，盆声与水声交错。彼此隔着几步，偶尔借皂，不多话。",
      "description": "沿渠洗衣隔步借皂。"
    },
    {
      "id": "lx.text-environment.b0003.0032",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "雨棚下躲雨的人肩挨肩，却各自看着自己的鞋尖。雨停后散得很快。",
      "description": "躲雨肩挨各自看鞋。"
    },
    {
      "id": "lx.text-environment.b0003.0033",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "孩子们在浅滩追漂叶，大人站在干处喊名字。喊声被水声削去一半。",
      "description": "浅滩追叶与岸上喊。"
    },
    {
      "id": "lx.text-environment.b0003.0034",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "有人蹲在闸旁补网，身边围着两三个看热闹的。补网的人不抬头，只偶尔应声。",
      "description": "补网旁观不抬头。"
    },
    {
      "id": "lx.text-environment.b0003.0035",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "傍晚提桶取水的人排成短列，前后保持湿靴不会踩到的距离。有人哼着不成调的歌。",
      "description": "取水短列湿靴距。"
    },
    {
      "id": "lx.text-environment.b0003.0036",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "桥上相遇的人侧身错开，伞骨轻轻一碰又分开。谁也没有停下。",
      "description": "桥上伞骨轻碰错身。"
    },
    {
      "id": "lx.text-environment.b0003.0037",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "船坞边有人坐着织绳，有人来回搬货。织绳的人偶尔抬眼，算一下潮位。",
      "description": "织绳与搬货共处。"
    },
    {
      "id": "lx.text-environment.b0003.0038",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "雾天人影先于声音出现，招呼声总比人晚半拍。有人因此多点一次头。",
      "description": "雾中人影先于招呼。"
    },
    {
      "id": "lx.text-environment.b0003.0039",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "晒台上下的人侧身躲着滴衣，嘴里道着歉。滴衣主人在一旁不好意思地笑。",
      "description": "躲滴衣道歉与笑。"
    },
    {
      "id": "lx.text-environment.b0003.0040",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "夜里水车吱呀声里，偶尔有提灯的人走过渠岸。灯火在水面拉出短短的金线。",
      "description": "夜提灯渠岸金线。"
    },
    {
      "id": "lx.text-environment.b0003.0041",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从棚檐下望向街心，雨丝把远近分成浓淡两层。近处鞋印还清楚，远处只剩水光。",
      "description": "棚檐望雨丝分浓淡远近。"
    },
    {
      "id": "lx.text-environment.b0003.0042",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你蹲在渠沿抬头，雨棚的梁木变成倾斜的格。格缝里漏下细碎光点。",
      "description": "渠沿仰视棚梁格缝。"
    },
    {
      "id": "lx.text-environment.b0003.0043",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从桥洞外往里看，洞内像一口横置的井。对岸的光缩成圆点。",
      "description": "桥洞外观内圆光。"
    },
    {
      "id": "lx.text-environment.b0003.0044",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你趴在浮板上侧视水面，自己的脸被波纹切碎。岸上人影摇成细条。",
      "description": "浮板侧视碎脸与岸影。"
    },
    {
      "id": "lx.text-environment.b0003.0045",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你站在高晒台俯看渠网，渠像银线织进宅间。洗衣的人只剩色点。",
      "description": "晒台俯看渠网银色。"
    },
    {
      "id": "lx.text-environment.b0003.0046",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你隔着垂藤缝隙望向闸口，闸板启闭时水面明暗交替。缝隙随风左右晃。",
      "description": "藤缝望闸明暗交替。"
    },
    {
      "id": "lx.text-environment.b0003.0047",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你坐在低矮船舷，视线与水面几乎齐平。远处屋檐像贴在水上的纸剪。",
      "description": "船舷平视水面屋檐。"
    },
    {
      "id": "lx.text-environment.b0003.0048",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从积水倒影里抬头，真实的天空比倒影里的更白。雨云边缘发亮。",
      "description": "倒影抬头比天空。"
    },
    {
      "id": "lx.text-environment.b0003.0049",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你侧身贴苔墙望向过道，过道被蕨叶切成碎段。有人走过时碎段被身影填满。",
      "description": "贴苔墙望蕨切过道。"
    },
    {
      "id": "lx.text-environment.b0003.0050",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你仰躺在棚下长椅，看雨点在棚布上撞出浅窝。浅窝消失得比形成更快。",
      "description": "仰躺看棚布雨窝。"
    }
  ]
}
