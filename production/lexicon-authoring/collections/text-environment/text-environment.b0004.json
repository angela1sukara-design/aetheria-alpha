{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-environment",
  "batchId": "text-environment.b0004",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "晴燥高地与远行者：石阶、遮阳、布帘、迁居见闻，避免地域与性格刻板绑定"
  },
  "entries": [
    {
      "id": "lx.text-environment.b0004.0001",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "石阶层层收窄通向坡顶，两侧护墙高度逐渐降低。越往上，风越大，视野越开。",
      "description": "石阶收窄与风视野。"
    },
    {
      "id": "lx.text-environment.b0004.0002",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "遮阳布一块接一块搭成凉廊，布下比廊外低半级气温。布影在地面画出整齐格。",
      "description": "遮阳凉廊温差与布影。"
    },
    {
      "id": "lx.text-environment.b0004.0003",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "门帘垂在矮屋门口，帘下沿离地一掌。进出的人先用手拨帘，再侧身迈过门槛石。",
      "description": "门帘与门槛石进出。"
    },
    {
      "id": "lx.text-environment.b0004.0004",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "高台边缘没有护栏，只有一排浅刻的防滑纹。有人坐在纹上歇脚，腿悬在台外。",
      "description": "高台无栏防滑纹歇脚。"
    },
    {
      "id": "lx.text-environment.b0004.0005",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "棚屋连片，檐角几乎相触。过道窄到两人相遇必须有一人侧身贴墙。",
      "description": "连片檐角窄过道。"
    },
    {
      "id": "lx.text-environment.b0004.0006",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "干涸渠沟横过路口，沟深不及膝。人们习惯跨过，偶尔有人沿沟边走抄近。",
      "description": "干渠横路可跨可沿。"
    },
    {
      "id": "lx.text-environment.b0004.0007",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "石廊两侧壁上嵌着旧挂钩，钩上挂着空水袋。廊顶开着窄缝，缝里漏下一条亮带。",
      "description": "石廊挂钩与顶缝光。"
    },
    {
      "id": "lx.text-environment.b0004.0008",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "遮阳篷与货架之间只剩侧身缝，水罐就放在缝尽头。伸手取罐时肩背贴着篷骨。",
      "description": "篷架侧缝取水罐。"
    },
    {
      "id": "lx.text-environment.b0004.0009",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "崖壁内侧小径贴着岩面走，外侧是缓坡。贴壁的人把右手扶岩，左侧给对向留空。",
      "description": "崖径贴壁让对向。"
    },
    {
      "id": "lx.text-environment.b0004.0010",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "驿站院落中央是一口浅井，井台比地面高两级。井周围的沙被踩成硬壳。",
      "description": "驿站浅井与硬沙壳。"
    },
    {
      "id": "lx.text-environment.b0004.0011",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "正午阳光直射石阶，阶面反光刺眼。人们把帽檐压到眉骨，一步一级。",
      "description": "正午石阶反光压帽。"
    },
    {
      "id": "lx.text-environment.b0004.0012",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "遮阳布把光滤成暖黄，布下人的脸色也跟着偏暖。布外一步就是惨白。",
      "description": "遮阳布暖黄滤光。"
    },
    {
      "id": "lx.text-environment.b0004.0013",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "黄昏时坡顶先暗，坡下还亮着。上下的人影长短不一，交错而过。",
      "description": "黄昏坡顶先暗。"
    },
    {
      "id": "lx.text-environment.b0004.0014",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "晨光从东方石缝挤进来，先照亮门帘缝。帘内仍暗，帘外已可辨色。",
      "description": "晨光先亮门帘缝。"
    },
    {
      "id": "lx.text-environment.b0004.0015",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "热浪把远处地平线揉虚，近处石面却清晰得能数清纹路。明暗反差很大。",
      "description": "热浪远虚近清。"
    },
    {
      "id": "lx.text-environment.b0004.0016",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "月光把高台照成银白，台下坡道仍在阴影里。银白与阴影的界线整齐如刀。",
      "description": "月照高台银白界线。"
    },
    {
      "id": "lx.text-environment.b0004.0017",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "沙尘扬起时，阳光变成浑浊的柱。柱里人影边缘发毛，看不清面目。",
      "description": "沙尘光柱人影发毛。"
    },
    {
      "id": "lx.text-environment.b0004.0018",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "屋内只靠门帘缝进光，桌面中央有一块不稳定的亮斑。风掀帘时亮斑乱跳。",
      "description": "门帘缝光斑乱跳。"
    },
    {
      "id": "lx.text-environment.b0004.0019",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "晚霞把西向石壁染红，东向仍是灰蓝。转过身就像换了一个时辰。",
      "description": "东西石壁霞色对比。"
    },
    {
      "id": "lx.text-environment.b0004.0020",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "星光下石阶轮廓依稀可辨，靠脚底触感比靠眼睛更多。远处灯火是唯一的色点。",
      "description": "星下石阶靠触感。"
    },
    {
      "id": "lx.text-environment.b0004.0021",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "石阶中央被靴底磨出浅槽，槽两侧棱角仍利。雨季浅槽会积一层薄泥后干裂。",
      "description": "石阶靴磨浅槽。"
    },
    {
      "id": "lx.text-environment.b0004.0022",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "门帘下沿被手拨得发亮，帘布其余部分仍是暗色。亮带高度齐多数人腰。",
      "description": "门帘拨亮下沿。"
    },
    {
      "id": "lx.text-environment.b0004.0023",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "遮阳柱上有被绳勒过的旧痕，痕上又缠着新绳。柱根堆着被风吹落的布屑。",
      "description": "遮阳柱绳勒新旧。"
    },
    {
      "id": "lx.text-environment.b0004.0024",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "水罐提梁磨出深槽，槽内木头发亮。罐身外侧有磕碰留下的白点。",
      "description": "水罐提梁磨槽。"
    },
    {
      "id": "lx.text-environment.b0004.0025",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "高台防滑纹边缘已被坐平，纹槽里嵌着干草屑。草屑在风里微微颤。",
      "description": "防滑纹坐平嵌草屑。"
    },
    {
      "id": "lx.text-environment.b0004.0026",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "石廊壁上的挂钩铁环磨细，钩尖向下弯得更厉害。空钩比挂袋的钩颜色深。",
      "description": "石廊挂钩磨细下弯。"
    },
    {
      "id": "lx.text-environment.b0004.0027",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "门槛石被鞋底蹭出斜纹，纹指向屋内。斜纹尽头有一小块被反复踩亮的区域。",
      "description": "门槛石斜纹踩亮。"
    },
    {
      "id": "lx.text-environment.b0004.0028",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "行囊常靠的墙角油漆剥落，露出浅色泥坯。剥落范围约合一只行囊的轮廓。",
      "description": "行囊靠墙漆剥轮廓。"
    },
    {
      "id": "lx.text-environment.b0004.0029",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "拴驮的石柱根部被绳磨出一圈深沟，沟上结着干燥的毛絮。观察停在这一层就够。",
      "description": "拴驮石柱绳沟毛絮。"
    },
    {
      "id": "lx.text-environment.b0004.0030",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "井台边缘有一圈被桶沿磕出的浅坑，坑间距大致相等。坑里积着细沙。",
      "description": "井台桶磕浅坑积沙。"
    },
    {
      "id": "lx.text-environment.b0004.0031",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "上下石阶的人保持单列，偶尔侧身错开。喘气声比说话声多。",
      "description": "石阶单列喘气多于话。"
    },
    {
      "id": "lx.text-environment.b0004.0032",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "遮阳廊下歇脚的人彼此隔着空位，有人闭目，有人慢慢喝水。很少主动搭话。",
      "description": "廊下歇脚隔位少话。"
    },
    {
      "id": "lx.text-environment.b0004.0033",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "驮队经过时，行人自动贴向崖壁一侧。驼铃远去后，过道才重新热闹。",
      "description": "驮队过行人贴壁。"
    },
    {
      "id": "lx.text-environment.b0004.0034",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "门帘外有人站着打听路，帘内探出半个脑袋答两句。答完帘又垂下。",
      "description": "门帘外问路帘内答。"
    },
    {
      "id": "lx.text-environment.b0004.0035",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "孩子们在干渠边跳远，大人在一旁数步。尘土扬起又慢慢落回。",
      "description": "干渠边跳远扬尘。"
    },
    {
      "id": "lx.text-environment.b0004.0036",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "傍晚归宿的人肩上多半有行囊或水袋。步伐比上坡时稳，神情也松一些。",
      "description": "傍晚归宿松态。"
    },
    {
      "id": "lx.text-environment.b0004.0037",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "驿站井边排队打水，前后距离能放下一个空罐。有人把罐垫在鞋边防倒。",
      "description": "井边排队罐距。"
    },
    {
      "id": "lx.text-environment.b0004.0038",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "风口处相遇的人对视一瞬，用眼神确认谁先过。风声盖过了可能的招呼。",
      "description": "风口眼神让路。"
    },
    {
      "id": "lx.text-environment.b0004.0039",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "夜里提灯下阶的人走得很慢，灯火在阶面上跳。后方的人跟着光斑落脚。",
      "description": "夜提灯下阶跟光斑。"
    },
    {
      "id": "lx.text-environment.b0004.0040",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "迁居的人把家具拆成可扛的块，邻人帮忙抬一段就歇。没人催促。",
      "description": "迁居拆抬邻帮不催。"
    },
    {
      "id": "lx.text-environment.b0004.0041",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从坡顶回望，来路石阶缩成一条灰线。路边棚屋小得像棋子。",
      "description": "坡顶回望阶缩棚小。"
    },
    {
      "id": "lx.text-environment.b0004.0042",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你蹲在石阶中段抬头，坡顶的遮阳布变成一条深色带子。带子下人影如蚁。",
      "description": "阶中仰视顶布人影。"
    },
    {
      "id": "lx.text-environment.b0004.0043",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你隔着门帘缝看院内，缝宽只够竖条视野。有人走过时竖条被身影填满又空出。",
      "description": "门帘缝竖条视野。"
    },
    {
      "id": "lx.text-environment.b0004.0044",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你趴在高台边缘俯看缓坡，坡上行人只剩帽与肩。热浪让他们边缘发虚。",
      "description": "高台俯看坡人发虚。"
    },
    {
      "id": "lx.text-environment.b0004.0045",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从石廊窄缝望向崖外，缝外是大片亮白。眼睛要适应片刻才能辨远山。",
      "description": "石廊窄缝望崖外亮白。"
    },
    {
      "id": "lx.text-environment.b0004.0046",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你坐在低矮行囊上平视，过往驮队的腿像移动的树林。铃铛在视线上方响。",
      "description": "坐囊平视驮队腿。"
    },
    {
      "id": "lx.text-environment.b0004.0047",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你侧身贴壁望向过道尽头，尽头的光成了梯形。梯形里晃着进出的人影。",
      "description": "贴壁望尽头梯形光。"
    },
    {
      "id": "lx.text-environment.b0004.0048",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你仰躺在遮阳布下，看布缝漏下的光点随风移动。光点落在鼻尖时微微发烫。",
      "description": "仰躺看布缝光点。"
    },
    {
      "id": "lx.text-environment.b0004.0049",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从井台边低头，井壁一圈圈缩向深处。水面小得像一枚硬币。",
      "description": "井台低头水面如币。"
    },
    {
      "id": "lx.text-environment.b0004.0050",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你站在棚屋过道尽头回头，连片檐角叠成锯齿线。锯齿下人影来回切过。",
      "description": "过道尽头回头檐锯齿。"
    }
  ]
}
