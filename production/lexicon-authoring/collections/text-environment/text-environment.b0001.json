{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-environment",
  "batchId": "text-environment.b0001",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "普通居民与公共生活：朴素材料、平常心情、不同礼貌距离，减少稀奇设定"
  },
  "entries": [
    {
      "id": "lx.text-environment.b0001.0001",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "巷口的公共坐台被磨得发亮，旁边矮墙上还留着几道粉笔划痕。坐台与墙之间刚好能并肩坐两人。",
      "description": "公共坐台与矮墙的日常空间关系。"
    },
    {
      "id": "lx.text-environment.b0001.0002",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "市集过道不宽，货筐贴着脚边排成两列。抬头能看见对面屋檐几乎要碰在一起。",
      "description": "市集窄过道的上下空间感。"
    },
    {
      "id": "lx.text-environment.b0001.0003",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "水台四周铺着旧石板，缝里嵌着细沙。石板向外微微倾斜，方便水流回水渠。",
      "description": "公共水台地面的功能空间。"
    },
    {
      "id": "lx.text-environment.b0001.0004",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "告示墙前留出一块空地，脚印把泥土踩成浅浅的凹坑。空地边缘摆着两只空桶挡道。",
      "description": "告示前空地与阻挡物。"
    },
    {
      "id": "lx.text-environment.b0001.0005",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "长廊两侧是带门的小铺，廊柱把光线切成一段段。人从柱间走过时，影子会被切成几截。",
      "description": "长廊柱列切割空间。"
    },
    {
      "id": "lx.text-environment.b0001.0006",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "院门洞开，门内石径直通井台。井台比地面略高，周围散落着几只水瓢。",
      "description": "院门到井台的纵深。"
    },
    {
      "id": "lx.text-environment.b0001.0007",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "楼梯拐角堆着闲置的竹筐，正好把转弯处的视线挡住一半。上下的人会在此停半步。",
      "description": "楼梯拐角被竹筐半遮。"
    },
    {
      "id": "lx.text-environment.b0001.0008",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "矮凳围着一张圆桌，桌腿之间还塞着一只猫睡的旧筐。座位间距近得只能侧身入座。",
      "description": "圆桌矮凳的紧凑围合。"
    },
    {
      "id": "lx.text-environment.b0001.0009",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "桥面两侧的护栏高度刚好到多数人的腰际。靠栏的人会把肘部搁上去，看桥下流水。",
      "description": "桥面护栏高度与倚靠。"
    },
    {
      "id": "lx.text-environment.b0001.0010",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "屋檐下的阴影带很整齐，像一条深色地毯铺到街心。出了阴影，地面颜色立刻变浅。",
      "description": "屋檐阴影带的边界清晰。"
    },
    {
      "id": "lx.text-environment.b0001.0011",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "午后的光从门缝斜进来，在地面画出一条细亮线。尘埃在亮线里缓慢翻滚。",
      "description": "门缝斜光与尘埃。"
    },
    {
      "id": "lx.text-environment.b0001.0012",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "窗纸把日光滤成柔白，桌面上的碗沿几乎看不清阴影。只有移动时才察觉光在跟。",
      "description": "窗纸柔光下的桌面。"
    },
    {
      "id": "lx.text-environment.b0001.0013",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "灯笼还没点，天色却已暗到看不清对面的脸。檐下人影只剩轮廓。",
      "description": "傍晚未点灯时的轮廓光。"
    },
    {
      "id": "lx.text-environment.b0001.0014",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "反光从水盆里跳到墙上，晃出一块不规则的亮斑。有人路过时，亮斑跟着抖一下。",
      "description": "水盆反光跳墙。"
    },
    {
      "id": "lx.text-environment.b0001.0015",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "清晨第一缕光照到井口石圈，圈内仍是阴影。石圈的湿痕在光里发亮。",
      "description": "井口晨光与湿痕。"
    },
    {
      "id": "lx.text-environment.b0001.0016",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "树影在墙面上慢慢挪移，起初像掌，后来拉成细条。墙根的苔藓因此半明半暗。",
      "description": "树影挪移改变墙面明暗。"
    },
    {
      "id": "lx.text-environment.b0001.0017",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "店铺里的油灯只照亮柜台前一小圈。货架深处要伸手才摸得到边缘。",
      "description": "油灯小圈照明。"
    },
    {
      "id": "lx.text-environment.b0001.0018",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "雨停后的天光发白，石板反光刺眼。人们走路时下意识把帽檐压低。",
      "description": "雨后天光刺眼。"
    },
    {
      "id": "lx.text-environment.b0001.0019",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "月光从檐缺口漏下，正好落在门槛中央。进出的脚步会短暂踩进那块银白。",
      "description": "月光落门槛。"
    },
    {
      "id": "lx.text-environment.b0001.0020",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "夕阳把对面屋墙染成浅橙，自己这边的巷子已经发灰。明暗交界就在巷中线。",
      "description": "巷中明暗交界。"
    },
    {
      "id": "lx.text-environment.b0001.0021",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "门把手被摸得发亮，周围木头仍是暗色。亮圈大小刚好是一只手掌的范围。",
      "description": "门把手摸亮痕迹。"
    },
    {
      "id": "lx.text-environment.b0001.0022",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "石阶中央被踩出浅槽，两侧棱角还比较完整。雨天时浅槽里会积一条细水。",
      "description": "石阶中央踩槽。"
    },
    {
      "id": "lx.text-environment.b0001.0023",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "桌面有一道道浅刀痕，新旧深浅不一。靠近桌沿的那几道摸起来已经圆滑。",
      "description": "桌面新旧刀痕。"
    },
    {
      "id": "lx.text-environment.b0001.0024",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "墙角的粉笔字被擦掉又写上，底色发灰。擦痕呈不规则的椭圆。",
      "description": "墙角粉笔反复擦写。"
    },
    {
      "id": "lx.text-environment.b0001.0025",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "水台边缘有一圈长期湿润留下的深色带，干湿交界处结着薄薄的水垢。让路的动作写进了布局。",
      "description": "水台湿润色带。"
    },
    {
      "id": "lx.text-environment.b0001.0026",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "长椅扶手上的漆皮裂开，露出底下浅色木纹。裂口顺着手指常搁的位置延伸。",
      "description": "长椅扶手漆裂。"
    },
    {
      "id": "lx.text-environment.b0001.0027",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "告示角上钉眼密密麻麻，旧钉锈迹和下方新钉并存。纸边还留着撕扯的毛茬。",
      "description": "告示墙钉眼密集。"
    },
    {
      "id": "lx.text-environment.b0001.0028",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "门槛被鞋底蹭出一道斜纹，纹路指向院内。斜纹尽头的木茬微微翘起。",
      "description": "门槛鞋底斜纹。"
    },
    {
      "id": "lx.text-environment.b0001.0029",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "井绳在井沿石上勒出深沟，沟底光滑。旁边另有几道浅一些的旧沟。",
      "description": "井绳勒石深沟。"
    },
    {
      "id": "lx.text-environment.b0001.0030",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "货筐提手缠着磨亮的麻绳，绳结处起了毛。提手两端的木头颜色明显浅于筐身。",
      "description": "货筐提手磨亮。"
    },
    {
      "id": "lx.text-environment.b0001.0031",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "早市的人流不紧不慢，提篮的肩擦过肩，又各自侧开。说话声混在一起，听不清完整句子。",
      "description": "早市并肩人流。"
    },
    {
      "id": "lx.text-environment.b0001.0032",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "排队取水的人站成短列，前后距离约一臂。偶尔有人踮脚看前面还剩几只桶。",
      "description": "取水短列间距。"
    },
    {
      "id": "lx.text-environment.b0001.0033",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "廊下坐着歇脚的人，彼此隔着一张矮凳的空位。有人点头，有人只看自己的鞋。",
      "description": "廊下歇脚的礼貌距离。"
    },
    {
      "id": "lx.text-environment.b0001.0034",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "孩子们绕着石柱跑，大人站在圈外低声叫停。石柱成了临时的分界。",
      "description": "石柱内外的孩子与大人。"
    },
    {
      "id": "lx.text-environment.b0001.0035",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "傍晚归家的人手里多半有东西：菜、布、空壶。步伐比白天慢，但仍朝同一方向。",
      "description": "傍晚归家物与方向。"
    },
    {
      "id": "lx.text-environment.b0001.0036",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "桥上相遇的人对视一下便错身，有的侧肩，有的轻声道谢。桥面因此始终通畅。",
      "description": "桥上错身礼节。"
    },
    {
      "id": "lx.text-environment.b0001.0037",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "窗边探出头交谈的两家，声音不高，手势却比平时大。街上的人抬眼就低头。",
      "description": "窗边交谈与路人回避。"
    },
    {
      "id": "lx.text-environment.b0001.0038",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "雨棚下挤着躲雨的人，肩挨肩却很少说话。雨声填满了本该有的闲聊空隙。",
      "description": "躲雨拥挤少言。"
    },
    {
      "id": "lx.text-environment.b0001.0039",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "工歇时有人靠墙站成一排，有人蹲着抽烟似的空着手。目光大多落在地面。",
      "description": "工歇靠墙与蹲姿。"
    },
    {
      "id": "lx.text-environment.b0001.0040",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "夜市散场后人影变稀，只剩收摊的背影和几盏未熄的灯。脚步声显得格外清晰。",
      "description": "夜市散场稀疏人影。"
    },
    {
      "id": "lx.text-environment.b0001.0041",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从二楼窗口往下看，街面的人缩成移动的色块。檐角挡住了巷口的一半。",
      "description": "二楼俯视街面被檐角遮挡。"
    },
    {
      "id": "lx.text-environment.b0001.0042",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你蹲在井台边抬头，屋檐线条变成倾斜的三角。天空只剩井口那么大一块。",
      "description": "井台仰视屋檐与天空。"
    },
    {
      "id": "lx.text-environment.b0001.0043",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你侧身贴墙望向街心，视野被门框切成竖条。对街的招牌只露出半个字。",
      "description": "贴墙侧望被门框切割。"
    },
    {
      "id": "lx.text-environment.b0001.0044",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从桥洞里往外看，外面的光亮成一块圆。人影进出时像被圆框裁切。",
      "description": "桥洞外望的圆形光框。"
    },
    {
      "id": "lx.text-environment.b0001.0045",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你坐在低凳上平视桌面，对面人的下巴被碗沿挡住。只有对方起身时才见全脸。",
      "description": "低凳平视被碗沿挡脸。"
    },
    {
      "id": "lx.text-environment.b0001.0046",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你站在阶顶回头，来路的石阶缩成一条灰带。路边的摊位小得像玩具。",
      "description": "阶顶回望来路缩小。"
    },
    {
      "id": "lx.text-environment.b0001.0047",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你隔着竹帘看院子，帘缝把景物切成细条。风过时细条左右晃动。",
      "description": "竹帘缝隙切割院景。"
    },
    {
      "id": "lx.text-environment.b0001.0048",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你趴在栏杆上俯看河面，自己的影子叠在水纹上。岸边洗衣的人只剩头顶。",
      "description": "栏杆俯看河面与岸人。"
    },
    {
      "id": "lx.text-environment.b0001.0049",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从货架缝隙望向店门，顾客进门时先露出鞋尖。店门框成了天然的取景框。",
      "description": "货架缝窥店门取景。"
    },
    {
      "id": "lx.text-environment.b0001.0050",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你仰躺在长椅上，屋檐与树冠叠进同一片视野。偶尔有鸟影从两层之间掠过。",
      "description": "仰躺叠视檐与树冠。"
    }
  ]
}
