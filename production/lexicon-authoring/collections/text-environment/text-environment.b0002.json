{
  "format": "aetheria-lexicon-batch",
  "schemaVersion": 1,
  "library": "text-environment",
  "batchId": "text-environment.b0002",
  "source": {
    "producer": "ai-text",
    "model": "Grok Bot",
    "theme": "手艺与修补：旧物、协作、小店、学徒、细致操作，避免全部采用机械隐喻"
  },
  "entries": [
    {
      "id": "lx.text-environment.b0002.0001",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "小店工作台占了大半进深，人要侧身才能走到后墙的材料架。台面与墙之间只够一只脚宽。",
      "description": "工作台压缩店内进深。"
    },
    {
      "id": "lx.text-environment.b0002.0002",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "学徒的矮凳挤在师傅座位旁，两套工具交错摆放。谁起身都要先看对方手在哪。",
      "description": "师徒座位工具交错。"
    },
    {
      "id": "lx.text-environment.b0002.0003",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "旧物堆到屋顶斜梁下，最高处的木箱要踩凳才够。斜梁把可用高度切成三角形。",
      "description": "斜梁下旧物堆叠高度。"
    },
    {
      "id": "lx.text-environment.b0002.0004",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "修补间门口挂着半截布帘，帘内灯火，帘外街声。帘下沿离地一掌，能看见进出的鞋。",
      "description": "布帘分隔内外声光。"
    },
    {
      "id": "lx.text-environment.b0002.0005",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "墙面上钉满挂钩，锉、锯、刷各归其位。空钩说明有工具正在桌上使用。",
      "description": "挂钩墙显示工具在用。"
    },
    {
      "id": "lx.text-environment.b0002.0006",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "柜台内侧比外侧低半级，跪着修合叶时肩背刚好卡进柜台下。外侧顾客只看见后脑。",
      "description": "柜台内外高差与跪修。"
    },
    {
      "id": "lx.text-environment.b0002.0007",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "线轴架横在过道上方，人要通过时必须低头。线头偶尔扫过经过者的发顶。",
      "description": "线轴架迫使低头通过。"
    },
    {
      "id": "lx.text-environment.b0002.0008",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "磨刀石靠窗摆着，光正好落在石面上。旁边水盆与废布挤在同一块小板上。",
      "description": "窗边磨刀与水盆小板。"
    },
    {
      "id": "lx.text-environment.b0002.0009",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "后门通向窄院，院里晾着刚修好的椅腿。院墙把风挡住，木味久久不散。",
      "description": "后门窄院晾椅腿。"
    },
    {
      "id": "lx.text-environment.b0002.0010",
      "category": "text-environment",
      "subcategory": "空间印象",
      "text": "两人合抬木箱时，店门宽度刚好让箱身通过。抬的人要侧髋，箱角擦着门框。",
      "description": "店门宽度与抬箱侧髋。"
    },
    {
      "id": "lx.text-environment.b0002.0011",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "工作台灯只照亮正在缝的那一角布。线头的颜色在光圈外就分不清。",
      "description": "工作灯小圈照布角。"
    },
    {
      "id": "lx.text-environment.b0002.0012",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "午后斜光从半开的后门进来，把锯末照得像细金粉。人走过时金粉乱一阵。",
      "description": "后门斜光中的锯末。"
    },
    {
      "id": "lx.text-environment.b0002.0013",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "油灯旁的铜盆反光，把学徒的手背映得忽明忽暗。师傅的脸仍在阴影里。",
      "description": "铜盆反光映手背。"
    },
    {
      "id": "lx.text-environment.b0002.0014",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "阴天时店内几乎全靠门口的天光。柜台深处要凑近才看得清裂纹走向。",
      "description": "阴天门口天光为主。"
    },
    {
      "id": "lx.text-environment.b0002.0015",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "晚间收工，灯一盏盏灭掉，最后只剩门口那盏。工具轮廓先于颜色消失。",
      "description": "收工灭灯轮廓先失。"
    },
    {
      "id": "lx.text-environment.b0002.0016",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "阳光穿过挂起的半透明布料，在地上投下浅色块。布料一晃，色块跟着挪。",
      "description": "半透明布料投浅色块。"
    },
    {
      "id": "lx.text-environment.b0002.0017",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "烙铁加热时炉口发红，照亮旁边一小片台面。其余角落仍靠窗外残余光。",
      "description": "炉口红光照台面一角。"
    },
    {
      "id": "lx.text-environment.b0002.0018",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "晨光先到窗台的蜡碗，碗沿亮了一圈。工作台中央还要再等片刻。",
      "description": "晨光先到蜡碗。"
    },
    {
      "id": "lx.text-environment.b0002.0019",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "雨天屋漏处的光柱里有水雾，光柱落点正好在废料筐上。筐沿因此发亮。",
      "description": "漏光水雾落废料筐。"
    },
    {
      "id": "lx.text-environment.b0002.0020",
      "category": "text-environment",
      "subcategory": "光线观察",
      "text": "对面店铺的灯透过自己店的窗，在墙上映出淡格。淡格随对方门帘开合而变。",
      "description": "对店灯光映淡格。"
    },
    {
      "id": "lx.text-environment.b0002.0021",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "台面中央有一块长期按压留下的浅凹，刚好适合手肘搁稳。凹周木纹被汗浸深。",
      "description": "台面肘搁浅凹。"
    },
    {
      "id": "lx.text-environment.b0002.0022",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "锉刀柄被握得发亮，刃口却还带着新磨的细纹。柄上指痕深浅不一。",
      "description": "锉刀柄握亮指痕。"
    },
    {
      "id": "lx.text-environment.b0002.0023",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "墙角量尺的零点被磨糊，数字只剩后半截清楚。靠墙的那一侧漆皮剥落。",
      "description": "量尺零点磨糊。"
    },
    {
      "id": "lx.text-environment.b0002.0024",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "针垫扎满新旧针孔，中心已经松软塌陷。边缘还钉着几根备用的粗针。",
      "description": "针垫中心塌陷。"
    },
    {
      "id": "lx.text-environment.b0002.0025",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "踏板被踩出两道平行浅槽，槽内木头颜色浅于周围。踏板边缘还留着鞋钉划痕。",
      "description": "踏板平行踩槽。"
    },
    {
      "id": "lx.text-environment.b0002.0026",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "胶水瓶盖内侧结着一圈干胶，拧开时要费一点力。瓶身标签被胶水糊得发皱。",
      "description": "胶盖干胶圈。"
    },
    {
      "id": "lx.text-environment.b0002.0027",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "旧钟壳内侧有被撬过的浅痕，痕边打磨圆滑。外壳则被擦得露出底层黄铜。",
      "description": "钟壳撬痕与擦亮。"
    },
    {
      "id": "lx.text-environment.b0002.0028",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "学徒凳面的漆已被坐穿，露出一圈浅色椭圆。椭圆大小与常坐者的坐姿吻合。",
      "description": "学徒凳坐穿椭圆。"
    },
    {
      "id": "lx.text-environment.b0002.0029",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "挂钩上的绳结磨出毛边，挂钩铁环被磨细一圈。空钩比负重钩颜色更深。",
      "description": "挂钩绳结磨毛。"
    },
    {
      "id": "lx.text-environment.b0002.0030",
      "category": "text-environment",
      "subcategory": "使用痕迹",
      "text": "砂纸盒盖内侧沾满各色砂粉，开盖时粉会轻轻扬起。盒底有被砂纸角戳出的小洞。",
      "description": "砂纸盒粉与戳洞。"
    },
    {
      "id": "lx.text-environment.b0002.0031",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "店门口偶尔停着问价的人，进门的少，探头的多。师傅抬头应一声，手不停活。",
      "description": "问价探头与手不停。"
    },
    {
      "id": "lx.text-environment.b0002.0032",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "两个学徒共用一张边桌，肘部会轻轻相碰，随即各自挪开半寸。没有人抱怨。",
      "description": "学徒并肘礼貌挪开。"
    },
    {
      "id": "lx.text-environment.b0002.0033",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "收活的人把修好的椅子抱出院门，回头道谢。店内其他人只抬眼一瞬又低头。",
      "description": "收活道谢与店内一瞬。"
    },
    {
      "id": "lx.text-environment.b0002.0034",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "傍晚有人靠门框闲聊修补进度，声音压得很低。过路人侧耳也听不清术语。",
      "description": "门框低声聊进度。"
    },
    {
      "id": "lx.text-environment.b0002.0035",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "有人送来一筐待修的旧物，放下就走。店里人围过去翻看，指指点点却不争抢。",
      "description": "送旧物围观不争。"
    },
    {
      "id": "lx.text-environment.b0002.0036",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "午歇时师傅坐门口喝茶，学徒蹲在台阶上吃干粮。两人之间隔着半级台阶的空。",
      "description": "午歇隔阶而坐。"
    },
    {
      "id": "lx.text-environment.b0002.0037",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "协作抬柜的两人步伐一致，呼吸也渐渐对齐。旁观的人自动让出通道。",
      "description": "抬柜协作与旁观让道。"
    },
    {
      "id": "lx.text-environment.b0002.0038",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "有人在柜台外等估价，手指无意识敲着木沿。店内忙碌的人不主动搭话。",
      "description": "等估价敲木沿。"
    },
    {
      "id": "lx.text-environment.b0002.0039",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "夜里加班的灯只亮一盏，人影在窗纸上缩成一团。街上空无一人。",
      "description": "夜加班窗纸人影。"
    },
    {
      "id": "lx.text-environment.b0002.0040",
      "category": "text-environment",
      "subcategory": "人群印象",
      "text": "孩子们趴在窗台看锯末飞，被大人轻声唤走。窗台上留下几个小手印。",
      "description": "孩童观锯末与手印。"
    },
    {
      "id": "lx.text-environment.b0002.0041",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从柜台内侧抬头，顾客的脸被台沿切掉下巴以下。只有对方弯腰时才见全貌。",
      "description": "柜台内仰视被台沿切。"
    },
    {
      "id": "lx.text-environment.b0002.0042",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你蹲着修桌腿，视野里尽是木纹与地面缝。人走过时先看到鞋，再看到裤脚。",
      "description": "蹲修视角先见鞋。"
    },
    {
      "id": "lx.text-environment.b0002.0043",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你站在凳上够高架，店内布局一下子变扁。门口进出的人只剩头顶旋涡。",
      "description": "凳上俯视见头顶。"
    },
    {
      "id": "lx.text-environment.b0002.0044",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你隔着半拉开的抽屉缝看店门，缝宽只够一条竖线。有人进门时竖线被身影填满。",
      "description": "抽屉缝窥店门。"
    },
    {
      "id": "lx.text-environment.b0002.0045",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你躺在柜下找掉落的螺丝，天花板梁缝成了主要风景。灯火在梁缝间一闪一闪。",
      "description": "柜下仰视梁缝灯火。"
    },
    {
      "id": "lx.text-environment.b0002.0046",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从后门缝看院中晾着的椅腿，椅腿在风里微晃，像一排不整齐的手指。功能与礼貌距离叠在同一画面里。",
      "description": "后门缝看晾椅腿。"
    },
    {
      "id": "lx.text-environment.b0002.0047",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你侧身贴墙望向工作台，台面上的工具被自己的肩遮掉一半。挪肩才见全套。",
      "description": "贴墙侧望被肩遮工具。"
    },
    {
      "id": "lx.text-environment.b0002.0048",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你透过挂起的量尺间隙看师傅的手，手被尺影切成几段，仍准确走线。材料的新旧并排放着，互不妨碍。",
      "description": "量尺间隙看走线手。"
    },
    {
      "id": "lx.text-environment.b0002.0049",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你坐在低矮学徒凳上，视线刚好平齐台沿。台面上的活计像舞台布景。",
      "description": "学徒凳平齐台沿视。"
    },
    {
      "id": "lx.text-environment.b0002.0050",
      "category": "text-environment",
      "subcategory": "视角变化",
      "text": "你从楼板缺口往下瞥，锯末像细雪落在下层台面。下层的人没有抬头。",
      "description": "楼板缺口俯见锯末。"
    }
  ]
}
