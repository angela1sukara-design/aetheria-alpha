{
  "format": "aetheria-prose-assembly-example",
  "note": "独立中性测试快照；姓名和地名取自绑定对象的显示记录，示例数据不是写死在词条中的名字。",
  "slashOrder": "place/opponentForm/bodyPart/actionCore/propEnv/materialFluid/senseMod/exitChoice",
  "rule": {
    "id": "assembly.example.eight-slots",
    "domain": "example",
    "mode": "prose",
    "contentTier": "general",
    "fallbackTier": "general",
    "checks": [
      "T03",
      "T04",
      "T05",
      "T27",
      "T32",
      "T33",
      "T34",
      "T35",
      "T36",
      "T37"
    ],
    "proseTemplate": [
      {
        "key": "where",
        "slot": "place",
        "poolId": "place.current",
        "bindTo": "place",
        "required": true,
        "prefix": "在",
        "suffix": "，"
      },
      {
        "key": "actor",
        "slot": "opponentForm",
        "poolId": "actor.form",
        "bindTo": "actor",
        "required": true,
        "prefix": "",
        "suffix": ""
      },
      {
        "key": "part",
        "slot": "bodyPart",
        "poolId": "actor.bodyPart",
        "bindTo": "part",
        "subjectAs": [
          "actor"
        ],
        "required": true,
        "prefix": "的",
        "suffix": "仍保持原状。"
      },
      {
        "key": "act",
        "slot": "actionCore",
        "poolId": "action.observed",
        "bindTo": "actor",
        "required": true,
        "prefix": "对方",
        "suffix": "。"
      },
      {
        "key": "prop",
        "slot": "propEnv",
        "poolId": "environment.prop",
        "bindTo": "prop",
        "required": true,
        "prefix": "旁边放着",
        "suffix": "，"
      },
      {
        "key": "material",
        "slot": "materialFluid",
        "poolId": "material.current",
        "bindTo": "material",
        "required": true,
        "prefixPools": [
          {
            "poolId": "material.qualifier",
            "required": false,
            "separator": ""
          }
        ],
        "prefix": "里面盛着",
        "suffix": "，"
      },
      {
        "key": "scent",
        "slot": "senseMod",
        "poolId": "environment.sense",
        "bindTo": "sense",
        "required": false,
        "prefix": "空气中带着",
        "suffix": "。"
      },
      {
        "key": "exit",
        "slot": "exitChoice",
        "poolId": "exit.current",
        "bindTo": "exit",
        "required": true,
        "prefix": "你可以",
        "suffix": "。"
      }
    ],
    "prose": "你可以结束观察，继续自己的安排。"
  },
