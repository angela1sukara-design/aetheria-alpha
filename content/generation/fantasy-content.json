      "ageYears": 32,
      "bodyTemplateId": "aetheria-tf:body.human",
      "patchIds": [
        "aetheria-tf:patch.ears.cat"
      ],
      "dialogue": {
        "intro": "“先洗手再碰药罐。敷料和净水在这边，有伤就去里面的护理座位。”",
        "repeat": "“又来了？先说说你哪里不舒服，别拿错了药。”",
        "help": "你按药柜上的标记分好绷带、药罐和净水。护理员检查封口后，把工钱递到你手里。"
      },
      "services": {
        "work": {
          "label": "协助护理员整理药柜",
          "text": "你按药柜上的标记分好绷带、药罐和净水。护理员检查封口后，把工钱递到你手里。"
        },
        "trade": [
          "fantasy:item.bandage",
          "fantasy:item.draught"
        ]
      },
      "roleName": "神殿护理员"
    },
