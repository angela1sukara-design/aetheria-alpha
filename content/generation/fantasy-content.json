      "behavior": "trade",
      "speciesId": "fantasy:species.human",
      "ageYears": 30,
      "bodyTemplateId": "aetheria-tf:body.human",
      "patchIds": [],
      "dialogue": {
        "intro": "“当天到的货都在这里，价钱标清了。要找活做，就先帮我把货单核清。”",
        "repeat": "“熟面孔了。要买东西，还是来谈今天的订单？”",
        "help": "你把送来的木箱逐一对照货单，数清扣环和布卷。摊主复核后付清约定的工钱。"
      },
      "services": {
        "work": {
          "label": "帮摊主核对货单",
          "text": "你把送来的木箱逐一对照货单，数清扣环和布卷。摊主复核后付清约定的工钱。"
        },
        "trade": [
          "progression:equipment.staff",
          "progression:equipment.charm",
          "fantasy:item.ration"
        ],
        "orders": true,
        "investments": true
      },
      "roleName": "集市摊主"
    },
    {
