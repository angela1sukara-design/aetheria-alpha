      "bodyTemplateId": "aetheria-tf:body.human",
      "patchIds": [],
      "dialogue": {
        "intro": "“我只是赶路的信使，交了信还要出城。你若问路，我倒是记得几条岔道。”",
        "repeat": "“又碰面了。城门那边今天通行得还顺利吗？”",
        "help": "你们交换了路况，随后各自继续赶路。"
      },
      "services": {},
      "roleName": "过路信使"
    },
    {
      "id": "fantasy:resident.broker",
      "locationIds": [
        "aetheria:location.street"
      ],
      "start": 480,
      "end": 1080,
      "names": [
        "伊索德",
        "米拉",
        "奎因",
        "乔纳斯",
        "佩拉",
        "罗伊"
      ],
      "profession": "摊贩",
      "appearance": [
        "账册与公会徽章",
        "腰间挂着验货镜"
      ],
      "personality": [
        "精于当面核算",
        "不喜欢空口承诺"
