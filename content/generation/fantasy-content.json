      "ageYears": 36,
      "bodyTemplateId": "aetheria-tf:body.human",
      "patchIds": [],
      "dialogue": {
        "intro": "“委托簿按日期排列。办事先看公告，登记过的事情都有回执，别弄丢了。”",
        "repeat": "“你上次的回执还留着吧？把编号报给我，就不用从头翻了。”",
        "help": "你对照印章整理已经办结的委托，把缺少收据的记录单独归档。文书复核后付清工钱。"
      },
      "services": {
        "work": {
          "label": "帮文书整理委托记录",
          "text": "你对照印章整理已经办结的委托，把缺少收据的记录单独归档。文书复核后付清工钱。"
        }
      },
      "roleName": "委托文书"
    },
    {
