      "y": 23688,
      "width": 336,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n532",
      "type": "text",
      "text": "身体部位改成八个，并修正归类",
      "x": 436,
      "y": 23744,
      "width": 256,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n533",
      "type": "text",
      "text": "这一轮先不装",
      "x": 204,
      "y": 23968,
      "width": 148,
      "height": 46,
      "color": "2"
    },
    {
