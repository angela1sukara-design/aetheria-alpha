      "y": 7168,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n174",
      "type": "text",
      "text": "魅魔、合欢 = 生物 + 人形，不新开材质",
      "x": 636,
      "y": 7224,
      "width": 320,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n175",
      "type": "text",
      "text": "产卵器不升成材质",
