      "width": 148,
      "height": 46,
      "color": "6"
    },
    {
      "id": "n3",
      "type": "text",
      "text": "绿：玩家流程",
      "x": 408,
      "y": 0,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n4",
      "type": "text",
      "text": "红：制作模块",
      "x": 408,
      "y": 56,
      "width": 148,
      "height": 46,
      "color": "1"
    },
    {
      "id": "n5",
      "type": "text",
      "text": "青：已经定下",
      "x": 408,
      "y": 112,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n6",
      "type": "text",
      "text": "黄：举例或还没勾选",
      "x": 408,
      "y": 168,
      "width": 176,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n7",
      "type": "text",
      "text": "橙：明确不做，或以后再做",
      "x": 408,
      "y": 224,
      "width": 224,
      "height": 46,
      "color": "2"
    },
    {
      "id": "n8",
      "type": "text",
      "text": "玩家流程",
      "x": 204,
      "y": 1904,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n9",
      "type": "text",
      "text": "1 选择世界",
      "x": 408,
      "y": 336,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n10",
      "type": "text",
      "text": "同时生成主线池",
      "x": 612,
      "y": 280,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n11",
      "type": "text",
      "text": "这批不写主线正文",
      "x": 816,
      "y": 280,
      "width": 160,
      "height": 46,
      "color": "2"
    },
    {
      "id": "n12",
      "type": "text",
      "text": "同时生成数个大区域",
      "x": 612,
      "y": 336,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n13",
      "type": "text",
      "text": "同时确定本世界允许的转化",
      "x": 612,
      "y": 392,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n14",
      "type": "text",
      "text": "转化种类见材质和形态，不另起一套名字",
      "x": 892,
      "y": 392,
      "width": 320,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n15",
      "type": "text",
      "text": "2 捏人加点",
      "x": 408,
      "y": 588,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n16",
      "type": "text",
      "text": "输入姓名",
      "x": 612,
      "y": 448,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n17",
      "type": "text",
      "text": "性别：女、男、双性、无性",
      "x": 612,
      "y": 504,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n18",
      "type": "text",
      "text": "出生大区域由捏人决定",
      "x": 612,
      "y": 560,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n19",
      "type": "text",
      "text": "按出生大区域从主线池领一条",
      "x": 612,
      "y": 616,
      "width": 240,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n20",
      "type": "text",
      "text": "加点用哪些属性还没定死",
      "x": 612,
      "y": 672,
      "width": 208,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n21",
      "type": "text",
      "text": "非类人角色",
      "x": 612,
      "y": 728,
      "width": 148,
      "height": 46,
      "color": "2"
    },
    {
      "id": "n22",
      "type": "text",
      "text": "主要内容做完再考虑。现在默认类人",
      "x": 816,
      "y": 728,
      "width": 288,
      "height": 46,
      "color": "2"
    },
    {
      "id": "n23",
      "type": "text",
      "text": "3 世界往下长",
      "x": 408,
      "y": 952,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n24",
      "type": "text",
      "text": "大区域",
      "x": 612,
      "y": 784,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n25",
      "type": "text",
      "text": "小区域",
      "x": 612,
      "y": 840,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n26",
      "type": "text",
      "text": "场景",
      "x": 612,
      "y": 924,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n27",
      "type": "text",
      "text": "早期例子：酒馆、医院、下水道、小巷",
      "x": 816,
      "y": 896,
      "width": 304,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n28",
      "type": "text",
      "text": "后来改为场景可自由写，之后再删",
      "x": 816,
      "y": 952,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n29",
      "type": "text",
      "text": "场景里生成相关的人",
      "x": 612,
      "y": 1008,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n30",
      "type": "text",
      "text": "组织挂在世界下面，和人并列",
      "x": 612,
      "y": 1064,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n31",
      "type": "text",
      "text": "道具按世界确定",
      "x": 612,
      "y": 1120,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n32",
      "type": "text",
      "text": "除基础种类外都要先设计。这一批不写道具",
      "x": 816,
      "y": 1120,
      "width": 336,
      "height": 46,
      "color": "2"
    },
    {
      "id": "n33",
      "type": "text",
      "text": "4 探索",
      "x": 408,
      "y": 1288,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n34",
      "type": "text",
      "text": "移动",
      "x": 612,
      "y": 1176,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n35",
      "type": "text",
      "text": "调查",
      "x": 612,
      "y": 1232,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n36",
      "type": "text",
      "text": "交谈",
      "x": 612,
      "y": 1288,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n37",
      "type": "text",
      "text": "使用资源",
      "x": 612,
      "y": 1344,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n38",
      "type": "text",
      "text": "触发事件",
      "x": 612,
      "y": 1400,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n39",
      "type": "text",
      "text": "5 事件",
      "x": 408,
      "y": 1652,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n40",
      "type": "text",
      "text": "NPC 事件",
      "x": 612,
      "y": 1596,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n41",
      "type": "text",
      "text": "支线任务",
      "x": 816,
      "y": 1456,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n42",
      "type": "text",
      "text": "攻略对方",
      "x": 816,
      "y": 1512,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n43",
      "type": "text",
      "text": "爱意、信任、恐惧、顺从、熟悉还没决定拆还是合成一个态度",
      "x": 1020,
      "y": 1512,
      "width": 420,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n44",
      "type": "text",
      "text": "特定功能",
      "x": 816,
      "y": 1652,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n45",
      "type": "text",
      "text": "做得到才出现",
      "x": 1020,
      "y": 1568,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n46",
      "type": "text",
      "text": "铁匠：打造、修理",
      "x": 1020,
      "y": 1624,
      "width": 160,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n47",
      "type": "text",
      "text": "医生：治疗，清除外伤和异常",
      "x": 1020,
      "y": 1680,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n48",
      "type": "text",
      "text": "旅馆酒馆：休息、吃饭、交谈",
      "x": 1020,
      "y": 1736,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n49",
      "type": "text",
      "text": "触发敌对",
      "x": 612,
      "y": 1792,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n50",
      "type": "text",
      "text": "也可以直接进入战斗",
      "x": 612,
      "y": 1848,
      "width": 176,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n51",
      "type": "text",
      "text": "6 战斗",
      "x": 408,
      "y": 2016,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n52",
      "type": "text",
      "text": "双方的标签和属性决定能用什么行为",
      "x": 612,
      "y": 1904,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n53",
      "type": "text",
      "text": "胸部开发到档，才出现乳汁相关行为",
      "x": 612,
      "y": 1960,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n54",
      "type": "text",
      "text": "有触手，才能缠或抽",
      "x": 612,
      "y": 2016,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n55",
      "type": "text",
      "text": "没长出的尾巴、额外肢体不能当目标",
      "x": 612,
      "y": 2072,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n56",
      "type": "text",
      "text": "状态会关掉部分行为，例如封口不能用口",
      "x": 612,
      "y": 2128,
      "width": 320,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n57",
      "type": "text",
      "text": "7 胜利并且不做色色",
      "x": 408,
      "y": 2324,
      "width": 176,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n58",
      "type": "text",
      "text": "结算成长属性",
      "x": 640,
      "y": 2184,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n59",
      "type": "text",
      "text": "结算道具",
      "x": 640,
      "y": 2240,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n60",
      "type": "text",
      "text": "对方组织的态度改变",
      "x": 640,
      "y": 2352,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n61",
      "type": "text",
      "text": "喜欢或厌恶",
      "x": 872,
      "y": 2296,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n62",
      "type": "text",
      "text": "畏惧",
      "x": 872,
      "y": 2352,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n63",
      "type": "text",
      "text": "接纳或通缉",
      "x": 872,
      "y": 2408,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n64",
      "type": "text",
      "text": "区域强度记在世界上，不记在角色身上",
      "x": 640,
      "y": 2464,
      "width": 304,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n65",
      "type": "text",
      "text": "8 失败，或胜利后选择做色色",
      "x": 408,
      "y": 2744,
      "width": 240,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n66",
      "type": "text",
      "text": "匹配顺序",
      "x": 704,
      "y": 2576,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n67",
      "type": "text",
      "text": "先材质、智慧、数量、立场",
      "x": 908,
      "y": 2520,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n68",
      "type": "text",
      "text": "再形态",
      "x": 908,
      "y": 2576,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n69",
      "type": "text",
      "text": "再小标签：位置、用哪里、留下什么、怎么控制",
      "x": 908,
      "y": 2632,
      "width": 368,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n70",
      "type": "text",
      "text": "生成多段文本",
      "x": 704,
      "y": 2688,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n71",
      "type": "text",
      "text": "至少一轮",
      "x": 704,
      "y": 2744,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n72",
      "type": "text",
      "text": "不是第一次可以跳过",
      "x": 704,
      "y": 2800,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n73",
      "type": "text",
      "text": "跳过仍获得少量成长",
      "x": 704,
      "y": 2856,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n74",
      "type": "text",
      "text": "已读内容决定能不能跳过，记在存档里",
      "x": 704,
      "y": 2912,
      "width": 304,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n75",
      "type": "text",
      "text": "离开结算仍然有少量成长",
      "x": 704,
      "y": 2968,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n76",
      "type": "text",
      "text": "9 恶堕结局",
      "x": 408,
      "y": 3136,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n77",
      "type": "text",
      "text": "理智归零",
      "x": 612,
      "y": 3024,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n78",
      "type": "text",
      "text": "或玩家主动选择",
      "x": 612,
      "y": 3080,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n79",
      "type": "text",
      "text": "多段恶堕文本",
      "x": 612,
      "y": 3136,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n80",
      "type": "text",
      "text": "最后变成什么样",
      "x": 612,
      "y": 3192,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n81",
      "type": "text",
      "text": "本局结束，读档或重开",
      "x": 612,
      "y": 3248,
      "width": 192,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n82",
      "type": "text",
      "text": "进门读到的内容",
      "x": 408,
      "y": 3416,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n83",
      "type": "text",
      "text": "每个场所都有场景描述",
      "x": 612,
      "y": 3304,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n84",
      "type": "text",
      "text": "看得见什么、有什么人、人在做什么",
      "x": 860,
      "y": 3304,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n85",
      "type": "text",
      "text": "功能场所才有对话",
      "x": 612,
      "y": 3416,
      "width": 160,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n86",
      "type": "text",
      "text": "招呼",
      "x": 828,
      "y": 3360,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n87",
      "type": "text",
      "text": "使用这个场所真正有的功能",
      "x": 828,
      "y": 3416,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n88",
      "type": "text",
      "text": "一条事件，选了才进入和这个 NPC 的战斗",
      "x": 828,
      "y": 3472,
      "width": 328,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n89",
      "type": "text",
      "text": "战斗场所不写功能对话",
      "x": 612,
      "y": 3528,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n90",
      "type": "text",
      "text": "场所规则",
      "x": 204,
      "y": 3864,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n91",
      "type": "text",
      "text": "功能场所",
      "x": 408,
      "y": 3696,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n92",
      "type": "text",
      "text": "治疗、打造、休息、交谈",
      "x": 612,
      "y": 3584,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n93",
      "type": "text",
