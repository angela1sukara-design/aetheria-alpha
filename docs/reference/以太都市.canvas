      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n229",
      "type": "text",
      "text": "口、耳、角都在头上",
      "x": 840,
      "y": 9912,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n230",
      "type": "text",
