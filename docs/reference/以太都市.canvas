      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n240",
      "type": "text",
      "text": "按四档性别描述",
      "x": 840,
      "y": 10304,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n241",
      "type": "text",
      "text": "后庭不写进这个名字",
