      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n187",
      "type": "text",
      "text": "立场",
      "x": 420,
      "y": 8036,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n188",
      "type": "text",
      "text": "支配",
      "x": 624,
      "y": 7840,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n189",
      "type": "text",
      "text": "顺从",
      "x": 624,
      "y": 7896,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n190",
      "type": "text",
      "text": "切换",
      "x": 624,
      "y": 7952,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n191",
      "type": "text",
      "text": "双方都强时用切换，避免两套文本一起出现",
      "x": 624,
      "y": 8008,
      "width": 336,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n192",
      "type": "text",
      "text": "切换不自动挑边",
      "x": 624,
      "y": 8064,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n193",
      "type": "text",
      "text": "流体支配走吞噬",
      "x": 624,
      "y": 8120,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n194",
      "type": "text",
      "text": "流体顺从走附身",
      "x": 624,
      "y": 8176,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n195",
      "type": "text",
      "text": "寄生不看立场",
      "x": 624,
      "y": 8232,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n196",
      "type": "text",
      "text": "尺度改成尺寸档",
      "x": 420,
      "y": 8848,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n197",
      "type": "text",
      "text": "不再用普通、巨大、微小三个标签",
      "x": 624,
      "y": 8288,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n198",
      "type": "text",
      "text": "微小不单列，偏小用档「小」",
      "x": 624,
      "y": 8344,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n199",
      "type": "text",
      "text": "句子只订定词，不订厘米",
      "x": 624,
      "y": 8400,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n200",
      "type": "text",
      "text": "r = 测量 ÷ 该形态成年基准",
      "x": 624,
      "y": 8456,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n201",
      "type": "text",
      "text": "r ≤ 0.85 → 小",
      "x": 624,
      "y": 8512,
      "width": 152,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n202",
      "type": "text",
      "text": "0.85 ＜ r ≤ 1.15 → 普通，可以不加词",
      "x": 624,
      "y": 8568,
      "width": 328,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n203",
      "type": "text",
      "text": "1.15 ＜ r ≤ 1.5 → 大",
      "x": 624,
      "y": 8624,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n204",
      "type": "text",
      "text": "r ＞ 1.5 → 巨大",
      "x": 624,
      "y": 8680,
      "width": 160,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n205",
      "type": "text",
      "text": "人形量身高",
      "x": 624,
      "y": 8736,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n206",
      "type": "text",
      "text": "兽形量肩高，耳尖和角不算，不设身高",
      "x": 624,
      "y": 8792,
      "width": 304,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n207",
      "type": "text",
      "text": "比谁大时比档，不比厘米",
      "x": 624,
      "y": 8848,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n208",
      "type": "text",
      "text": "半人马：人躯和兽躯各量各的",
      "x": 624,
      "y": 8904,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n209",
      "type": "text",
      "text": "场面谁更大，取两档里更高的一档",
      "x": 624,
      "y": 8960,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n210",
      "type": "text",
      "text": "流体用体积，一人高的一滩 = 1",
      "x": 624,
      "y": 9016,
      "width": 256,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n211",
      "type": "text",
      "text": "触手和额外肢体量这一肢自己的长度",
      "x": 624,
      "y": 9072,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n212",
      "type": "text",
      "text": "生殖器官直接存档，默认抄全身体量档",
      "x": 624,
      "y": 9128,
      "width": 304,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n213",
      "type": "text",
      "text": "生殖允许高一档或低一档",
      "x": 624,
      "y": 9184,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n214",
      "type": "text",
      "text": "生殖用自己的定词，不复用身高词",
      "x": 624,
      "y": 9240,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n215",
      "type": "text",
      "text": "无性没有生殖尺寸档",
      "x": 624,
      "y": 9296,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n216",
      "type": "text",
      "text": "腹下悬吊：半人马或多足，且对方体量档至少高一档",
      "x": 624,
      "y": 9352,
      "width": 400,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n217",
      "type": "text",
      "text": "四档的具体用词还没定",
      "x": 624,
      "y": 9408,
      "width": 192,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n218",
      "type": "text",
      "text": "性别与性转",
      "x": 420,
      "y": 9660,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n219",
      "type": "text",
      "text": "女",
      "x": 624,
      "y": 9464,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n220",
      "type": "text",
      "text": "男",
      "x": 624,
      "y": 9520,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n221",
      "type": "text",
      "text": "双性",
      "x": 624,
      "y": 9576,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n222",
      "type": "text",
