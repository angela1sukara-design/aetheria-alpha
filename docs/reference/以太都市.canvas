      "color": "5"
    },
    {
      "id": "n246",
      "type": "text",
      "text": "默认没有",
      "x": 840,
      "y": 10528,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n247",
      "type": "text",
      "text": "额外肢体",
      "x": 636,
      "y": 10640,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n248",
      "type": "text",
      "text": "默认没有",
      "x": 840,
      "y": 10584,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n249",
      "type": "text",
      "text": "只放翅膀、触手、多出来的机械臂",
      "x": 840,
      "y": 10640,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n250",
      "type": "text",
      "text": "半人马四足躯干是形态，不放这里",
      "x": 840,
      "y": 10696,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n251",
      "type": "text",
      "text": "默认存在：头、颈、胸、腰、生殖器官、四肢",
      "x": 636,
      "y": 10752,
      "width": 352,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n252",
      "type": "text",
      "text": "不存在就不能当目标，句子里也不写",
