      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n296",
      "type": "text",
      "text": "五感剥夺",
      "x": 652,
      "y": 12936,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n297",
      "type": "text",
      "text": "真空封装",
      "x": 652,
      "y": 12992,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n298",
      "type": "text",
      "text": "项圈",
      "x": 652,
      "y": 13048,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n299",
      "type": "text",
      "text": "催眠",
      "x": 652,
      "y": 13104,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n300",
      "type": "text",
      "text": "真空封装时人还是自己，材质不改",
      "x": 652,
      "y": 13160,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n301",
      "type": "text",
      "text": "同化、吞噬、附身、寄生",
      "x": 420,
      "y": 13972,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n302",
      "type": "text",
      "text": "同化不是人人可用的小标签",
      "x": 684,
      "y": 13216,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n303",
      "type": "text",
      "text": "单纯吞噬",
      "x": 684,
      "y": 13328,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n304",
      "type": "text",
      "text": "只有支配的流体",
      "x": 888,
      "y": 13272,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n305",
      "type": "text",
      "text": "对方在内部，仍是自己",
      "x": 888,
      "y": 13328,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n306",
      "type": "text",
      "text": "状态：在内部",
      "x": 888,
      "y": 13384,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n307",
      "type": "text",
      "text": "融合，也就是同化",
      "x": 684,
      "y": 13552,
      "width": 160,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n308",
      "type": "text",
      "text": "只有支配的流体，并且选了融合",
      "x": 900,
      "y": 13440,
      "width": 256,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n309",
      "type": "text",
      "text": "对方不再独立",
      "x": 900,
      "y": 13496,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n310",
      "type": "text",
      "text": "变成这只流体的器官或肢体",
      "x": 900,
      "y": 13552,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n311",
      "type": "text",
      "text": "记下原来是谁",
      "x": 900,
      "y": 13608,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n312",
      "type": "text",
      "text": "材质改为流体",
      "x": 900,
      "y": 13664,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n313",
      "type": "text",
      "text": "拟态",
      "x": 684,
      "y": 13776,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n314",
      "type": "text",
      "text": "顺从的流体，或灵体",
      "x": 888,
      "y": 13720,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n315",
      "type": "text",
      "text": "呈现成另一个生物的样子",
      "x": 888,
      "y": 13776,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n316",
      "type": "text",
      "text": "外形词订那个生物，材质词仍是流体或灵体",
      "x": 888,
      "y": 13832,
      "width": 336,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n317",
      "type": "text",
      "text": "附在体表",
      "x": 684,
      "y": 14028,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n318",
      "type": "text",
      "text": "顺从的流体，或灵体",
      "x": 888,
      "y": 13888,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n319",
      "type": "text",
      "text": "宿主的身份、部位、尺寸都还在",
      "x": 888,
      "y": 13944,
      "width": 256,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n320",
      "type": "text",
      "text": "描述 = 宿主外形 + 流体或灵体材质",
      "x": 888,
      "y": 14000,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n321",
      "type": "text",
      "text": "这是状态，不进装备栏",
      "x": 888,
      "y": 14056,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n322",
      "type": "text",
      "text": "可以标记谁在选行动",
      "x": 888,
      "y": 14112,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n323",
      "type": "text",
      "text": "标记只改谁选行动，不把人变成装备",
      "x": 888,
      "y": 14168,
      "width": 288,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n324",
      "type": "text",
      "text": "寄生",
      "x": 684,
      "y": 14392,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n325",
      "type": "text",
      "text": "谁能做：流体、触手、虫群",
      "x": 888,
      "y": 14224,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n326",
      "type": "text",
      "text": "藏在宿主体内",
      "x": 888,
      "y": 14280,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n327",
      "type": "text",
      "text": "宿主外形不变，不追加材质词",
      "x": 888,
      "y": 14336,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n328",
      "type": "text",
      "text": "记下种类和来源",
      "x": 888,
      "y": 14392,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n329",
      "type": "text",
      "text": "不自动抢走行动",
      "x": 888,
      "y": 14448,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n330",
      "type": "text",
      "text": "不把人收成器官",
      "x": 888,
      "y": 14504,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n331",
      "type": "text",
      "text": "灵体不寄生",
      "x": 888,
      "y": 14560,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n332",
      "type": "text",
      "text": "感染",
      "x": 684,
      "y": 14672,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n333",
      "type": "text",
      "text": "已经被寄生的生物可以传给另一个",
      "x": 888,
      "y": 14616,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n334",
      "type": "text",
      "text": "新宿主得到同样的种类和来源",
      "x": 888,
      "y": 14672,
      "width": 240,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n335",
      "type": "text",
      "text": "原宿主不因此解除",
      "x": 888,
      "y": 14728,
      "width": 160,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n336",
      "type": "text",
      "text": "属性 · 原图有的和后补的",
      "x": 204,
      "y": 16884,
      "width": 224,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n337",
      "type": "text",
      "text": "战斗资源 · 原图已有",
      "x": 484,
      "y": 14980,
      "width": 192,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n338",
      "type": "text",
      "text": "生命",
      "x": 732,
      "y": 14784,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n339",
      "type": "text",
      "text": "理智",
      "x": 732,
      "y": 14840,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n340",
      "type": "text",
      "text": "精力",
      "x": 732,
      "y": 14896,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n341",
      "type": "text",
      "text": "体力",
      "x": 732,
      "y": 14952,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n342",
      "type": "text",
      "text": "生命归零：这次战斗失败",
      "x": 732,
      "y": 15008,
      "width": 208,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n343",
      "type": "text",
      "text": "理智满为清醒，归零进入恶堕结局",
      "x": 732,
      "y": 15064,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n344",
      "type": "text",
      "text": "体力：赶路、挣扎、重击、闪避",
      "x": 732,
      "y": 15120,
      "width": 256,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n345",
      "type": "text",
      "text": "精力：交谈、调查、谈判。不和体力顶替",
      "x": 732,
      "y": 15176,
      "width": 320,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n346",
      "type": "text",
      "text": "加点 · 原图举例",
      "x": 484,
      "y": 15316,
      "width": 160,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n347",
      "type": "text",
      "text": "力量",
      "x": 700,
      "y": 15232,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n348",
      "type": "text",
      "text": "敏捷",
      "x": 700,
      "y": 15288,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n349",
      "type": "text",
      "text": "智力",
      "x": 700,
      "y": 15344,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n350",
      "type": "text",
      "text": "这三项名字来自原图，留不留还没勾",
      "x": 700,
      "y": 15400,
      "width": 288,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n351",
      "type": "text",
      "text": "检定候选 · 后补",
      "x": 484,
      "y": 15540,
      "width": 160,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n352",
      "type": "text",
      "text": "感知",
      "x": 700,
      "y": 15456,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n353",
      "type": "text",
      "text": "意志",
      "x": 700,
      "y": 15512,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n354",
      "type": "text",
      "text": "意志是人有多难被逼迫",
      "x": 700,
      "y": 15568,
      "width": 192,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n355",
      "type": "text",
      "text": "理智是会扣光的那一条，两者不是同一个",
      "x": 700,
      "y": 15624,
      "width": 320,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n356",
      "type": "text",
      "text": "战斗派生 · 候选，可由加点算出",
      "x": 484,
      "y": 15904,
      "width": 272,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n357",
      "type": "text",
      "text": "攻击",
      "x": 812,
      "y": 15680,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n358",
      "type": "text",
      "text": "防御",
      "x": 812,
      "y": 15736,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n359",
      "type": "text",
      "text": "速度",
      "x": 812,
      "y": 15792,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n360",
