      "x": 812,
      "y": 16128,
      "width": 148,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n366",
      "type": "text",
      "text": "色色 · 原图已有",
      "x": 484,
      "y": 16240,
      "width": 160,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n367",
      "type": "text",
      "text": "支配 / 顺从",
      "x": 700,
      "y": 16184,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n368",
      "type": "text",
      "text": "已定，见立场",
      "x": 904,
      "y": 16184,
      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n369",
      "type": "text",
      "text": "性癖 / 玩法倾向",
      "x": 700,
      "y": 16240,
      "width": 152,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n370",
      "type": "text",
      "text": "是一组标签，不是一个数字",
      "x": 908,
      "y": 16240,
      "width": 224,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n371",
      "type": "text",
      "text": "敏感度",
      "x": 700,
      "y": 16296,
      "width": 148,
      "height": 46,
      "color": "4"
    },
    {
      "id": "n372",
      "type": "text",
      "text": "可全局一条，也可拆到每个部位",
      "x": 904,
      "y": 16296,
      "width": 256,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n373",
      "type": "text",
      "text": "色色 · 后补，还没勾选",
      "x": 484,
      "y": 16548,
      "width": 208,
      "height": 46,
      "color": "3"
    },
    {
      "id": "n374",
      "type": "text",
      "text": "快感",
