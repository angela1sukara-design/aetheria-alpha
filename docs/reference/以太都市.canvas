      "width": 148,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n224",
      "type": "text",
      "text": "性转只在四档之间换，不新开材质",
      "x": 624,
      "y": 9744,
      "width": 272,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n225",
      "type": "text",
      "text": "通常改胸和生殖的描述",
      "x": 624,
      "y": 9800,
      "width": 192,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n226",
      "type": "text",
      "text": "无性不另造能量核心",
      "x": 624,
      "y": 9856,
      "width": 176,
      "height": 46,
      "color": "5"
    },
    {
      "id": "n227",
